---
// AmbassadorLogin.astro - Acceso Exclusivo de Embajadores con Estética Luxury Brandbook
---

<div id="ambassador-login" class="max-w-md mx-auto p-8 bg-[#140816]/95 border border-[#c5a059]/40 rounded-2xl shadow-[0_4px_30px_rgba(89,31,38,0.3)] mt-8">
  <div class="text-center mb-6">
    <span class="text-xs uppercase tracking-[0.25em] text-[#c5a059] font-medium block mb-1">Comunidad & Embajadores</span>
    <h2 class="text-2xl font-serif font-bold text-[#ead397]">Acceso a Embajadores</h2>
    <p class="text-xs text-[#f7f4ee]/70 mt-2">Gestiona tu enlace exclusivo, monitorea tus referidos y activa tus beneficios.</p>
  </div>
  
  <div id="step-phone" class="space-y-4">
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider text-[#f7f4ee]/80 mb-1">
        WhatsApp / Teléfono <span class="text-[#b84a39]">*</span>
      </label>
      <p class="text-[11px] text-[#f7f4ee]/60 mb-2">Ingresa el número con el que te registraste en nuestra comunidad.</p>
      <input 
        type="tel" 
        id="phone-input" 
        placeholder="Ej: 310 123 4567" 
        class="w-full px-4 py-3 rounded-lg bg-[#0a0608] border border-[#c5a059]/30 text-[#f7f4ee] placeholder-[#f7f4ee]/30 focus:outline-none focus:border-[#c5a059] focus:ring-1 focus:ring-[#c5a059] text-sm transition-all"
      >
    </div>
    <button 
      id="send-otp-btn" 
      class="w-full py-3.5 rounded-lg font-serif font-bold uppercase tracking-wider text-xs bg-[#c5a059] text-[#0a0608] hover:bg-[#ead397] transition-all shadow-md"
    >
      Enviar Código de Acceso
    </button>
  </div>

  <div id="step-verify" class="space-y-4 hidden">
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider text-[#f7f4ee]/80 mb-2">
        Código de Verificación <span class="text-[#b84a39]">*</span>
      </label>
      <input 
        type="text" 
        id="code-input" 
        maxlength="6"
        placeholder="123456" 
        class="w-full px-4 py-3 text-center font-mono tracking-[0.5em] text-lg rounded-lg bg-[#0a0608] border border-[#c5a059]/40 text-[#ead397] focus:outline-none focus:border-[#c5a059] text-sm transition-all"
      >
      <p class="text-[10px] text-[#f7f4ee]/50 mt-1 text-center">Código de 6 dígitos enviado a tu WhatsApp.</p>
    </div>
    <div class="flex gap-2">
      <button 
        id="verify-otp-btn" 
        class="flex-1 py-3.5 rounded-lg font-serif font-bold uppercase tracking-wider text-xs bg-[#c5a059] text-[#0a0608] hover:bg-[#ead397] transition-all shadow-md"
      >
        Verificar y Entrar
      </button>
      <button 
        id="back-btn" 
        class="px-4 py-3.5 rounded-lg text-xs text-[#f7f4ee]/60 hover:text-[#f7f4ee] border border-[#c5a059]/20"
      >
        Atrás
      </button>
    </div>
  </div>
  
  <p id="auth-message" class="mt-4 text-xs text-center min-h-[16px]"></p>
</div>

<script>
  const stepPhone = document.getElementById('step-phone');
  const stepVerify = document.getElementById('step-verify');
  const phoneInput = document.getElementById('phone-input') as HTMLInputElement;
  const codeInput = document.getElementById('code-input') as HTMLInputElement;
  const sendOtpBtn = document.getElementById('send-otp-btn') as HTMLButtonElement;
  const verifyOtpBtn = document.getElementById('verify-otp-btn') as HTMLButtonElement;
  const backBtn = document.getElementById('back-btn');
  const authMessage = document.getElementById('auth-message');

  let currentPhone = '';

  sendOtpBtn?.addEventListener('click', async () => {
    currentPhone = phoneInput?.value.trim();
    if (!currentPhone) {
      if (authMessage) {
        authMessage.className = 'mt-4 text-xs text-center text-[#ef5350]';
        authMessage.textContent = 'Por favor ingresa un número de teléfono válido';
      }
      return;
    }
    
    sendOtpBtn.textContent = 'Enviando...';
    sendOtpBtn.disabled = true;
    
    try {
      const res = await fetch("/api/otp/send", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ destination: currentPhone, channel: "whatsapp" }),
      });
      const data = await res.json();
      
      if (!data.success) {
        if (authMessage) {
          authMessage.className = 'mt-4 text-xs text-center text-[#ef5350]';
          authMessage.textContent = data.error || 'Error al enviar código';
        }
      } else {
        stepPhone?.classList.add('hidden');
        stepVerify?.classList.remove('hidden');
        if (authMessage) {
          authMessage.className = 'mt-4 text-xs text-center text-[#81c784]';
          authMessage.textContent = 'Código enviado a tu WhatsApp';
        }
        codeInput?.focus();
      }
    } catch (e: any) {
      if (authMessage) {
        authMessage.className = 'mt-4 text-xs text-center text-[#ef5350]';
        authMessage.textContent = e.message || 'Error de conexión';
      }
    } finally {
      sendOtpBtn.textContent = 'Enviar Código de Acceso';
      sendOtpBtn.disabled = false;
    }
  });

  backBtn?.addEventListener('click', () => {
    stepVerify?.classList.add('hidden');
    stepPhone?.classList.remove('hidden');
    if (authMessage) authMessage.textContent = '';
  });

  verifyOtpBtn?.addEventListener('click', async () => {
    const code = codeInput?.value.trim();
    if (!code || code.length < 4) {
      if (authMessage) {
        authMessage.className = 'mt-4 text-xs text-center text-[#ef5350]';
        authMessage.textContent = 'Ingresa el código de verificación';
      }
      return;
    }
    
    verifyOtpBtn.textContent = 'Verificando...';
    verifyOtpBtn.disabled = true;
    
    try {
      const res = await fetch("/api/otp/verify", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ destination: currentPhone, code, channel: "whatsapp" }),
      });
      const data = await res.json();
      
      if (!data.success) {
        if (authMessage) {
          authMessage.className = 'mt-4 text-xs text-center text-[#ef5350]';
          authMessage.textContent = data.error || 'Código inválido o expirado';
        }
      } else {
        // Save session identifier in localStorage
        localStorage.setItem("ambassador_session_phone", currentPhone);
        if (authMessage) {
          authMessage.className = 'mt-4 text-xs text-center text-[#81c784]';
          authMessage.textContent = 'Acceso concedido. Redirigiendo...';
        }
        window.location.href = '/dashboard';
      }
    } catch (e: any) {
      if (authMessage) {
        authMessage.className = 'mt-4 text-xs text-center text-[#ef5350]';
        authMessage.textContent = e.message || 'Error de verificación';
      }
    } finally {
      verifyOtpBtn.textContent = 'Verificar y Entrar';
      verifyOtpBtn.disabled = false;
    }
  });
</script>
