---
interface Props {
  current?: "inicio" | "luna-llena" | "vip" | "checkout";
}

const { current } = Astro.props;
---

<header class="py-4 px-4 sm:px-8 max-w-7xl mx-auto flex justify-between items-center border-b border-[#c5a059]/20 relative z-30">
  <a href="/the-corset-society" class="flex items-center gap-2.5 sm:gap-3 group">
    <img 
      src="/media/logo_corsetsociety_transparent.png" 
      alt="Sigilo The Corset Society" 
      class="h-10 sm:h-12 w-auto object-contain group-hover:scale-105 transition-transform drop-shadow-[0_0_15px_rgba(197,160,89,0.25)]" 
    />
    <div class="flex flex-col">
      <span class="font-serif text-xs sm:text-base uppercase tracking-[0.25em] text-[#ead397] font-semibold">The Corset Society</span>
      <span class="text-[8px] sm:text-[9px] uppercase tracking-[0.3em] text-[#c5a059]/70 font-sans hidden sm:inline">Línea de Alta Exclusividad</span>
    </div>
  </a>

  <!-- Right Actions -->
  <div class="flex items-center gap-2 sm:gap-4">
    <!-- Botón Pequeño de Panel (siempre visible por fuera) -->
    <a 
      href="/dashboard" 
      class="text-[11px] sm:text-xs font-sans tracking-wider uppercase text-[#ead397] hover:text-white border border-[#c5a059]/50 px-2.5 sm:px-3 py-1.5 rounded-full bg-[#c5a059]/20 hover:bg-[#c5a059]/35 transition-all flex items-center gap-1 shadow-sm whitespace-nowrap"
      title="Acceso al Panel"
    >
      <span>👤</span>
      <span>Panel</span>
    </a>

    <!-- Menú Desktop -->
    <nav class="hidden md:flex items-center gap-3">
      <a 
        href="/the-corset-society/luna-llena" 
        class={`text-xs uppercase tracking-wider px-3 py-1.5 rounded-full border transition-all ${
          current === "luna-llena" 
            ? "border-[#c5a059] bg-[#c5a059]/25 text-[#ead397] font-bold" 
            : "text-[#c5a059] border-[#c5a059]/40 bg-[#c5a059]/10 hover:bg-[#c5a059]/20"
        }`}
      >
        🌕 Luna Llena
      </a>
      <a 
        href="/corset-vip" 
        class={`text-xs font-sans tracking-wider uppercase px-3 py-1.5 rounded-full border transition-all ${
          current === "vip" 
            ? "border-[#c5a059] bg-[#c5a059]/25 text-white font-bold" 
            : "text-[#ead397] hover:text-white border-[#c5a059]/40 bg-[#c5a059]/20 hover:bg-[#c5a059]/30"
        }`}
      >
        Credencial VIP
      </a>
      <a 
        href="/" 
        class="text-xs font-sans tracking-wider uppercase text-[#c5a059] hover:text-[#ead397] border border-[#c5a059]/30 px-3 py-1.5 rounded-full hover:bg-[#c5a059]/10 transition-colors"
      >
        ← El Placer DC
      </a>
    </nav>

    <!-- Botón Hamburguesa Mobile -->
    <button 
      type="button" 
      id="corset-menu-toggle"
      class="md:hidden p-2 rounded-xl border border-[#c5a059]/40 bg-[#250e29] text-[#ead397] hover:bg-[#c5a059]/20 transition-all focus:outline-none"
      aria-label="Abrir menú de The Corset Society"
    >
      <svg id="corset-icon-burger" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="corset-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Menú Desplegable Hamburguesa Mobile -->
  <div 
    id="corset-mobile-panel" 
    class="hidden md:hidden absolute top-full left-0 right-0 bg-[#120516]/98 backdrop-blur-2xl border-b border-[#c5a059]/40 p-5 space-y-3 shadow-2xl z-50 text-center"
  >
    <a 
      href="/the-corset-society/luna-llena" 
      class="block py-2.5 px-4 rounded-xl text-xs uppercase tracking-wider font-serif font-bold text-[#050505] bg-gradient-to-r from-[#c5a059] to-[#ead397] shadow-md"
    >
      🌕 Noche de Luna Llena (Halloween)
    </a>
    <a 
      href="/corset-vip" 
      class="block py-2.5 px-4 rounded-xl text-xs uppercase tracking-wider font-semibold text-[#ead397] border border-[#c5a059]/40 bg-[#250e29]/70 hover:bg-[#c5a059]/20 transition-all"
    >
      💎 Credencial & Membresía Anual VIP
    </a>
    <a 
      href="/the-corset-society" 
      class="block py-2 px-4 rounded-xl text-xs uppercase tracking-wider text-[#c5a059] hover:text-white transition-colors"
    >
      🗝️ Inicio The Corset Society
    </a>
    <a 
      href="/" 
      class="block py-2 px-4 rounded-xl text-xs uppercase tracking-wider text-[#f7f4ee]/70 hover:text-white transition-colors"
    >
      ← Volver a El Placer DC
    </a>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById("corset-menu-toggle");
  const mobilePanel = document.getElementById("corset-mobile-panel");
  const iconBurger = document.getElementById("corset-icon-burger");
  const iconClose = document.getElementById("corset-icon-close");

  toggleBtn?.addEventListener("click", () => {
    const isHidden = mobilePanel?.classList.contains("hidden");
    if (isHidden) {
      mobilePanel?.classList.remove("hidden");
      iconBurger?.classList.add("hidden");
      iconClose?.classList.remove("hidden");
    } else {
      mobilePanel?.classList.add("hidden");
      iconBurger?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
    }
  });
</script>
