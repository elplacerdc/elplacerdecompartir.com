---
// src/components/CorsetHeader.astro - Cabecera Oficial The Corset Society
import { pool } from "../db/index";

interface Props {
  current?: "inicio" | "luna-llena" | "vip" | "checkout";
}

const { current } = Astro.props;

let nextEvent = {
  title: "🌕 Luna Llena Halloween",
  url_path: "/the-corset-society/luna-llena",
};

try {
  const { rows } = await pool.query(
    `SELECT title, url_path FROM events 
     WHERE sub_brand IN ('the_corset_society', 'corset') 
       AND is_active = true 
       AND date >= NOW() 
     ORDER BY date ASC LIMIT 1`
  );
  if (rows.length > 0) {
    nextEvent = {
      title: rows[0].title.includes("Luna Llena") ? "🌕 Luna Llena Halloween" : `✨ ${rows[0].title}`,
      url_path: rows[0].url_path || "/the-corset-society/luna-llena",
    };
  }
} catch (_) {}
---

<header class="py-4 px-4 sm:px-8 max-w-7xl mx-auto flex justify-between items-center border-b border-[#c5a059]/20 relative z-30 bg-[#050505]">
  <a href="/the-corset-society" class="flex items-center gap-2.5 sm:gap-3 group">
    <img 
      src="/media/logo_corsetsociety_transparent.png" 
      alt="Sigilo The Corset Society" 
      class="h-10 sm:h-12 w-auto object-contain group-hover:scale-105 transition-transform drop-shadow-[0_0_15px_rgba(197,160,89,0.25)]" 
    />
    <div class="flex flex-col">
      <span class="font-serif text-xs sm:text-base uppercase tracking-[0.25em] text-[#ead397] font-semibold">The Corset Society</span>
      <span class="text-[8px] sm:text-[9px] uppercase tracking-[0.3em] text-[#c5a059]/70 font-sans hidden sm:inline">Línea de Alta Exclusividad</span>
    </div>
  </a>

  <!-- Right Actions -->
  <div class="flex items-center gap-2 sm:gap-4">
    <!-- Redes Sociales Corset & Segisw -->
    <div class="hidden lg:flex items-center gap-2 text-[#c5a059]/80 pr-1">
      <a href="https://x.com/corsetsociety" target="_blank" rel="noopener noreferrer" title="X @corsetsociety" class="p-1.5 hover:text-[#ead397] transition-colors flex items-center gap-1 text-[11px] font-sans">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        <span class="hidden xl:inline text-[10px]">@corsetsociety</span>
      </a>
      <a href="https://x.com/SegiSw" target="_blank" rel="noopener noreferrer" title="X @SegiSw" class="p-1.5 hover:text-[#ead397] transition-colors flex items-center gap-1 text-[11px] font-sans">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        <span class="hidden xl:inline text-[10px]">@SegiSw</span>
      </a>
    </div>

    <!-- Botón Pequeño de Panel -->
    <a 
      href="/dashboard" 
      class="text-[11px] sm:text-xs font-sans tracking-wider uppercase text-[#ead397] hover:text-white border border-[#c5a059]/50 px-2.5 sm:px-3 py-1.5 rounded-full bg-[#0a0608] hover:bg-[#c5a059]/20 transition-all flex items-center gap-1 shadow-sm whitespace-nowrap"
      title="Acceso al Panel"
    >
      <span>👤</span>
      <span>Panel</span>
    </a>

    <!-- Menú Desktop -->
    <nav class="hidden md:flex items-center gap-3">
      <a 
        href="/the-corset-society" 
        class={`text-xs uppercase tracking-wider px-3 py-1.5 rounded-full transition-all ${
          current === "inicio"
            ? "border border-[#c5a059] bg-[#c5a059]/25 text-[#ead397] font-bold"
            : "text-[#c5a059] hover:text-[#ead397] hover:bg-[#c5a059]/10"
        }`}
      >
        The Corset Society
      </a>
      <a 
        href={nextEvent.url_path} 
        class={`text-xs uppercase tracking-wider px-3.5 py-1.5 rounded-full border transition-all ${
          current === "luna-llena" 
            ? "border-[#c5a059] bg-[#c5a059]/25 text-[#ead397] font-bold" 
            : "text-[#c5a059] border-[#c5a059]/40 bg-[#0a0608] hover:bg-[#c5a059]/20"
        }`}
      >
        {nextEvent.title}
      </a>
      <a 
        href="/corset-vip#vip-checkout-box" 
        class="corset-vip-cta-item text-xs font-sans tracking-wider uppercase px-3.5 py-1.5 rounded-full border text-[#ead397] hover:text-white border-[#c5a059]/50 bg-[#0a0608] hover:bg-[#c5a059]/20 hover:brightness-110 transition-all"
      >
        💎 Activar VIP <span class="corset-vip-price-tag font-sans font-bold">($199k)</span>
      </a>
      <a 
        href="/corset-vip" 
        class="corset-vip-benefits-item hidden text-xs font-sans tracking-wider uppercase px-3.5 py-1.5 rounded-full border text-[#c5a059] hover:text-[#ead397] border-[#c5a059]/40 bg-[#0a0608] hover:bg-[#c5a059]/20 transition-all"
      >
        💎 Beneficios VIP
      </a>
      <a 
        href="/" 
        class="text-xs font-sans tracking-wider uppercase text-[#ead397] hover:text-white bg-[#380b1e] border border-[#b84a39] px-3.5 py-1.5 rounded-full hover:bg-[#b84a39] transition-all shadow-[0_0_12px_rgba(184,74,57,0.3)] font-semibold"
      >
        ← Volver a El Placer DC
      </a>
    </nav>

    <!-- Botón Hamburguesa Mobile -->
    <button 
      type="button" 
      id="corset-menu-toggle"
      class="md:hidden p-2 rounded-xl border border-[#c5a059]/40 bg-[#0a0608] text-[#ead397] hover:bg-[#c5a059]/20 transition-all focus:outline-none"
      aria-label="Abrir menú de The Corset Society"
    >
      <svg id="corset-icon-burger" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="corset-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Menú Desplegable Hamburguesa Mobile -->
  <div 
    id="corset-mobile-panel" 
    class="hidden md:hidden absolute top-full left-0 right-0 bg-[#000000]/98 backdrop-blur-2xl border-b border-[#c5a059]/40 p-5 space-y-3 shadow-2xl z-50 text-center"
  >
    <a 
      href="/the-corset-society" 
      class="block py-2.5 px-4 rounded-xl text-xs uppercase tracking-wider font-serif font-bold text-[#ead397] border border-[#c5a059]/40 bg-[#0a0608] hover:bg-[#c5a059]/20 transition-all"
    >
      The Corset Society
    </a>
    <a 
      href={nextEvent.url_path} 
      class="block py-2.5 px-4 rounded-xl text-xs uppercase tracking-wider font-serif font-bold text-[#050505] bg-gradient-to-r from-[#c5a059] to-[#ead397] shadow-md"
    >
      {nextEvent.title}
    </a>
    <a 
      href="/corset-vip#vip-checkout-box" 
      class="corset-vip-cta-item block py-2.5 px-4 rounded-xl text-xs uppercase tracking-wider font-semibold text-[#ead397] border border-[#c5a059]/40 bg-[#0a0608] hover:bg-[#c5a059]/20 transition-all"
    >
      💎 Activar Membresía VIP <span class="corset-vip-price-tag font-sans font-bold">($199k)</span>
    </a>
    <a 
      href="/corset-vip" 
      class="block py-2 px-4 rounded-xl text-xs uppercase tracking-wider text-[#ead397]/80 hover:text-white transition-colors"
    >
      🗝️ Ver Beneficios VIP
    </a>
    <div class="flex items-center justify-center gap-4 py-2 border-t border-[#c5a059]/20 text-[#c5a059]">
      <a href="https://x.com/corsetsociety" target="_blank" rel="noopener noreferrer" class="text-xs hover:text-[#ead397]">
        @corsetsociety
      </a>
      <span>•</span>
      <a href="https://x.com/SegiSw" target="_blank" rel="noopener noreferrer" class="text-xs hover:text-[#ead397]">
        @SegiSw
      </a>
    </div>
    <a 
      href="/" 
      class="block py-2.5 px-4 rounded-xl text-xs uppercase tracking-wider text-[#ead397] hover:text-white bg-[#380b1e] border border-[#b84a39] transition-all font-semibold shadow-[0_0_12px_rgba(184,74,57,0.3)]"
    >
      ← Volver a El Placer DC
    </a>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById("corset-menu-toggle");
  const mobilePanel = document.getElementById("corset-mobile-panel");
  const iconBurger = document.getElementById("corset-icon-burger");
  const iconClose = document.getElementById("corset-icon-close");

  toggleBtn?.addEventListener("click", () => {
    const isHidden = mobilePanel?.classList.contains("hidden");
    if (isHidden) {
      mobilePanel?.classList.remove("hidden");
      iconBurger?.classList.add("hidden");
      iconClose?.classList.remove("hidden");
    } else {
      mobilePanel?.classList.add("hidden");
      iconBurger?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
    }
  });

  // Client check: si el usuario es VIP activo, ocultar "Activar VIP" y mostrar "Beneficios VIP", y actualizar precio dinámico
  function checkCorsetHeaderVip() {
    const cachedVip = localStorage.getItem("user_vip_status") || localStorage.getItem("vip_status");
    if (cachedVip === "vip_activo") {
      document.querySelectorAll(".corset-vip-cta-item").forEach(el => el.classList.add("hidden"));
      document.querySelectorAll(".corset-vip-benefits-item").forEach(el => el.classList.remove("hidden"));
      return;
    }

    // Resolver descuento por referido activo
    const urlParams = new URLSearchParams(window.location.search);
    let ref = urlParams.get("ref") || urlParams.get("r") || localStorage.getItem("affiliate_ref");
    if (!ref) {
      const match = document.cookie.match(/(?:^|;\s*)affiliate_ref=([^;]+)/);
      if (match) ref = decodeURIComponent(match[1]).trim().toLowerCase();
    }

    function applyHeaderPrice(priceK: string) {
      document.querySelectorAll(".corset-vip-price-tag").forEach(el => {
        el.textContent = `(${priceK})`;
      });
    }

    if (ref) {
      const cleanRef = ref.trim().toLowerCase();
      let isVipRef = cleanRef === "segisw";
      applyHeaderPrice(isVipRef ? "$159k" : "$179k");

      fetch(`/api/affiliates/stats?identifier=${encodeURIComponent(cleanRef)}`)
        .then(res => res.json())
        .then(data => {
          if (data?.stats?.vipStatus === "vip_activo") {
            applyHeaderPrice("$159k");
          } else {
            applyHeaderPrice("$179k");
          }
        })
        .catch(() => {});
    } else {
      applyHeaderPrice("$199k");
    }

    const ident = localStorage.getItem("user_phone") || localStorage.getItem("user_alias") || localStorage.getItem("user_email") || localStorage.getItem("ambassador_session_phone");
    if (!ident) return;
    fetch(`/api/affiliates/stats?identifier=${encodeURIComponent(ident)}`)
      .then(res => res.json())
      .then(data => {
        if (data?.stats?.vipStatus === "vip_activo") {
          localStorage.setItem("user_vip_status", "vip_activo");
          document.querySelectorAll(".corset-vip-cta-item").forEach(el => el.classList.add("hidden"));
          document.querySelectorAll(".corset-vip-benefits-item").forEach(el => el.classList.remove("hidden"));
        } else if (data?.stats?.referredBy) {
          const isVipRef = data.stats.isReferrerVip || data.stats.referredBy.toLowerCase() === "segisw";
          applyHeaderPrice(isVipRef ? "$159k" : "$179k");
        }
      })
      .catch(() => {});
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", checkCorsetHeaderVip);
  } else {
    checkCorsetHeaderVip();
  }
</script>
