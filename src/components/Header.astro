---
// Header.astro - El Placer de Compartir
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-elplacer-midnight-plum/95 border-b border-corset-gold/25 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <img 
        src="/media/logo_elplacerdc_x.jpg" 
        alt="Logo El Placer de Compartir" 
        class="w-10 h-10 rounded-full border border-elplacer-terracotta/60 group-hover:border-elplacer-terracotta transition-colors object-cover shadow-[0_0_12px_rgba(184,74,57,0.3)]" 
      />
      <div class="flex flex-col">
        <span class="font-serif text-base sm:text-lg tracking-[0.15em] text-corset-gold font-bold uppercase">El Placer</span>
        <span class="text-[9px] sm:text-[10px] uppercase tracking-[0.25em] text-elplacer-ivory font-medium -mt-0.5">de Compartir</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-5 lg:gap-7 text-sm font-medium text-elplacer-ivory/80">
      <a href="/#manifiesto" class="hover:text-elplacer-terracotta transition-colors">Manifiesto</a>
      <a href="/centro-cultural" class="hover:text-elplacer-terracotta transition-colors flex items-center gap-1.5">
        <span>Centro Cultural</span>
        <span class="px-1.5 py-0.5 text-[9px] uppercase font-bold tracking-wider rounded bg-elplacer-terracotta text-elplacer-ivory">Nuevo</span>
      </a>
      <a href="/the-corset-society" class="text-corset-champagne hover:text-corset-gold transition-colors flex items-center gap-1 font-serif tracking-wide">
        <span>The Corset Society</span>
        <span class="text-xs">🔒</span>
      </a>
      <a href="/the-corset-society/luna-llena" class="hover:text-corset-gold transition-colors text-xs uppercase tracking-wider text-corset-champagne border border-corset-gold/40 px-3 py-1 rounded-full bg-corset-gold/10 hover:bg-corset-gold/20">
        🌕 Noche de Luna Llena
      </a>
    </nav>

    <!-- Social & WhatsApp CTA -->
    <div class="flex items-center gap-3 sm:gap-4">
      <div class="hidden lg:flex items-center gap-3 text-elplacer-ivory/60">
        <a href="https://x.com/ElPlacerDC" target="_blank" rel="noopener noreferrer" title="X @ElPlacerDC" class="hover:text-elplacer-terracotta transition-colors">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="https://x.com/SegiSw" target="_blank" rel="noopener noreferrer" title="Directora @SegiSw" class="hover:text-elplacer-terracotta transition-colors">
          <img src="/media/avatar_segisw_x.jpg" alt="SegiSw" class="w-5 h-5 rounded-full border border-elplacer-terracotta/40 object-cover" />
        </a>
        <a href="https://www.tiktok.com/@elplacerdc" target="_blank" rel="noopener noreferrer" title="TikTok @elplacerdc" class="hover:text-elplacer-terracotta transition-colors">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.82 4.49 6.27 6.27 0 0 0 1.86-4.49V8.58a8.28 8.28 0 0 0 5-1.78l-1.09-2.11z"/></svg>
        </a>
      </div>

      <a 
        href="https://wa.me/573194194785" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-2 rounded-full bg-[#2e7d32]/25 text-[#4caf50] border border-[#4caf50]/40 text-xs font-semibold hover:bg-[#2e7d32]/40 transition-all shadow-[0_0_12px_rgba(76,175,80,0.25)]"
      >
        <span class="w-2 h-2 rounded-full bg-[#4caf50] animate-pulse"></span>
        <span>WhatsApp</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button 
        id="mobile-menu-toggle" 
        type="button" 
        class="md:hidden p-2 rounded-lg text-elplacer-terracotta hover:bg-elplacer-terracotta/10 border border-elplacer-terracotta/30 transition-colors focus:outline-none" 
        aria-label="Abrir menú"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div 
    id="mobile-menu-panel" 
    class="hidden md:hidden border-b border-elplacer-terracotta/30 bg-[#180a22]/98 backdrop-blur-xl px-6 py-6 space-y-4"
  >
    <nav class="flex flex-col space-y-3 font-medium text-sm">
      <a href="/#manifiesto" class="mobile-nav-link text-elplacer-ivory/90 hover:text-elplacer-terracotta py-2 border-b border-elplacer-terracotta/15">Manifiesto de Libertad</a>
      <a href="/centro-cultural" class="mobile-nav-link text-elplacer-ivory/90 hover:text-elplacer-terracotta py-2 border-b border-elplacer-terracotta/15 flex items-center justify-between">
        <span>Centro Cultural</span>
        <span class="px-2 py-0.5 text-[9px] uppercase font-bold tracking-wider rounded bg-elplacer-terracotta text-elplacer-ivory">Nuevo</span>
      </a>
      <a href="/the-corset-society" class="mobile-nav-link text-corset-champagne hover:text-corset-gold py-2 border-b border-elplacer-terracotta/15 flex items-center justify-between font-serif">
        <span>The Corset Society</span>
        <span>🔒</span>
      </a>
      <a href="/the-corset-society/luna-llena" class="mobile-nav-link text-corset-gold hover:text-corset-champagne py-2.5 px-3 rounded-lg bg-corset-gold/15 border border-corset-gold/30 text-xs uppercase tracking-wider font-semibold">
        🌕 Noche de Luna Llena (Halloween)
      </a>
    </nav>

    <!-- Social links row in mobile menu -->
    <div class="pt-4 flex items-center justify-around border-t border-elplacer-terracotta/20 text-xs text-elplacer-ivory/60">
      <a href="https://x.com/ElPlacerDC" target="_blank" rel="noopener noreferrer" class="hover:text-elplacer-terracotta py-1">X: @ElPlacerDC</a>
      <span>•</span>
      <a href="https://x.com/SegiSw" target="_blank" rel="noopener noreferrer" class="hover:text-elplacer-terracotta py-1">Dirección: @SegiSw</a>
      <span>•</span>
      <a href="https://www.tiktok.com/@elplacerdc" target="_blank" rel="noopener noreferrer" class="hover:text-elplacer-terracotta py-1">TikTok</a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById("mobile-menu-toggle");
  const panel = document.getElementById("mobile-menu-panel");
  const hamburgerIcon = document.getElementById("hamburger-icon");
  const closeIcon = document.getElementById("close-icon");
  const mobileLinks = document.querySelectorAll(".mobile-nav-link");

  toggleBtn?.addEventListener("click", () => {
    const isHidden = panel?.classList.contains("hidden");
    if (isHidden) {
      panel?.classList.remove("hidden");
      hamburgerIcon?.classList.add("hidden");
      closeIcon?.classList.remove("hidden");
    } else {
      panel?.classList.add("hidden");
      hamburgerIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
    }
  });

  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => {
      panel?.classList.add("hidden");
      hamburgerIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
    });
  });
</script>
