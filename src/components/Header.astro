---
// Header.astro - Menú Superior con Anclas y Botón Luna Llena al Final
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-[#180A1A]/95 border-b border-[#c5a059]/25 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <img 
        src="/media/logo_elplacerdc_x.jpg" 
        alt="Logo El Placer de Compartir" 
        class="w-10 h-10 rounded-full border border-[#b84a39]/60 group-hover:border-[#b84a39] transition-colors object-cover shadow-[0_0_12px_rgba(184,74,57,0.3)]" 
      />
      <div class="flex flex-col">
        <span class="font-serif text-sm sm:text-base tracking-[0.12em] text-[#c5a059] font-bold uppercase">El Placer</span>
        <span class="text-[8px] sm:text-[9px] uppercase tracking-[0.2em] text-[#f7f4ee] font-medium -mt-0.5">de Compartir</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-4 xl:gap-5 text-xs xl:text-sm font-medium text-[#f7f4ee]/85">
      <a href="/centro-cultural" class="hover:text-[#c5a059] transition-colors whitespace-nowrap inline-flex items-center gap-1.5">
        <span>Centro Cultural</span>
        <span class="text-[9px] bg-[#c5a059]/20 text-[#ead397] px-1.5 py-0.5 rounded-full font-semibold border border-[#c5a059]/30 uppercase">Nuevo</span>
      </a>
      <a href="/the-corset-society" class="px-3 py-1.5 rounded-lg bg-[#0a050c] border border-[#c5a059]/40 text-[#ead397] hover:bg-[#c5a059]/20 hover:text-white hover:border-[#c5a059] transition-all shadow-[0_0_12px_rgba(0,0,0,0.6)] whitespace-nowrap inline-flex items-center gap-1.5 font-serif font-semibold text-xs tracking-wide">
        <span>🔒 The Corset Society</span>
        <span class="text-[9px] uppercase tracking-wider text-[#c5a059] bg-[#c5a059]/15 px-1.5 py-0.5 rounded-full border border-[#c5a059]/30">VIP</span>
      </a>

      <!-- Dropdown Comunidad -->
      <div class="relative group">
        <button 
          type="button" 
          class="flex items-center gap-1 hover:text-[#c5a059] transition-colors whitespace-nowrap focus:outline-none cursor-pointer py-2"
        >
          <span>Comunidad</span>
          <svg class="w-3.5 h-3.5 text-[#c5a059]/70 group-hover:text-[#c5a059] transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="absolute left-0 mt-1 w-52 rounded-xl bg-[#180A1A]/98 backdrop-blur-xl border border-[#c5a059]/30 shadow-2xl py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
          <a href="/centro-cultural#proximos-eventos" class="block px-4 py-2 text-xs text-[#ead397] hover:bg-[#c5a059]/15 hover:text-white transition-colors">
            📅 Próximos Eventos
          </a>
          <a href="/#registro" class="block px-4 py-2 text-xs text-[#f7f4ee]/90 hover:bg-[#c5a059]/15 hover:text-[#ead397] transition-colors">
            ✨ Unirme a la Comunidad
          </a>
          <a href="/dashboard" class="block px-4 py-2 text-xs text-[#ead397] hover:bg-[#c5a059]/15 hover:text-white transition-colors">
            💎 Gana como Embajador
          </a>
          <a href="/centro-cultural#postulacion" class="block px-4 py-2 text-xs text-[#f7f4ee]/90 hover:bg-[#c5a059]/15 hover:text-[#ead397] transition-colors">
            🤝 Postular Alianza
          </a>
        </div>
      </div>

      <!-- Botón Luna Llena -->
      <a 
        href="/the-corset-society/luna-llena" 
        class="text-xs uppercase tracking-wider font-serif font-bold text-[#0a0608] bg-gradient-to-r from-[#c5a059] to-[#ead397] hover:brightness-110 px-3.5 py-1.5 rounded-full shadow-[0_0_15px_rgba(197,160,89,0.3)] transition-all whitespace-nowrap"
      >
        🌕 Luna Llena
      </a>

      <!-- Botón Panel Embajadores dedicado -->
      <a 
        href="/dashboard" 
        class="text-xs uppercase tracking-wider font-semibold text-[#ead397] hover:text-white px-3 py-1.5 rounded-full border border-[#c5a059]/40 hover:bg-[#c5a059]/20 transition-all whitespace-nowrap"
      >
        Panel Embajadores
      </a>
    </nav>

    <!-- Social & WhatsApp CTA -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Enlaces Redes Sociales -->
      <div class="hidden xl:flex items-center gap-2 text-[#c5a059]/80 pr-1">
        <a href="https://x.com/ElPlacerDC" target="_blank" rel="noopener noreferrer" title="X @ElPlacerDC" class="p-1.5 hover:text-[#ead397] transition-colors">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="https://www.tiktok.com/@elplacerdc" target="_blank" rel="noopener noreferrer" title="TikTok @elplacerdc" class="p-1.5 hover:text-[#ead397] transition-colors">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.82 4.49 6.27 6.27 0 0 0 1.86-4.49V8.58a8.28 8.28 0 0 0 5-1.78l-1.09-2.11z"/></svg>
        </a>
      </div>

      <!-- Botón WhatsApp con texto guiado y emoticon -->
      <a 
        href="https://wa.me/573194194785?text=te%20escribo%20desde%20la%20p%C3%A1gina%20web%20de%20ElPlacerDC,%20deseo%20m%C3%A1s%20informaci%C3%B3n,%20me%20gu%C3%ADas%3F%20%E2%9C%A8" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-2 rounded-full bg-[#2e7d32]/25 text-[#4caf50] border border-[#4caf50]/40 text-xs font-semibold hover:bg-[#2e7d32]/40 transition-all shadow-[0_0_12px_rgba(76,175,80,0.25)] whitespace-nowrap"
      >
        <span class="w-2 h-2 rounded-full bg-[#4caf50] animate-pulse"></span>
        <span>WhatsApp</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button 
        id="mobile-menu-toggle" 
        type="button" 
        class="lg:hidden p-2 rounded-lg text-[#b84a39] hover:bg-[#b84a39]/10 border border-[#b84a39]/30 transition-colors focus:outline-none" 
        aria-label="Abrir menú"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div 
    id="mobile-menu-panel" 
    class="hidden lg:hidden border-b border-[#b84a39]/30 bg-[#180a22]/98 backdrop-blur-xl px-6 py-6 space-y-4"
  >
    <nav class="flex flex-col space-y-3 font-medium text-sm">
      <a href="/centro-cultural" class="mobile-nav-link text-[#f7f4ee]/90 hover:text-[#c5a059] py-2 border-b border-[#b84a39]/15 flex items-center justify-between">
        <span>Centro Cultural</span>
        <span class="text-[9px] bg-[#c5a059]/20 text-[#ead397] px-1.5 py-0.5 rounded-full font-semibold border border-[#c5a059]/30 uppercase">Nuevo</span>
      </a>
      <a href="/the-corset-society" class="mobile-nav-link text-[#ead397] bg-[#0a050c] border border-[#c5a059]/40 px-3 py-2 rounded-lg hover:text-white hover:bg-[#c5a059]/20 transition-all font-serif font-semibold text-xs flex items-center justify-between shadow-sm">
        <span>🔒 The Corset Society</span>
        <span class="text-[9px] uppercase tracking-wider text-[#c5a059] bg-[#c5a059]/15 px-2 py-0.5 rounded-full border border-[#c5a059]/30">VIP</span>
      </a>
      
      <div class="pt-2 pb-1">
        <span class="text-[11px] uppercase tracking-wider text-[#c5a059] font-serif font-bold">Comunidad</span>
      </div>
      <a href="/centro-cultural#proximos-eventos" class="mobile-nav-link text-[#f7f4ee]/90 hover:text-[#c5a059] py-1.5 pl-3 border-l-2 border-[#c5a059]/40">
        📅 Próximos Eventos
      </a>
      <a href="/#registro" class="mobile-nav-link text-[#f7f4ee]/90 hover:text-[#b84a39] py-1.5 pl-3 border-l-2 border-[#c5a059]/40">
        ✨ Unirme a la Comunidad
      </a>
      <a href="/dashboard" class="mobile-nav-link text-[#ead397] hover:text-[#c5a059] py-1.5 pl-3 border-l-2 border-[#c5a059]/40">
        💎 Gana como Embajador
      </a>
      <a href="/centro-cultural#postulacion" class="mobile-nav-link text-[#f7f4ee]/90 hover:text-[#c5a059] py-1.5 pl-3 border-l-2 border-[#c5a059]/40">
        🤝 Postular Alianza
      </a>

      <!-- Redes Sociales Mobile -->
      <div class="flex items-center gap-4 pt-3 pb-2 text-[#c5a059]">
        <a href="https://x.com/ElPlacerDC" target="_blank" rel="noopener noreferrer" class="text-xs hover:text-[#ead397]">X: @ElPlacerDC</a>
        <span>•</span>
        <a href="https://www.tiktok.com/@elplacerdc" target="_blank" rel="noopener noreferrer" class="text-xs hover:text-[#ead397]">TikTok: @elplacerdc</a>
      </div>

      <!-- Botón Luna Llena -->
      <a 
        href="/the-corset-society/luna-llena" 
        class="mobile-nav-link text-center text-[#0a0608] bg-gradient-to-r from-[#c5a059] to-[#ead397] py-2.5 px-3 rounded-xl text-xs uppercase tracking-wider font-bold shadow-md"
      >
        🌕 Noche de Luna Llena (Halloween)
      </a>

      <!-- Botón Panel Embajadores Mobile -->
      <a 
        href="/dashboard" 
        class="mobile-nav-link text-center text-[#ead397] border border-[#c5a059]/40 hover:bg-[#c5a059]/20 py-2.5 px-3 rounded-xl text-xs uppercase tracking-wider font-semibold shadow-sm"
      >
        Panel Embajadores
      </a>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById("mobile-menu-toggle");
  const panel = document.getElementById("mobile-menu-panel");
  const hamburgerIcon = document.getElementById("hamburger-icon");
  const closeIcon = document.getElementById("close-icon");
  const mobileNavLinks = document.querySelectorAll(".mobile-nav-link");

  toggleBtn?.addEventListener("click", () => {
    panel?.classList.toggle("hidden");
    hamburgerIcon?.classList.toggle("hidden");
    closeIcon?.classList.toggle("hidden");
  });

  mobileNavLinks.forEach((link) => {
    link.addEventListener("click", () => {
      panel?.classList.add("hidden");
      hamburgerIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
    });
  });
</script>
