---
// VipCheckout.astro - Button to start VIP checkout flow
export interface Props {
  userId?: string;
  userEmail?: string;
  userName?: string;
}

const { userId, userEmail, userName } = Astro.props;
---

<div class="vip-checkout-container bg-gradient-to-b from-[#180a22]/80 to-corset-noir p-6 rounded-xl border border-corset-gold shadow-[0_0_20px_rgba(197,160,89,0.2)] text-center space-y-4">
  <h3 class="text-xl font-bold font-serif text-corset-champagne">Membresía VIP Anual</h3>
  <p class="text-sm font-sans font-light text-elplacer-ivory/80">
    Acceso preferencial, invitaciones exclusivas y estatus prioritario durante todo un año por $99 USD.
  </p>
  
  <form action="/api/checkout/dlocal" method="POST">
    <input type="hidden" name="userId" value={userId || ""} />
    <input type="hidden" name="userEmail" value={userEmail || ""} />
    <input type="hidden" name="userName" value={userName || ""} />
    <button 
      type="submit"
      class="inline-block px-6 py-3 rounded-full font-serif font-bold uppercase tracking-widest text-xs bg-gradient-to-r from-corset-gold to-corset-champagne text-corset-noir hover:brightness-110 shadow-[0_0_15px_rgba(197,160,89,0.4)] transition-all cursor-pointer"
    >
      Become VIP
    </button>
  </form>
</div>
