---
// VipCheckout.astro - Botón de Activación de Credencial VIP Anual con Soporte de Descuento 10% por Embajador
export interface Props {
  userId?: string;
  userEmail?: string;
  userName?: string;
}

const { userId, userEmail, userName } = Astro.props;
const cookieRef = Astro.cookies.get("affiliate_ref")?.value || Astro.url.searchParams.get("ref") || Astro.url.searchParams.get("r") || null;
---

<div class="vip-checkout-container bg-gradient-to-b from-[#180a22]/90 via-[#0f0714] to-[#050505] p-8 rounded-2xl border border-[#c5a059] shadow-[0_0_30px_rgba(197,160,89,0.25)] text-center space-y-4">
  <div class="flex items-center justify-center gap-2">
    <span class="inline-block px-3.5 py-1 rounded-full text-[10px] font-serif font-bold uppercase tracking-[0.2em] bg-[#c5a059]/20 text-[#ead397] border border-[#c5a059]/40">
      Línea de Alta Exclusividad
    </span>
    <span id="vip-discount-tag" class={`${cookieRef ? '' : 'hidden'} px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-[#81c784]/20 text-[#81c784] border border-[#81c784]/40`}>
      -10% Embajador
    </span>
  </div>

  <h3 class="text-2xl font-bold font-serif text-[#ead397]">Credencial VIP Anual</h3>

  <div id="vip-price-display" class="text-3xl font-serif font-bold text-[#f7f4ee]">
    {cookieRef ? (
      <>
        <span class="line-through text-[#f7f4ee]/40 text-xl mr-2 font-normal">$199.000</span>
        <span class="text-[#81c784]">$179.000</span>
        <span class="text-sm font-sans font-normal text-[#c5a059] ml-1">COP / año</span>
      </>
    ) : (
      <>
        $199.000 <span class="text-sm font-sans font-normal text-[#c5a059]">COP / año</span>
      </>
    )}
  </div>

  <!-- Banner de Embajador Activo -->
  <div id="vip-affiliate-banner" class={`${cookieRef ? '' : 'hidden'} p-3 rounded-xl bg-[#c5a059]/15 border border-[#c5a059]/40 text-xs text-[#ead397] max-w-md mx-auto`}>
    🎉 <strong>Beneficio de Embajador Activo:</strong> 10% de descuento de cortesía aplicado por invitación exclusiva de <strong id="vip-affiliate-name" class="text-[#c5a059]">@{cookieRef || 'embajador'}</strong>.
  </div>

  <p class="text-xs sm:text-sm font-sans font-light text-[#f7f4ee]/80 max-w-md mx-auto leading-relaxed">
    Acceso preferencial durante 365 días a convocatorias secretas, descuentos permanentes en todas las veladas, convocatorias a fantasías privadas y trato de honor como miembro del círculo prémium de ElPlacerDC.
  </p>
  
  <form id="vipCheckoutForm" action="/api/checkout/dlocal" method="POST" class="pt-2">
    <input type="hidden" name="userId" value={userId || ""} />
    <input type="hidden" name="userEmail" value={userEmail || ""} />
    <input type="hidden" name="userName" value={userName || ""} />
    <input type="hidden" id="vip-input-ref" name="ref" value={cookieRef || ""} />
    <button 
      type="submit"
      id="vip-submit-btn"
      class="w-full sm:w-auto px-8 py-4 rounded-full font-serif font-bold uppercase tracking-widest text-xs bg-gradient-to-r from-[#c5a059] via-[#ead397] to-[#8a6d3b] text-[#050505] hover:brightness-110 shadow-[0_0_20px_rgba(197,160,89,0.35)] transition-all cursor-pointer"
    >
      Adquirir Membresía Anual VIP {cookieRef ? "($179.000 COP)" : "($199.000 COP)"}
    </button>
  </form>
  <p class="text-[10px] text-[#f7f4ee]/40 font-sans">Pago cifrado y seguro en pesos colombianos (COP). Activación inmediata.</p>
</div>

<script is:inline>
  function initVipPricing() {
    try {
      const urlParams = new URLSearchParams(window.location.search);
      const refParam = urlParams.get("ref") || urlParams.get("r");
      let localRef = refParam || localStorage.getItem("affiliate_ref");
      if (!localRef) {
        const match = document.cookie.match(/(?:^|;\s*)affiliate_ref=([^;]+)/);
        if (match) localRef = decodeURIComponent(match[1]).trim().toLowerCase();
      }
      if (localRef) {
        const cleanRef = localRef.trim().toLowerCase();
        localStorage.setItem("affiliate_ref", cleanRef);
        document.cookie = 'affiliate_ref=' + encodeURIComponent(cleanRef) + '; path=/; max-age=2592000; SameSite=Lax';

        const inputRef = document.getElementById("vip-input-ref");
        if (inputRef) inputRef.value = cleanRef;

        const discountTag = document.getElementById("vip-discount-tag");
        if (discountTag) discountTag.classList.remove("hidden");

        const banner = document.getElementById("vip-affiliate-banner");
        const bannerName = document.getElementById("vip-affiliate-name");
        if (banner) banner.classList.remove("hidden");
        if (bannerName) bannerName.textContent = `@${cleanRef}`;

        const priceDisplay = document.getElementById("vip-price-display");
        if (priceDisplay) {
          priceDisplay.innerHTML = `
            <span class="line-through text-[#f7f4ee]/40 text-xl mr-2 font-normal">$199.000</span>
            <span class="text-[#81c784] font-bold">$179.000</span>
            <span class="text-sm font-sans font-normal text-[#c5a059] ml-1">COP / año</span>
          `;
        }

        const submitBtn = document.getElementById("vip-submit-btn");
        if (submitBtn) {
          submitBtn.textContent = "Adquirir Membresía Anual VIP ($179.000 COP)";
        }
      }
    } catch (e) {}
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initVipPricing);
  } else {
    initVipPricing();
  }
</script>
