---
// VipCheckout.astro - Botón de Activación de Credencial VIP Anual con Soporte de Descuento 20% (VIP) / 10% (Estándar)
import { pool } from "../db/index";

export interface Props {
  userId?: string;
  userEmail?: string;
  userName?: string;
}

const { userId, userEmail, userName } = Astro.props;
const cookieRef = Astro.cookies.get("affiliate_ref")?.value || Astro.url.searchParams.get("ref") || Astro.url.searchParams.get("r") || null;

let isVipRefSsr = false;
if (cookieRef) {
  try {
    const ambCheck = await pool.query(
      `SELECT l.vip_until, l.metadata 
       FROM afiliados a 
       LEFT JOIN leads l ON (LOWER(l.email) = LOWER(a.email) OR l.whatsapp = a.whatsapp OR LOWER(l.alias_nombre) = LOWER(a.alias))
       WHERE LOWER(a.alias) = LOWER($1)
       LIMIT 1`,
      [cookieRef.trim()]
    );
    if (ambCheck.rows.length > 0) {
      const amb = ambCheck.rows[0];
      isVipRefSsr = Boolean(
        (amb.vip_until && new Date(amb.vip_until) > new Date()) ||
        (amb.metadata?.vip_until && new Date(amb.metadata.vip_until) > new Date()) ||
        (amb.metadata?.tags && amb.metadata.tags.includes("vip_activo"))
      );
    }
  } catch (_) {}
}

const initialPrice = isVipRefSsr ? "$159.000" : (cookieRef ? "$179.000" : "$199.000");
const initialTag = isVipRefSsr ? "-20% Embajador VIP" : "-10% Embajador";
const initialPct = isVipRefSsr ? "20%" : "10%";
---

<div class="vip-checkout-container bg-gradient-to-b from-[#180a22]/90 via-[#0f0714] to-[#050505] p-8 rounded-2xl border border-[#c5a059] shadow-[0_0_30px_rgba(197,160,89,0.25)] text-center space-y-4">
  <div class="flex items-center justify-center gap-2">
    <span class="inline-block px-3.5 py-1 rounded-full text-[10px] font-serif font-bold uppercase tracking-[0.2em] bg-[#c5a059]/20 text-[#ead397] border border-[#c5a059]/40">
      Línea de Alta Exclusividad
    </span>
    <span id="vip-discount-tag" class={`${cookieRef ? '' : 'hidden'} px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-[#81c784]/20 text-[#81c784] border border-[#81c784]/40`}>
      {initialTag}
    </span>
  </div>

  <h3 class="text-2xl font-bold font-serif text-[#ead397]">Credencial VIP Anual</h3>

  <div id="vip-price-display" class="text-3xl font-serif font-bold text-[#f7f4ee]">
    {cookieRef ? (
      <>
        <span class="line-through text-[#f7f4ee]/40 text-xl mr-2 font-normal">$199.000</span>
        <span class="text-[#81c784]">{initialPrice}</span>
        <span class="text-sm font-sans font-normal text-[#c5a059] ml-1">COP / año</span>
      </>
    ) : (
      <>
        $199.000 <span class="text-sm font-sans font-normal text-[#c5a059]">COP / año</span>
      </>
    )}
  </div>

  <!-- Banner de Embajador -->
  <div id="vip-affiliate-banner" class={`${cookieRef ? '' : 'hidden'} p-3 rounded-xl bg-[#c5a059]/15 border border-[#c5a059]/40 text-xs text-[#ead397] max-w-md mx-auto`}>
    🎉 <strong>Beneficio de Embajador:</strong> <span id="vip-affiliate-pct">{initialPct}</span> de descuento de cortesía por invitación de <strong id="vip-affiliate-name" class="text-[#c5a059]">@{cookieRef || 'embajador'}</strong>.
  </div>

  <p class="text-xs sm:text-sm font-sans font-light text-[#f7f4ee]/80 max-w-md mx-auto leading-relaxed">
    Acceso preferencial con tu membresía anual a convocatorias secretas, descuentos permanentes en todas las veladas, convocatorias a fantasías privadas y trato de honor como miembro del círculo prémium de ElPlacerDC.
  </p>
  
  <form class="vipCheckoutForm pt-2" action="/api/checkout/dlocal" method="POST">
    <input type="hidden" name="userId" value={userId || ""} />
    <input type="hidden" name="userEmail" value={userEmail || ""} />
    <input type="hidden" name="userName" value={userName || ""} />
    <input type="hidden" class="vip-input-phone" name="userPhone" value="" />
    <input type="hidden" class="vip-input-ref" name="ref" value={cookieRef || ""} />
    <button 
      type="submit"
      class="vip-submit-btn w-full sm:w-auto px-8 py-4 rounded-full font-serif font-bold uppercase tracking-widest text-xs bg-gradient-to-r from-[#c5a059] via-[#ead397] to-[#8a6d3b] text-[#050505] hover:brightness-110 shadow-[0_0_20px_rgba(197,160,89,0.35)] transition-all cursor-pointer"
    >
      Adquirir Membresía Anual VIP ({initialPrice} COP)
    </button>
    <p class="vip-checkout-msg text-xs text-[#ead397] mt-2 min-h-[1.25rem]"></p>
  </form>
  <p class="text-[10px] text-[#f7f4ee]/40 font-sans">Pago cifrado y seguro en pesos colombianos (COP). Activación inmediata.</p>
</div>

<script is:inline>
  function initVipPricing() {
    try {
      // 1. Session autofill for all VIP checkout forms
      let profile = null;
      try {
        const rawProfile = localStorage.getItem("user_profile");
        if (rawProfile) profile = JSON.parse(rawProfile);
      } catch (_) {}
      const phone = profile?.whatsapp || localStorage.getItem("ambassador_session_phone") || localStorage.getItem("user_phone");
      const email = profile?.email || localStorage.getItem("user_email");
      const alias = profile?.alias_nombre || localStorage.getItem("user_alias");

      const forms = document.querySelectorAll(".vipCheckoutForm");
      forms.forEach((form) => {
        const emailInput = form.querySelector('input[name="userEmail"]');
        const nameInput = form.querySelector('input[name="userName"]');
        const phoneInput = form.querySelector('.vip-input-phone');
        const idInput = form.querySelector('input[name="userId"]');

        if (phone && phoneInput) phoneInput.value = phone;
        if (email && emailInput && !emailInput.value) emailInput.value = email;
        if (alias && nameInput && !nameInput.value) nameInput.value = alias;
        if (phone && idInput && !idInput.value) idInput.value = phone;

        // AJAX submit with clear feedback
        form.addEventListener("submit", async function(e) {
          e.preventDefault();
          const btn = form.querySelector(".vip-submit-btn");
          const msg = form.querySelector(".vip-checkout-msg");

          if (btn) btn.disabled = true;
          if (msg) msg.textContent = "⏳ Conectando con la pasarela segura...";

          const payload = {
            userId: (form.querySelector('input[name="userId"]')?.value || phone || "guest_" + Date.now()),
            userEmail: (form.querySelector('input[name="userEmail"]')?.value || email || "contacto@elplacerdecompartir.com"),
            userName: (form.querySelector('input[name="userName"]')?.value || alias || "Invitado VIP"),
            userPhone: (form.querySelector('.vip-input-phone')?.value || phone || ""),
            ref: (form.querySelector('.vip-input-ref')?.value || localStorage.getItem("affiliate_ref") || ""),
          };

          try {
            const res = await fetch("/api/checkout/dlocal", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (data.success && data.redirect_url) {
              if (msg) msg.textContent = "✓ Redireccionando a la pasarela segura...";
              window.location.href = data.redirect_url;
            } else {
              if (msg) msg.textContent = `❌ ${data.error || "No se pudo generar la orden de pago."}`;
              if (btn) btn.disabled = false;
            }
          } catch (err) {
            if (msg) msg.textContent = "❌ Error de conexión al procesar el pago.";
            if (btn) btn.disabled = false;
          }
        });
      });

      // 2. Affiliate Ref and Discount UI
      let myAlias = (localStorage.getItem("user_alias") || "").trim().toLowerCase();
      let myReferredBy = (localStorage.getItem("user_referred_by") || "").trim().toLowerCase();
      try {
        const rawProfile = localStorage.getItem("user_profile");
        if (rawProfile) {
          const parsed = JSON.parse(rawProfile);
          if (parsed.alias) myAlias = parsed.alias.trim().toLowerCase();
          if (parsed.referredBy) myReferredBy = parsed.referredBy.trim().toLowerCase();
        }
      } catch (_) {}

      const urlParams = new URLSearchParams(window.location.search);
      const refParam = urlParams.get("ref") || urlParams.get("r");
      let localRef = refParam ? refParam.trim().toLowerCase() : null;

      if (localRef && myAlias && localRef === myAlias) {
        localRef = myReferredBy || "segisw";
      }
      if (myReferredBy && myAlias && localRef && localRef !== myReferredBy) {
        localRef = myReferredBy;
      }
      if (!localRef) {
        localRef = localStorage.getItem("affiliate_ref");
      }
      if (!localRef) {
        const match = document.cookie.match(/(?:^|;\s*)affiliate_ref=([^;]+)/);
        if (match) localRef = decodeURIComponent(match[1]).trim().toLowerCase();
      }
      if (localRef && myAlias && localRef === myAlias) {
        localRef = myReferredBy || "segisw";
      }

      if (localRef) {
        const cleanRef = localRef.trim().toLowerCase();
        localStorage.setItem("affiliate_ref", cleanRef);
        document.cookie = 'affiliate_ref=' + encodeURIComponent(cleanRef) + '; path=/; max-age=2592000; SameSite=Lax';

        document.querySelectorAll(".vip-input-ref").forEach((inp) => {
          inp.value = cleanRef;
        });

        let isVipRefClient = cleanRef === 'segisw';
        fetch(`/api/affiliates/stats?identifier=${encodeURIComponent(cleanRef)}`)
          .then((r) => r.json())
          .then((d) => {
            if (d.stats?.vipStatus === 'vip_activo') isVipRefClient = true;
            applyVipRefUI();
          })
          .catch(() => {
            applyVipRefUI();
          });

        function applyVipRefUI() {
          const discountTags = document.querySelectorAll("#vip-discount-tag");
          discountTags.forEach((tag) => {
            tag.textContent = isVipRefClient ? "-20% Embajador VIP" : "-10% Embajador";
            tag.classList.remove("hidden");
          });

          const banners = document.querySelectorAll("#vip-affiliate-banner");
          banners.forEach((banner) => banner.classList.remove("hidden"));

          const bannerNames = document.querySelectorAll("#vip-affiliate-name");
          bannerNames.forEach((bn) => { bn.textContent = `@${cleanRef}`; });

          const bannerPcts = document.querySelectorAll("#vip-affiliate-pct");
          bannerPcts.forEach((bp) => { bp.textContent = isVipRefClient ? "20%" : "10%"; });

          const finalPriceStr = isVipRefClient ? "$159.000" : "$179.000";
          const priceDisplays = document.querySelectorAll("#vip-price-display");
          priceDisplays.forEach((pd) => {
            pd.innerHTML = `
              <span class="line-through text-[#f7f4ee]/40 text-xl mr-2 font-normal">$199.000</span>
              <span class="text-[#81c784] font-bold">${finalPriceStr}</span>
              <span class="text-sm font-sans font-normal text-[#c5a059] ml-1">COP / año</span>
            `;
          });

          const submitBtns = document.querySelectorAll(".vip-submit-btn");
          submitBtns.forEach((btn) => {
            btn.textContent = `Adquirir Membresía Anual VIP (${finalPriceStr} COP)`;
          });
        }
        applyVipRefUI();
      }
    } catch (e) {}
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initVipPricing);
  } else {
    initVipPricing();
  }
</script>
