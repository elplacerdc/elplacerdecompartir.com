---
// LeadForm.astro - Formulario con Perfilado Progresivo, OTP en Tiempo Real y Asignación de Embajador
interface Props {
  isVip?: boolean;
  title?: string;
  subtitle?: string;
}

const { 
  isVip = false, 
  title = isVip ? "Solicitud de Membresía VIP" : "Acceso a la Comunidad", 
  subtitle = isVip
    ? "La admisión se evalúa rigurosamente. The Corset Society es un círculo privado de gala y ticket alto, con covers prémium y aforo estrictamente limitado como filtro natural de privacidad y confort."
    : "Regístrate para recibir convocatorias privadas, talleres y eventos de la comunidad en nuestro centro cultural." 
} = Astro.props;
---

<div class={`p-6 sm:p-10 rounded-2xl border transition-all duration-300 relative overflow-hidden ${
  isVip 
    ? "bg-[#0a0608]/90 border-[#c5a059]/40 shadow-[0_0_30px_rgba(197,160,89,0.15)]" 
    : "bg-[#250F22]/90 border-[#c5a059]/35 shadow-[0_4px_30px_rgba(89,31,38,0.25)]"
}`}>
  <!-- Decorative Ambient Glow -->
  <div class={`absolute top-0 right-0 w-64 h-64 rounded-full blur-3xl -z-10 pointer-events-none ${
    isVip ? "bg-[#4a0e17]/20" : "bg-[#721c24]/20"
  }`}></div>

  <div class="mb-8">
    <h3 class={`text-2xl font-serif font-bold tracking-wide uppercase ${isVip ? "text-[#c5a059]" : "text-[#ead397]"}`}>
      {title}
    </h3>
    <p class="text-sm text-[#f7f4ee]/70 mt-2 leading-relaxed">
      {subtitle}
    </p>
  </div>

  <form id="lead-form" class="space-y-5">
    <input type="hidden" name="corset_vip" value={isVip ? "true" : "false"} />

    <!-- 1. Modalidad de Asistencia o Participación -->
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider text-[#f7f4ee]/80 mb-2">
        Modalidad de Asistencia <span class="text-[#b84a39]">*</span>
      </label>
      <select
        name="rol"
        id="input-rol"
        class="w-full px-4 py-3 rounded-lg bg-[#140816] border border-[#c5a059]/30 text-[#f7f4ee] focus:outline-none focus:border-[#c5a059] text-sm transition-all"
      >
        <option value="pareja">👫 Pareja</option>
        <option value="mujer_sola">🦄 Mujer Sola (Unicornio)</option>
        <option value="hombre_solo">🙋‍♂️ Hombre Solo (Single)</option>
      </select>
    </div>

    <!-- 2. Alias / Pseudónimo con placeholder dinámico -->
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider text-[#f7f4ee]/80 mb-2">
        Alias / Pseudónimo <span class="text-[#b84a39]">*</span>
      </label>
      <input
        type="text"
        name="alias_nombre"
        id="input-alias"
        required
        placeholder="Nombre discreto de Pareja (ej: Camilo & Andrea)"
        class="w-full px-4 py-3 rounded-lg bg-[#140816]/90 border border-[#c5a059]/30 text-[#f7f4ee] placeholder-[#f7f4ee]/30 focus:outline-none focus:border-[#c5a059] focus:ring-1 focus:ring-[#c5a059] text-sm transition-all"
      />
    </div>

    <!-- 3. WhatsApp Phone with Progressive OTP Verification -->
    <div>
      <div id="step-wa-phone" class="space-y-2">
        <label class="block text-xs font-semibold uppercase tracking-wider text-[#f7f4ee]/80 mb-2">
          WhatsApp / Teléfono <span class="text-[#b84a39]">*</span>
        </label>
        <div class="flex flex-col sm:flex-row gap-2">
          <input
            type="tel"
            name="whatsapp"
            id="input-whatsapp"
            required
            placeholder="Ej: 310 123 4567"
            class="flex-1 px-4 py-3 rounded-lg bg-[#140816]/90 border border-[#c5a059]/30 text-[#f7f4ee] placeholder-[#f7f4ee]/30 focus:outline-none focus:border-[#c5a059] focus:ring-1 focus:ring-[#c5a059] text-sm transition-all"
          />
          <button
            type="button"
            id="btn-send-wa-otp"
            class="w-full sm:w-auto px-5 py-3 text-xs uppercase tracking-wider font-semibold rounded-lg bg-[#c5a059] text-[#0a0608] hover:bg-[#ead397] transition-all text-center whitespace-nowrap shadow-md"
          >
            Enviar Código
          </button>
        </div>
      </div>

      <!-- OTP Verification Step (Hides phone input while active, allows "Atrás") -->
      <div id="step-wa-verify" class="hidden p-4 rounded-xl bg-[#140816] border border-[#c5a059]/40 space-y-3">
        <label class="block text-xs font-semibold uppercase tracking-wider text-[#ead397]">
          Código de Verificación WhatsApp <span class="text-[#b84a39]">*</span>
        </label>
        <p class="text-xs text-[#f7f4ee]/70">Ingresa el código de 6 dígitos enviado a tu número.</p>
        <div class="flex flex-col sm:flex-row gap-2">
          <input
            type="text"
            id="input-wa-otp"
            maxlength="6"
            placeholder="123456"
            class="w-full sm:w-44 px-4 py-2.5 text-center font-mono tracking-[0.4em] text-base rounded-lg bg-[#0a0608] border border-[#c5a059]/40 text-[#ead397] focus:outline-none focus:border-[#c5a059]"
          />
          <button
            type="button"
            id="btn-verify-wa-otp"
            class="px-5 py-2.5 text-xs font-bold uppercase rounded-lg bg-[#c5a059] text-[#0a0608] hover:bg-[#ead397] transition-all shadow-md"
          >
            Verificar
          </button>
          <button
            type="button"
            id="btn-back-wa-otp"
            class="px-4 py-2.5 text-xs text-[#f7f4ee]/70 hover:text-white border border-[#c5a059]/30 rounded-lg transition-all"
          >
            Atrás
          </button>
        </div>
        <span id="wa-otp-status" class="text-xs block min-h-[16px]"></span>
      </div>

      <div id="wa-verified-badge" class="hidden p-3 rounded-lg bg-[#140816] border border-[#81c784]/40 flex items-center justify-between text-xs text-[#81c784] font-medium mt-2">
        <span>✓ WhatsApp verificado: <strong id="wa-verified-display" class="text-white font-mono"></strong></span>
        <button type="button" id="btn-change-wa" class="text-[11px] text-[#ead397] underline hover:text-[#c5a059]">Cambiar</button>
      </div>
    </div>

    <!-- Box para usuario existente detectado -->
    <div id="lead-existing-box" class="hidden p-5 rounded-xl bg-[#c5a059]/15 border border-[#c5a059]/40 space-y-4"></div>

    <!-- Campos complementarios para registro nuevo (Ciudad y Email) -->
    <div id="lead-remaining-fields" class="space-y-5">
      <!-- 4. Ciudad -->
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-[#f7f4ee]/80 mb-2">
          Ciudad
        </label>
        <select
          name="ciudad"
          id="input-ciudad"
          class="w-full px-4 py-3 rounded-lg bg-[#050505] border border-[#c5a059]/30 text-[#f7f4ee] focus:outline-none focus:border-[#c5a059] text-sm transition-all"
        >
          <option value="Bogotá">Bogotá</option>
          <option value="Medellín">Medellín</option>
          <option value="Otra">Otra ciudad</option>
        </select>
      </div>

      <!-- 5. Correo Electrónico (al final) con Real-time OTP -->
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-[#f7f4ee]/80 mb-2">
          Correo Electrónico {isVip ? <span class="text-[#c5a059]">(Requerido para membresía VIP *)</span> : <span class="text-[#f7f4ee]/40">(Opcional)</span>}
        </label>
        <div class="flex flex-col sm:flex-row gap-2">
          <input
            type="email"
            name="email"
            id="input-email"
            required={isVip}
            placeholder="ejemplo@correo.com"
            class="flex-1 px-4 py-3 rounded-lg bg-[#140816]/90 border border-[#c5a059]/30 text-[#f7f4ee] placeholder-[#f7f4ee]/30 focus:outline-none focus:border-[#c5a059] focus:ring-1 focus:ring-[#c5a059] text-sm transition-all"
          />
          {isVip && (
            <button
              type="button"
              id="btn-send-email-otp"
              class="w-full sm:w-auto px-4 py-3 text-xs uppercase tracking-wider font-semibold rounded-lg bg-[#c5a059]/20 hover:bg-[#c5a059]/30 text-[#ead397] border border-[#c5a059]/40 transition-all text-center"
            >
              Enviar Código
            </button>
          )}
        </div>

        <!-- Inline OTP verification box for Email -->
        <div id="email-otp-box" class="hidden mt-2 p-3 rounded-lg bg-[#140816] border border-[#c5a059]/30 space-y-2">
          <div class="flex items-center gap-2">
            <input
              type="text"
              id="input-email-otp"
              maxlength="6"
              placeholder="Código (6 dígitos)"
              class="w-36 px-3 py-1.5 text-center font-mono tracking-widest text-sm rounded bg-[#0a0608] border border-[#c5a059]/30 text-[#f7f4ee] focus:border-[#c5a059]"
            />
            <button
              type="button"
              id="btn-verify-email-otp"
              class="px-3 py-1.5 text-xs font-bold uppercase rounded bg-[#c5a059] text-[#0a0608] hover:bg-[#ead397]"
            >
              Verificar
            </button>
            <span id="email-otp-status" class="text-xs text-[#ead397]"></span>
          </div>
        </div>
        <p id="email-verified-badge" class="hidden text-xs text-[#81c784] font-medium mt-1">✓ Correo verificado</p>
      </div>

      <button
        type="submit"
        id="submit-btn"
        class={`w-full py-4 rounded-lg font-serif font-bold uppercase tracking-widest text-sm transition-all shadow-md ${
          isVip
            ? "bg-gradient-to-r from-[#c5a059] via-[#ead397] to-[#8a6d3b] text-[#050505] hover:brightness-110 shadow-[0_0_20px_rgba(197,160,89,0.3)]"
            : "bg-[#b84a39] text-[#f7f4ee] hover:bg-[#a03d2e] shadow-[0_0_15px_rgba(184,74,57,0.3)]"
        }`}
      >
        {isVip ? "Solicitar Admisión VIP" : "Unirme al Círculo"}
      </button>
    </div>

    <!-- Feedback Message (outside remaining-fields so it stays visible on submit) -->
    <div id="form-feedback" class="hidden text-sm p-4 rounded-lg mt-4"></div>
  </form>
</div>

<script>
  const form = document.getElementById("lead-form") as HTMLFormElement;
  const inputWhatsapp = document.getElementById("input-whatsapp") as HTMLInputElement;
  const inputEmail = document.getElementById("input-email") as HTMLInputElement;
  const inputAlias = document.getElementById("input-alias") as HTMLInputElement;
  const inputRol = document.getElementById("input-rol") as HTMLSelectElement;
  const inputCiudad = document.getElementById("input-ciudad") as HTMLSelectElement;
  const formFeedback = document.getElementById("form-feedback") as HTMLElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const leadExistingBox = document.getElementById("lead-existing-box") as HTMLElement;
  const leadRemainingFields = document.getElementById("lead-remaining-fields") as HTMLElement;

  const btnSendWaOtp = document.getElementById("btn-send-wa-otp") as HTMLButtonElement;
  const waOtpBox = document.getElementById("wa-otp-box") as HTMLElement;
  const inputWaOtp = document.getElementById("input-wa-otp") as HTMLInputElement;
  const btnVerifyWaOtp = document.getElementById("btn-verify-wa-otp") as HTMLButtonElement;
  const waOtpStatus = document.getElementById("wa-otp-status") as HTMLElement;
  const waVerifiedBadge = document.getElementById("wa-verified-badge") as HTMLElement;

  const stepWaPhone = document.getElementById("step-wa-phone");
  const stepWaVerify = document.getElementById("step-wa-verify");
  const btnBackWaOtp = document.getElementById("btn-back-wa-otp");
  const waVerifiedDisplay = document.getElementById("wa-verified-display");
  const btnChangeWa = document.getElementById("btn-change-wa");

  const btnSendEmailOtp = document.getElementById("btn-send-email-otp") as HTMLButtonElement | null;
  const emailOtpBox = document.getElementById("email-otp-box") as HTMLElement | null;
  const inputEmailOtp = document.getElementById("input-email-otp") as HTMLInputElement | null;
  const btnVerifyEmailOtp = document.getElementById("btn-verify-email-otp") as HTMLButtonElement | null;
  const emailOtpStatus = document.getElementById("email-otp-status") as HTMLElement | null;
  const emailVerifiedBadge = document.getElementById("email-verified-badge") as HTMLElement | null;

  let waVerified = false;
  let emailVerified = false;
  const isVip = (document.querySelector('input[name="corset_vip"]') as HTMLInputElement)?.value === "true";

  function updateLeadAliasPlaceholder(roleVal: string) {
    if (!inputAlias) return;
    const r = (roleVal || "").toLowerCase();
    if (r.includes("pareja")) {
      inputAlias.placeholder = "Nombre discreto de Pareja (ej: Camilo & Andrea)";
    } else if (r.includes("mujer") || r.includes("unicornio")) {
      inputAlias.placeholder = "Nombre discreto de Mujer (ej: Valeria)";
    } else if (r.includes("hombre") || r.includes("single")) {
      inputAlias.placeholder = "Nombre discreto de Hombre (ej: Alejandro)";
    } else {
      inputAlias.placeholder = "Tu alias o nombre discreto";
    }
  }

  inputRol?.addEventListener("change", () => {
    updateLeadAliasPlaceholder(inputRol.value);
  });

  if (inputRol) {
    updateLeadAliasPlaceholder(inputRol.value);
  }

  // Capture URL affiliate parameter on mount if present
  try {
    const urlParams = new URLSearchParams(window.location.search);
    const refQuery = urlParams.get("ref") || urlParams.get("r");
    if (refQuery) {
      localStorage.setItem("affiliate_ref", refQuery.trim().toLowerCase());
    }
  } catch (e) {}

  // Real-time WA OTP Send
  btnSendWaOtp?.addEventListener("click", async () => {
    const whatsapp = inputWhatsapp.value.trim();
    if (!whatsapp) {
      alert("Por favor ingresa tu número de WhatsApp");
      inputWhatsapp.focus();
      return;
    }

    btnSendWaOtp.disabled = true;
    btnSendWaOtp.textContent = "Enviando...";

    try {
      const res = await fetch("/api/otp/send", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ destination: whatsapp, channel: "whatsapp" }),
      });
      const data = await res.json();

      if (data.success) {
        stepWaPhone?.classList.add("hidden");
        stepWaVerify?.classList.remove("hidden");
        inputWaOtp?.focus();
        if (waOtpStatus) waOtpStatus.textContent = "";
      } else {
        alert(data.error || "No se pudo enviar el código a WhatsApp");
      }
    } catch (e: any) {
      alert("Error al conectar para enviar código");
    } finally {
      btnSendWaOtp.disabled = false;
      btnSendWaOtp.textContent = "Enviar Código";
    }
  });

  // Enter key listeners for frictionless desktop UX
  inputWhatsapp?.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      btnSendWaOtp?.click();
    }
  });

  inputWaOtp?.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      btnVerifyWaOtp?.click();
    }
  });

  inputEmail?.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      btnSendEmailOtp?.click();
    }
  });

  inputEmailOtp?.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      btnVerifyEmailOtp?.click();
    }
  });

  // Back button to change phone number
  btnBackWaOtp?.addEventListener("click", () => {
    stepWaVerify?.classList.add("hidden");
    stepWaPhone?.classList.remove("hidden");
    inputWhatsapp.focus();
  });

  // Change phone button from badge
  btnChangeWa?.addEventListener("click", () => {
    waVerified = false;
    waVerifiedBadge?.classList.add("hidden");
    stepWaVerify?.classList.add("hidden");
    stepWaPhone?.classList.remove("hidden");
    leadExistingBox?.classList.add("hidden");
    leadRemainingFields?.classList.add("hidden");
    inputWhatsapp.readOnly = false;
    inputWhatsapp.value = "";
    inputWhatsapp.focus();
  });

  async function processVerifiedPhone(whatsapp: string) {
    try {
      const checkRes = await fetch("/api/leads/check", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ whatsapp }),
      });
      const checkData = await checkRes.json();

      if (checkData.exists && checkData.lead) {
        const existing = checkData.lead;
        localStorage.setItem("ambassador_session_phone", whatsapp);
        const affiliateCode = existing.affiliate_code || "embajador";
        const shareUrl = `https://elplacerdecompartir.com/?ref=${affiliateCode}`;
        const waMsg = encodeURIComponent(`¡Hola! Te invito a conocer El Placer de Compartir y The Corset Society: ${shareUrl}`);
        const xMsg = encodeURIComponent(`Te invito a conocer El Placer de Compartir y The Corset Society: ${shareUrl}`);

        // Pre-llenar campos existentes en memoria
        if (inputAlias) inputAlias.value = existing.alias_nombre || "";
        if (inputEmail && existing.email) {
          inputEmail.value = existing.email;
          if (isVip && existing.metadata?.email_verified) {
            emailVerified = true;
            emailVerifiedBadge?.classList.remove("hidden");
            btnSendEmailOtp?.classList.add("hidden");
          }
        }
        if (inputRol && existing.rol) inputRol.value = existing.rol;
        if (inputCiudad && existing.ciudad) inputCiudad.value = existing.ciudad;

        if (isVip) {
          // Si ya es VIP con credencial anual activa
          const hasActiveVip = existing.corset_vip && existing.vip_until && new Date(existing.vip_until) > new Date();
          if (hasActiveVip) {
            leadExistingBox.innerHTML = `
              <div class="flex items-center gap-2 text-sm font-serif font-bold text-[#ead397]">
                <span>✓</span> Membresía VIP Activa Confirmada
              </div>
              <p class="text-xs text-[#f7f4ee]/90 leading-relaxed">
                Hola <strong class="text-[#ead397]">${existing.alias_nombre || "Miembro"}</strong>, tu membresía anual a The Corset Society está activa hasta el ${new Date(existing.vip_until).toLocaleDateString()}.
              </p>
              <div class="pt-2 border-t border-[#c5a059]/20 flex flex-wrap gap-2">
                <a href="/dashboard" class="px-4 py-2 rounded-lg bg-[#c5a059] text-[#0a0608] text-xs font-bold uppercase tracking-wider hover:bg-[#ead397] transition-all">
                  Ir a mi Panel de Embajador →
                </a>
              </div>
            `;
            leadExistingBox.classList.remove("hidden");
            leadRemainingFields.classList.add("hidden");
            return;
          }

          // Si el usuario ya verificó ambos canales (whatsapp_verified && email_verified):
          const isWaVerified = Boolean(existing.whatsapp_verified || (existing as any).metadata?.whatsapp_verified || waVerified);
          const isMailVerified = Boolean(existing.email_verified || (existing as any).metadata?.email_verified);

          if (isWaVerified && isMailVerified) {
            if (existing.corset_vip) {
              const hasAffiliateRef = Boolean(localStorage.getItem("affiliate_ref") || document.cookie.includes("affiliate_ref"));
              const vipPriceLabel = hasAffiliateRef ? "Adquirir Membresía Anual VIP ($159.000 COP) (-20% Embajador) →" : "Adquirir Membresía Anual VIP ($199.000 COP) →";

              leadExistingBox.innerHTML = `
                <div class="p-5 bg-[#2e7d32]/20 border border-[#81c784]/40 rounded-2xl text-xs space-y-3">
                  <div class="text-[#81c784] font-serif font-bold text-sm flex items-center gap-1.5">
                    <span>✓</span> Postulación Radicada con Éxito
                  </div>
                  <p class="text-[#f7f4ee]/90 text-xs leading-relaxed">
                    Hola <strong class="text-[#ead397]">${existing.alias_nombre || "Miembro"}</strong>, tu postulación a <strong>The Corset Society</strong> está radicada con éxito. Tus credenciales oficiales (WhatsApp <span class="font-mono text-[#ead397]">${whatsapp}</span> y correo <span class="font-mono text-[#ead397]">${existing.email || ""}</span>) se encuentran verificadas.
                  </p>
                  <div class="pt-2 flex flex-col gap-2">
                    <a href="/corset-vip#vip-checkout-box" class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-[#c5a059] to-[#ead397] text-[#0a0608] text-center font-serif font-bold text-xs uppercase tracking-wider hover:brightness-110 shadow-md">
                      ${vipPriceLabel}
                    </a>
                    <a href="/dashboard" class="w-full py-2.5 px-4 rounded-xl border border-[#c5a059]/40 text-[#ead397] text-center font-bold text-xs uppercase tracking-wider hover:bg-[#c5a059]/10">
                      Ir al Panel de Embajador →
                    </a>
                  </div>
                </div>
              `;
              leadExistingBox.classList.remove("hidden");
              leadRemainingFields.classList.add("hidden");
              return;
            } else {
              // Lead verificado en la comunidad pero que aún NO ha solicitado admisión a The Corset Society
              leadExistingBox.innerHTML = `
                <div class="p-5 bg-[#140816] rounded-2xl border border-[#c5a059]/50 text-xs space-y-4">
                  <div class="text-[#ead397] font-serif font-bold text-sm flex items-center gap-1.5">
                    <span>💎</span> Solicitud de Admisión — The Corset Society
                  </div>
                  <p class="text-[#f7f4ee]/90 text-xs leading-relaxed">
                    Hola <strong class="text-[#ead397]">${existing.alias_nombre || "Miembro"}</strong>, tus canales oficiales ya se encuentran verificados. Para radicar tu postulación formal a <strong>The Corset Society</strong>:
                  </p>
                  <button 
                    type="button" 
                    id="btn-apply-corset-vip-verified"
                    class="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-[#c5a059] to-[#ead397] text-[#0a0608] font-serif font-bold text-xs uppercase tracking-wider hover:brightness-110 shadow-md cursor-pointer transition-all"
                  >
                    Radicar Postulación a The Corset Society →
                  </button>
                </div>
              `;
              leadExistingBox.classList.remove("hidden");
              leadRemainingFields.classList.add("hidden");

              document.getElementById("btn-apply-corset-vip-verified")?.addEventListener("click", async () => {
                const btn = document.getElementById("btn-apply-corset-vip-verified") as HTMLButtonElement | null;
                if (btn) {
                  btn.disabled = true;
                  btn.textContent = "Radicando postulación...";
                }
                try {
                  const regRes = await fetch("/api/leads/register", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                      alias_nombre: existing.alias_nombre,
                      whatsapp: whatsapp,
                      email: existing.email,
                      rol: existing.rol || "pareja",
                      ciudad: existing.ciudad || "Bogotá",
                      origen: "web_corset",
                      corset_vip: true,
                      verified: true,
                      whatsapp_verified: true,
                      email_verified: true,
                      ref: localStorage.getItem("affiliate_ref") || undefined,
                    }),
                  });
                  const regData = await regRes.json();
                  if (regData.success) {
                    window.location.reload();
                  }
                } catch (_) {}
              });
              return;
            }
          }

          // Lead existente que tiene WhatsApp verificado pero falta verificar correo electrónico (Paso 2 secuencial obligatorio):
          leadExistingBox.innerHTML = `
            <div class="p-5 bg-[#140816] rounded-2xl border border-[#c5a059]/50 text-xs space-y-4">
              <div class="flex items-center justify-between">
                <div class="text-[#ead397] font-serif font-bold text-sm flex items-center gap-1.5">
                  <span>②</span> Paso 2: Verificación de Correo Electrónico
                </div>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#c5a059]/20 text-[#ead397] border border-[#c5a059]/30">Paso Requerido</span>
              </div>
              <p class="text-[#f7f4ee]/90 text-xs leading-relaxed">
                Hola <strong class="text-[#ead397] font-bold">${existing.alias_nombre || "Miembro"}</strong>. Tu WhatsApp ya está verificado. Para la admisión a The Corset Society requerimos verificar tu correo oficial con código OTP.
              </p>
              
              <div class="space-y-2 text-left">
                <label for="corset-step2-email" class="block text-[11px] font-bold text-[#ead397] uppercase tracking-wider">
                  Correo Electrónico Oficial <span class="text-[#c5a059]">*</span>
                </label>
                <div class="flex flex-col sm:flex-row gap-2">
                  <input 
                    type="email" 
                    id="corset-step2-email" 
                    value="${existing.email || ''}" 
                    placeholder="tu@correo.com" 
                    class="flex-1 px-3.5 py-2.5 rounded-xl bg-[#0a050c] border border-[#c5a059]/40 text-xs text-[#f7f4ee] focus:border-[#ead397] outline-none transition-all placeholder-[#f7f4ee]/30"
                  />
                  <button 
                    type="button" 
                    id="btn-corset-step2-send-otp"
                    class="px-4 py-2.5 text-xs font-bold uppercase rounded-xl bg-[#c5a059] text-[#0a0608] hover:bg-[#ead397] transition-all shadow cursor-pointer whitespace-nowrap"
                  >
                    Enviar Código al Correo
                  </button>
                </div>
              </div>

              <div id="corset-step2-otp-container" class="hidden p-3 rounded-xl bg-[#0a050c] border border-[#c5a059]/40 space-y-2">
                <label class="block text-[10px] uppercase tracking-wider text-[#ead397]">
                  Código recibido en tu correo:
                </label>
                <div class="flex items-center gap-2">
                  <input
                    type="text"
                    id="input-corset-step2-otp"
                    maxlength="6"
                    placeholder="123456"
                    class="w-32 px-3 py-2 text-center font-mono tracking-widest text-sm rounded-lg bg-[#140816] border border-[#c5a059]/40 text-[#ead397] focus:outline-none focus:border-[#c5a059]"
                  />
                  <button
                    type="button"
                    id="btn-corset-step2-verify-otp"
                    class="px-4 py-2 text-xs font-bold uppercase rounded-lg bg-[#c5a059] text-[#0a0608] hover:bg-[#ead397] transition-all cursor-pointer whitespace-nowrap"
                  >
                    Verificar y Radicar
                  </button>
                </div>
                <span id="corset-step2-otp-status" class="text-xs text-[#ead397] block"></span>
              </div>
            </div>
          `;
          leadExistingBox.classList.remove("hidden");
          leadRemainingFields.classList.add("hidden");

          const step2EmailInput = document.getElementById("corset-step2-email") as HTMLInputElement | null;
          const btnStep2SendOtp = document.getElementById("btn-corset-step2-send-otp") as HTMLButtonElement | null;
          const step2OtpContainer = document.getElementById("corset-step2-otp-container");
          const inputStep2Otp = document.getElementById("input-corset-step2-otp") as HTMLInputElement | null;
          const btnStep2VerifyOtp = document.getElementById("btn-corset-step2-verify-otp") as HTMLButtonElement | null;
          const step2OtpStatus = document.getElementById("corset-step2-otp-status");

          btnStep2SendOtp?.addEventListener("click", async () => {
            const targetMail = step2EmailInput?.value.trim();
            if (!targetMail || !targetMail.includes("@")) {
              alert("Por favor ingresa un correo electrónico válido");
              step2EmailInput?.focus();
              return;
            }
            btnStep2SendOtp.disabled = true;
            btnStep2SendOtp.textContent = "Enviando...";
            try {
              const res = await fetch("/api/otp/send", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ destination: targetMail, channel: "email" }),
              });
              const data = await res.json();
              if (data.success) {
                step2OtpContainer?.classList.remove("hidden");
                btnStep2SendOtp.textContent = "Reenviar Código";
                if (step2OtpStatus) step2OtpStatus.textContent = "Código enviado a " + targetMail;
                inputStep2Otp?.focus();
              } else {
                alert(data.error || "No se pudo enviar el código al correo.");
                btnStep2SendOtp.textContent = "Enviar Código al Correo";
              }
            } catch (e: any) {
              alert("Error de conexión al enviar código.");
              btnStep2SendOtp.textContent = "Enviar Código al Correo";
            } finally {
              btnStep2SendOtp.disabled = false;
            }
          });

          btnStep2VerifyOtp?.addEventListener("click", async () => {
            const targetMail = step2EmailInput?.value.trim();
            const otpCode = inputStep2Otp?.value.trim();
            if (!otpCode || otpCode.length < 4) {
              alert("Ingresa el código de 6 dígitos recibido.");
              inputStep2Otp?.focus();
              return;
            }
            btnStep2VerifyOtp.disabled = true;
            btnStep2VerifyOtp.textContent = "Verificando...";
            try {
              const res = await fetch("/api/otp/verify", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ destination: targetMail, code: otpCode, channel: "email" }),
              });
              const data = await res.json();
              if (data.success) {
                // Radicar postulación oficial con ambos canales verificados
                const applyRes = await fetch("/api/leads/register", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({
                    alias_nombre: existing.alias_nombre,
                    whatsapp: whatsapp,
                    email: targetMail,
                    rol: existing.rol || "pareja",
                    ciudad: existing.ciudad || "Bogotá",
                    origen: "web_corset",
                    corset_vip: true,
                    verified: true,
                    whatsapp_verified: true,
                    email_verified: true,
                    ref: localStorage.getItem("affiliate_ref") || undefined,
                  }),
                });
                const applyData = await applyRes.json();
                if (applyData.success) {
                  const hasAffiliateRef = Boolean(localStorage.getItem("affiliate_ref") || document.cookie.includes("affiliate_ref"));
                  const vipPriceLabel = hasAffiliateRef ? "Adquirir Membresía Anual VIP ($159.000 COP) (-20% Embajador) →" : "Adquirir Membresía Anual VIP ($199.000 COP) →";
                  leadExistingBox.innerHTML = `
                    <div class="p-5 bg-[#2e7d32]/20 border border-[#81c784]/40 rounded-2xl text-xs space-y-3">
                      <div class="text-[#81c784] font-serif font-bold text-sm flex items-center gap-1.5">
                        <span>✓</span> Postulación Radicada con Éxito
                      </div>
                      <p class="text-[#f7f4ee]/90 text-xs leading-relaxed">
                        Hola <strong class="text-[#ead397]">${existing.alias_nombre || "Miembro"}</strong>, tu postulación a <strong>The Corset Society</strong> ha sido radicada exitosamente y tus credenciales oficiales han quedado verificadas.
                      </p>
                      <div class="pt-2 flex flex-col gap-2">
                        <a href="/corset-vip#vip-checkout-box" class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-[#c5a059] to-[#ead397] text-[#0a0608] text-center font-serif font-bold text-xs uppercase tracking-wider hover:brightness-110 shadow-md">
                          ${vipPriceLabel}
                        </a>
                        <a href="/dashboard" class="w-full py-2.5 px-4 rounded-xl border border-[#c5a059]/40 text-[#ead397] text-center font-bold text-xs uppercase tracking-wider hover:bg-[#c5a059]/10">
                          Ir al Panel de Embajador →
                        </a>
                      </div>
                    </div>
                  `;
                } else {
                  if (step2OtpStatus) step2OtpStatus.textContent = applyData.error || "Error al radicar postulación.";
                  btnStep2VerifyOtp.disabled = false;
                  btnStep2VerifyOtp.textContent = "Verificar y Radicar";
                }
              } else {
                if (step2OtpStatus) step2OtpStatus.textContent = "Código incorrecto.";
                btnStep2VerifyOtp.disabled = false;
                btnStep2VerifyOtp.textContent = "Verificar y Radicar";
              }
            } catch (e: any) {
              if (step2OtpStatus) step2OtpStatus.textContent = "Error de conexión.";
              btnStep2VerifyOtp.disabled = false;
              btnStep2VerifyOtp.textContent = "Verificar y Radicar";
            }
          });
          return;
        }

        // Formulario general con lead existente (Datos inmutables protegidos)
        leadExistingBox.innerHTML = `
          <div class="flex items-center gap-2 text-sm font-serif font-bold text-[#ead397]">
            <span>✓</span> Registro Previo Confirmado
          </div>
          <p class="text-xs text-[#f7f4ee]/90 leading-relaxed">
            Hola <strong class="text-[#ead397]">${existing.alias_nombre || "Miembro"}</strong>, tu número ya se encuentra registrado activamente en nuestra comunidad en modalidad <strong class="text-[#ead397] capitalize">${existing.rol ? existing.rol.replace('_', ' ') : 'General'}</strong>.
          </p>
          <p class="text-[11px] text-[#f7f4ee]/70">
            Tu perfil ya está activo y protegido. Tu enlace de embajador oficial es:
          </p>
          <div class="p-2.5 bg-[#0a0608] rounded border border-[#c5a059]/40 text-xs font-mono text-[#ead397] select-all">
            ${shareUrl}
          </div>
          <p class="text-[11px] text-[#ead397]/90 mt-1">
            💡 <em>Nota: Puedes personalizar tu código de embajador directamente ingresando a tu panel.</em>
          </p>
          <div class="pt-2 border-t border-[#c5a059]/20 flex flex-wrap gap-2">
            <a href="/dashboard" class="px-4 py-2 rounded-lg bg-[#c5a059] text-[#0a0608] text-xs font-bold uppercase tracking-wider hover:bg-[#ead397] transition-all">
              Ir a mi Panel de Embajador →
            </a>
            <a href="https://wa.me/?text=${waMsg}" target="_blank" rel="noopener noreferrer" class="px-3.5 py-2 rounded-lg bg-[#2e7d32] text-white text-xs font-bold uppercase tracking-wider hover:bg-[#388e3c] transition-all">
              Compartir por WhatsApp
            </a>
            <a href="https://x.com/intent/tweet?text=${xMsg}" target="_blank" rel="noopener noreferrer" class="px-3.5 py-2 rounded-lg bg-[#050505] border border-[#c5a059]/40 text-[#ead397] text-xs font-bold uppercase tracking-wider hover:bg-[#c5a059]/20 transition-all">
              Compartir en X (x.com)
            </a>
          </div>
        `;
        leadExistingBox.classList.remove("hidden");
        leadRemainingFields.classList.add("hidden");
        return;
      }
    } catch (checkErr) {
      console.warn("[Check Lead Err]:", checkErr);
    }

    // Si NO existe: Desplegar casillas para completar datos y registrar
    leadExistingBox.classList.add("hidden");
    leadRemainingFields.classList.remove("hidden");
    inputAlias?.focus();
  }

  // Real-time WA OTP Verify & Anti-Duplicate Check Gate
  btnVerifyWaOtp?.addEventListener("click", async () => {
    const whatsapp = inputWhatsapp.value.trim();
    const code = inputWaOtp.value.trim();

    if (!code || code.length < 4) {
      alert("Ingresa el código de 6 dígitos");
      return;
    }

    btnVerifyWaOtp.disabled = true;
    btnVerifyWaOtp.textContent = "...";

    try {
      const res = await fetch("/api/otp/verify", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ destination: whatsapp, code, channel: "whatsapp" }),
      });
      const data = await res.json();

      if (data.success) {
        waVerified = true;
        stepWaVerify?.classList.add("hidden");
        if (waVerifiedDisplay) waVerifiedDisplay.textContent = whatsapp;
        waVerifiedBadge?.classList.remove("hidden");
        inputWhatsapp.readOnly = true;

        await processVerifiedPhone(whatsapp);
      } else {
        if (waOtpStatus) waOtpStatus.textContent = "Código incorrecto";
        btnVerifyWaOtp.disabled = false;
        btnVerifyWaOtp.textContent = "Verificar";
      }
    } catch (e: any) {
      alert("Error al verificar código");
      btnVerifyWaOtp.disabled = false;
      btnVerifyWaOtp.textContent = "Verificar";
    }
  });

  // Auto-verificar si el usuario ya tiene sesión iniciada con WhatsApp
  const activeSessionPhone = localStorage.getItem("ambassador_session_phone");
  if (activeSessionPhone) {
    inputWhatsapp.value = activeSessionPhone;
    waVerified = true;
    stepWaPhone?.classList.add("hidden");
    stepWaVerify?.classList.add("hidden");
    if (waVerifiedDisplay) waVerifiedDisplay.textContent = activeSessionPhone;
    waVerifiedBadge?.classList.remove("hidden");
    inputWhatsapp.readOnly = true;
    processVerifiedPhone(activeSessionPhone);
  }

  // Real-time Email OTP Send (VIP)
  btnSendEmailOtp?.addEventListener("click", async () => {
    const email = inputEmail.value.trim();
    if (!email) {
      alert("Por favor ingresa tu correo electrónico");
      inputEmail.focus();
      return;
    }

    btnSendEmailOtp.disabled = true;
    btnSendEmailOtp.textContent = "Enviando...";

    try {
      const res = await fetch("/api/otp/send", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ destination: email, channel: "email" }),
      });
      const data = await res.json();

      if (data.success) {
        emailOtpBox?.classList.remove("hidden");
        btnSendEmailOtp.textContent = "Reenviar";
        btnSendEmailOtp.disabled = false;
        if (emailOtpStatus) emailOtpStatus.textContent = "Código enviado";
        inputEmailOtp?.focus();
      } else {
        alert(data.error || "No se pudo enviar el código al correo");
        btnSendEmailOtp.textContent = "Enviar Código";
        btnSendEmailOtp.disabled = false;
      }
    } catch (e: any) {
      alert("Error al conectar para enviar código");
      btnSendEmailOtp.textContent = "Enviar Código";
      btnSendEmailOtp.disabled = false;
    }
  });

  // Real-time Email OTP Verify
  btnVerifyEmailOtp?.addEventListener("click", async () => {
    const email = inputEmail.value.trim();
    const code = inputEmailOtp?.value.trim();

    if (!code || code.length < 4) {
      alert("Ingresa el código de 6 dígitos");
      return;
    }

    btnVerifyEmailOtp.disabled = true;
    btnVerifyEmailOtp.textContent = "...";

    try {
      const res = await fetch("/api/otp/verify", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ destination: email, code, channel: "email" }),
      });
      const data = await res.json();

      if (data.success) {
        emailVerified = true;
        emailOtpBox?.classList.add("hidden");
        btnSendEmailOtp?.classList.add("hidden");
        inputEmail.readOnly = true;
        emailVerifiedBadge?.classList.remove("hidden");
      } else {
        if (emailOtpStatus) emailOtpStatus.textContent = "Código incorrecto";
        btnVerifyEmailOtp.disabled = false;
        btnVerifyEmailOtp.textContent = "Verificar";
      }
    } catch (e: any) {
      alert("Error al verificar código");
      btnVerifyEmailOtp.disabled = false;
      btnVerifyEmailOtp.textContent = "Verificar";
    }
  });

  // Form submission gate
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    // Check OTP verification
    if (!waVerified) {
      formFeedback.className = "text-sm p-4 rounded-lg bg-[#b84a39]/20 border border-[#b84a39]/40 text-[#ef5350]";
      formFeedback.textContent = "⚠️ Por favor verifica tu número de WhatsApp antes de continuar pulsando 'Enviar Código'.";
      formFeedback.classList.remove("hidden");
      btnSendWaOtp.focus();
      return;
    }

    if (isVip && !emailVerified) {
      formFeedback.className = "text-sm p-4 rounded-lg bg-[#c5a059]/20 border border-[#c5a059]/40 text-[#ead397]";
      formFeedback.textContent = "⚠️ Para membresía VIP es necesario verificar también tu correo electrónico.";
      formFeedback.classList.remove("hidden");
      btnSendEmailOtp?.focus();
      return;
    }

    const aliasInput = document.getElementById("input-alias") as HTMLInputElement;
    if (aliasInput && !aliasInput.value.trim()) {
      formFeedback.className = "text-sm p-4 rounded-lg bg-[#b84a39]/20 border border-[#b84a39]/40 text-[#ef5350]";
      formFeedback.textContent = "⚠️ Por favor ingresa tu alias o pseudónimo antes de continuar.";
      formFeedback.classList.remove("hidden");
      aliasInput.focus();
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = "Procesando...";

    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());
    const formIsVip = (form.querySelector('input[name="corset_vip"]') as HTMLInputElement)?.value === "true" || formData.get("corset_vip") === "true" || isVip;

    try {
      const res = await fetch("/api/leads/register", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          ...payload,
          ref: localStorage.getItem("affiliate_ref") || undefined,
          verified: true,
          corset_vip: formIsVip,
          whatsapp_verified: waVerified,
          email_verified: emailVerified,
        }),
      });
      const data = await res.json();

      if (data.success) {
        // Auto-login ambassador session seamlessly
        const submittedPhone = inputWhatsapp.value.trim();
        if (submittedPhone) {
          localStorage.setItem("ambassador_session_phone", submittedPhone);
        }
        if (inputRol?.value) {
          localStorage.setItem("user_role", inputRol.value);
        }

        let affiliateMsg = "";
        if (data.affiliate_code) {
          const shareUrl = `https://elplacerdecompartir.com/?ref=${data.affiliate_code}`;
          const waMsg = encodeURIComponent(`Hola! Te invito a conocer El Placer de Compartir y The Corset Society: ${shareUrl}`);
          const xMsg = encodeURIComponent(`Te invito a conocer El Placer de Compartir y The Corset Society: ${shareUrl}`);
          affiliateMsg = `<div class="mt-3 p-3 bg-[#140816] rounded border border-[#c5a059]/40 text-xs text-left space-y-2">
            <span class="text-[#ead397] font-semibold block">Tu Enlace de Embajador:</span> 
            <code class="text-[#c5a059] block select-all font-mono">${shareUrl}</code>
            <p class="text-[11px] text-[#ead397]/90 mt-1">
              💡 <em>Nota: Puedes personalizar tu código de embajador directamente ingresando a tu panel.</em>
            </p>
            <div class="pt-1 flex flex-wrap gap-2">
              <a href="/dashboard" class="inline-block px-3 py-1.5 rounded bg-[#c5a059] text-[#0a0608] text-xs font-bold uppercase tracking-wider hover:bg-[#ead397]">Ir al Panel de Embajador →</a>
              <a href="https://wa.me/?text=${waMsg}" target="_blank" rel="noopener noreferrer" class="inline-block px-3 py-1.5 rounded bg-[#2e7d32] text-white text-xs font-bold uppercase tracking-wider hover:bg-[#388e3c]">Compartir por WhatsApp</a>
              <a href="https://x.com/intent/tweet?text=${xMsg}" target="_blank" rel="noopener noreferrer" class="inline-block px-3 py-1.5 rounded bg-[#050505] border border-[#c5a059]/40 text-[#ead397] text-xs font-bold uppercase tracking-wider hover:bg-[#c5a059]/20">Compartir en X (x.com)</a>
            </div>
          </div>`;
        }

        let vipNextAction = "";
        if (isVip) {
          const hasAffiliateRef = Boolean(localStorage.getItem("affiliate_ref") || document.cookie.includes("affiliate_ref"));
          const vipPriceLabel = hasAffiliateRef ? "($179.000 COP) (-10% Embajador)" : "($199.000 COP)";
          vipNextAction = `
            <div class="mt-4 p-3 bg-[#0a0608] rounded border border-[#c5a059]/40 text-center">
              <p class="text-xs text-[#ead397] mb-2">Tu postulación VIP ha sido radicada. Puedes continuar a la activación de tu credencial oficial:</p>
              <a href="/corset-vip#vip-checkout-box" class="inline-block px-6 py-2.5 rounded-full bg-gradient-to-r from-[#c5a059] to-[#ead397] text-[#050505] font-serif font-bold text-xs uppercase tracking-wider hover:brightness-110 shadow-md">
                Proceder a Credencial VIP Anual ${vipPriceLabel} →
              </a>
            </div>
          `;
        }

        leadRemainingFields.classList.add("hidden");
        formFeedback.className = "text-sm p-4 rounded-lg bg-[#2e7d32]/20 border border-[#4caf50]/40 text-[#81c784]";
        formFeedback.innerHTML = `✨ ¡Registro confirmado exitosamente! Te hemos enviado los detalles a tus canales de contacto.${affiliateMsg}${vipNextAction}`;
        formFeedback.classList.remove("hidden");
        submitBtn.classList.add("hidden");
      } else {
        throw new Error(data.error || "Ocurrió un error al procesar.");
      }
    } catch (err: any) {
      formFeedback.className = "text-sm p-4 rounded-lg bg-[#b71c1c]/20 border border-[#b71c1c]/40 text-[#ef5350]";
      formFeedback.textContent = err.message || "Error al conectar.";
      formFeedback.classList.remove("hidden");
      submitBtn.disabled = false;
      submitBtn.textContent = isVip ? "Solicitar Admisión VIP" : "Unirme al Círculo";
    }
  });
</script>
