---
// LeadForm.astro - Formulario con Perfilado Progresivo, Emojis de Rol y Detección de Conflictos
interface Props {
  isVip?: boolean;
  title?: string;
  subtitle?: string;
}

const { 
  isVip = false, 
  title = isVip ? "Solicitud de Membresía VIP" : "Acceso a la Comunidad", 
  subtitle = isVip
    ? "La admisión se evalúa rigurosamente. The Corset Society es un círculo privado de gala y ticket alto, con covers prémium y aforo estrictamente limitado como filtro natural de privacidad y confort."
    : "Regístrate para recibir convocatorias privadas, talleres y accesos exclusivos a nuestro centro cultural." 
} = Astro.props;
---

<div class={`p-6 sm:p-10 rounded-2xl border transition-all duration-300 relative overflow-hidden ${
  isVip 
    ? "bg-[#0a0608]/90 border-[#c5a059]/40 shadow-[0_0_30px_rgba(197,160,89,0.15)]" 
    : "bg-[#250F22]/90 border-[#c5a059]/35 shadow-[0_4px_30px_rgba(89,31,38,0.25)]"
}`}>
  <!-- Decorative Ambient Glow -->
  <div class={`absolute top-0 right-0 w-64 h-64 rounded-full blur-3xl -z-10 pointer-events-none ${
    isVip ? "bg-[#4a0e17]/20" : "bg-[#721c24]/20"
  }`}></div>

  <div class="mb-8">
    <h3 class={`text-2xl font-serif font-bold tracking-wide uppercase ${isVip ? "text-[#c5a059]" : "text-[#ead397]"}`}>
      {title}
    </h3>
    <p class="text-sm text-[#f7f4ee]/70 mt-2 leading-relaxed">
      {subtitle}
    </p>
  </div>

  <form id="lead-form" class="space-y-5">
    <input type="hidden" name="corset_vip" value={isVip ? "true" : "false"} />

    <!-- WhatsApp Phone -->
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider text-[#f7f4ee]/80 mb-2">
        WhatsApp / Teléfono <span class="text-[#b84a39]">*</span>
      </label>
      <input
        type="tel"
        name="whatsapp"
        id="input-whatsapp"
        required
        placeholder="Ej: 310 123 4567 o +57 310..."
        class="w-full px-4 py-3 rounded-lg bg-[#140816]/90 border border-[#c5a059]/30 text-[#f7f4ee] placeholder-[#f7f4ee]/30 focus:outline-none focus:border-[#c5a059] focus:ring-1 focus:ring-[#c5a059] text-sm transition-all"
      />
      <p class="text-[10px] text-[#f7f4ee]/40 mt-1">Deducción automática Colombia (+57). Si usas número internacional, escribe con indicativo (+).</p>
    </div>

    <!-- Email -->
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider text-[#f7f4ee]/80 mb-2">
        Correo Electrónico {isVip ? <span class="text-[#c5a059]">(Requerido para membresía VIP *)</span> : <span class="text-[#f7f4ee]/40">(Opcional)</span>}
      </label>
      <input
        type="email"
        name="email"
        id="input-email"
        required={isVip}
        placeholder="ejemplo@correo.com"
        class="w-full px-4 py-3 rounded-lg bg-[#140816]/90 border border-[#c5a059]/30 text-[#f7f4ee] placeholder-[#f7f4ee]/30 focus:outline-none focus:border-[#c5a059] focus:ring-1 focus:ring-[#c5a059] text-sm transition-all"
      />
    </div>

    <!-- Alias / Nombre -->
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider text-[#f7f4ee]/80 mb-2">
        Alias o Nombre de Pila <span class="text-[#b84a39]">*</span>
      </label>
      <input
        type="text"
        name="alias_nombre"
        id="input-alias"
        required
        placeholder="Tu alias o nombre discreto"
        class="w-full px-4 py-3 rounded-lg bg-[#140816]/90 border border-[#c5a059]/30 text-[#f7f4ee] placeholder-[#f7f4ee]/30 focus:outline-none focus:border-[#c5a059] focus:ring-1 focus:ring-[#c5a059] text-sm transition-all"
      />
    </div>

    <!-- Rol / Identidad con Emojis Canónicos -->
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider text-[#f7f4ee]/80 mb-2">
        Modalidad de Asistencia o Participación <span class="text-[#b84a39]">*</span>
      </label>
      <select
        name="rol"
        id="input-rol"
        class="w-full px-4 py-3 rounded-lg bg-[#140816] border border-[#c5a059]/30 text-[#f7f4ee] focus:outline-none focus:border-[#c5a059] text-sm transition-all"
      >
        <option value="pareja">👫 Pareja</option>
        <option value="mujer_sola">🦄 Mujer Sola (Unicornio)</option>
        <option value="hombre_solo">🙋‍♂️ Hombre Solo (Single)</option>
      </select>
    </div>

    <!-- Ciudad -->
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider text-[#f7f4ee]/80 mb-2">
        Ciudad
      </label>
      <select
        name="ciudad"
        id="input-ciudad"
        class="w-full px-4 py-3 rounded-lg bg-[#050505] border border-[#c5a059]/30 text-[#f7f4ee] focus:outline-none focus:border-[#c5a059] text-sm transition-all"
      >
        <option value="Bogotá">Bogotá</option>
        <option value="Medellín">Medellín</option>
        <option value="Otra">Otra ciudad</option>
      </select>
    </div>

    <!-- Feedback Message -->
    <div id="form-feedback" class="hidden text-sm p-3 rounded-lg"></div>

    <!-- OTP Section (Hidden initially) -->
    <div id="otp-section" class="hidden">
      <label class="block text-xs font-semibold uppercase tracking-wider text-[#f7f4ee]/80 mb-2">
        Código de Verificación (Enviado a WhatsApp) <span class="text-[#b84a39]">*</span>
      </label>
      <input
        type="text"
        name="otp"
        id="input-otp"
        placeholder="Ej: 123456"
        class="w-full px-4 py-3 rounded-lg bg-[#140816]/90 border border-[#c5a059]/30 text-[#f7f4ee] placeholder-[#f7f4ee]/30 focus:outline-none focus:border-[#c5a059] focus:ring-1 focus:ring-[#c5a059] text-sm transition-all text-center tracking-[0.5em] font-mono"
      />
    </div>

    <button
      type="submit"
      id="submit-btn"
      class={`w-full py-4 rounded-lg font-serif font-bold uppercase tracking-widest text-sm transition-all shadow-md ${
        isVip
          ? "bg-gradient-to-r from-[#c5a059] via-[#ead397] to-[#8a6d3b] text-[#050505] hover:brightness-110 shadow-[0_0_20px_rgba(197,160,89,0.3)]"
          : "bg-[#b84a39] text-[#f7f4ee] hover:bg-[#a03d2e] shadow-[0_0_15px_rgba(184,74,57,0.3)]"
      }`}
    >
      {isVip ? "Solicitar Admisión VIP" : "Unirme al Círculo"}
    </button>
  </form>
</div>

<script>
  const form = document.getElementById("lead-form") as HTMLFormElement;
  const inputWhatsapp = document.getElementById("input-whatsapp") as HTMLInputElement;
  const inputEmail = document.getElementById("input-email") as HTMLInputElement;
  const inputAlias = document.getElementById("input-alias") as HTMLInputElement;
  const inputRol = document.getElementById("input-rol") as HTMLSelectElement;
  const inputCiudad = document.getElementById("input-ciudad") as HTMLSelectElement;
  const formFeedback = document.getElementById("form-feedback") as HTMLElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const otpSection = document.getElementById("otp-section") as HTMLElement;
  const inputOtp = document.getElementById("input-otp") as HTMLInputElement;

  let checking = false;
  let otpSent = false;

  async function checkContact() {
    const whatsapp = inputWhatsapp.value.trim();
    const email = inputEmail.value.trim();

    if ((!whatsapp && !email) || checking) return;
    checking = true;

    try {
      const res = await fetch("/api/leads/check", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ whatsapp, email }),
      });
      const data = await res.json();

      if (data.exists && data.lead) {
        if (!inputAlias.value && data.lead.alias_nombre) inputAlias.value = data.lead.alias_nombre;
        if (!inputWhatsapp.value && data.lead.whatsapp) inputWhatsapp.value = data.lead.whatsapp;
        if (!inputEmail.value && data.lead.email) inputEmail.value = data.lead.email;
        if (data.lead.rol) inputRol.value = data.lead.rol;
        if (data.lead.ciudad) inputCiudad.value = data.lead.ciudad;
      }
    } catch (e) {
      // Silent error - zero invasive messaging
    } finally {
      checking = false;
    }
  }

  inputWhatsapp?.addEventListener("blur", checkContact);
  inputEmail?.addEventListener("blur", checkContact);

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = "Procesando...";

    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());

    try {
      if (!otpSent) {
        // Send OTP first
        const otpRes = await fetch("/api/otp/send", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ whatsapp: payload.whatsapp }),
        });
        const otpData = await otpRes.json();
        
        if (otpData.success) {
          otpSent = true;
          otpSection.classList.remove("hidden");
          inputOtp.required = true;
          formFeedback.className = "text-sm p-4 rounded-lg bg-[#c5a059]/20 border border-[#c5a059]/40 text-[#ead397]";
          formFeedback.textContent = "ℹ️ Hemos enviado un código de verificación a tu WhatsApp. Ingrésalo para continuar.";
          formFeedback.classList.remove("hidden");
          submitBtn.textContent = "Verificar y Completar";
          submitBtn.disabled = false;
        } else {
          throw new Error(otpData.error || "Error al enviar código de verificación.");
        }
        return;
      }

      // If OTP sent, proceed with registration
      const res = await fetch("/api/leads/register", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          ...payload,
          corset_vip: payload.corset_vip === "true",
        }),
      });
      const data = await res.json();

      if (data.success) {
        if (data.already_registered) {
          formFeedback.className = "text-sm p-4 rounded-lg bg-[#c5a059]/20 border border-[#c5a059]/40 text-[#ead397]";
          formFeedback.textContent = `ℹ️ ${data.message || "Ya te encuentras registrado(a) en este canal."}`;
        } else {
          formFeedback.className = "text-sm p-4 rounded-lg bg-[#2e7d32]/20 border border-[#4caf50]/40 text-[#81c784]";
          formFeedback.textContent = "✨ ¡Registro confirmado exitosamente! Te hemos enviado los detalles a tus canales de contacto.";
          form.reset();
          otpSent = false;
          otpSection.classList.add("hidden");
          inputOtp.required = false;
        }
        formFeedback.classList.remove("hidden");
      } else {
        throw new Error(data.error || "Ocurrió un error al procesar.");
      }
    } catch (err: any) {
      formFeedback.className = "text-sm p-4 rounded-lg bg-[#b71c1c]/20 border border-[#b71c1c]/40 text-[#ef5350]";
      formFeedback.textContent = err.message || "Error al conectar.";
      formFeedback.classList.remove("hidden");
    } finally {
      if (!otpSent) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Completado";
      } else if (!submitBtn.disabled) {
        submitBtn.textContent = "Verificar y Completar";
      }
    }
  });
</script>
