---
// the-corset-society/ticket.astro - Credencial Digital Sellada de Evento
import Layout from "../../layouts/Layout.astro";
import { query } from "../../db";
import QRCode from "qrcode";

const hash = Astro.url.searchParams.get("hash");
let ticket: any = null;
let lead: any = null;
let qrSvg = "";

if (hash) {
  try {
    const res = await query(
      `SELECT t.*, l.alias_nombre, l.email, l.whatsapp, l.rol 
       FROM event_tickets t 
       LEFT JOIN leads l ON t.lead_id = l.id 
       WHERE t.ticket_hash = $1`,
      [hash]
    );
    if (res.rows.length > 0) {
      ticket = res.rows[0];
      lead = {
        alias_nombre: ticket.alias_nombre,
        email: ticket.email,
        whatsapp: ticket.whatsapp,
        rol: ticket.rol,
      };

      const ticketUrl = `https://elplacerdecompartir.com/the-corset-society/ticket?hash=${ticket.ticket_hash}`;
      qrSvg = await QRCode.toString(ticketUrl, {
        type: "svg",
        color: {
          dark: "#C5A059",
          light: "#00000000",
        },
        margin: 1,
        width: 160,
      });
    }
  } catch (err) {
    console.error("Error consultando ticket o generando QR:", err);
  }
}
---

<Layout 
  title="Credencial Digital Sellada | The Corset Society"
  description="Credencial oficial de acceso para eventos de The Corset Society. Presentar al ingresar."
  isCorset={true}
>
  <div class="min-h-screen bg-corset-noir text-elplacer-ivory font-serif selection:bg-corset-gold selection:text-corset-noir relative overflow-hidden flex flex-col justify-between py-12 px-4 sm:px-6">
    <!-- Header -->
    <header class="max-w-xl mx-auto w-full text-center space-y-3 pb-8">
      <div class="inline-flex items-center gap-2">
        <img src="/media/logo_corsetsociety_transparent.png" alt="Sigilo The Corset Society" class="w-12 h-12 rounded-full border border-corset-gold object-cover" />
      </div>
      <div class="text-xs uppercase tracking-[0.3em] text-corset-gold font-bold">The Corset Society</div>
      <h1 class="text-2xl sm:text-3xl font-bold text-corset-champagne">Credencial de Acceso Sellada</h1>
      <p class="text-xs font-sans text-elplacer-ivory/60">Presenta esta credencial digital al ingresar a la gala privada</p>
    </header>

    <!-- Ticket Body -->
    <main class="max-w-md mx-auto w-full">
      {ticket ? (
        <div class="rounded-3xl bg-gradient-to-b from-[#140a18] via-[#0a0608] to-corset-noir border-2 border-corset-gold shadow-[0_0_50px_rgba(197,160,89,0.3)] overflow-hidden relative">
          <!-- Decorative Gold Corner Accents -->
          <div class="absolute top-3 left-3 w-4 h-4 border-t-2 border-l-2 border-corset-gold"></div>
          <div class="absolute top-3 right-3 w-4 h-4 border-t-2 border-r-2 border-corset-gold"></div>
          <div class="absolute bottom-3 left-3 w-4 h-4 border-b-2 border-l-2 border-corset-gold"></div>
          <div class="absolute bottom-3 right-3 w-4 h-4 border-b-2 border-r-2 border-corset-gold"></div>

          <div class="p-8 space-y-6 text-center">
            <!-- Event Header -->
            <div class="border-b border-corset-gold/30 pb-4 space-y-1">
              <span class="text-[10px] uppercase tracking-[0.25em] text-corset-gold font-bold">Gala Privada</span>
              <h2 class="text-xl sm:text-2xl font-bold text-elplacer-ivory">Noche de Luna Llena 🌕</h2>
              <p class="text-xs font-sans text-corset-champagne">Sábado 31 Octubre 2026 • Bogotá</p>
            </div>

            <!-- Status Badge -->
            <div class="py-1 px-4 rounded-full inline-block border text-xs font-sans uppercase tracking-wider font-bold"
                 class:list={[
                   ticket.estado === 'confirmado' 
                     ? 'border-emerald-500/50 bg-emerald-950/40 text-emerald-300' 
                     : 'border-corset-gold/50 bg-corset-gold/10 text-corset-champagne'
                 ]}
            >
              {ticket.estado === 'confirmado' ? '✓ Entrada Confirmada' : '⏳ Reserva en Proceso / Pendiente'}
            </div>

            <!-- Attendee Details -->
            <div class="grid grid-cols-2 gap-4 text-left font-sans text-xs bg-corset-noir/70 p-4 rounded-xl border border-corset-gold/20">
              <div>
                <span class="text-[10px] text-corset-gold uppercase block tracking-wider">Invitado(a)</span>
                <span class="font-bold text-elplacer-ivory text-sm">{lead?.alias_nombre || 'Invitado Confidencial'}</span>
              </div>
              <div>
                <span class="text-[10px] text-corset-gold uppercase block tracking-wider">Pase Concedido</span>
                <span class="font-bold text-elplacer-ivory capitalize text-sm">{ticket.tipo_entrada}</span>
              </div>
              <div>
                <span class="text-[10px] text-corset-gold uppercase block tracking-wider">Modalidad</span>
                <span class="font-medium text-elplacer-ivory">{ticket.tipo_pago === 'reserva_40' ? 'Separación 40%' : 'Pago Total 100%'}</span>
              </div>
              <div>
                <span class="text-[10px] text-corset-gold uppercase block tracking-wider">Monto Registrado</span>
                <span class="font-bold text-corset-champagne">${Number(ticket.monto_pagado).toLocaleString('es-CO')} COP</span>
              </div>
            </div>

            <!-- Official Scannable Real QR & ID Lacrado -->
            <div class="space-y-3 pt-2 flex flex-col items-center">
              <div class="p-3 bg-corset-noir rounded-2xl border border-corset-gold/40 shadow-[0_0_25px_rgba(197,160,89,0.2)] flex flex-col items-center">
                <div class="w-36 h-36 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full" set:html={qrSvg} />
                <span class="text-[9px] font-mono tracking-widest text-corset-champagne uppercase mt-2">
                  Escanear en Puerta para Validación
                </span>
              </div>
              <div class="text-[10px] font-mono tracking-widest text-elplacer-ivory/50 uppercase">
                ID Lacrado: {ticket.ticket_hash ? ticket.ticket_hash.substring(0, 16) : 'CONFIDENTIAL'}
              </div>
            </div>

            <!-- Security Instruction -->
            <div class="text-[11px] font-sans text-elplacer-ivory/60 space-y-1 pt-2">
              <p>🎭 <strong>Dress Code:</strong> Máscara obligatoria. Ven caracterizado.</p>
              <p>📍 La locación secreta se informará 24 horas antes vía WhatsApp al <strong>{lead?.whatsapp || '+57...'}</strong>.</p>
              <p class="text-[10px] italic text-corset-champagne">El acceso se concede, no se anuncia. Derecho de admisión reservado.</p>
            </div>
          </div>
        </div>
      ) : (
        <div class="p-8 rounded-2xl bg-[#0a0608] border border-red-500/40 text-center space-y-4">
          <div class="text-3xl">⚠️</div>
          <h2 class="text-lg font-bold text-red-300">Credencial No Encontrada</h2>
          <p class="text-xs font-sans text-elplacer-ivory/60">
            No se encontró un ticket activo con este código de verificación. Por favor revisa el enlace enviado a tu correo o comunícate con el concierge oficial.
          </p>
          <a 
            href="/the-corset-society/luna-llena" 
            class="inline-block px-6 py-2.5 rounded-full border border-corset-gold text-xs uppercase tracking-wider text-corset-gold hover:bg-corset-gold/10"
          >
            Ir a Reserva de Boletas
          </a>
        </div>
      )}

      <!-- Actions -->
      <div class="mt-8 text-center space-y-4">
        <a 
          href="https://wa.me/573194194785?text=Hola,%20tengo%20una%20consulta%20sobre%20mi%20credencial%20The%20Corset%20Society" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-xs font-sans text-corset-champagne hover:text-corset-gold transition-colors"
        >
          <span>Asistencia de Concierge por WhatsApp (+57 319 419 4785)</span>
          <span>↗</span>
        </a>
        <div>
          <a 
            href="https://elplacerdecompartir.com/" 
            class="text-[11px] font-sans text-elplacer-ivory/40 hover:text-elplacer-ivory/80 transition-colors uppercase tracking-wider"
          >
            ← Volver al Portal de la Comunidad
          </a>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer class="text-center pt-8 text-[10px] font-sans text-elplacer-ivory/30 uppercase tracking-widest">
      The Corset Society • Círculo Privado de Gala
    </footer>
  </div>
</Layout>
