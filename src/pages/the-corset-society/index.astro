---
// the-corset-society/index.astro - Landing Noir & Gold (The Corset Society)
import Layout from "../../layouts/Layout.astro";
import LeadForm from "../../components/LeadForm.astro";
import VipCheckout from "../../components/VipCheckout.astro";
import CorsetHeader from "../../components/CorsetHeader.astro";
---

<Layout 
  title="The Corset Society | Línea de Alta Exclusividad de ElPlacerDC"
  description="Círculo privado de gala noir, antifaces y alta discreción. Membresía anual VIP con acceso a convocatorias reservadas, encuentros íntimos y beneficios exclusivos."
  isCorset={true}
>
  <!-- Dedicated Noir Ambient Canvas -->
  <div class="min-h-screen bg-[#050505] text-[#f7f4ee] font-serif selection:bg-[#c5a059] selection:text-[#050505] relative overflow-hidden">
    
    <!-- Top Sigil & Navigation -->
    <CorsetHeader current="inicio" />

    <!-- Hero Noir -->
    <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 text-center space-y-12 relative z-10">
      <div class="space-y-4">
        <div class="inline-block px-4 py-1.5 rounded-full border border-[#c5a059]/40 bg-[#4a0e17]/20 text-[11px] tracking-[0.25em] uppercase text-[#ead397] mb-2">
          La Línea de Alta Exclusividad de ElPlacerDC
        </div>
        <h1 class="text-3xl sm:text-5xl lg:text-7xl font-bold tracking-tight text-[#f7f4ee] leading-[1.1] pt-2 break-words">
          El acceso se concede, <br />
          <span class="italic font-normal text-transparent bg-clip-text bg-gradient-to-r from-[#c5a059] via-[#ead397] to-[#8a6d3b]">
            no se anuncia.
          </span>
        </h1>
        <p class="max-w-xl mx-auto text-sm sm:text-base font-sans font-light text-[#f7f4ee]/80 leading-relaxed pt-2">
          The Corset Society representa la cúspide de exclusividad y discreción de ElPlacerDC: una congregación selecta de gala noir, antifaces y etiqueta rigurosa, donde la privacidad absoluta y la sofisticación protegen la experiencia de cada velada.
        </p>

        <!-- Botón inmediato al ancla de la solicitud de admisión -->
        <div class="pt-4">
          <a 
            id="hero-vip-action-btn"
            href="#solicitud-admision-vip" 
            class="inline-block px-8 py-3.5 rounded-full font-serif font-bold uppercase tracking-[0.15em] text-xs bg-gradient-to-r from-[#c5a059] to-[#ead397] text-[#050505] hover:brightness-110 shadow-[0_0_25px_rgba(197,160,89,0.4)] transition-all"
          >
            Solicitud de Admisión VIP →
          </a>
        </div>
      </div>

      <!-- Membresía Anual $199.000 COP & Flyer Limpio Clickeable hacia la solicitud -->
      <a id="corset-vip-flyer-card" href="#solicitud-admision-vip" class="block max-w-xl mx-auto rounded-2xl overflow-hidden border border-[#c5a059]/50 shadow-[0_0_50px_rgba(197,160,89,0.2)] bg-[#0a0608] hover:border-[#ead397] transition-all group">
        <img 
          src="/media/corset-society/flyer_membresia_corset.jpg" 
          alt="Credencial y Membresía The Corset Society" 
          class="w-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
        <div class="p-6 bg-[#0a0608] border-t border-[#c5a059]/20 space-y-3 text-left">
          <div class="flex items-center justify-between">
            <h2 id="corset-vip-card-title" class="text-lg font-serif font-bold text-[#ead397]">Membresía Anual VIP ($199.000 COP)</h2>
            <span class="text-xs text-[#c5a059] font-mono font-semibold">Anualidad</span>
          </div>
          <p class="text-xs font-sans text-[#f7f4ee]/75 leading-relaxed font-light">
            La activación de la credencial oficial incluye descuentos permanentes en todas las veladas, invitaciones prioritarias a convocatorias reservadas, acceso a fantasías privadas y pertenencia formal a nuestra comunidad prémium.
          </p>
          <p id="corset-vip-card-cta" class="text-xs font-serif text-[#c5a059] group-hover:text-[#ead397] font-semibold">
            Haz clic aquí para iniciar tu solicitud de admisión VIP →
          </p>
        </div>
      </a>

      <!-- Promoción Fiesta Luna Llena: Primer Año Sin Costo -->
      <div class="p-6 sm:p-10 rounded-2xl bg-gradient-to-b from-[#180a22]/90 via-[#0d0510] to-[#050505] border border-[#c5a059] shadow-[0_0_35px_rgba(197,160,89,0.2)] max-w-2xl mx-auto space-y-6 text-center">
        <span class="inline-block px-3 py-1 rounded-full text-xs uppercase tracking-[0.2em] text-[#c5a059] font-bold bg-[#c5a059]/10 border border-[#c5a059]/30">
          Promoción Exclusiva
        </span>
        <h3 class="text-2xl sm:text-3xl font-bold text-[#ead397]">
          🌕 Fiesta Luna Llena Halloween 🌲
        </h3>
        <div class="p-4 rounded-xl bg-[#140816] border border-[#c5a059]/30 text-xs sm:text-sm font-sans text-[#f7f4ee]/90 leading-relaxed text-left sm:text-center">
          <p>
            ✨ <strong>Tu Asistencia a este evento te Otorga el Primer Año de Membresía VIP Gratis:</strong> Quienes adquieran su entrada y asistan a la fiesta oficial <em>Noche de Luna Llena Halloween</em> reciben la activación de su primer año de credencial VIP de The Corset Society <strong>totalmente sin costo</strong>.
          </p>
        </div>
        <div class="max-w-xs mx-auto rounded-xl overflow-hidden border border-[#c5a059]/40 shadow-lg">
          <img 
            src="/media/corset-society/flyer_halloween_clean.jpg" 
            alt="Flyer Oficial Luna Llena Halloween" 
            class="w-full object-cover"
          />
        </div>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a 
            href="/the-corset-society/luna-llena" 
            class="w-full sm:w-auto px-6 py-3.5 rounded-full font-serif font-bold uppercase tracking-[0.12em] text-xs border border-[#c5a059]/60 text-[#ead397] hover:bg-[#c5a059]/20 transition-all text-center"
          >
            Ver Información Completa
          </a>
          <a 
            href="/the-corset-society/luna-llena" 
            class="w-full sm:w-auto px-6 py-3.5 rounded-full font-serif font-bold uppercase tracking-[0.12em] text-xs bg-gradient-to-r from-[#c5a059] to-[#ead397] text-[#050505] hover:brightness-110 shadow-[0_0_25px_rgba(197,160,89,0.4)] transition-all text-center"
          >
            Reservar / Pagar Entrada →
          </a>
        </div>
      </div>

      <!-- Solicitud de Admisión VIP -->
      <div id="solicitud-admision-vip" class="max-w-xl mx-auto pt-4 text-left scroll-mt-24">
        <div id="postulacion-vip" class="scroll-mt-24"></div>
        <LeadForm 
          isVip={true}
          title="Solicitud de Admisión VIP"
          subtitle="La admisión se evalúa rigurosamente por la dirección. Al postularte aseguras tu turno prioritario para la activación de credenciales y veladas secretas."
        />
      </div>

      <!-- Legal Footer Minimalista Noir -->
      <footer class="pt-16 pb-8 text-center text-[10px] font-sans text-[#f7f4ee]/30 tracking-widest uppercase space-y-2">
        <p>© {new Date().getFullYear()} The Corset Society • Línea de Alta Exclusividad de ElPlacerDC</p>
        <p>Línea Oficial de Asistencia: +57 319 419 4785</p>
      </footer>
    </main>
  </div>

  <script is:inline>
    function checkCorsetSocietyVip() {
      const heroBtn = document.getElementById("hero-vip-action-btn");
      const flyerCard = document.getElementById("corset-vip-flyer-card");
      const flyerCta = document.getElementById("corset-vip-card-cta");

      function applyVipMode() {
        if (heroBtn) {
          heroBtn.href = "/corset-vip";
          heroBtn.textContent = "Ver Beneficios VIP 💎 →";
        }
        if (flyerCard) {
          flyerCard.href = "/corset-vip";
        }
        if (flyerCta) {
          flyerCta.innerHTML = '💎 Eres miembro VIP activo. Haz clic aquí para ver tus beneficios de honor →';
        }
      }

      const cachedVip = localStorage.getItem("user_vip_status") || localStorage.getItem("vip_status");
      if (cachedVip === "vip_activo") {
        applyVipMode();
        return;
      }

      const ident = localStorage.getItem("user_phone") || localStorage.getItem("user_alias") || localStorage.getItem("user_email");
      if (ident) {
        fetch(`/api/affiliates/stats?identifier=${encodeURIComponent(ident)}`)
          .then(function(res) { return res.json(); })
          .then(function(data) {
            if (data && data.stats && data.stats.vipStatus === "vip_activo") {
              localStorage.setItem("user_vip_status", "vip_activo");
              applyVipMode();
            }
          })
          .catch(function() {});
      }
    }

    function checkCorsetAffiliateDiscount() {
      try {
        let myAlias = (localStorage.getItem("user_alias") || "").trim().toLowerCase();
        let myReferredBy = (localStorage.getItem("user_referred_by") || "").trim().toLowerCase();
        try {
          const rawProfile = localStorage.getItem("user_profile");
          if (rawProfile) {
            const parsed = JSON.parse(rawProfile);
            if (parsed.alias) myAlias = parsed.alias.trim().toLowerCase();
            if (parsed.referredBy) myReferredBy = parsed.referredBy.trim().toLowerCase();
          }
        } catch (_) {}

        const urlParams = new URLSearchParams(window.location.search);
        const refParam = urlParams.get("ref") || urlParams.get("r");
        let activeRef = refParam ? refParam.trim().toLowerCase() : null;

        if (activeRef && myAlias && activeRef === myAlias) {
          activeRef = myReferredBy || "segisw";
        }
        if (myReferredBy && myAlias && activeRef && activeRef !== myReferredBy) {
          activeRef = myReferredBy;
        }

        if (!activeRef) {
          activeRef = localStorage.getItem("affiliate_ref");
        }
        if (!activeRef) {
          const match = document.cookie.match(/(?:^|;\s*)affiliate_ref=([^;]+)/);
          if (match) activeRef = decodeURIComponent(match[1]).trim().toLowerCase();
        }
        if (activeRef && myAlias && activeRef === myAlias) {
          activeRef = myReferredBy || "segisw";
        }
        if (activeRef) {
          const title = document.getElementById("corset-vip-card-title");
          if (title) {
            title.innerHTML = 'Membresía Anual VIP <span class="line-through text-[#f7f4ee]/40 text-sm font-normal mr-1">$199.000</span> <span class="text-[#81c784] font-bold">$179.000 COP</span> <span class="text-xs text-[#81c784] font-mono">(-10% Embajador)</span>';
          }
        }
      } catch (e) {}
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", function() {
        checkCorsetSocietyVip();
        checkCorsetAffiliateDiscount();
      });
    } else {
      checkCorsetSocietyVip();
      checkCorsetAffiliateDiscount();
    }
  </script>
</Layout>
