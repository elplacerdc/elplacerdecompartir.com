import AmbassadorLink from "../../components/AmbassadorLink.astro";
---
import Layout from "../../layouts/Layout.astro";
import LeadForm from "../../components/LeadForm.astro";
import VipCheckout from "../../components/VipCheckout.astro";
---

<Layout 
  title="The Corset Society | Línea Exclusiva"
  description="Línea de Alta Exclusividad nivel premium de ElPlacerDC."
>
  <div class="pt-24 pb-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto space-y-16">
    
    <!-- Hero / Presentación -->
    <div class="text-center space-y-6">
      <span class="px-4 py-1.5 rounded-full text-xs font-serif font-bold uppercase tracking-widest bg-corset-gold/20 text-corset-gold border border-corset-gold/40 inline-block mb-4">
        Línea de Alta Exclusividad
      </span>
      <h1 class="font-serif text-4xl sm:text-6xl font-bold tracking-tight text-elplacer-ivory">
        The Corset Society
      </h1>
      <p class="text-xl text-corset-gold font-light italic">
        Nivel Premium de ElPlacerDC
      </p>
    </div>

    <!-- Nueva Filosofía de Membresía Anual -->
    <div class="bg-elplacer-midnight-plum p-8 sm:p-12 rounded-2xl border border-corset-gold/30 text-center space-y-6">
      <h2 class="text-2xl font-serif font-bold text-corset-champagne">Membresía VIP Anual</h2>
      <p class="text-elplacer-ivory/80 font-light leading-relaxed max-w-2xl mx-auto">
        El concepto de ticket alto de The Corset Society evoluciona hacia una <strong>Credencial Anual Exclusiva</strong>. Esta membresía es tu acceso directo a descuentos permanentes, invitaciones prioritarias, convocatorias para encuentros, fantasías privadas y nuestra comunidad premium.
      </p>
      
      <div class="bg-elplacer-midnight-plum border border-corset-gold/40 p-6 rounded-xl inline-block mt-4 text-left">
        <h4 class="text-corset-champagne font-bold font-serif mb-2 text-center">🎁 Especial Noche de Halloween</h4>
        <p class="text-sm text-elplacer-ivory/70 text-center">
          Quienes asistan a nuestra Fiesta de Luna Llena en Halloween recibirán su <strong>primer año de credencial sin costo</strong>.
        </p>
      </div>

      <p class="text-sm text-corset-gold uppercase tracking-wider font-bold mt-8">
        Importante: Postularse es Obligatorio
      </p>
      <p class="text-xs text-elplacer-ivory/60">
        Antes de cualquier activación o pago, debes postularte a través del siguiente formulario. Todo ingreso es curado por nuestro equipo.
      </p>
    </div>

    <!-- Formulario Obligatorio VIP -->
    <div class="pt-8">
      <AmbassadorLink />
      <LeadForm 
        title="Postulación a Membresía" 
        subtitle="Ingresa tus datos para iniciar el proceso de admisión VIP."
        isVip={true}
      />
    </div>

    <!-- Redirección al Checkout -->
    <div class="text-center pt-12 border-t border-corset-gold/20">
      <p class="text-elplacer-ivory/70 text-sm mb-4">¿Ya fuiste admitido y deseas activar tu credencial anual?</p>
      <a href="/corset-vip" class="inline-block px-8 py-3 rounded-full border border-corset-gold text-corset-gold hover:bg-corset-gold hover:text-corset-noir font-serif font-bold uppercase text-sm transition-all">
        Ir a Pago de Membresía
      </a>
    </div>

  </div>
</Layout>
