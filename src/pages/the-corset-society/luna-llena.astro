---
// the-corset-society/luna-llena.astro - Landing Oficial Evento Noche de Luna Llena
import Layout from "../../layouts/Layout.astro";
import CorsetHeader from "../../components/CorsetHeader.astro";
import { pool } from "../../db/index";

const cookieRef = Astro.cookies.get("affiliate_ref")?.value || Astro.url.searchParams.get("ref") || Astro.url.searchParams.get("r") || null;

let isVipRefSsr = false;
if (cookieRef) {
  const cleanRef = cookieRef.trim().toLowerCase();
  if (cleanRef === "segisw") {
    isVipRefSsr = true;
  } else {
    try {
      const { rows } = await pool.query(
        `SELECT l.vip_until, l.metadata 
         FROM afiliados a 
         LEFT JOIN leads l ON (LOWER(l.email) = LOWER(a.email) OR l.whatsapp = a.whatsapp OR LOWER(l.alias_nombre) = LOWER(a.alias))
         WHERE LOWER(a.alias) = LOWER($1)
         LIMIT 1`,
        [cleanRef]
      );
      if (rows.length > 0) {
        const row = rows[0];
        const hasVipUntil = row.vip_until && new Date(row.vip_until) > new Date();
        const hasVipTag = Array.isArray(row.metadata?.tags) && (row.metadata.tags.includes("vip_activo") || row.metadata.tags.includes("corset_vip"));
        if (hasVipUntil || hasVipTag) {
          isVipRefSsr = true;
        }
      }
    } catch (_) {}
  }
}

const discPercentSsr = isVipRefSsr ? 0.20 : (cookieRef ? 0.10 : 0);
const discLabelSsr = isVipRefSsr ? "-20% OFF" : "-10% OFF";
const precioParejaSsr = Math.round(100000 * (1 - discPercentSsr));
const separaParejaSsr = Math.round(40000 * (1 - discPercentSsr));
const precioSingleSsr = Math.round(120000 * (1 - discPercentSsr));
const separaSingleSsr = Math.round(50000 * (1 - discPercentSsr));
const precioUnicornioSsr = Math.round(30000 * (1 - discPercentSsr));
const separaUnicornioSsr = Math.round(10000 * (1 - discPercentSsr));
---

<Layout 
  title="Noche de Luna Llena — Mascarada de Halloween Noir | The Corset Society"
  description="Gala y Mascarada oficial de Halloween en Bogotá. Esta noche el bosque despierta: hadas, elfos, duendes o espíritus nocturnos. Reserva de entradas y membresías."
  isCorset={true}
  ogImage="/media/og/luna-llena-og.jpg"
>
  <div class="min-h-screen bg-[#050505] text-[#f7f4ee] font-serif selection:bg-[#c5a059] selection:text-[#050505] relative overflow-hidden">
    <!-- Header Noir -->
    <CorsetHeader current="luna-llena" />

    <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16 relative z-10">
      <!-- Title & Lore -->
      <section class="text-center space-y-6">
        <div class="inline-flex items-center gap-2 px-4 py-1 rounded-full border border-[#c5a059]/40 bg-[#4a0e17]/30 text-xs tracking-[0.25em] uppercase text-[#ead397]">
          <span>🌕</span> Gala de Halloween & Mascarada Noir <span>🎃</span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-[#f7f4ee] leading-tight">
          Noche de Luna Llena <br />
          <span class="italic font-normal text-transparent bg-clip-text bg-gradient-to-r from-[#c5a059] via-[#ead397] to-[#8a6d3b]">
            Máscarada en el Bosque
          </span>
        </h1>
        <p class="max-w-2xl mx-auto text-base sm:text-lg font-sans font-light text-[#f7f4ee]/80 leading-relaxed">
          Esta noche el bosque despierta… Las máscaras ocultan identidades, la luna revela deseos y cada invitado puede elegir en qué espíritu convertirse.
        </p>
        <p class="text-sm font-sans italic text-[#ead397]">
          🧚‍♀️ ¿Hada, elfo, duende o una criatura salida de tu imaginación? Ven caracterizado y vive la experiencia.
        </p>

        <!-- Promoción Exclusiva Gala Halloween: 1 Año de Membresía VIP Incluido -->
        <div class="my-6 p-6 sm:p-8 rounded-2xl bg-gradient-to-r from-[#2a0e28] via-[#140816] to-[#2a0e28] border-2 border-[#c5a059] shadow-[0_0_35px_rgba(197,160,89,0.3)] text-center space-y-4 max-w-3xl mx-auto">
          <div class="inline-flex items-center gap-2 px-4 py-1 rounded-full border border-[#c5a059]/50 bg-[#c5a059]/15 text-xs tracking-[0.2em] uppercase text-[#ead397] font-bold">
            <span>🎃</span> Promoción Exclusiva Gala Halloween <span>💎</span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-bold font-serif text-[#f7f4ee]">
            ¡Tu Entrada a Luna Llena Activa <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#c5a059] via-[#ead397] to-[#c5a059]">1 Año de Membresía VIP</span> de Regalo!
          </h3>
          <p class="max-w-2xl mx-auto text-xs sm:text-sm font-sans text-[#f7f4ee]/90 leading-relaxed">
            Quienes adquieran su pase y asistan a la <strong>Mascarada de Halloween Noir</strong> reciben la activación formal de su <strong>Credencial VIP Anual de The Corset Society ($199.000 COP) totalmente sin costo</strong>. Acceso a convocatorias secretas, 20% de descuento permanente en eventos y tu enlace exclusivo de embajador.
          </p>
        </div>

        <div class="pt-2">
          <a
            href="#reservas"
            class="inline-flex items-center gap-3 px-8 py-3.5 rounded-full font-serif font-semibold text-xs sm:text-sm tracking-wider uppercase bg-gradient-to-r from-[#c5a059] via-[#ead397] to-[#c5a059] text-[#050505] shadow-[0_0_25px_rgba(197,160,89,0.35)] hover:shadow-[0_0_35px_rgba(197,160,89,0.6)] hover:scale-105 active:scale-95 transition-all duration-300"
          >
            <span>Reservar Entrada</span>
            <span>→</span>
          </a>
        </div>
      </section>

      <!-- Event Details Bar -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-6 rounded-2xl bg-[#0a0608] border border-[#c5a059]/30 text-center text-xs font-sans">
        <div class="p-3 border-r border-[#c5a059]/20">
          <div class="text-[#c5a059] uppercase tracking-wider mb-1">Fecha</div>
          <div class="text-[#f7f4ee] font-semibold">Sábado 31 Octubre 2026</div>
        </div>
        <div class="p-3 sm:border-r border-[#c5a059]/20">
          <div class="text-[#c5a059] uppercase tracking-wider mb-1">Horario</div>
          <div class="text-[#f7f4ee] font-semibold">8:00 P.M. — 4:00 A.M.</div>
        </div>
        <div class="p-3 border-r border-[#c5a059]/20">
          <div class="text-[#c5a059] uppercase tracking-wider mb-1">Ubicación</div>
          <div class="text-[#f7f4ee] font-semibold">Centro Cultural El Placer de Compartir, Bogotá</div>
        </div>
        <div class="p-3">
          <div class="text-[#c5a059] uppercase tracking-wider mb-1">Dress Code</div>
          <div class="text-[#f7f4ee] font-semibold">Máscara obligatoria / Noir Fantasy</div>
        </div>
      </div>

      <!-- Flyers & Video Gallery -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <!-- Col 1: Flyer Oficial de Gala Halloween -->
        <div class="rounded-2xl overflow-hidden border border-[#c5a059]/40 shadow-[0_0_30px_rgba(197,160,89,0.15)] bg-[#0a0608]">
          <img 
            src="/media/corset-society/flyer_halloween_clean.jpg" 
            alt="Flyer Oficial Noche de Luna Llena" 
            class="w-full object-cover hover:scale-105 transition-transform duration-700"
          />
          <div class="p-3 text-center text-xs text-[#ead397] font-sans border-t border-[#c5a059]/20">
            Flyer Oficial de Gala • Sábado 31 Octubre
          </div>
        </div>

        <!-- Col 2: Video de Atmósfera Vertical (9:16) -->
        <div class="flex flex-col items-center justify-center">
          <div class="w-full max-w-[280px] sm:max-w-[320px] rounded-2xl overflow-hidden border border-[#c5a059]/40 shadow-[0_0_40px_rgba(197,160,89,0.25)] bg-[#050505]">
            <video 
              controls 
              preload="metadata" 
              poster="/media/society_hero_opt.jpg"
              class="w-full aspect-[9/16] object-contain bg-black"
            >
              <source src="/media/corset-society/video_juan_kreiss.mp4" type="video/mp4" />
              Tu navegador no soporta el formato de video.
            </video>
            <div class="p-3 text-center text-xs text-[#c5a059] font-sans border-t border-[#c5a059]/20">
              Atmósfera & Registro Cinematográfico
            </div>
          </div>
        </div>
      </div>

      <!-- Pricing & Interactive Checkout Section -->
      <section class="pt-8 space-y-8">
        <div class="text-center space-y-3">
          <span class="text-xs uppercase tracking-[0.25em] text-[#c5a059] font-bold">Círculo Privado & Experiencias de Ticket Alto</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-[#ead397]">Valores Oficiales de Cover</h2>
          <p class="text-sm font-sans text-[#f7f4ee]/70 max-w-xl mx-auto leading-relaxed">
            The Corset Society es una experiencia de ticket alto con aforo rigurosamente limitado. Nuestros covers constituyen un filtro deliberado de confort, discreción y distinción. Puedes realizar el <strong>Pago Total</strong> o asegurar tu cupo con la <strong>Separación Inicial</strong> y liquidar el excedente en el ingreso.
          </p>
        </div>

        <!-- Affiliate Discount Banner (Dynamic) -->
        <div id="affiliateDiscountBanner" class={`${cookieRef ? '' : 'hidden'} p-4 rounded-2xl bg-gradient-to-r from-[#c5a059]/25 via-[#250F22] to-[#140816] border border-[#c5a059]/50 flex items-center justify-between text-xs text-[#ead397] mb-6 shadow-[0_0_25px_rgba(197,160,89,0.2)]`}>
          <div class="flex items-center gap-3">
            <span class="text-2xl">🎉</span>
            <div>
              <strong class="text-white block text-sm font-serif">{isVipRefSsr ? 'Beneficio de Embajador VIP' : 'Beneficio de Embajador'}</strong>
              <span class="text-xs text-[#f7f4ee]/90">{isVipRefSsr ? '20%' : '10%'} de descuento de cortesía por invitación de <strong id="affiliateAliasDisplay" class="text-[#c5a059]">@{cookieRef || 'embajador'}</strong></span>
            </div>
          </div>
          <span class="px-3.5 py-1.5 rounded-full bg-gradient-to-r from-[#c5a059] to-[#ead397] text-[#050505] font-bold text-xs uppercase tracking-wider shadow-md shrink-0">
            {discLabelSsr}
          </span>
        </div>

        <!-- Ancla de Pago sobre la sección de pase adaptado -->
        <div id="reservas" class="scroll-mt-24"></div>

        <!-- Cover Tier Cards -->
        <div id="tier-cards-container" class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Pareja -->
          <div id="tier-card-pareja" class="p-6 rounded-2xl bg-gradient-to-b from-[#140a18] to-[#0a0608] border border-[#c5a059] shadow-[0_0_20px_rgba(197,160,89,0.2)] flex flex-col justify-between space-y-4">
            <div class="space-y-2">
              <div class="text-xs uppercase tracking-wider text-[#c5a059] font-bold flex items-center justify-between">
                <span class="flex items-center gap-1.5"><span>👫</span> <span>Pase Pareja</span></span>
                <span id="badge-disc-pareja" class={`${cookieRef ? '' : 'hidden'} text-[10px] bg-[#81c784]/20 text-[#81c784] border border-[#81c784]/40 px-2 py-0.5 rounded-full font-mono`}>{discLabelSsr}</span>
              </div>
              <div id="tier-price-pareja" class="text-3xl font-bold text-[#f7f4ee]">
                {cookieRef ? (
                  <>
                    <span class="line-through text-[#f7f4ee]/40 text-xl mr-2 font-normal">$100.000</span>
                    <span class="text-[#81c784]">${precioParejaSsr.toLocaleString('es-CO')}</span>
                    <span class="text-xs font-normal text-[#f7f4ee]/50 ml-1">COP</span>
                  </>
                ) : (
                  <>$100.000 <span class="text-xs font-normal text-[#f7f4ee]/50">COP</span></>
                )}
              </div>
              <p id="tier-separa-pareja" class="text-xs font-sans text-[#ead397]">
                {cookieRef ? (
                  <>O separa con solo <strong class="text-[#81c784]">${separaParejaSsr.toLocaleString('es-CO')} COP</strong> <span class="line-through text-[#f7f4ee]/40 text-[11px]">($40.000)</span></>
                ) : (
                  <>O separa con solo <strong>$40.000 COP</strong></>
                )}
              </p>
              <ul class="text-xs font-sans text-[#f7f4ee]/70 space-y-1.5 pt-2">
                <li>✓ Acceso para 2 personas</li>
                <li>✓ Coctelería de bienvenida</li>
                <li>✓ Acceso a todas las atmósferas</li>
                <li>✓ Participación concurso de disfraces</li>
              </ul>
            </div>
            <button 
              type="button" 
              onclick="selectTier('pareja', true)"
              class="w-full py-2.5 rounded-full border border-[#c5a059] text-xs font-serif uppercase tracking-wider text-[#c5a059] hover:bg-[#c5a059] hover:text-[#050505] transition-all font-bold"
            >
              Seleccionar Pareja
            </button>
          </div>

          <!-- Single (Hombre Solo) -->
          <div id="tier-card-single" class="p-6 rounded-2xl bg-gradient-to-b from-[#140a18] to-[#0a0608] border border-[#c5a059] shadow-[0_0_20px_rgba(197,160,89,0.2)] flex flex-col justify-between space-y-4">
            <div class="space-y-2">
              <div class="text-xs uppercase tracking-wider text-[#c5a059] font-bold flex items-center justify-between">
                <span class="flex items-center gap-1.5"><span>🙋‍♂️</span> <span>Pase Single (Hombre Solo)</span></span>
                <span id="badge-disc-single" class={`${cookieRef ? '' : 'hidden'} text-[10px] bg-[#81c784]/20 text-[#81c784] border border-[#81c784]/40 px-2 py-0.5 rounded-full font-mono`}>{discLabelSsr}</span>
              </div>
              <div id="tier-price-single" class="text-3xl font-bold text-[#f7f4ee]">
                {cookieRef ? (
                  <>
                    <span class="line-through text-[#f7f4ee]/40 text-xl mr-2 font-normal">$120.000</span>
                    <span class="text-[#81c784]">${precioSingleSsr.toLocaleString('es-CO')}</span>
                    <span class="text-xs font-normal text-[#f7f4ee]/50 ml-1">COP</span>
                  </>
                ) : (
                  <>$120.000 <span class="text-xs font-normal text-[#f7f4ee]/50">COP</span></>
                )}
              </div>
              <p id="tier-separa-single" class="text-xs font-sans text-[#ead397]">
                {cookieRef ? (
                  <>O separa con solo <strong class="text-[#81c784]">${separaSingleSsr.toLocaleString('es-CO')} COP</strong> <span class="line-through text-[#f7f4ee]/40 text-[11px]">($50.000)</span></>
                ) : (
                  <>O separa con solo <strong>$50.000 COP</strong></>
                )}
              </p>
              <div class="p-2 rounded-lg bg-[#050505]/70 border border-[#c5a059]/40 text-[11px] text-[#ead397] font-sans leading-tight">
                ⚖️ <strong>Filtro 1:3:</strong> Admisión de 1 hombre solo por cada 3 parejas confirmadas. Sujeto a lista de espera.
              </div>
              <ul class="text-xs font-sans text-[#f7f4ee]/70 space-y-1.5 pt-2">
                <li>✓ Acceso individual selecto</li>
                <li>✓ Coctel de autor de bienvenida</li>
                <li>✓ Admisión filtrada de caballeros</li>
                <li>✓ Dinámicas y rituales de integración</li>
              </ul>
            </div>
            <button 
              type="button" 
              onclick="selectTier('single', true)"
              class="w-full py-2.5 rounded-full border border-[#c5a059] text-xs font-serif uppercase tracking-wider text-[#c5a059] hover:bg-[#c5a059] hover:text-[#050505] transition-all font-bold"
            >
              Seleccionar Single
            </button>
          </div>

          <!-- Unicornio (Mujer Sola) -->
          <div id="tier-card-unicornio" class="p-6 rounded-2xl bg-gradient-to-b from-[#140a18] to-[#0a0608] border border-[#c5a059] shadow-[0_0_20px_rgba(197,160,89,0.2)] flex flex-col justify-between space-y-4">
            <div class="space-y-2">
              <div class="text-xs uppercase tracking-wider text-[#c5a059] font-bold flex items-center justify-between">
                <span class="flex items-center gap-1.5"><span>🦄</span> <span>Pase Unicornio (Mujer Sola)</span></span>
                <span id="badge-disc-unicornio" class={`${cookieRef ? '' : 'hidden'} text-[10px] bg-[#81c784]/20 text-[#81c784] border border-[#81c784]/40 px-2 py-0.5 rounded-full font-mono`}>{discLabelSsr}</span>
              </div>
              <div id="tier-price-unicornio" class="text-3xl font-bold text-[#f7f4ee]">
                {cookieRef ? (
                  <>
                    <span class="line-through text-[#f7f4ee]/40 text-xl mr-2 font-normal">$30.000</span>
                    <span class="text-[#81c784]">${precioUnicornioSsr.toLocaleString('es-CO')}</span>
                    <span class="text-xs font-normal text-[#f7f4ee]/50 ml-1">COP</span>
                  </>
                ) : (
                  <>$30.000 <span class="text-xs font-normal text-[#f7f4ee]/50">COP</span></>
                )}
              </div>
              <p id="tier-separa-unicornio" class="text-xs font-sans text-[#ead397]">
                {cookieRef ? (
                  <>O separa con solo <strong class="text-[#81c784]">${separaUnicornioSsr.toLocaleString('es-CO')} COP</strong> <span class="line-through text-[#f7f4ee]/40 text-[11px]">($10.000)</span></>
                ) : (
                  <>O separa con solo <strong>$10.000 COP</strong></>
                )}
              </p>
              <ul class="text-xs font-sans text-[#f7f4ee]/70 space-y-1.5 pt-2">
                <li>✓ Exclusivo mujer sola</li>
                <li>✓ Tarifa simbólica preferencial</li>
                <li>✓ Espacio de absoluto consentimiento</li>
                <li>✓ Admisión prioritaria y coctel de cortesía</li>
              </ul>
            </div>
            <button 
              type="button" 
              onclick="selectTier('unicornio', true)"
              class="w-full py-2.5 rounded-full border border-[#c5a059] text-xs font-serif uppercase tracking-wider text-[#c5a059] hover:bg-[#c5a059] hover:text-[#050505] transition-all font-bold"
            >
              Seleccionar Unicornio
            </button>
          </div>
        </div>

        <!-- Controles de Gestión de Pase y Rol -->
        <div id="role-controls-wrapper" class="hidden max-w-xl mx-auto space-y-3 mb-6">
          <!-- Control 1: Cambiar tipo de pase para esta compra sin alterar rol de perfil -->
          <div id="role-switch-container" class="p-4 rounded-2xl bg-[#0a0608] border border-[#c5a059]/40 text-xs font-sans text-center space-y-2.5 shadow-md">
            <div class="text-[#ead397] font-serif font-bold text-xs flex items-center justify-center gap-1.5">
              <span>💡</span> ¿Deseas asistir en otra modalidad?
            </div>
            <p class="text-[#f7f4ee]/70 text-[11px] leading-relaxed">
              Puedes seleccionar temporalmente otro tipo de pase para esta velada sin modificar tu rol registrado en la comunidad:
            </p>
            <div class="flex flex-wrap items-center justify-center gap-2 pt-1">
              <button 
                type="button" 
                id="btn-switch-pareja"
                onclick="setTemporaryPassMode('pareja')" 
                class="px-3.5 py-1.5 rounded-full border border-[#c5a059]/50 text-[#ead397] hover:bg-[#c5a059]/20 transition-all font-sans text-xs cursor-pointer"
              >
                👫 Pase Pareja
              </button>
              <button 
                type="button" 
                id="btn-switch-single"
                onclick="setTemporaryPassMode('single')" 
                class="px-3.5 py-1.5 rounded-full border border-[#c5a059]/50 text-[#ead397] hover:bg-[#c5a059]/20 transition-all font-sans text-xs cursor-pointer"
              >
                🙋‍♂️ Pase Single (Hombre)
              </button>
              <button 
                type="button" 
                id="btn-switch-unicornio"
                onclick="setTemporaryPassMode('unicornio')" 
                class="px-3.5 py-1.5 rounded-full border border-[#c5a059]/50 text-[#ead397] hover:bg-[#c5a059]/20 transition-all font-sans text-xs cursor-pointer"
              >
                🦄 Pase Unicornio (Mujer)
              </button>
            </div>
          </div>

          <!-- Control 2: Cambiar rol permanente en perfil de comunidad -->
          <div id="role-profile-container" class="p-3.5 rounded-2xl bg-[#140816] border border-[#c5a059]/20 text-xs font-sans flex flex-col sm:flex-row items-center justify-between gap-2 shadow-sm text-center sm:text-left">
            <div>
              <span class="text-[#f7f4ee]/80 font-medium text-[11px]">¿Tu configuración de perfil cambió?</span>
              <p class="text-[10px] text-[#c5a059]/70">Para modificar tu rol permanente de comunidad:</p>
            </div>
            <a 
              href="/dashboard#section-profile-settings" 
              class="px-4 py-1.5 rounded-full border border-[#c5a059]/50 text-[#ead397] hover:bg-[#c5a059]/20 text-xs font-bold uppercase tracking-wider transition-all whitespace-nowrap shrink-0 inline-flex items-center gap-1"
            >
              <span>⚙️</span> Cambiar rol en mi Perfil →
            </a>
          </div>
        </div>

        <!-- Checkout Form Box -->
        <div class="max-w-2xl mx-auto p-6 sm:p-8 rounded-3xl bg-[#0a0608] border border-[#c5a059] shadow-[0_0_40px_rgba(197,160,89,0.25)] space-y-6">
          <div class="border-b border-[#c5a059]/20 pb-4 text-center">
            <h3 class="text-2xl font-bold text-[#ead397]">Formalizar Reserva de Acceso</h3>
            <p class="text-xs font-sans text-[#f7f4ee]/60 mt-1">Completa los datos de tu credencial digital sellada</p>
          </div>

          <form id="checkoutForm" class="space-y-5">
            <!-- Modalidad Switch -->
            <div class="space-y-2">
              <label class="block text-xs uppercase tracking-wider text-[#c5a059] font-bold">Modalidad de Pago</label>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <label class="flex items-center justify-center gap-2 p-3 rounded-xl border border-[#c5a059]/40 cursor-pointer hover:bg-[#c5a059]/10 transition-colors">
                  <input type="radio" name="modalidad" value="total" checked onchange="updateSummary()" class="accent-[#c5a059]" />
                  <span class="text-xs font-sans text-[#f7f4ee]">Pago Total</span>
                </label>
                <label class="flex items-center justify-center gap-2 p-3 rounded-xl border border-[#c5a059]/40 cursor-pointer hover:bg-[#c5a059]/10 transition-colors">
                  <input type="radio" name="modalidad" value="reserva_40" onchange="updateSummary()" class="accent-[#c5a059]" />
                  <span class="text-xs font-sans text-[#f7f4ee]">Separación de Cupo</span>
                </label>
              </div>
            </div>

            <!-- Tier Select (Controlled visually by interactive cards) -->
            <input type="hidden" id="tipo_entrada" name="tipo_entrada" value="pareja" />

            <!-- Aviso cuando los datos están precargados de la cuenta oficial -->
            <div id="prefilled-profile-notice" class="hidden p-3.5 rounded-xl bg-[#140816] border border-[#c5a059]/40 text-xs font-sans text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-2 shadow-sm">
              <div class="flex items-center gap-2">
                <span class="text-base">🔒</span>
                <div>
                  <span class="text-[#ead397] font-semibold block text-[11px]">Datos vinculados a tu cuenta oficial</span>
                  <span class="text-[#f7f4ee]/70 text-[10px]">Para modificar tu nombre, correo o modalidad:</span>
                </div>
              </div>
              <a 
                href="/dashboard#section-profile-settings" 
                class="px-3.5 py-1.5 rounded-full border border-[#c5a059]/50 text-[#ead397] hover:bg-[#c5a059]/20 text-[11px] font-bold uppercase tracking-wider transition-all whitespace-nowrap shrink-0 inline-flex items-center gap-1"
              >
                <span>⚙️</span> Editar mi Perfil →
              </a>
            </div>

            <!-- Lead Details -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1">
                <label for="alias_nombre" class="block text-xs text-[#c5a059] uppercase tracking-wider">Nombre o Alias Discreto *</label>
                <input 
                  type="text" 
                  id="alias_nombre" 
                  name="alias_nombre" 
                  required 
                  placeholder="Tu alias" 
                  class="w-full bg-[#140a18] border border-[#c5a059]/30 rounded-xl px-4 py-2.5 text-sm text-[#f7f4ee] focus:border-[#c5a059] focus:outline-none"
                />
              </div>

              <div class="space-y-1">
                <label for="whatsapp" class="block text-xs text-[#c5a059] uppercase tracking-wider">WhatsApp Oficial (+57) *</label>
                <input 
                  type="tel" 
                  id="whatsapp" 
                  name="whatsapp" 
                  required 
                  placeholder="3194194785" 
                  class="w-full bg-[#140a18] border border-[#c5a059]/30 rounded-xl px-4 py-2.5 text-sm text-[#f7f4ee] focus:border-[#c5a059] focus:outline-none"
                />
              </div>
            </div>

            <div class="space-y-1">
              <label for="email" class="block text-xs text-[#c5a059] uppercase tracking-wider">Correo Electrónico (Recepción de Ticket) *</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                placeholder="tu-correo@privado.com" 
                class="w-full bg-[#140a18] border border-[#c5a059]/30 rounded-xl px-4 py-2.5 text-sm text-[#f7f4ee] focus:border-[#c5a059] focus:outline-none"
              />
            </div>

            <!-- Price Breakdown Box -->
            <div class="p-4 rounded-xl bg-[#140a18] border border-[#c5a059]/30 flex justify-between items-center text-sm font-sans">
              <div>
                <span class="text-[#c5a059] font-semibold block">Total a Pagar Hoy:</span>
                <span id="saldoPendienteLabel" class="text-[11px] text-[#f7f4ee]/50">Saldo en puerta: $0 COP</span>
              </div>
              <div id="montoTotalDisplay" class="text-2xl font-bold font-serif text-[#ead397]">
                $100.000 COP
              </div>
            </div>

            <!-- Actions -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
              <button 
                type="button" 
                id="btnDigitalPay"
                onclick="handleCheckout('pasarela_digital')"
                class="py-3.5 px-6 rounded-full font-serif font-bold uppercase tracking-wider text-xs bg-gradient-to-r from-[#c5a059] to-[#ead397] text-[#050505] hover:brightness-110 shadow-[0_0_20px_rgba(197,160,89,0.4)] transition-all cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
              >
                Pagar Online (Tarjetas / PSE / Nequi)
              </button>

              <button 
                type="button" 
                id="btnNequi"
                onclick="handleCheckout('nequi_breb')"
                class="py-3.5 px-6 rounded-full font-serif font-bold uppercase tracking-wider text-xs border border-[#c5a059] text-[#ead397] hover:bg-[#c5a059]/15 transition-all cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
              >
                Coordinar por WhatsApp (BreB, nequí, trasnferencia)
