            <p id="checkoutMsg" class="text-center text-xs font-sans text-[#ead397] min-h-[1.5rem]"></p>
          </form>

          <div class="text-[11px] font-sans text-center text-[#f7f4ee]/40 space-y-1 pt-2 border-t border-[#c5a059]/10">
            <p>🔐 El acceso se concede, no se anuncia. Nos reservamos el derecho de admisión y permanencia.</p>
            <p>Atención directa por WhatsApp: <strong>+57 319 419 4785</strong></p>
          </div>
        </div>
      </section>
    </main>
  </div>

  <script is:inline>
    let activeDiscount = false;
    let activeRef = null;

    try {
      const urlParams = new URLSearchParams(window.location.search);
      const qRef = urlParams.get("ref") || urlParams.get("r");

      // Datos de sesión activa para prevenir auto-referido
      let myAlias = (localStorage.getItem("user_alias") || "").trim().toLowerCase();
      let myReferredBy = (localStorage.getItem("user_referred_by") || "").trim().toLowerCase();
      try {
        const rawProfile = localStorage.getItem("user_profile");
        if (rawProfile) {
          const parsed = JSON.parse(rawProfile);
          if (parsed.alias) myAlias = parsed.alias.trim().toLowerCase();
          if (parsed.referredBy) myReferredBy = parsed.referredBy.trim().toLowerCase();
        }
      } catch (_) {}

      let candidateRef = qRef ? qRef.trim().toLowerCase() : null;

      // Si el candidato es el propio alias del usuario logueado, usar su verdadero embajador referidor (o 'segisw')
      if (candidateRef && myAlias && candidateRef === myAlias) {
        candidateRef = myReferredBy || "segisw";
      }

      // Si el usuario ya está registrado en la comunidad bajo un embajador, su referidor está sellado
      if (myReferredBy && myAlias && candidateRef && candidateRef !== myReferredBy) {
        candidateRef = myReferredBy;
      }

      let storedRef = candidateRef || localStorage.getItem("affiliate_ref");
      if (!storedRef) {
        const match = document.cookie.match(/(?:^|;\s*)affiliate_ref=([^;]+)/);
        if (match) storedRef = decodeURIComponent(match[1]).trim().toLowerCase();
      }

      if (storedRef && myAlias && storedRef === myAlias) {
        storedRef = myReferredBy || "segisw";
      }

      if (storedRef) {
        activeRef = storedRef.trim().toLowerCase();
        localStorage.setItem("affiliate_ref", activeRef);
        document.cookie = 'affiliate_ref=' + encodeURIComponent(activeRef) + '; path=/; max-age=2592000; SameSite=Lax';
        activeDiscount = true;
      }
    } catch (e) {}

    const PRICING = {
      pareja: { 
        total: activeDiscount ? 90000 : 100000, 
        reserva_40: activeDiscount ? 36000 : 40000 
      },
      single: { 
        total: activeDiscount ? 108000 : 120000, 
        reserva_40: activeDiscount ? 45000 : 50000 
      },
      unicornio: { 
        total: activeDiscount ? 27000 : 30000, 
        reserva_40: activeDiscount ? 9000 : 10000 
      }
    };

    async function applyDynamicDiscountUI() {
      let isVipUser = false;
      let userAttendedCount = 0;

      const sessionPhone = localStorage.getItem("ambassador_session_phone") || localStorage.getItem("user_phone");
      const userIdent = sessionPhone || localStorage.getItem("user_email") || localStorage.getItem("user_alias");
      if (userIdent) {
        try {
          const userRes = await fetch(`/api/affiliates/stats?identifier=${encodeURIComponent(userIdent)}`);
          const userData = await userRes.json();
          if (userData?.stats) {
            userAttendedCount = userData.stats.attendedEventsCount || 0;
            if (userData.stats.vipStatus === "vip_activo") {
              isVipUser = true;
            }
          }
        } catch (_) {}
      }

      // 1. VIP Activo: tarifa de honor permanente del 20%
      if (isVipUser) {
        PRICING.pareja.total = 80000;
        PRICING.pareja.reserva_40 = 32000;
        PRICING.single.total = 96000;
        PRICING.single.reserva_40 = 40000;
        PRICING.unicornio.total = 24000;
        PRICING.unicornio.reserva_40 = 8000;

        const banner = document.getElementById("affiliateDiscountBanner");
        if (banner) {
          banner.classList.remove("hidden");
          banner.innerHTML = `
            <div class="flex items-start gap-3 w-full justify-between">
              <div class="flex items-start gap-3">
                <span class="text-2xl">👑</span>
                <div>
                  <strong class="text-white block text-sm font-serif">Tarifa de Honor VIP Corset</strong>
                  <span class="text-xs text-[#f7f4ee]/90">Membresía anual activa. Cuentas con 20% de descuento permanente en tus entradas.</span>
                </div>
              </div>
              <span class="px-3.5 py-1.5 rounded-full bg-gradient-to-r from-[#c5a059] to-[#ead397] text-[#050505] font-bold text-xs uppercase tracking-wider shadow-md shrink-0">
                -20% VIP
              </span>
            </div>
          `;
        }
        updatePricingBadges("-20% VIP");
        updateSummary();
        return;
      }

      // 2. Usuario con eventos asistidos previos: ya consumió el beneficio de primera entrada
      if (userAttendedCount > 0) {
        activeDiscount = false;
        PRICING.pareja.total = 100000;
        PRICING.pareja.reserva_40 = 40000;
        PRICING.single.total = 120000;
        PRICING.single.reserva_40 = 50000;
        PRICING.unicornio.total = 30000;
        PRICING.unicornio.reserva_40 = 10000;

        const banner = document.getElementById("affiliateDiscountBanner");
        if (banner) {
          banner.classList.remove("hidden");
          banner.innerHTML = `
            <div class="flex items-start gap-3 w-full justify-between">
              <div class="flex items-start gap-3">
                <span class="text-2xl">🎟️</span>
                <div>
                  <strong class="text-white block text-sm font-serif">Tarifa Oficial Estándar</strong>
                  <span class="text-xs text-[#f7f4ee]/80">Tu beneficio de embajador para primera entrada ya fue utilizado en tu asistencia previa.</span>
                </div>
              </div>
              <span class="px-3 py-1.5 rounded-full bg-[#140816] text-[#ead397] border border-[#c5a059]/40 font-mono text-[11px] uppercase tracking-wider shrink-0">
                Tarifa Regular
              </span>
            </div>
          `;
        }
        hidePricingBadges();
        updateSummary();
        return;
      }

      // 3. Usuario nuevo con referido: aplicar descuento de primera entrada
      if (!activeDiscount || !activeRef) {
        hidePricingBadges();
        updateSummary();
        return;
      }

      let isVipRef = activeRef === 'segisw';
      try {
        const checkRes = await fetch(`/api/affiliates/stats?identifier=${encodeURIComponent(activeRef)}`);
        const checkData = await checkRes.json();
        if (checkData.stats?.vipStatus === 'vip_activo') {
          isVipRef = true;
        }
      } catch (_) {}

      const discPercent = isVipRef ? 0.20 : 0.10;
      const discLabel = isVipRef ? "-20% OFF" : "-10% OFF";

      PRICING.pareja.total = Math.round(100000 * (1 - discPercent));
      PRICING.pareja.reserva_40 = Math.round(40000 * (1 - discPercent));
      PRICING.single.total = Math.round(120000 * (1 - discPercent));
      PRICING.single.reserva_40 = Math.round(50000 * (1 - discPercent));
      PRICING.unicornio.total = Math.round(30000 * (1 - discPercent));
      PRICING.unicornio.reserva_40 = Math.round(10000 * (1 - discPercent));

      const banner = document.getElementById("affiliateDiscountBanner");
      if (banner) {
        banner.classList.remove("hidden");
        banner.innerHTML = `
          <div class="flex items-start gap-3 w-full justify-between">
            <div class="flex items-start gap-3">
              <span class="text-2xl">🎉</span>
              <div>
                <strong class="text-white block text-sm font-serif">${isVipRef ? 'Beneficio de Embajador VIP' : 'Beneficio de Embajador'}</strong>
                <span class="text-xs text-[#f7f4ee]/90">${isVipRef ? '20%' : '10%'} de descuento de cortesía por invitación de <strong class="text-[#c5a059]">@${activeRef}</strong> en tu primer acceso</span>
              </div>
            </div>
            <span class="px-3.5 py-1.5 rounded-full bg-gradient-to-r from-[#c5a059] to-[#ead397] text-[#050505] font-bold text-xs uppercase tracking-wider shadow-md shrink-0">
              ${discLabel}
            </span>
          </div>
        `;
      }

      updatePricingBadges(discLabel);
      updateSummary();
    }

    function updatePricingBadges(discLabel) {
      const badgeP = document.getElementById("badge-disc-pareja");
      if (badgeP) {
        badgeP.textContent = discLabel;
        badgeP.classList.remove("hidden");
      }
      const badgeS = document.getElementById("badge-disc-single");
      if (badgeS) {
        badgeS.textContent = discLabel;
        badgeS.classList.remove("hidden");
      }
      const badgeU = document.getElementById("badge-disc-unicornio");
      if (badgeU) {
        badgeU.textContent = discLabel;
        badgeU.classList.remove("hidden");
      }

      const pPareja = document.getElementById("tier-price-pareja");
      if (pPareja) {
        pPareja.innerHTML = `<span class="line-through text-[#f7f4ee]/40 text-xl mr-2 font-normal">$100.000</span><span class="text-[#81c784]">$${PRICING.pareja.total.toLocaleString('es-CO')}</span><span class="text-xs font-normal text-[#f7f4ee]/50 ml-1">COP</span>`;
      }
      const sPareja = document.getElementById("tier-separa-pareja");
      if (sPareja) {
        sPareja.innerHTML = `O separa con solo <strong class="text-[#81c784]">$${PRICING.pareja.reserva_40.toLocaleString('es-CO')} COP</strong> <span class="line-through text-[#f7f4ee]/40 text-[11px]">($40.000)</span>`;
      }

      const pSingle = document.getElementById("tier-price-single");
      if (pSingle) {
        pSingle.innerHTML = `<span class="line-through text-[#f7f4ee]/40 text-xl mr-2 font-normal">$120.000</span><span class="text-[#81c784]">$${PRICING.single.total.toLocaleString('es-CO')}</span><span class="text-xs font-normal text-[#f7f4ee]/50 ml-1">COP</span>`;
      }
      const sSingle = document.getElementById("tier-separa-single");
      if (sSingle) {
        sSingle.innerHTML = `O separa con solo <strong class="text-[#81c784]">$${PRICING.single.reserva_40.toLocaleString('es-CO')} COP</strong> <span class="line-through text-[#f7f4ee]/40 text-[11px]">($50.000)</span>`;
      }

      const pUni = document.getElementById("tier-price-unicornio");
      if (pUni) {
        pUni.innerHTML = `<span class="line-through text-[#f7f4ee]/40 text-xl mr-2 font-normal">$30.000</span><span class="text-[#81c784]">$${PRICING.unicornio.total.toLocaleString('es-CO')}</span><span class="text-xs font-normal text-[#f7f4ee]/50 ml-1">COP</span>`;
      }
      const sUni = document.getElementById("tier-separa-unicornio");
      if (sUni) {
        sUni.innerHTML = `O separa con solo <strong class="text-[#81c784]">$${PRICING.unicornio.reserva_40.toLocaleString('es-CO')} COP</strong> <span class="line-through text-[#f7f4ee]/40 text-[11px]">($10.000)</span>`;
      }
    }

    function hidePricingBadges() {
      const badgeP = document.getElementById("badge-disc-pareja");
      if (badgeP) badgeP.classList.add("hidden");
      const badgeS = document.getElementById("badge-disc-single");
      if (badgeS) badgeS.classList.add("hidden");
      const badgeU = document.getElementById("badge-disc-unicornio");
      if (badgeU) badgeU.classList.add("hidden");

      const pPareja = document.getElementById("tier-price-pareja");
      if (pPareja) pPareja.innerHTML = `<span class="text-[#ead397]">$100.000</span><span class="text-xs font-normal text-[#f7f4ee]/50 ml-1">COP</span>`;
      const sPareja = document.getElementById("tier-separa-pareja");
      if (sPareja) sPareja.innerHTML = `O separa con solo <strong class="text-[#ead397]">$40.000 COP</strong> (saldo en puerta $60.000)`;

      const pSingle = document.getElementById("tier-price-single");
      if (pSingle) pSingle.innerHTML = `<span class="text-[#ead397]">$120.000</span><span class="text-xs font-normal text-[#f7f4ee]/50 ml-1">COP</span>`;
      const sSingle = document.getElementById("tier-separa-single");
      if (sSingle) sSingle.innerHTML = `O separa con solo <strong class="text-[#ead397]">$50.000 COP</strong> (saldo en puerta $70.000)`;

      const pUni = document.getElementById("tier-price-unicornio");
      if (pUni) pUni.innerHTML = `<span class="text-[#ead397]">$30.000</span><span class="text-xs font-normal text-[#f7f4ee]/50 ml-1">COP</span>`;
      const sUni = document.getElementById("tier-separa-unicornio");
      if (sUni) sUni.innerHTML = `O separa con solo <strong class="text-[#ead397]">$10.000 COP</strong> (saldo en puerta $20.000)`;
    }

    function selectTier(tier, shouldScroll = false) {
      const select = document.getElementById('tipo_entrada');
      if (select) {
        select.value = tier;
        updateSummary();
        if (shouldScroll) {
          document.getElementById('checkoutForm')?.scrollIntoView({ behavior: 'smooth' });
        }
      }
    }

    function updateSummary() {
      const tier = document.getElementById('tipo_entrada')?.value || 'pareja';
      const modalidad = document.querySelector('input[name="modalidad"]:checked')?.value || 'total';
      const prices = PRICING[tier];
      if (!prices) return;

      const montoHoy = modalidad === 'reserva_40' ? prices.reserva_40 : prices.total;
      const saldoPuerta = modalidad === 'reserva_40' ? (prices.total - prices.reserva_40) : 0;

      const montoDisplay = document.getElementById('montoTotalDisplay');
      if (montoDisplay) {
        montoDisplay.textContent = `$${montoHoy.toLocaleString('es-CO')} COP`;
      }

      const saldoDisplay = document.getElementById('saldoPendienteLabel');
      if (saldoDisplay) {
        saldoDisplay.textContent = saldoPuerta > 0 
          ? `Saldo restante en puerta: $${saldoPuerta.toLocaleString('es-CO')} COP`
          : 'Pago 100% completado (Sin saldo pendiente)';
      }
    }

    async function handleCheckout(metodo) {
      const alias = document.getElementById('alias_nombre')?.value.trim();
      const whatsapp = document.getElementById('whatsapp')?.value.trim();
      const email = document.getElementById('email')?.value.trim();
      const tipo_entrada = document.getElementById('tipo_entrada')?.value;
      const modalidad = document.querySelector('input[name="modalidad"]:checked')?.value;
      const msg = document.getElementById('checkoutMsg');
      const btnDigital = document.getElementById('btnDigitalPay');
      const btnNequi = document.getElementById('btnNequi');

      if (!alias || !whatsapp || !email) {
        if (msg) msg.textContent = 'Por favor completa todos los campos requeridos (*).';
        return;
      }

      // Coordinación manual por WhatsApp (Bre-B, Nequi, transferencia)
      if (metodo === 'nequi_breb') {
        const prices = PRICING[tipo_entrada] || PRICING.pareja;
        const montoHoy = modalidad === 'reserva_40' ? prices.reserva_40 : prices.total;
        const modName = modalidad === 'reserva_40' ? 'Separación de Cupo (40%)' : 'Pago Total (100%)';
        const passName = tipo_entrada === 'pareja' ? '👫 Pareja' : (tipo_entrada === 'single' ? '🙋‍♂️ Single' : '🦄 Unicornio');

        const waText = encodeURIComponent(
          `¡Hola Segisw / El Placer DC! Deseo coordinar el pago manual para la Noche de Luna Llena:\n\n` +
          `• Alias: ${alias}\n` +
          `• WhatsApp: ${whatsapp}\n` +
          `• Correo: ${email}\n` +
          `• Pase: ${passName}\n` +
          `• Modalidad: ${modName}\n` +
          `• Monto a transferir: $${montoHoy.toLocaleString('es-CO')} COP\n` +
          `${activeRef ? `• Embajador: @${activeRef}\n` : ''}\n` +
          `Solicito los datos para transferir por Bre-B, Nequi o Bancolombia.`
        );
        const waUrl = `https://wa.me/573194194785?text=${waText}`;

        if (msg) {
          msg.innerHTML = `
            <div class="p-4 rounded-2xl bg-[#140816] border border-[#c5a059]/50 text-xs text-[#ead397] space-y-2.5 text-left mt-2 shadow-lg">
              <div class="font-bold flex items-center gap-1.5 text-white">
                <span>📲</span> <span>Coordinación de Transferencia Manual (Bre-B / Nequi / Bancolombia)</span>
              </div>
              <p class="text-[#f7f4ee]/80 leading-relaxed text-[11px]">
                Te hemos redirigido a la línea oficial para coordinar tu transferencia manual por <strong>$${montoHoy.toLocaleString('es-CO')} COP</strong>. Tu entrada y credencial digital sellada serán activadas por el administrador una vez confirmado el comprobante.
              </p>
              <div class="pt-1 flex flex-wrap gap-2">
                <a href="${waUrl}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-[#2e7d32] text-white font-bold text-xs hover:bg-[#388e3c] shadow-sm">
                  <span>Abrir WhatsApp Ahora 💬</span>
                </a>
              </div>
            </div>
          `;
        }

        window.open(waUrl, "_blank");
        if (btnDigital) btnDigital.disabled = false;
        if (btnNequi) btnNequi.disabled = false;
        return;
      }

      // Pasarela Digital online
      if (btnDigital) btnDigital.disabled = true;
      if (btnNequi) btnNequi.disabled = true;

      if (msg) msg.textContent = 'Conectando con la pasarela segura de pagos...';

      try {
        const res = await fetch('/api/checkout/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            alias_nombre: alias,
            whatsapp: whatsapp,
            email: email,
            tipo_entrada: tipo_entrada,
            modalidad_pago: modalidad,
            metodo_pago: metodo,
            ref: activeRef || undefined
          })
        });

        const data = await res.json();
        if (data.redirect_url) {
          if (msg) msg.textContent = 'Redirigiendo a pasarela...';
          window.location.href = data.redirect_url;
        } else if (data.ticketHash) {
          window.location.href = `/the-corset-society/ticket?hash=${data.ticketHash}`;
        } else if (data.isVipUnlockRequired) {
          if (msg) {
            msg.innerHTML = `
              <div class="p-4 rounded-2xl bg-[#250F22] border border-[#c5a059] text-xs text-[#ead397] space-y-2.5 mt-2 text-left">
                <div class="flex items-center gap-2 text-sm font-bold text-white">
                  <span>💎</span> <span>Cupo Single Reservado para Miembros VIP</span>
                </div>
                <p class="leading-relaxed text-[#f7f4ee]/90">${data.error}</p>
                <div class="pt-1">
                  <a href="/corset-vip#vip-checkout-box" class="inline-block px-5 py-2.5 rounded-full bg-gradient-to-r from-[#c5a059] to-[#ead397] text-[#0a0608] font-bold text-xs uppercase tracking-wider hover:brightness-110 shadow-md">
                    Activar Credencial VIP 💎 →
                  </a>
                </div>
              </div>
            `;
          }
          if (btnDigital) btnDigital.disabled = false;
          if (btnNequi) btnNequi.disabled = false;
        } else if (data.requiresWaitlistContact && data.contactUrl) {
          if (msg) {
            msg.innerHTML = `
              <div class="p-4 rounded-2xl bg-[#140816] border border-[#4caf50]/60 text-xs text-[#ead397] space-y-2.5 mt-2 text-left">
                <div class="flex items-center gap-2 text-sm font-bold text-white">
                  <span>📋</span> <span>Aforo de Singles Completo — Lista de Espera</span>
                </div>
                <p class="leading-relaxed text-[#f7f4ee]/90">${data.error}</p>
                <div class="pt-1">
                  <a href="${data.contactUrl}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#2e7d32] text-white font-bold text-xs uppercase tracking-wider hover:bg-[#388e3c] shadow-md">
                    <span>Contactar a Segisw por WhatsApp 📲</span>
                  </a>
                </div>
              </div>
            `;
          }
          if (btnDigital) btnDigital.disabled = false;
          if (btnNequi) btnNequi.disabled = false;
        } else if (data.error) {
          if (msg) msg.textContent = 'Error: ' + data.error;
          if (btnDigital) btnDigital.disabled = false;
          if (btnNequi) btnNequi.disabled = false;
        }
      } catch (err) {
        if (msg) msg.textContent = 'Ocurrió un error al procesar la reserva. Intenta de nuevo.';
        if (btnDigital) btnDigital.disabled = false;
        if (btnNequi) btnNequi.disabled = false;
      }
    }

    let originalUserRole = null;
    let currentTicketRole = null;

    function applyRoleTicketFilter(userRole, isTemporarySwitch = false) {
      if (!isTemporarySwitch) {
        originalUserRole = userRole;
      }
      currentTicketRole = userRole;

      const cardPareja = document.getElementById("tier-card-pareja");
      const cardSingle = document.getElementById("tier-card-single");
      const cardUnicornio = document.getElementById("tier-card-unicornio");
      const container = document.getElementById("tier-cards-container");
      const select = document.getElementById("tipo_entrada");
      const controlsWrapper = document.getElementById("role-controls-wrapper");
      const btnPareja = document.getElementById("btn-switch-pareja");
      const btnSingle = document.getElementById("btn-switch-single");
      const btnUnicornio = document.getElementById("btn-switch-unicornio");

      if (!cardPareja || !cardSingle || !cardUnicornio) return;

      if (controlsWrapper) controlsWrapper.classList.remove("hidden");

      if (userRole === "hombre_solo" || userRole === "single") {
        cardPareja.classList.add("hidden");
        cardUnicornio.classList.add("hidden");
        cardSingle.classList.remove("hidden");
        if (container) container.className = "max-w-md mx-auto";
        if (btnSingle) btnSingle.classList.add("hidden");
        if (btnPareja) btnPareja.classList.remove("hidden");
        if (btnUnicornio) btnUnicornio.classList.remove("hidden");
        if (select) select.value = "single";
        selectTier("single", false);
      } else if (userRole === "mujer_sola" || userRole === "unicornio") {
        cardPareja.classList.add("hidden");
        cardSingle.classList.add("hidden");
        cardUnicornio.classList.remove("hidden");
        if (container) container.className = "max-w-md mx-auto";
        if (btnUnicornio) btnUnicornio.classList.add("hidden");
        if (btnPareja) btnPareja.classList.remove("hidden");
        if (btnSingle) btnSingle.classList.remove("hidden");
        if (select) select.value = "unicornio";
        selectTier("unicornio", false);
      } else if (userRole === "pareja") {
        cardSingle.classList.add("hidden");
        cardUnicornio.classList.add("hidden");
        cardPareja.classList.remove("hidden");
        if (container) container.className = "max-w-md mx-auto";
        if (btnPareja) btnPareja.classList.add("hidden");
        if (btnSingle) btnSingle.classList.remove("hidden");
        if (btnUnicornio) btnUnicornio.classList.remove("hidden");
        if (select) select.value = "pareja";
        selectTier("pareja", false);
      }
    }

    function setTemporaryPassMode(mode) {
      applyRoleTicketFilter(mode, true);
    }

    async function hydrateSessionFormFields() {
      let userProfile = null;
      try {
        const raw = localStorage.getItem("user_profile");
        if (raw) userProfile = JSON.parse(raw);
      } catch (_) {}

      const sessionPhone = localStorage.getItem("ambassador_session_phone") || localStorage.getItem("user_phone") || userProfile?.whatsapp;
      let aliasVal = userProfile?.alias_nombre || localStorage.getItem("user_alias");
      let emailVal = userProfile?.email || localStorage.getItem("user_email");
      let phoneVal = sessionPhone;

      const inputAlias = document.getElementById("alias_nombre") as HTMLInputElement | null;
      const inputPhone = document.getElementById("whatsapp") as HTMLInputElement | null;
      const inputEmail = document.getElementById("email") as HTMLInputElement | null;
      const noticeBanner = document.getElementById("prefilled-profile-notice");

      function lockReadOnly(el: HTMLInputElement | null) {
        if (!el || !el.value) return;
        el.readOnly = true;
        el.classList.add("opacity-80", "cursor-not-allowed", "bg-[#0a050c]");
        el.title = "Dato vinculado a tu cuenta oficial. Para modificarlo haz clic en 'Editar mi Perfil'.";
      }

      if (inputAlias && aliasVal) {
        inputAlias.value = aliasVal;
        lockReadOnly(inputAlias);
      }
      if (inputPhone && phoneVal) {
        inputPhone.value = phoneVal;
        lockReadOnly(inputPhone);
      }
      if (inputEmail && emailVal) {
        inputEmail.value = emailVal;
        lockReadOnly(inputEmail);
      }

      if (aliasVal || phoneVal || emailVal) {
        if (noticeBanner) noticeBanner.classList.remove("hidden");
      }

      if ((!aliasVal || !emailVal) && sessionPhone) {
        try {
          const res = await fetch("/api/leads/check", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ whatsapp: sessionPhone }),
          });
          const data = await res.json();
          if (data.exists && data.lead) {
            const lead = data.lead;
            if (lead.alias_nombre) {
              aliasVal = lead.alias_nombre;
              localStorage.setItem("user_alias", lead.alias_nombre);
              if (inputAlias) {
                inputAlias.value = lead.alias_nombre;
                lockReadOnly(inputAlias);
              }
            }
            if (lead.email) {
              emailVal = lead.email;
              localStorage.setItem("user_email", lead.email);
              if (inputEmail) {
                inputEmail.value = lead.email;
                lockReadOnly(inputEmail);
              }
            }
            if (lead.whatsapp) {
              phoneVal = lead.whatsapp;
              localStorage.setItem("user_phone", lead.whatsapp);
              if (inputPhone) {
                inputPhone.value = lead.whatsapp;
                lockReadOnly(inputPhone);
              }
            }
            if (lead.rol) {
              localStorage.setItem("user_role", lead.rol);
              applyRoleTicketFilter(lead.rol);
            }
            localStorage.setItem("user_profile", JSON.stringify({
              alias: lead.affiliate_code || aliasVal,
              alias_nombre: aliasVal,
              whatsapp: phoneVal,
              email: emailVal || "",
              rol: lead.rol || "pareja",
              ciudad: lead.ciudad || "Bogotá",
              referredBy: lead.referred_by || null,
            }));
            if (noticeBanner) noticeBanner.classList.remove("hidden");
          }
        } catch (_) {}
      }
    }

    async function checkUserRoleAndFilter() {
      let userProfile = null;
      try {
        const raw = localStorage.getItem("user_profile");
        if (raw) userProfile = JSON.parse(raw);
      } catch (_) {}

      let userRole = userProfile?.rol || localStorage.getItem("user_role");
      const sessionPhone = localStorage.getItem("ambassador_session_phone") || localStorage.getItem("user_phone");

      if (!userRole && sessionPhone) {
        try {
          const res = await fetch("/api/leads/check", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ whatsapp: sessionPhone }),
          });
          const data = await res.json();
          if (data.exists && data.lead && data.lead.rol) {
            userRole = data.lead.rol;
            localStorage.setItem("user_role", userRole);
          }
        } catch (_) {}
      }

      if (userRole) {
        applyRoleTicketFilter(userRole);
      }
    }

    // Expose global methods
    window.setTemporaryPassMode = setTemporaryPassMode;
    window.selectTier = selectTier;
    window.handleCheckout = handleCheckout;
    window.updateSummary = updateSummary;
    window.applyRoleTicketFilter = applyRoleTicketFilter;

    // Real-time reactive hydration when user inputs phone or email
    const inputPhone = document.getElementById("whatsapp");
    const inputEmail = document.getElementById("email");

    inputPhone?.addEventListener("change", async () => {
      const val = inputPhone.value.trim();
      if (val && val.length >= 7) {
        localStorage.setItem("user_phone", val);
        await hydrateSessionFormFields();
        await checkUserRoleAndFilter();
        await applyDynamicDiscountUI();
      }
    });

    inputEmail?.addEventListener("change", async () => {
      const val = inputEmail.value.trim();
      if (val && val.includes("@")) {
        localStorage.setItem("user_email", val);
        await hydrateSessionFormFields();
        await checkUserRoleAndFilter();
        await applyDynamicDiscountUI();
      }
    });

    // Initialize display immediately or on load
    async function initPricing() {
      await checkUserRoleAndFilter();
      await hydrateSessionFormFields();
      await applyDynamicDiscountUI();
      updateSummary();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initPricing);
    } else {
      initPricing();
    }
  </script>
</Layout>
