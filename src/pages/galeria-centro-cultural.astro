---
// galeria-centro-cultural.astro - Galería Completa del Centro Cultural El Placer de Compartir
import Layout from "../layouts/Layout.astro";
import AmbassadorSection from "../components/AmbassadorSection.astro";

const zones = [
  {
    title: "Lobby & Recepción Principal",
    subtitle: "El umbral de bienvenida, diseñado con luz tenue, privacidad y acústica reservada.",
    photos: [
      { src: "/media/centro-cultural/fotos/lobby-1.jpg", title: "Lobby Central" },
    ],
  },
  {
    title: "Salones de Talleres & Encuentros",
    subtitle: "Espacios versátiles para dinámicas grupales, Shibari, charlas, masajes tántricos y cine reflexivo.",
    photos: [
      { src: "/media/centro-cultural/fotos/salon-principal-1-a.jpg", title: "Salón Principal (Vista Frontal)" },
      { src: "/media/centro-cultural/fotos/salon-principal-2-a.jpg", title: "Salón Principal (Ángulo Amplio)" },
      { src: "/media/centro-cultural/fotos/salon-negro-1.jpg", title: "Salón Negro (Atmósfera Íntima)" },
      { src: "/media/centro-cultural/fotos/salon-negro-2.jpg", title: "Salón Negro (Detalle de Iluminación)" },
      { src: "/media/centro-cultural/fotos/salon-rogo-1.jpg", title: "Salón Rojo (Terciopelo & Sensaciones)" },
      { src: "/media/centro-cultural/fotos/salon-rogo-2.jpg", title: "Salón Rojo (Vista Lateral)" },
      { src: "/media/centro-cultural/fotos/salon-cine-1.jpg", title: "Salón Cine & Proyecciones" },
    ],
  },
  {
    title: "Habitaciones & Espacios Íntimos",
    subtitle: "Habitaciones acondicionadas con confort prémium, higiene absoluta y estética cuidada.",
    photos: [
      { src: "/media/centro-cultural/fotos/hab-1-a.jpg", title: "Suite Sensorial I" },
      { src: "/media/centro-cultural/fotos/hab-1-b.jpg", title: "Suite Sensorial I (Detalle)" },
      { src: "/media/centro-cultural/fotos/hab-2-a.jpg", title: "Suite Sensorial II" },
      { src: "/media/centro-cultural/fotos/hab-3-a.jpg", title: "Suite Sensorial III" },
    ],
  },
  {
    title: "Zona Licorera & Coctelería",
    subtitle: "Barra de autor para degustaciones, cócteles artesanales y conversación distendida.",
    photos: [
      { src: "/media/centro-cultural/fotos/licorera-1.jpg", title: "Barra Principal" },
      { src: "/media/centro-cultural/fotos/licorera-2.jpg", title: "Área de Coctelería" },
    ],
  },
];

const videos = [
  {
    src: "/media/centro-cultural/videos/sitio-licorera.mp4",
    poster: "/media/centro-cultural/fotos/licorera-1.jpg",
    title: "Recorrido Zona Licorera & Bar",
  },
  {
    src: "/media/centro-cultural/videos/sitio-logos-1.mp4",
    poster: "/media/centro-cultural/fotos/salon-principal-1-a.jpg",
    title: "Identidad & Atmósfera del Centro Cultural",
  },
];
---

<Layout 
  title="Galería del Centro Cultural | El Placer de Compartir"
  description="Explora las fotos reales y videos de salones, habitaciones, lobby y licorera de nuestro Centro Cultural en Bogotá."
>
  <div class="pt-24 pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-16">
    
    <!-- Hero Title -->
    <div class="text-center space-y-4">
      <span class="inline-block px-4 py-1.5 rounded-full text-xs font-serif font-bold uppercase tracking-widest bg-[#c5a059]/20 text-[#ead397] border border-[#c5a059]/40 mb-2">
        Instalaciones Reales • Bogotá
      </span>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold tracking-tight text-[#f7f4ee]">
        Galería Centro Cultural
      </h1>
      <p class="text-base sm:text-lg text-[#f7f4ee]/80 font-light max-w-2xl mx-auto leading-relaxed">
        Conoce los espacios, salones y zonas diseñadas para la exploración sensorial, talleres y eventos de nuestra comunidad.
      </p>
      
      <div class="pt-4">
        <a 
          href="/centro-cultural#postulacion" 
          class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-[#c5a059] text-[#180A1A] font-serif font-bold text-xs uppercase tracking-wider hover:bg-[#ead397] shadow-lg transition-all"
        >
          Reserva un espacio (Alianzas)
        </a>
      </div>
    </div>

    <!-- Carruseles Horizontales por Zona -->
    <div class="space-y-16">
      {zones.map((zone) => (
        <section class="space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between border-b border-[#c5a059]/20 pb-3 gap-2">
            <div>
              <h2 class="font-serif text-2xl font-bold text-[#ead397]">{zone.title}</h2>
              <p class="text-xs sm:text-sm text-[#f7f4ee]/70 font-light mt-1">{zone.subtitle}</p>
            </div>
            <span class="text-[11px] text-[#c5a059] uppercase tracking-wider font-mono">
              Desliza horizontalmente →
            </span>
          </div>

          <!-- Carrusel Horizontal Fluido -->
          <div class="flex gap-4 overflow-x-auto pb-4 pt-2 snap-x snap-mandatory scrollbar-thin scrollbar-thumb-[#c5a059]/40">
            {zone.photos.map((photo) => (
              <div class="min-w-[280px] sm:min-w-[360px] md:min-w-[420px] max-w-[460px] flex-shrink-0 snap-start rounded-2xl overflow-hidden bg-[#140816] border border-[#c5a059]/30 shadow-md group relative">
                <div class="aspect-[4/3] w-full overflow-hidden bg-[#0a0608]">
                  <img 
                    src={photo.src} 
                    alt={photo.title} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </div>
                <div class="p-3.5 bg-gradient-to-t from-[#140816] via-[#140816]/90 to-transparent">
                  <p class="font-serif text-sm font-semibold text-[#f7f4ee]">{photo.title}</p>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- Sección de Videos del Centro Cultural -->
    <section class="space-y-6 pt-8 border-t border-[#c5a059]/20">
      <div class="text-center space-y-2">
        <span class="inline-block px-3 py-1 rounded-full text-xs uppercase tracking-widest text-[#c5a059] font-serif border border-[#c5a059]/30">
          Recorridos Audiovisuales
        </span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#f7f4ee]">Videos de la Sede</h2>
        <p class="text-xs sm:text-sm text-[#f7f4ee]/70 max-w-xl mx-auto">
          Descubre el ambiente, la iluminación y la arquitectura del espacio en video.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 max-w-3xl mx-auto">
        {videos.map((vid) => (
          <div class="rounded-2xl overflow-hidden bg-[#140816] border border-[#c5a059]/30 shadow-lg p-3.5 space-y-3 flex flex-col items-center">
            <div class="rounded-xl overflow-hidden bg-black aspect-[9/16] w-full max-w-[280px] flex items-center justify-center relative">
              <video 
                src={vid.src} 
                poster={vid.poster}
                controls 
                playsinline 
                preload="none"
                class="w-full h-full object-cover"
              >
                Tu navegador no soporta el formato de video.
              </video>
            </div>
            <p class="font-serif text-xs font-semibold text-[#ead397] text-center px-1">{vid.title}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Ambassador Section -->
    <AmbassadorSection />

    <div class="text-center pt-4">
      <a href="/centro-cultural" class="text-xs text-[#c5a059] hover:text-[#ead397] transition-colors underline underline-offset-2">← Volver a Centro Cultural</a>
    </div>

  </div>
</Layout>
