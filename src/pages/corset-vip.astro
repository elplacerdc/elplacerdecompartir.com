---
// src/pages/corset-vip.astro - Portal Oficial de Beneficios para Miembros VIP
import Layout from "../layouts/Layout.astro";
import CorsetHeader from "../components/CorsetHeader.astro";
---

<Layout 
  title="Beneficios de Membresía VIP — The Corset Society"
  description="Conoce los privilegios de honor, tarifas preferenciales del 20% y accesos reservados para miembros con Credencial VIP activa en The Corset Society."
  isCorset={true}
>
  <div class="min-h-screen bg-[#050505] text-[#f7f4ee] font-serif selection:bg-[#c5a059] selection:text-[#050505] relative overflow-hidden">
    
    <!-- Header Minimalista Noir -->
    <CorsetHeader current="vip" />

    <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 text-center space-y-14 relative z-10">
      
      <!-- Headline del Círculo de Honor -->
      <div class="space-y-4">
        <div class="inline-block px-4 py-1.5 rounded-full border border-[#c5a059]/40 bg-[#4a0e17]/25 text-[11px] tracking-[0.25em] uppercase text-[#ead397]">
          Círculo de Honor & Privilegios
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#f7f4ee] leading-[1.15]">
          Beneficios Exclusivos <br />
          <span class="italic font-normal text-transparent bg-clip-text bg-gradient-to-r from-[#c5a059] via-[#ead397] to-[#8a6d3b]">
            Credencial VIP The Corset Society
          </span>
        </h1>

        <p class="max-w-2xl mx-auto text-sm sm:text-base font-sans font-light text-[#f7f4ee]/85 leading-relaxed">
          Tu membresía anual activa representa la máxima distinción de nuestra comunidad. Estos son los privilegios y accesos de honor habilitados permanentemente para tu perfil.
        </p>
      </div>

      <!-- Credencial VIP Visual -->
      <div class="max-w-md mx-auto relative group">
        <div class="absolute -inset-1.5 bg-gradient-to-r from-[#c5a059]/30 via-[#ead397]/50 to-[#c5a059]/30 rounded-3xl blur-md opacity-75"></div>
        <div class="relative rounded-2xl overflow-hidden shadow-[0_0_40px_rgba(197,160,89,0.3)] border border-[#c5a059]/50 bg-[#0d0408]">
          <img 
            src="/media/corset-society/credencial-vip-checkout.jpg" 
            alt="Credencial VIP Oficial The Corset Society" 
            class="w-full h-auto object-contain"
          />
          <div class="py-3 px-4 bg-[#140816]/95 border-t border-[#c5a059]/30 flex items-center justify-between text-left">
            <div>
              <p class="text-[11px] font-serif font-bold text-[#ead397] uppercase tracking-wider">Credencial Oficial Activa</p>
              <p class="text-[10px] font-sans text-[#f7f4ee]/70">Emisión digital sellada e intransferible</p>
            </div>
            <span class="inline-flex items-center gap-1 text-[11px] uppercase tracking-wider text-[#81c784] font-bold border border-[#81c784]/40 px-3 py-1 rounded-full bg-[#81c784]/15 font-mono">
              ✓ Estatus VIP
            </span>
          </div>
        </div>
      </div>

      <!-- Grid de 6 Beneficios Oficiales VIP (Actualizados al 20%) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 text-left">
        
        <!-- Beneficio 1: 20% Descuento Permanente -->
        <div class="p-6 rounded-2xl bg-[#140816] border border-[#c5a059]/40 shadow-lg space-y-3 flex flex-col justify-between">
          <div class="space-y-2">
            <span class="text-3xl">💎</span>
            <h2 class="font-serif text-lg font-bold text-[#ead397]">20% de Descuento Permanente</h2>
            <p class="text-xs font-sans text-[#f7f4ee]/75 leading-relaxed font-light">
              Tarifa de honor reducida del <strong>20% en todas las entradas y consumos</strong> para eventos de El Placer de Compartir y veladas noir de The Corset Society durante todo tu año de membresía.
            </p>
          </div>
          <div class="text-[11px] text-[#c5a059] font-mono">✓ Aplicación automática en checkout</div>
        </div>

        <!-- Beneficio 2: Enlace Embajador VIP al 20% -->
        <div class="p-6 rounded-2xl bg-[#140816] border border-[#c5a059]/40 shadow-lg space-y-3 flex flex-col justify-between">
          <div class="space-y-2">
            <span class="text-3xl">🚀</span>
            <h2 class="font-serif text-lg font-bold text-[#ead397]">Enlace de Embajador al 20%</h2>
            <p class="text-xs font-sans text-[#f7f4ee]/75 leading-relaxed font-light">
              Tus referidos reciben un <strong>20% de descuento especial en su primera compra</strong> (en lugar del 10% estándar), convirtiendo tu enlace en una invitación de alto valor y acelerando tus entradas gratuitas ganadas.
            </p>
          </div>
          <div class="text-[11px] text-[#c5a059] font-mono">✓ Beneficio exclusivo de embajador VIP</div>
        </div>

        <!-- Beneficio 3: Desbloqueo Cupo Single -->
        <div class="p-6 rounded-2xl bg-[#140816] border border-[#c5a059]/40 shadow-lg space-y-3 flex flex-col justify-between">
          <div class="space-y-2">
            <span class="text-3xl">🛡️</span>
            <h2 class="font-serif text-lg font-bold text-[#ead397]">Cupo Single Garantizado</h2>
            <p class="text-xs font-sans text-[#f7f4ee]/75 leading-relaxed font-light">
              Desbloqueo prioritario del cupo individual de caballero reservado exclusivamente para credenciales VIP, sin quedar sujeto a bloqueos de aforo proporcional o listas de espera generales.
            </p>
          </div>
          <div class="text-[11px] text-[#c5a059] font-mono">✓ Cupo de honor reservado</div>
        </div>

        <!-- Beneficio 4: Convocatorias Secretas -->
        <div class="p-6 rounded-2xl bg-[#140816] border border-[#c5a059]/40 shadow-lg space-y-3 flex flex-col justify-between">
          <div class="space-y-2">
            <span class="text-3xl">🗝️</span>
            <h2 class="font-serif text-lg font-bold text-[#ead397]">Acceso Anticipado (24h)</h2>
            <p class="text-xs font-sans text-[#f7f4ee]/75 leading-relaxed font-light">
              Invitaciones privadas con 24 horas de antelación a encuentros selectos, veladas secretas y talleres especializados de aforo reducido antes de cualquier convocatoria general.
            </p>
          </div>
          <div class="text-[11px] text-[#c5a059] font-mono">✓ Notificación prioritaria por WhatsApp</div>
        </div>

        <!-- Beneficio 5: Fantasías a Medida y Canal Directo -->
        <div class="p-6 rounded-2xl bg-[#140816] border border-[#c5a059]/40 shadow-lg space-y-3 flex flex-col justify-between">
          <div class="space-y-2">
            <span class="text-3xl">🎭</span>
            <h2 class="font-serif text-lg font-bold text-[#ead397]">Curaduría & Fantasías Privadas</h2>
            <p class="text-xs font-sans text-[#f7f4ee]/75 leading-relaxed font-light">
              Canal de comunicación directo y confidencial con Segisw y la dirección general para coordinación de fantasías a medida, reserva de salones íntimos y asesoría personalizada.
            </p>
          </div>
          <div class="text-[11px] text-[#c5a059] font-mono">✓ Atención directa con dirección</div>
        </div>

        <!-- Beneficio 6: Credencial Digital Sellada -->
        <div class="p-6 rounded-2xl bg-[#140816] border border-[#c5a059]/40 shadow-lg space-y-3 flex flex-col justify-between">
          <div class="space-y-2">
            <span class="text-3xl">🎟️</span>
            <h2 class="font-serif text-lg font-bold text-[#ead397]">Acceso Preferencial en Puerta</h2>
            <p class="text-xs font-sans text-[#f7f4ee]/75 leading-relaxed font-light">
              Tu credencial digital cuenta con hash criptográfico y código QR de verificación instantánea para ingreso directo sin filas, atención de cortesía y trato preferencial.
            </p>
          </div>
          <div class="text-[11px] text-[#c5a059] font-mono">✓ Check-in prioritario sin esperas</div>
        </div>

      </div>

      <!-- Botones de Acción para Miembros VIP -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
        <a 
          href="/the-corset-society/luna-llena" 
          class="w-full sm:w-auto px-8 py-3.5 rounded-full font-serif font-bold uppercase tracking-wider text-xs bg-gradient-to-r from-[#c5a059] via-[#ead397] to-[#c5a059] text-[#050505] hover:brightness-110 shadow-[0_0_25px_rgba(197,160,89,0.4)] transition-all text-center"
        >
          Próximo Evento The Corset Society 🌕 →
        </a>

        <a 
          href="/dashboard" 
          class="w-full sm:w-auto px-8 py-3.5 rounded-full font-serif font-bold uppercase tracking-wider text-xs border border-[#c5a059]/60 text-[#ead397] hover:bg-[#c5a059]/20 transition-all text-center"
        >
          Mi Panel de Embajador 👤 →
        </a>
      </div>

      <!-- Banner de Activación para No-VIPs que lleguen a esta página -->
      <div class="p-6 rounded-2xl bg-[#140816] border border-[#c5a059]/30 max-w-xl mx-auto text-xs text-[#f7f4ee]/70 space-y-2">
        <p class="text-sm font-serif font-bold text-[#ead397]">¿Aún no cuentas con tu membresía activa?</p>
        <p class="leading-relaxed">
          Cualquier miembro de la comunidad puede activar su anualidad y disfrutar de todos los beneficios de honor de forma inmediata.
        </p>
        <div class="pt-2">
          <a 
            href="/corset/checkout" 
            class="inline-block px-6 py-2.5 rounded-full bg-gradient-to-r from-[#c5a059] to-[#ead397] text-[#0a0608] font-bold text-xs uppercase tracking-wider hover:brightness-110 shadow-md transition-all"
          >
            Activar Credencial VIP Anual ($199.000 COP) 💎 →
          </a>
        </div>
      </div>

      <!-- Legal Footer -->
      <footer class="pt-12 pb-6 text-center text-[10px] font-sans text-[#f7f4ee]/30 tracking-widest uppercase space-y-2 border-t border-[#c5a059]/10">
        <p>© {new Date().getFullYear()} The Corset Society • Círculo Privado de El Placer de Compartir</p>
        <p>Línea Oficial de Asistencia y Concierge: +57 319 419 4785</p>
      </footer>

    </main>
  </div>
</Layout>
