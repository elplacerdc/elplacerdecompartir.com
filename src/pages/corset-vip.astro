---
// corset-vip.astro - Landing Persuasiva Growth-Engine para Venta de Credencial VIP Anual
import Layout from "../layouts/Layout.astro";
import VipCheckout from "../components/VipCheckout.astro";
import LeadForm from "../components/LeadForm.astro";
---

<Layout 
  title="Credencial VIP Anual — The Corset Society | El Placer de Compartir"
  description="Adquiere tu membresía anual VIP a The Corset Society. Acceso permanente a convocatorias secretas, descuentos exclusivos y beneficios de honor."
  isCorset={true}
>
  <div class="min-h-screen bg-[#050505] text-[#f7f4ee] font-serif selection:bg-[#c5a059] selection:text-[#050505] relative overflow-hidden">
    
    <!-- Header Minimalista Noir -->
    <header class="py-6 px-4 sm:px-8 max-w-7xl mx-auto flex justify-between items-center border-b border-[#c5a059]/20 relative z-20">
      <a href="/the-corset-society" class="flex items-center gap-3">
        <img 
          src="/media/logo_corsetsociety_transparent.png" 
          alt="The Corset Society" 
          class="h-12 w-auto object-contain drop-shadow-[0_0_15px_rgba(197,160,89,0.3)]"
        />
        <div class="flex flex-col">
          <span class="text-sm uppercase tracking-[0.25em] text-[#ead397] font-bold">The Corset Society</span>
          <span class="text-[9px] uppercase tracking-[0.3em] text-[#c5a059]/70 font-sans">Línea de Alta Exclusividad</span>
        </div>
      </a>

      <div class="flex items-center gap-4">
        <a 
          href="/the-corset-society/luna-llena" 
          class="text-xs uppercase tracking-wider text-[#c5a059] border border-[#c5a059]/40 px-3 py-1.5 rounded-full bg-[#c5a059]/10 hover:bg-[#c5a059]/20 transition-colors"
        >
          🌕 Luna Llena
        </a>
        <a 
          href="/" 
          class="text-xs font-sans tracking-wider uppercase text-[#c5a059] hover:text-[#ead397] border border-[#c5a059]/30 px-3 py-1.5 rounded-full hover:bg-[#c5a059]/10 transition-colors hidden sm:inline-block"
        >
          ← El Placer DC
        </a>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 text-center space-y-16 relative z-10">
      
      <!-- Hero Headline Growth-Engine -->
      <div class="space-y-6">
        <div class="inline-block px-4 py-1.5 rounded-full border border-[#c5a059]/40 bg-[#4a0e17]/25 text-[11px] tracking-[0.25em] uppercase text-[#ead397]">
          Membresía Exclusiva Anual
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#f7f4ee] leading-[1.15]">
          Tu Credencial VIP <br />
          <span class="italic font-normal text-transparent bg-clip-text bg-gradient-to-r from-[#c5a059] via-[#ead397] to-[#8a6d3b]">
            al Círculo Más Exclusivo
          </span>
        </h1>

        <p class="max-w-2xl mx-auto text-sm sm:text-base font-sans font-light text-[#f7f4ee]/85 leading-relaxed">
          The Corset Society es la línea de alta exclusividad de ElPlacerDC. Diseñada para quienes valoran la elegancia, la privacidad inquebrantable y el acceso prioritario a experiencias que jamás se hacen públicas.
        </p>
      </div>

      <!-- Grid de Beneficios Privados -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-left">
        <div class="p-6 rounded-2xl bg-[#140816] border border-[#c5a059]/30 shadow-lg space-y-3">
          <span class="text-2xl">🗝️</span>
          <h2 class="font-serif text-lg font-bold text-[#ead397]">Acceso Preferencial</h2>
          <p class="text-xs font-sans text-[#f7f4ee]/70 leading-relaxed font-light">
            Invitaciones prioritarias y acceso directo a convocatorias íntimas, veladas temáticas de ticket alto y locaciones secretas con 24h de antelación.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-[#140816] border border-[#c5a059]/30 shadow-lg space-y-3">
          <span class="text-2xl">💎</span>
          <h2 class="font-serif text-lg font-bold text-[#ead397]">Descuentos Permanentes</h2>
          <p class="text-xs font-sans text-[#f7f4ee]/70 leading-relaxed font-light">
            Tarifas de honor y descuentos permanentes en todas las veladas, talleres especializados y celebraciones del ecosistema durante 365 días.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-[#140816] border border-[#c5a059]/30 shadow-lg space-y-3">
          <span class="text-2xl">🎭</span>
          <h2 class="font-serif text-lg font-bold text-[#ead397]">Fantasías Privadas</h2>
          <p class="text-xs font-sans text-[#f7f4ee]/70 leading-relaxed font-light">
            Canal confidencial con la dirección para coordinación de fantasías a medida, reservaciones de salones y atención personalizada.
          </p>
        </div>
      </div>

      <!-- Checkout Container con dLocal Go (Totalmente transparente sin marcas de terceros) -->
      <div class="max-w-xl mx-auto">
        <VipCheckout />
      </div>

      <!-- Promoción Estelar: Luna Llena = Primer Año Sin Costo -->
      <div class="p-8 sm:p-12 rounded-3xl bg-gradient-to-b from-[#250F22] via-[#140816] to-[#0a0608] border-2 border-[#c5a059] shadow-[0_0_45px_rgba(197,160,89,0.3)] space-y-6 text-center">
        <div class="inline-block px-4 py-1 rounded-full bg-[#c5a059] text-[#0a0608] text-xs font-serif font-bold uppercase tracking-wider">
          Oportunidad Única de Acceso
        </div>

        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[#ead397]">
          Asiste a la Noche de Luna Llena y Obtén tu Primer Año GRATIS
        </h2>

        <p class="text-xs sm:text-sm font-sans font-light text-[#f7f4ee]/85 max-w-xl mx-auto leading-relaxed">
          Quienes aseguren su entrada y asistan a nuestra gala oficial <em>Noche de Luna Llena Halloween</em> reciben de cortesía la activación de su primer año de membresía VIP sin ningún costo adicional.
        </p>

        <!-- Flyer Oficial Luna Llena Clickeable -->
        <a href="/the-corset-society/luna-llena" class="block max-w-xs mx-auto rounded-2xl overflow-hidden border border-[#c5a059]/50 shadow-2xl group">
          <img 
            src="/media/corset-society/flyer_halloween_clean.jpg" 
            alt="Flyer Oficial Luna Llena Halloween" 
            class="w-full object-cover group-hover:scale-105 transition-transform duration-500"
          />
        </a>

        <div>
          <a 
            href="/the-corset-society/luna-llena" 
            class="inline-block px-8 py-4 rounded-full font-serif font-bold uppercase tracking-wider text-xs bg-gradient-to-r from-[#c5a059] via-[#ead397] to-[#c5a059] text-[#050505] hover:brightness-110 shadow-[0_0_20px_rgba(197,160,89,0.4)] transition-all"
          >
            Reservar Entrada a Luna Llena ($100k-$120k COP) →
          </a>
        </div>
      </div>

      <!-- Formulario de Postulación de Admisión -->
      <div class="max-w-xl mx-auto pt-6 text-left">
        <div class="text-center mb-6">
          <span class="text-xs uppercase tracking-[0.25em] text-[#c5a059] font-bold block mb-1">Registro de Admisión</span>
          <h2 class="text-2xl font-serif font-bold text-[#ead397]">Postulación a la Lista de Espera VIP</h2>
          <p class="text-xs text-[#f7f4ee]/70 mt-1">
            Si prefieres postularte antes de adquirir la credencial, completa el siguiente formulario:
          </p>
        </div>
        <LeadForm 
          isVip={true}
          title="Solicitud de Admisión VIP"
          subtitle="La dirección evaluará tu postulación y te contactará directamente vía WhatsApp para coordinar la activación de tu credencial."
        />
      </div>

      <!-- Legal Footer -->
      <footer class="pt-16 pb-8 text-center text-[10px] font-sans text-[#f7f4ee]/30 tracking-widest uppercase space-y-2">
        <p>© {new Date().getFullYear()} The Corset Society • Línea de Alta Exclusividad de ElPlacerDC</p>
        <p>Línea Oficial: +57 319 419 4785 • Bogotá, Colombia</p>
      </footer>
    </main>
  </div>
</Layout>
