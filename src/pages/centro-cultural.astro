---
// centro-cultural.astro - Landing Centro Cultural El Placer de Compartir
import Layout from "../layouts/Layout.astro";
import AllianceForm from "../components/AllianceForm.astro";
import AmbassadorSection from "../components/AmbassadorSection.astro";
---

<Layout 
  title="Centro Cultural El Placer de Compartir | Talleres, Arte Sensorial y Encuentros en Bogotá"
  description="Nuevo espacio cultural en Bogotá dedicado a talleres de parejas, BDSM ético, masajes tántricos, nudismo consciente, organizadores de eventos para adultos y dating auténtico."
>
  <div class="pt-16 sm:pt-20 pb-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto space-y-16 sm:space-y-20">
    
    <!-- Hero Section con Diferenciación Radical Growth-Engine (No Bar Swinger / Sin Zonas Húmedas) -->
    <div class="text-center max-w-3xl mx-auto space-y-6 pt-6 sm:pt-10">
      <span class="inline-block px-4 py-1.5 rounded-full text-xs font-serif font-bold uppercase tracking-widest bg-[#b84a39]/20 text-[#ead397] border border-[#c5a059]/40 mb-2">
        Espacio Multidisciplinario • Bogotá
      </span>
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#f7f4ee] break-words">
        Centro Cultural <br />
        <span class="italic text-[#c5a059]">El Placer de Compartir</span>
      </h1>
      
      <!-- Growth-Engine Positioning Copy Desencasillado -->
      <div class="max-w-3xl mx-auto space-y-4 text-center">
        <p class="text-base sm:text-lg text-[#f7f4ee]/90 font-light leading-relaxed">
          El Centro Cultural de ElPlacerDC nace como un espacio seguro, lúcido y de alta estética concebido para una agenda semanal completa dirigida a comunidades de mente abierta.
        </p>
        <p class="text-sm sm:text-base text-[#f7f4ee]/80 leading-relaxed font-light">
          Entre semana nuestras puertas están abiertas para talleres formativos, masajes tántricos, Shibari, arte sensorial y encuentros íntimos de comunidad. Los fines de semana acogemos las fiestas temáticas y veladas específicas —propias y de nuestros aliados—. Aquí el consentimiento lúcido prima sobre el consumo inmediato. Y para que lo tengas presente, no somos un bar swinger tradicional ni contamos con zonas húmedas.
        </p>
      </div>

      <!-- Action Buttons Reordenados con Estilo Unificado -->
      <div class="pt-4 flex flex-wrap justify-center gap-3">
        <a 
          href="#proximos-eventos" 
          class="px-6 py-3 rounded-full bg-[#c5a059] text-[#180A1A] font-serif font-bold text-xs uppercase tracking-wider hover:bg-[#ead397] shadow-md transition-all"
        >
          Próximos Eventos
        </a>
        <a 
          href="/galeria-centro-cultural" 
          class="px-6 py-3 rounded-full border border-[#c5a059]/40 text-[#ead397] font-serif font-semibold text-xs uppercase tracking-wider hover:bg-[#c5a059]/10 transition-all"
        >
          Galería de Espacios 🏛️
        </a>
      </div>
    </div>

    <!-- Próximos Eventos -->
    <div id="proximos-eventos" class="space-y-8">
      <div class="text-center space-y-2">
        <span class="inline-block px-3 py-1 rounded-full text-xs uppercase tracking-widest text-[#c5a059] font-serif border border-[#c5a059]/30 mb-2">
          Agenda Exclusiva
        </span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#f7f4ee]">Próximos Eventos</h2>
      </div>

      <!-- Evento Propio: Oportunidad de conocer el nuevo lugar de ElPlacerDC -->
      <a href="/eventos/sitio-9-oct" class="block group max-w-4xl mx-auto rounded-3xl bg-[#250F22] border border-[#c5a059]/40 shadow-[0_4px_35px_rgba(89,31,38,0.25)] hover:shadow-[0_4px_35px_rgba(197,160,89,0.4)] transition-all overflow-hidden grid grid-cols-1 md:grid-cols-2 items-center">
        <div class="p-6 sm:p-8 space-y-4">
          <span class="inline-block px-3 py-1 rounded-full text-xs uppercase tracking-widest text-[#c5a059] font-serif font-bold border border-[#c5a059]/30 mb-1">
            Evento Oficial ElPlacerDC
          </span>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold text-[#ead397] group-hover:text-white transition-colors">
            Viernes 9 de Octubre
          </h3>
          <p class="text-xs sm:text-sm text-[#f7f4ee]/85 leading-relaxed font-light">
            Tu gran <strong>oportunidad de conocer el nuevo lugar de ElPlacerDC</strong>. Un encuentro diseñado para explorar las nuevas instalaciones, compartir entre personas afines y disfrutar de una atmósfera de libertad sin presiones.
          </p>
          <div class="pt-2 flex flex-wrap gap-3">
            <span class="px-5 py-2.5 rounded-full bg-[#c5a059] text-[#180A1A] font-serif font-bold text-xs uppercase tracking-wider group-hover:bg-[#ead397] transition-all">
              Ver Detalles y Reservar
            </span>
          </div>
        </div>
        <div class="p-4 sm:p-6 flex justify-center bg-[#1E0A1A]">
          <img 
            src="/media/eventos-elplacerdc/viernes-9-octubre-sitio.jpg" 
            alt="Viernes 9 de Octubre" 
            class="rounded-2xl max-h-[480px] w-full object-contain border border-[#c5a059]/30 shadow-lg group-hover:scale-105 transition-transform duration-500"
          />
        </div>
      </a>

      <!-- Evento Aliado: Impacto Producciones con Paleta Más Oscura y Elegante -->
      <a href="/eventos/impacto-10-oct" class="block group max-w-4xl mx-auto rounded-3xl bg-[#1E0C24] border border-[#8E4A8C]/40 shadow-[0_4px_35px_rgba(142,74,140,0.2)] hover:shadow-[0_4px_35px_rgba(142,74,140,0.35)] transition-all overflow-hidden grid grid-cols-1 md:grid-cols-2 items-center">
        <div class="p-6 sm:p-8 space-y-4">
          <span class="inline-block px-3 py-1 rounded-full text-xs uppercase tracking-widest text-[#f3e5f5] font-serif font-bold bg-[#8E4A8C]/20 border border-[#8E4A8C]/40 mb-1">
            Evento Aliado
          </span>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold text-[#f3e5f5] group-hover:text-white transition-colors">
            Impacto Producciones - Sábado 10
          </h3>
          <p class="text-xs sm:text-sm text-[#f7f4ee]/80 leading-relaxed font-light">
            Nuestros aliados de Impacto Producciones se toman la casa. Una noche distinta con música, shows y performances en vivo en nuestro escenario central.
          </p>
          <div class="pt-2 flex flex-wrap gap-3">
            <span class="px-5 py-2.5 rounded-full bg-[#8E4A8C] hover:bg-[#a35da1] text-white font-serif font-bold text-xs uppercase tracking-wider transition-all shadow-md">
              Ver Detalles y Reservar
            </span>
          </div>
        </div>
        <div class="p-4 sm:p-6 flex justify-center bg-[#200d28]/60">
          <img 
            src="/media/eventos-aliados/sabado-10-octubre_impacto-producciones.jpg" 
            alt="Sábado 10 de Octubre" 
            class="rounded-2xl max-h-[480px] w-full object-contain border border-[#8E4A8C]/30 shadow-lg group-hover:scale-105 transition-transform duration-500"
          />
        </div>
      </a>

      <!-- Evento Luna Llena (The Corset Society) -->
      <a href="/the-corset-society/luna-llena" class="block group max-w-4xl mx-auto rounded-3xl bg-gradient-to-br from-[#260e2a] to-[#200d28] border border-[#c5a059]/50 shadow-[0_4px_35px_rgba(197,160,89,0.2)] hover:shadow-[0_4px_35px_rgba(197,160,89,0.4)] transition-all overflow-hidden grid grid-cols-1 md:grid-cols-2 items-center">
        <div class="p-6 sm:p-8 space-y-4">
          <span class="inline-block px-3 py-1 rounded-full text-xs uppercase tracking-widest text-[#ead397] font-serif font-bold bg-[#c5a059]/20 border border-[#c5a059]/40 mb-1">
            🌕 The Corset Society • Gala de Misterio
          </span>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold text-[#ead397] group-hover:text-white transition-colors">
            Noche de Luna Llena — Halloween
          </h3>
          <p class="text-xs sm:text-sm text-[#f7f4ee]/85 leading-relaxed font-light">
            Máscarada exclusiva en nuestro Centro Cultural. Gala Noir, antifaces y misterio en las noches de luna llena. Tu asistencia incluye el primer año de membresía VIP gratis.
          </p>
          <div class="pt-2 flex flex-wrap gap-3">
            <span class="px-5 py-2.5 rounded-full bg-gradient-to-r from-[#c5a059] to-[#ead397] text-[#050505] font-serif font-bold text-xs uppercase tracking-wider hover:brightness-110 transition-all shadow-md">
              Ver Tarifas y Reservar Entrada
            </span>
          </div>
        </div>
        <div class="p-4 sm:p-6 flex justify-center bg-[#1c081e]/80">
          <img 
            src="/media/corset-society/flyer_halloween_clean.jpg" 
            alt="Noche de Luna Llena Halloween" 
            class="rounded-2xl max-h-[480px] w-full object-contain border border-[#c5a059]/40 shadow-lg group-hover:scale-105 transition-transform duration-500"
          />
        </div>
      </a>

      <!-- Botón 'Postularme como Aliado' ubicado debajo de la sección de eventos -->
      <div class="text-center pt-2">
        <a 
          href="#postulacion" 
          class="inline-block px-8 py-3.5 rounded-full bg-[#c5a059] text-[#180A1A] font-serif font-bold text-xs uppercase tracking-wider hover:bg-[#ead397] shadow-md transition-all"
        >
          Postularme como Aliado
        </a>
      </div>
    </div>

    <!-- Actividades & Alianzas con Párrafo Descriptivo Incorporado -->
    <div class="space-y-6">
      <div class="text-center space-y-3 max-w-3xl mx-auto">
        <span class="inline-block px-3 py-1 rounded-full text-xs uppercase tracking-widest text-[#c5a059] font-serif border border-[#c5a059]/30 mb-1">
          Áreas de Colaboración & Talleres
        </span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#f7f4ee]">Ecosistema Multidisciplinario</h2>
        
        <!-- Párrafo descriptivo con eventos mente abierta y realizas masajes -->
        <p class="text-xs sm:text-sm text-[#f7f4ee]/80 font-light leading-relaxed">
          ¿Organizas eventos mente abierta, facilitas talleres de tantra o BDSM ético, realizas masajes o buscas una locación singular en Bogotá <strong>para tus fantasías</strong>? Déjanos tu propuesta para coordinar fechas y producción.
        </p>
        <div>
          <a href="#postulacion" class="inline-flex items-center gap-1.5 text-xs text-[#ead397] hover:text-[#c5a059] underline font-medium">
            Completar formulario de alianza directa →
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 rounded-xl bg-[#250F22] border border-[#c5a059]/25 shadow-md space-y-3">
          <span class="text-2xl">🌿</span>
          <h3 class="font-serif text-lg font-bold text-[#ead397]">Masajes & Tacto Consciente</h3>
          <p class="text-xs text-[#f7f4ee]/70 leading-relaxed font-light">
            Talleres de masaje tántrico, desensibilización sensorial y desbloqueo emocional guiados por terapeutas certificados.
          </p>
        </div>

        <div class="p-6 rounded-xl bg-[#250F22] border border-[#c5a059]/25 shadow-md space-y-3">
          <span class="text-2xl">⛓️</span>
          <h3 class="font-serif text-lg font-bold text-[#ead397]">BDSM Ético & Shibari</h3>
          <p class="text-xs text-[#f7f4ee]/70 leading-relaxed font-light">
            Cuerdas japonesas, dinámicas de poder acordadas, protocolos de seguridad SSC (Sano, Seguro y Consentido).
          </p>
        </div>

        <div class="p-6 rounded-xl bg-[#250F22] border border-[#c5a059]/25 shadow-md space-y-3">
          <span class="text-2xl">✨</span>
          <h3 class="font-serif text-lg font-bold text-[#ead397]">Nudismo Social & Conexión</h3>
          <p class="text-xs text-[#f7f4ee]/70 leading-relaxed font-light">
            Espacio seguro de desnudamiento libre de connotaciones sexuales obligatorias. Normalización del cuerpo en su estado natural.
          </p>
        </div>

        <div class="p-6 rounded-xl bg-[#250F22] border border-[#c5a059]/40 shadow-md space-y-3">
          <span class="text-2xl">🥂</span>
          <h3 class="font-serif text-lg font-bold text-[#c5a059]">Organizadores de Eventos Mente Abierta</h3>
          <p class="text-xs text-[#f7f4ee]/70 leading-relaxed font-light">
            Coproducción de galas privadas, fiestas temáticas, salones de networking swinger y experiencias para adultos con criterios éticos y logística segura.
          </p>
        </div>
      </div>
    </div>

    <!-- Sección de Embajadores ubicada ANTES del formulario de alianzas -->
    <AmbassadorSection />

    <!-- Formulario para Aliados, Terapeutas y Organizadores -->
    <div id="postulacion" class="max-w-2xl mx-auto">
      <AllianceForm 
        title="Alianzas, Talleres & Contratación de Sede"
      />
    </div>

    <!-- Botón de 'Ver Eventos Anteriores' ubicado DESPUÉS del formulario de aliados -->
    <div class="text-center pt-4">
      <a href="/eventos-realizados" class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-white/20 text-white hover:bg-white/10 text-xs font-serif font-semibold tracking-wider uppercase transition-colors">
        <span>Ver Eventos Anteriores</span>
        <span>→</span>
      </a>
    </div>

  </div>
</Layout>
