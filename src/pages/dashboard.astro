---
// src/pages/dashboard.astro - Panel de Embajadores El Placer de Compartir
import Layout from "../layouts/Layout.astro";
import AmbassadorLogin from "../components/AmbassadorLogin.astro";
---

<Layout title="Panel de Embajadores — El Placer de Compartir" isCorset={false}>
  <main class="min-h-screen bg-[#0d050f] text-[#f7f4ee] py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[#ead397] tracking-wide">
          Panel de Control de Embajador
        </h1>
        <p class="text-sm text-[#f7f4ee]/70 mt-2 max-w-xl mx-auto">
          Monitorea el alcance de tu enlace, tus registros generados y el estado de tus entradas gratuitas ganadas.
        </p>
      </div>

      <!-- Auth Gate Container -->
      <div id="unauthenticated-view">
        <AmbassadorLogin />
      </div>

      <!-- Authenticated Dashboard View -->
      <div id="authenticated-view" class="hidden space-y-8">
        
        <!-- Welcome Bar -->
        <div class="flex flex-col sm:flex-row items-center justify-between p-6 rounded-2xl bg-[#140816] border border-[#c5a059]/30 shadow-lg gap-4">
          <div>
            <span class="text-xs text-[#c5a059] uppercase tracking-widest font-semibold block">Embajador Activo</span>
            <div class="flex flex-wrap items-baseline gap-2.5">
              <a href="#section-profile-settings" class="hover:text-[#ead397] transition-colors group flex items-center gap-1.5" title="Ir a ajustes de perfil">
                <h2 id="ambassador-name" class="text-xl font-serif font-bold text-[#f7f4ee] group-hover:text-[#ead397]">Cargando...</h2>
                <span class="text-xs text-[#c5a059]/70 group-hover:text-[#ead397]">⚙️</span>
              </a>
              <a href="#section-custom-code" class="text-xs text-[#c5a059] hover:text-[#ead397] underline underline-offset-2 transition-colors font-medium">
                Editar alias de enlace / referido →
              </a>
              <a href="#section-profile-settings" class="text-xs text-[#c5a059]/70 hover:text-[#ead397] underline underline-offset-2 transition-colors">
                Ajustes de perfil →
              </a>
            </div>
            <p id="ambassador-contact" class="text-xs text-[#f7f4ee]/50 mt-0.5 font-mono"></p>
          </div>
          <div class="flex items-center gap-2">
            <button 
              id="btn-refresh" 
              class="px-3.5 py-2 rounded-lg text-xs uppercase tracking-wider font-semibold border border-[#c5a059]/40 text-[#ead397] hover:bg-[#c5a059]/20 transition-all flex items-center gap-1.5"
              title="Actualizar datos"
            >
              <span id="refresh-icon">↻</span> Actualizar
            </button>
            <button 
              id="btn-logout" 
              class="px-4 py-2 rounded-lg text-xs uppercase tracking-wider font-semibold border border-[#c5a059]/30 text-[#f7f4ee]/70 hover:text-[#f7f4ee] hover:border-[#c5a059] transition-all"
            >
              Cerrar Sesión
            </button>
          </div>
        </div>

        <!-- VIP Membership & Privileges Card -->
        <div id="vip-status-card" class="p-5 rounded-2xl bg-[#140816] border border-[#c5a059]/30 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <div id="vip-status-icon" class="w-10 h-10 rounded-xl bg-[#c5a059]/20 border border-[#c5a059]/40 flex items-center justify-center text-lg shrink-0">
              👑
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="text-xs uppercase tracking-wider text-[#f7f4ee]/60">Membresía Exclusiva</span>
                <span id="vip-status-badge" class="px-2 py-0.5 rounded text-[10px] font-bold"></span>
              </div>
              <p id="vip-status-desc" class="text-xs text-[#f7f4ee]/80 mt-0.5"></p>
            </div>
          </div>
          <div id="vip-action-container" class="w-full sm:w-auto shrink-0">
            <!-- CTA Button injected via JS -->
          </div>
        </div>

        <!-- 3 Primary Metric Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="p-5 rounded-2xl bg-[#140816]/90 border border-[#c5a059]/30 text-center">
            <span class="text-xs uppercase tracking-wider text-[#f7f4ee]/60 block mb-1">Registros con tu Enlace</span>
            <span id="metric-leads" class="text-3xl font-serif font-bold text-[#ead397]">0</span>
            <span class="text-[10px] text-[#f7f4ee]/40 block mt-1">Personas registradas con tu link</span>
          </div>

          <div class="p-5 rounded-2xl bg-[#140816]/90 border border-[#c5a059]/30 text-center">
            <span class="text-xs uppercase tracking-wider text-[#f7f4ee]/60 block mb-1">Entradas Compradas</span>
            <span id="metric-purchases" class="text-3xl font-serif font-bold text-[#81c784]">0</span>
            <span class="text-[10px] text-[#f7f4ee]/40 block mt-1">Compras realizadas desde tu enlace</span>
          </div>

          <div class="p-5 rounded-2xl bg-[#140816]/90 border border-[#c5a059]/30 text-center">
            <span class="text-xs uppercase tracking-wider text-[#f7f4ee]/60 block mb-1">Entradas Ganadas</span>
            <span id="metric-tickets" class="text-3xl font-serif font-bold text-[#e57373]">0</span>
            <span class="text-[10px] text-[#f7f4ee]/40 block mt-1 whitespace-nowrap">3 compras = 1 entrada (máx. 3 entradas)</span>
          </div>
        </div>

        <!-- Reward Milestone Tracker -->
        <div class="p-6 rounded-2xl bg-gradient-to-r from-[#250F22] to-[#140816] border border-[#c5a059]/40 relative overflow-hidden">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <span class="text-xs uppercase tracking-[0.2em] text-[#c5a059] font-bold block mb-1">Incentivo Exclusivo</span>
              <h3 class="text-lg font-serif font-bold text-[#ead397] flex flex-wrap items-center gap-1.5">
                <span>Regla de Recompensas:</span>
                <span class="whitespace-nowrap text-[#c5a059]">3 compras = 1 entrada gratuita</span>
              </h3>
              <p class="text-xs text-[#f7f4ee]/70 mt-1 max-w-lg leading-relaxed">
                Por cada 3 compras de entradas generadas con tu enlace, el sistema activa automáticamente tu entrada gratuita para eventos oficiales de ElPlacerDC o veladas de The Corset Society (hasta un máximo de 3 entradas gratuitas).
              </p>
              <p class="text-[11px] text-[#ead397]/90 mt-2 border-t border-[#c5a059]/20 pt-2 leading-relaxed">
                🎁 <em>A partir de 9 ventas referidas, cada nueva compra te otorga un 10% de descuento no acumulable para la compra de tus propias entradas.</em>
              </p>
              <p class="text-[11px] text-[#f7f4ee]/50 mt-1 italic">
                * Para redimir tu entrada en veladas de The Corset Society, es indispensable contar con membresía VIP activa (<a href="/the-corset-society" class="underline text-[#c5a059] hover:text-[#ead397]">solicítala aquí</a>).
              </p>
            </div>
            <div id="reward-badge-container" class="text-right shrink-0">
              <!-- Rendered via JS -->
            </div>
          </div>

          <!-- Progress Bar -->
          <div class="mt-4 pt-4 border-t border-[#c5a059]/20">
            <div class="flex justify-between text-xs text-[#f7f4ee]/60 mb-1">
              <span>Progreso hacia tu próxima entrada gratuita</span>
              <span id="reward-progress-text" class="font-mono text-[#ead397]">0 / 3 compras</span>
            </div>
            <div class="w-full h-2.5 bg-[#0a0608] rounded-full overflow-hidden border border-[#c5a059]/20">
              <div id="reward-progress-bar" class="h-full bg-gradient-to-r from-[#c5a059] to-[#ead397] transition-all duration-500" style="width: 0%"></div>
            </div>
          </div>
        </div>

        <!-- Section: Registros Acreditados (FIRST) -->
        <div id="section-registros" class="p-6 sm:p-8 rounded-2xl bg-[#140816] border border-[#c5a059]/30 space-y-4">
          <div class="flex items-center justify-between border-b border-[#c5a059]/20 pb-3">
            <div>
              <h3 class="text-lg font-serif font-bold text-[#ead397]">Registros Acreditados</h3>
              <p class="text-xs text-[#f7f4ee]/60">Personas que ingresaron y se registraron en la comunidad a través de tu enlace exclusivo.</p>
            </div>
            <span id="referred-leads-count" class="text-xs font-mono px-3 py-1 rounded-full bg-[#c5a059]/20 text-[#ead397] border border-[#c5a059]/30 font-bold">0</span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead>
                <tr class="text-[#f7f4ee]/50 border-b border-[#c5a059]/10">
                  <th class="py-2.5 px-3">Usuario Acreditado</th>
                  <th class="py-2.5 px-3">Estado de Compra</th>
                  <th class="py-2.5 px-3 text-right">Fecha de Registro</th>
                </tr>
              </thead>
              <tbody id="referred-leads-body" class="divide-y divide-[#c5a059]/10 text-[#f7f4ee]/80 font-mono">
                <tr>
                  <td colspan="3" class="py-4 text-center text-[#f7f4ee]/40 font-sans">No hay registros acreditados aún. Comparte tu enlace para comenzar a sumar.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Section: Tu Enlace de Afiliado Exclusivo -->
        <div id="section-custom-code" class="p-6 sm:p-8 rounded-2xl bg-[#140816] border border-[#c5a059]/30 space-y-6">
          <div class="flex items-center justify-between border-b border-[#c5a059]/20 pb-4">
            <div>
              <h3 class="text-lg font-serif font-bold text-[#ead397]">Tu Enlace de Afiliado Exclusivo</h3>
            </div>
            <span class="text-xs text-[#81c784] font-medium flex items-center gap-1">
              <span class="w-2 h-2 rounded-full bg-[#81c784] animate-pulse"></span> Activo y comisionable
            </span>
          </div>

          <!-- 1. Custom Code Editor (Optimized for Mobile & Desktop) -->
          <div class="space-y-3">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
              <span class="text-[11px] text-[#f7f4ee]/50 font-mono hidden sm:inline">Mínimo 3 caracteres alfanuméricos</span>
            </div>
            <p class="text-xs text-[#f7f4ee]/70 leading-relaxed">
              Modifica tu alias personalizado para que tu enlace sea fácil de recordar al compartirlo con tus contactos.
            </p>

            <div class="space-y-3 pt-1">
              <!-- Mobile friendly adaptive input box -->
              <div class="bg-[#0a0608] border border-[#c5a059]/40 rounded-xl p-3 sm:py-2 sm:px-4 focus-within:border-[#c5a059] focus-within:ring-1 focus-within:ring-[#c5a059] transition-all shadow-inner">
                <!-- Mobile top pill: shows domain context cleanly without clipping -->
                <div class="flex items-center justify-between pb-2 mb-2 border-b border-[#c5a059]/20 sm:hidden">
                  <span class="text-[10px] uppercase font-bold text-[#c5a059] tracking-wider">Prefijo de tu enlace</span>
                  <span class="text-[11px] text-[#f7f4ee]/50 font-mono">elplacerdecompartir.com/?ref=</span>
                </div>
                
                <div class="flex items-center">
                  <!-- Desktop inline prefix -->
                  <span class="hidden sm:inline text-xs text-[#f7f4ee]/40 font-mono pr-1 select-none">
                    elplacerdecompartir.com/?ref=
                  </span>
                  <input 
                    type="text" 
                    id="input-new-code" 
                    placeholder="tu-alias" 
                    class="w-full sm:flex-1 bg-transparent py-1.5 px-0 text-base sm:text-sm text-[#ead397] font-mono font-bold focus:outline-none min-w-0 placeholder-[#f7f4ee]/30"
                    autocomplete="off"
                    autocapitalize="none"
                    spellcheck="false"
                  />
                </div>
              </div>

              <!-- Button & feedback row -->
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <p id="code-update-feedback" class="text-xs min-h-[16px] font-medium order-2 sm:order-1"></p>
                <button 
                  id="btn-update-code" 
                  type="button"
                  class="w-full sm:w-auto order-1 sm:order-2 px-6 py-3 rounded-xl text-xs uppercase tracking-wider font-bold bg-[#c5a059] text-[#0a0608] hover:bg-[#ead397] transition-all shadow-md active:scale-95 text-center cursor-pointer"
                >
                  Guardar Nuevo Alias
                </button>
              </div>
            </div>
          </div>

          <!-- 2. Share Actions (SECOND inside this section, no raw URL text input) -->
          <div class="pt-6 border-t border-[#c5a059]/20 space-y-3">
            <h4 class="text-sm font-semibold text-[#f7f4ee]/80">Compartir tu Enlace</h4>
            <div class="flex flex-wrap gap-3">
              <button 
                id="btn-copy-url" 
                class="px-5 py-3 rounded-lg text-xs uppercase tracking-wider font-bold bg-[#c5a059] text-[#0a0608] hover:bg-[#ead397] transition-all flex items-center gap-2 shadow-md"
              >
                Copiar Enlace
              </button>
              <a 
                id="btn-share-wa" 
                href="#" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="px-5 py-3 rounded-lg text-xs uppercase tracking-wider font-bold bg-[#2e7d32] text-[#f7f4ee] hover:bg-[#388e3c] transition-all flex items-center justify-center gap-2 shadow-md"
              >
                Compartir por WhatsApp
              </a>
              <a 
                id="btn-share-x" 
                href="#" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="px-5 py-3 rounded-lg text-xs uppercase tracking-wider font-bold bg-[#050505] text-[#f7f4ee] border border-[#c5a059]/40 hover:bg-[#c5a059]/20 transition-all flex items-center justify-center gap-2 shadow-md"
              >
                Compartir en X (x.com)
              </a>
            </div>
          </div>
        </div>

        <!-- Section: Ajustes de Perfil / Modificar Datos Oficiales -->
        <div id="section-profile-settings" class="scroll-mt-24 p-6 sm:p-8 rounded-2xl bg-[#140816] border border-[#c5a059]/30 space-y-6">
          <div class="flex items-center justify-between border-b border-[#c5a059]/20 pb-4">
            <div>
              <h3 class="text-lg font-serif font-bold text-[#ead397]">Ajustes de Perfil</h3>
              <p class="text-xs text-[#f7f4ee]/60 mt-0.5">Modifica tu alias, modalidad/rol o ciudad oficial para adaptar tus entradas y membresía.</p>
            </div>
            <span class="text-xs text-[#c5a059] font-mono flex items-center gap-1.5">
              <span>👤</span> Perfil de Miembro
            </span>
          </div>

          <form id="profile-settings-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Alias / Nombre -->
              <div class="space-y-1.5">
                <label for="profile-alias" class="block text-xs font-semibold text-[#c5a059] uppercase tracking-wider">
                  Alias / Pseudónimo
                </label>
                <input 
                  type="text" 
                  id="profile-alias" 
                  name="alias_nombre" 
                  placeholder="Tu alias" 
                  class="w-full px-4 py-2.5 rounded-xl bg-[#0a0608] border border-[#c5a059]/30 text-xs text-[#f7f4ee] focus:outline-none focus:border-[#ead397] font-sans"
                />
              </div>

              <!-- Correo Electrónico -->
              <div class="space-y-1.5">
                <label for="profile-email" class="block text-xs font-semibold text-[#c5a059] uppercase tracking-wider">
                  Correo Electrónico
                </label>
                <input 
                  type="email" 
                  id="profile-email" 
                  name="email" 
                  placeholder="tu@correo.com" 
                  class="w-full px-4 py-2.5 rounded-xl bg-[#0a0608] border border-[#c5a059]/30 text-xs text-[#f7f4ee] focus:outline-none focus:border-[#ead397] font-sans"
                />
              </div>

              <!-- Modalidad / Rol -->
              <div class="space-y-1.5">
                <label for="profile-rol" class="block text-xs font-semibold text-[#c5a059] uppercase tracking-wider">
                  Modalidad / Rol
                </label>
                <select 
                  id="profile-rol" 
                  name="rol" 
                  class="w-full px-4 py-2.5 rounded-xl bg-[#0a0608] border border-[#c5a059]/30 text-xs text-[#f7f4ee] focus:outline-none focus:border-[#ead397] font-sans"
                >
                  <option value="pareja">👫 Pareja</option>
                  <option value="mujer_sola">🦄 Mujer Sola (Unicornio)</option>
                  <option value="hombre_solo">🙋‍♂️ Hombre Solo (Single)</option>
                </select>
                <span class="text-[10px] text-[#f7f4ee]/50 block">Define las opciones de entradas a eventos que se mostrarán en la plataforma.</span>
              </div>

              <!-- Ciudad -->
              <div class="space-y-1.5">
                <label for="profile-ciudad" class="block text-xs font-semibold text-[#c5a059] uppercase tracking-wider">
                  Ciudad
                </label>
                <select 
                  id="profile-ciudad" 
                  name="ciudad" 
                  class="w-full px-4 py-2.5 rounded-xl bg-[#0a0608] border border-[#c5a059]/30 text-xs text-[#f7f4ee] focus:outline-none focus:border-[#ead397] font-sans"
                >
                  <option value="Bogotá">Bogotá</option>
                  <option value="Medellín">Medellín</option>
                  <option value="Otra">Otra ciudad</option>
                </select>
              </div>
            </div>

            <div id="profile-update-feedback" class="hidden text-xs p-3 rounded-lg"></div>

            <div class="pt-2 flex justify-end">
              <button 
                type="submit" 
                id="btn-save-profile" 
                class="px-6 py-2.5 rounded-full font-serif font-bold uppercase tracking-wider text-xs bg-gradient-to-r from-[#c5a059] to-[#ead397] text-[#0a0608] hover:brightness-110 transition-all shadow-md cursor-pointer"
              >
                Guardar Cambios de Perfil
              </button>
            </div>
          </form>
        </div>

      </div>

    </div>
  </main>
</Layout>

<script>
  const unauthView = document.getElementById("unauthenticated-view");
  const authView = document.getElementById("authenticated-view");
  const ambassadorName = document.getElementById("ambassador-name");
  const ambassadorContact = document.getElementById("ambassador-contact");
  const metricLeads = document.getElementById("metric-leads");
  const metricPurchases = document.getElementById("metric-purchases");
  const metricTickets = document.getElementById("metric-tickets");
  const btnCopyUrl = document.getElementById("btn-copy-url");
  const btnShareWa = document.getElementById("btn-share-wa") as HTMLAnchorElement | null;
  const btnShareX = document.getElementById("btn-share-x") as HTMLAnchorElement | null;
  const inputNewCode = document.getElementById("input-new-code") as HTMLInputElement | null;
  const btnUpdateCode = document.getElementById("btn-update-code");
  const codeUpdateFeedback = document.getElementById("code-update-feedback");
  const btnLogout = document.getElementById("btn-logout");
  const btnRefresh = document.getElementById("btn-refresh");
  const refreshIcon = document.getElementById("refresh-icon");
  const rewardProgressBar = document.getElementById("reward-progress-bar");
  const rewardProgressText = document.getElementById("reward-progress-text");
  const rewardBadgeContainer = document.getElementById("reward-badge-container");

  let currentAlias = "";
  let activeShareUrl = "";

  async function loadDashboard() {
    const sessionIdentifier = localStorage.getItem("ambassador_session_phone");
    if (!sessionIdentifier) {
      unauthView?.classList.remove("hidden");
      authView?.classList.add("hidden");
      return;
    }

    if (refreshIcon) refreshIcon.classList.add("animate-spin");

    try {
      const res = await fetch(`/api/affiliates/stats?identifier=${encodeURIComponent(sessionIdentifier)}`);
      const data = await res.json();

      if (data.success && data.stats) {
        const stats = data.stats;
        currentAlias = stats.alias;

        unauthView?.classList.add("hidden");
        authView?.classList.remove("hidden");

        if (ambassadorName) ambassadorName.textContent = `@${stats.alias}`;
        if (ambassadorContact) ambassadorContact.textContent = stats.whatsapp || stats.email || "";

        // Pre-llenar campos de ajustes de perfil
        const profileAlias = document.getElementById("profile-alias") as HTMLInputElement | null;
        const profileEmail = document.getElementById("profile-email") as HTMLInputElement | null;
        const profileRol = document.getElementById("profile-rol") as HTMLSelectElement | null;
        const profileCiudad = document.getElementById("profile-ciudad") as HTMLSelectElement | null;

        if (profileAlias) profileAlias.value = stats.alias_nombre || stats.nombre || stats.alias || "";
        if (profileEmail) profileEmail.value = stats.email || "";
        if (profileRol && stats.rol) profileRol.value = stats.rol;
        if (profileCiudad && stats.ciudad) profileCiudad.value = stats.ciudad;
        const profile = {
          alias: stats.alias,
          alias_nombre: stats.alias_nombre || stats.nombre || stats.alias,
          whatsapp: stats.whatsapp || sessionIdentifier,
          email: stats.email || "",
          rol: stats.rol || "",
          ciudad: stats.ciudad || "",
        };
        localStorage.setItem("user_profile", JSON.stringify(profile));
        localStorage.setItem("user_phone", profile.whatsapp);
        localStorage.setItem("user_alias", profile.alias_nombre);
        if (profile.email) localStorage.setItem("user_email", profile.email);
        if (stats.rol) {
          localStorage.setItem("user_role", stats.rol);
        }
        if (stats.vipStatus) {
          localStorage.setItem("user_vip_status", stats.vipStatus);
        }
        if (stats.referredBy) {
          try {
            localStorage.setItem("affiliate_ref", stats.referredBy);
            document.cookie = `affiliate_ref=${encodeURIComponent(stats.referredBy)}; path=/; max-age=2592000; SameSite=Lax`;
          } catch (_) {}
        }

        if (metricLeads) metricLeads.textContent = stats.leadsCount.toString();
        if (metricPurchases) metricPurchases.textContent = stats.purchasesCount.toString();
        if (metricTickets) metricTickets.textContent = stats.freeTicketsEarned.toString();

        activeShareUrl = `https://elplacerdecompartir.com/?ref=${stats.alias}`;
        if (inputNewCode) inputNewCode.value = stats.alias;

        if (btnShareWa) {
          const waMsg = encodeURIComponent(`¡Hola! Te invito a conocer El Placer de Compartir y The Corset Society: ${activeShareUrl}`);
          btnShareWa.href = `https://wa.me/?text=${waMsg}`;
        }

        if (btnShareX) {
          const xMsg = encodeURIComponent(`Te invito a conocer El Placer de Compartir y The Corset Society: ${activeShareUrl}`);
          btnShareX.href = `https://x.com/intent/tweet?text=${xMsg}`;
        }

        // Render VIP status card
        const vipBadge = document.getElementById("vip-status-badge");
        const vipDesc = document.getElementById("vip-status-desc");
        const vipActionContainer = document.getElementById("vip-action-container");
        const vipStatus = stats.vipStatus || "no_vip";

        if (vipStatus === "vip_activo") {
          if (vipBadge) {
            vipBadge.className = "px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-[#81c784]/20 text-[#81c784] border border-[#81c784]/40";
            vipBadge.textContent = "Eres VIP";
          }
          if (vipDesc) vipDesc.textContent = "Membresía anual activa. Cuentas con 20% de descuento permanente en todas las entradas y tu enlace otorga 20% de beneficio en primera compra a tus referidos.";
          if (vipActionContainer) {
            vipActionContainer.innerHTML = `
              <div class="flex flex-wrap gap-2 justify-center sm:justify-start">
                <a href="/the-corset-society/luna-llena" class="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-[#c5a059] text-[#0a0608] text-xs font-bold uppercase tracking-wider hover:bg-[#ead397] transition-all inline-block text-center shadow-md">
                  Próximo Evento Corset 🌕
                </a>
                <a href="/corset-vip" class="w-full sm:w-auto px-4 py-2.5 rounded-xl border border-[#c5a059]/40 text-[#ead397] hover:bg-[#c5a059]/10 text-xs font-bold uppercase tracking-wider transition-all inline-block text-center">
                  Ver Beneficios VIP 💎
                </a>
              </div>
            `;
          }
        } else if (vipStatus === "posible_vip") {
          if (vipBadge) {
            vipBadge.className = "px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-[#c5a059]/20 text-[#ead397] border border-[#c5a059]/40";
            vipBadge.textContent = "Postulación Radicada";
          }
          if (vipDesc) vipDesc.textContent = "Tu solicitud a The Corset Society está registrada. Activa tu credencial oficial para gozar de descuentos y accesos de honor.";
          if (vipActionContainer) {
            const effectiveRef = stats.referredBy ||
              localStorage.getItem("affiliate_ref") ||
              (document.cookie.match(/(?:^|;\s*)affiliate_ref=([^;]+)/)?.[1]) ||
              new URLSearchParams(window.location.search).get("ref");
            const isReferredUser = Boolean(effectiveRef);
            const isVipDiscount = Boolean(
              stats.isReferrerVip ||
              (effectiveRef && effectiveRef.toLowerCase() === "segisw")
            );

            const vipPriceDisplay = isReferredUser 
              ? (isVipDiscount ? "$159.200 COP" : "$179.100 COP")
              : "$199.000 COP";

            const vipDiscountTag = isReferredUser
              ? (isVipDiscount 
                  ? ' <span class="text-[10px] bg-[#0a0608] text-[#81c784] px-2 py-0.5 rounded-full font-bold font-sans ml-1.5 shadow-sm inline-block">(-20% Embajador VIP)</span>'
                  : ' <span class="text-[10px] bg-[#0a0608] text-[#81c784] px-2 py-0.5 rounded-full font-bold font-sans ml-1.5 shadow-sm inline-block">(-10% Embajador)</span>')
              : '';

            vipActionContainer.innerHTML = `
              <a href="/corset-vip#vip-checkout-box" class="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#c5a059] to-[#ead397] text-[#0a0608] text-xs font-bold uppercase tracking-wider hover:brightness-110 transition-all inline-block text-center shadow-md">
                Hazte VIP (${vipPriceDisplay})${vipDiscountTag} →
              </a>
            `;
          }
        } else {
          if (vipBadge) {
            vipBadge.className = "px-2.5 py-0.5 rounded-full text-[10px] font-medium bg-[#f7f4ee]/10 text-[#f7f4ee]/60 border border-[#f7f4ee]/20";
            vipBadge.textContent = "Comunidad General";
          }
          if (vipDesc) vipDesc.textContent = "Accede a las veladas secretas de The Corset Society solicitando tu admisión al círculo exclusivo.";
          if (vipActionContainer) {
            const effectiveRef = stats.referredBy ||
              localStorage.getItem("affiliate_ref") ||
              (document.cookie.match(/(?:^|;\s*)affiliate_ref=([^;]+)/)?.[1]) ||
              new URLSearchParams(window.location.search).get("ref");
            const isReferredUser = Boolean(effectiveRef);
            const isVipDiscount = Boolean(
              stats.isReferrerVip ||
              (effectiveRef && effectiveRef.toLowerCase() === "segisw")
            );

            const vipPriceDisplay = isReferredUser 
              ? (isVipDiscount ? "$159.200 COP" : "$179.100 COP")
              : "$199.000 COP";

            const vipDiscountTag = isReferredUser
              ? (isVipDiscount 
                  ? ' <span class="text-[10px] bg-[#0a0608] text-[#81c784] px-2 py-0.5 rounded-full font-bold font-sans ml-1.5 shadow-sm inline-block">(-20% Descuento Embajador VIP)</span>'
                  : ' <span class="text-[10px] bg-[#0a0608] text-[#81c784] px-2 py-0.5 rounded-full font-bold font-sans ml-1.5 shadow-sm inline-block">(-10% Descuento Embajador)</span>')
              : '';

            vipActionContainer.innerHTML = `
              <a href="/the-corset-society" class="w-full sm:w-auto px-4 py-2.5 rounded-xl border border-[#c5a059]/60 text-[#ead397] hover:bg-[#c5a059]/20 text-xs font-bold uppercase tracking-wider transition-all inline-block text-center">
                Solicita VIP (${vipPriceDisplay})${vipDiscountTag} →
              </a>
            `;
          }
        }

        const referredLeadsBody = document.getElementById("referred-leads-body");
        const referredLeadsCount = document.getElementById("referred-leads-count");
        if (stats.referredLeads && stats.referredLeads.length > 0) {
          if (referredLeadsCount) referredLeadsCount.textContent = stats.referredLeads.length.toString();
          if (referredLeadsBody) {
            referredLeadsBody.innerHTML = stats.referredLeads.map((l: any) => `
              <tr>
                <td class="py-2.5 px-3 font-semibold text-[#ead397] font-mono">${l.email_masked || 'u****@privado.com'}</td>
                <td class="py-2.5 px-3">
                  ${l.compro_entrada 
                    ? '<span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#81c784]/20 text-[#81c784] border border-[#81c784]/40">✓ Entrada Acreditada</span>'
                    : '<span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] text-[#f7f4ee]/40 border border-[#f7f4ee]/10">Pendiente de compra</span>'
                  }
                </td>
                <td class="py-2.5 px-3 text-right text-[#f7f4ee]/50 text-[11px] font-mono">${new Date(l.created_at).toLocaleDateString('es-CO', { timeZone: 'America/Bogota' })}</td>
              </tr>
            `).join('');
          }
        } else if (referredLeadsBody) {
          if (referredLeadsCount) referredLeadsCount.textContent = "0";
          referredLeadsBody.innerHTML = `<tr><td colspan="3" class="py-4 text-center text-[#f7f4ee]/40 font-sans">No hay registros acreditados aún. Comparte tu enlace para comenzar a sumar.</td></tr>`;
        }

        // Calculate progress to next ticket without repeating text
        const totalPurchases = stats.purchasesCount || 0;
        const progressCount = totalPurchases % 3;
        const freeTickets = stats.freeTicketsEarned || 0;
        const maxReached = totalPurchases >= 9;

        if (maxReached) {
          if (rewardProgressBar) rewardProgressBar.style.width = "100%";
          if (rewardProgressText) rewardProgressText.textContent = "3 / 3 entradas alcanzadas (Máximo)";
        } else {
          const progressPercent = Math.min(100, Math.round((progressCount / 3) * 100));
          if (rewardProgressBar) rewardProgressBar.style.width = `${progressPercent}%`;
          if (rewardProgressText) rewardProgressText.textContent = `${progressCount} / 3 compras`;
        }

        // Display Active Rewards & Claim Button
        if (rewardBadgeContainer) {
          if (freeTickets > 0) {
            const claimUrl = `https://wa.me/573194194785?text=${encodeURIComponent(
              `¡Hola! Soy embajador con alias ${stats.alias}. Reclamo mi entrada de cortesía ganada (Cupón: VIP-FREE-${stats.alias.toUpperCase()}).`
            )}`;
            rewardBadgeContainer.innerHTML = `
              <div class="p-3 bg-[#c5a059]/20 border border-[#c5a059] rounded-xl text-center space-y-2">
                <span class="text-[10px] uppercase tracking-wider text-[#ead397] block font-bold">Cupón Desbloqueado (${freeTickets} ganada${freeTickets > 1 ? 's' : ''})</span>
                <span class="font-mono text-sm font-bold text-[#f7f4ee] select-all block">VIP-FREE-${stats.alias.toUpperCase()}</span>
                <a href="${claimUrl}" target="_blank" rel="noopener noreferrer" class="inline-block px-3 py-1.5 rounded-lg bg-[#2e7d32] text-white text-[11px] font-bold uppercase tracking-wider hover:bg-[#388e3c] transition-all">
                  Reclamar Entrada de Cortesía →
                </a>
              </div>
            `;
          } else if (maxReached) {
            rewardBadgeContainer.innerHTML = `
              <div class="p-3 bg-[#140816] border border-[#c5a059]/40 rounded-xl text-center">
                <span class="text-[10px] uppercase tracking-wider text-[#81c784] block font-bold">Nivel 10% Activado</span>
                <p class="text-[11px] text-[#ead397] mt-0.5">${stats.subsequentDiscounts || 0} compras adicionales acumuladas</p>
              </div>
            `;
          } else {
            rewardBadgeContainer.innerHTML = `
              <div class="p-3 bg-[#0a0608]/50 border border-[#c5a059]/20 rounded-xl text-center">
                <span class="text-xs text-[#f7f4ee]/50">Faltan ${3 - progressCount} compras</span>
              </div>
            `;
          }
        }

      } else {
        console.error("[Dashboard] Error al sincronizar estadísticas:", data?.error);
        if (res.status === 404) {
          localStorage.removeItem("ambassador_session_phone");
          unauthView?.classList.remove("hidden");
          authView?.classList.add("hidden");
        } else {
          // No cerrar sesion por error transitorio de servidor
          unauthView?.classList.add("hidden");
          authView?.classList.remove("hidden");
          if (ambassadorName) ambassadorName.textContent = "Error al sincronizar datos";
        }
      }
    } catch (e) {
      console.error("Error loading ambassador stats:", e);
    } finally {
      if (refreshIcon) refreshIcon.classList.remove("animate-spin");
      scrollToHashIfPresent();
    }
  }

  // Copy link
  btnCopyUrl?.addEventListener("click", () => {
    if (!activeShareUrl) return;
    navigator.clipboard.writeText(activeShareUrl).then(() => {
      const originalText = btnCopyUrl.textContent;
      btnCopyUrl.textContent = "¡Copiado!";
      setTimeout(() => {
        btnCopyUrl.textContent = originalText;
      }, 2000);
    });
  });

  // Update Code
  btnUpdateCode?.addEventListener("click", async () => {
    const newCode = inputNewCode?.value.trim().toLowerCase();
    if (!newCode || newCode.length < 3) {
      if (codeUpdateFeedback) {
        codeUpdateFeedback.className = "text-xs mt-2 text-[#ef5350]";
        codeUpdateFeedback.textContent = "El código debe tener al menos 3 caracteres alfanuméricos";
      }
      return;
    }

    if (newCode === currentAlias.toLowerCase()) {
      if (codeUpdateFeedback) {
        codeUpdateFeedback.className = "text-xs mt-2 text-[#ead397]";
        codeUpdateFeedback.textContent = "El código ya es el actual";
      }
      return;
    }

    try {
      const res = await fetch("/api/affiliates/update-code", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ oldCode: currentAlias, newCode }),
      });
      const data = await res.json();

      if (data.success) {
        currentAlias = data.newCode;
        activeShareUrl = `https://elplacerdecompartir.com/?ref=${currentAlias}`;
        if (codeUpdateFeedback) {
          codeUpdateFeedback.className = "text-xs mt-2 text-[#81c784]";
          codeUpdateFeedback.textContent = "✓ Código actualizado exitosamente";
        }
        loadDashboard();
      } else {
        if (codeUpdateFeedback) {
          codeUpdateFeedback.className = "text-xs mt-2 text-[#ef5350]";
          codeUpdateFeedback.textContent = data.error || "No se pudo actualizar el código";
        }
      }
    } catch (e: any) {
      if (codeUpdateFeedback) {
        codeUpdateFeedback.className = "text-xs mt-2 text-[#ef5350]";
        codeUpdateFeedback.textContent = "Error al actualizar código";
      }
    }
  });

  // Profile Settings Form Update
  const profileForm = document.getElementById("profile-settings-form");
  const btnSaveProfile = document.getElementById("btn-save-profile") as HTMLButtonElement | null;
  const profileFeedback = document.getElementById("profile-update-feedback");
  const profileAliasInput = document.getElementById("profile-alias") as HTMLInputElement | null;
  const profileEmailInput = document.getElementById("profile-email") as HTMLInputElement | null;
  const profileRolSelect = document.getElementById("profile-rol") as HTMLSelectElement | null;
  const profileCiudadSelect = document.getElementById("profile-ciudad") as HTMLSelectElement | null;

  async function handleProfileSave(e?: Event) {
    if (e) e.preventDefault();
    const sessionIdentifier = localStorage.getItem("ambassador_session_phone") || 
                              localStorage.getItem("user_phone") || 
                              localStorage.getItem("user_email") || 
                              currentAlias;
    if (!sessionIdentifier) {
      if (profileFeedback) {
        profileFeedback.className = "text-xs p-3 rounded-lg bg-[#b71c1c]/20 border border-[#b71c1c]/40 text-[#ef5350] block";
        profileFeedback.textContent = "Sesión no identificada. Por favor recarga la página o inicia sesión nuevamente.";
      }
      return;
    }

    if (btnSaveProfile) {
      btnSaveProfile.disabled = true;
      btnSaveProfile.textContent = "Guardando...";
    }

    try {
      const res = await fetch("/api/leads/update-profile", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          identifier: sessionIdentifier,
          alias_nombre: profileAliasInput?.value.trim(),
          email: profileEmailInput?.value.trim(),
          rol: profileRolSelect?.value,
          ciudad: profileCiudadSelect?.value,
        }),
      });
      const data = await res.json();
      if (data.success) {
        if (profileFeedback) {
          profileFeedback.className = "text-xs p-3 rounded-lg bg-[#2e7d32]/20 border border-[#81c784]/40 text-[#81c784] block";
          profileFeedback.textContent = "✓ Perfil actualizado exitosamente. Tus modalidades y entradas a eventos han sido sincronizadas.";
        }
        if (data.lead?.rol) {
          localStorage.setItem("user_role", data.lead.rol);
        }
        if (ambassadorName) {
          ambassadorName.textContent = currentAlias ? `@${currentAlias}` : (data.lead?.alias_nombre ? `@${data.lead.alias_nombre}` : "");
        }
      } else {
        if (profileFeedback) {
          profileFeedback.className = "text-xs p-3 rounded-lg bg-[#b71c1c]/20 border border-[#b71c1c]/40 text-[#ef5350] block";
          profileFeedback.textContent = data.error || "No se pudo actualizar el perfil.";
        }
      }
    } catch (err: any) {
      if (profileFeedback) {
        profileFeedback.className = "text-xs p-3 rounded-lg bg-[#b71c1c]/20 border border-[#b71c1c]/40 text-[#ef5350] block";
        profileFeedback.textContent = "Error de conexión al guardar.";
      }
    } finally {
      if (btnSaveProfile) {
        btnSaveProfile.disabled = false;
        btnSaveProfile.textContent = "Guardar Cambios de Perfil";
      }
    }
  }

  profileForm?.addEventListener("submit", handleProfileSave);
  btnSaveProfile?.addEventListener("click", handleProfileSave);

  // Manual Refresh
  btnRefresh?.addEventListener("click", () => {
    loadDashboard();
  });

  // Lightweight Visibility-based Auto-refresh (0 extra background load)
  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible") {
      loadDashboard();
    }
  });

  // 30s Polling only when document is visible
  setInterval(() => {
    if (document.visibilityState === "visible" && localStorage.getItem("ambassador_session_phone")) {
      loadDashboard();
    }
  }, 30000);

  // Logout
  btnLogout?.addEventListener("click", () => {
    localStorage.removeItem("ambassador_session_phone");
    window.location.reload();
  });

  function scrollToHashIfPresent() {
    if (window.location.hash) {
      const hash = window.location.hash;
      setTimeout(() => {
        try {
          const target = document.querySelector(hash);
          if (target) {
            target.scrollIntoView({ behavior: "smooth", block: "start" });
          }
        } catch (_) {}
      }, 150);
    }
  }

  window.addEventListener("hashchange", () => {
    scrollToHashIfPresent();
  });

  // Escuchar inicio de sesión inmediato
  window.addEventListener("ambassador-session-started", () => {
    loadDashboard();
  });

  loadDashboard();
</script>
