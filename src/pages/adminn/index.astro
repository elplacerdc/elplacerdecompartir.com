            <div class="text-[10px] text-[#f7f4ee]/40 font-mono">ID: ${l.id.substring(0, 8)}...</div>
          </td>
          <td class="py-3 px-3 font-mono text-[11px]">
            <div class="text-[#f7f4ee]/90">${l.whatsapp || "—"}</div>
            <div class="text-[#f7f4ee]/50 text-[10px] truncate max-w-[150px]">${l.email || "—"}</div>
          </td>
          <td class="py-3 px-3 font-mono text-[11px] text-[#ead397] font-semibold">
            ${affAlias}
          </td>
          <td class="py-3 px-3 text-[11px]">
            <span class="capitalize text-[#f7f4ee]/80">${roleDisplay}</span>
            <span class="block text-[10px] text-[#c5a059]/70">${l.origen || "web"}</span>
          </td>
          <td class="py-3 px-2 text-center">
            <button 
              type="button" 
              class="btn-row-events px-2.5 py-1 rounded-lg bg-[#c5a059]/15 text-[#ead397] hover:bg-[#c5a059]/30 border border-[#c5a059]/30 font-mono text-xs font-semibold cursor-pointer"
              data-lead-id="${l.id}"
              title="Ver historial de eventos asistidos"
