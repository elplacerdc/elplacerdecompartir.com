        `;
      }

      const eventsOptions = Object.entries(EVENT_CATALOG).map(([key, ev]) => `
        <option value="${key}">${ev.name}</option>
      `).join("");

      crudFieldsContainer.innerHTML = `
        ${userBlockHtml}

        <div>
          <label class="block text-xs uppercase text-[#c5a059] font-bold mb-1">Evento *</label>
          <select id="crud-evento" class="w-full px-3 py-2 rounded-xl bg-[#0a050c] border border-[#c5a059]/30 text-xs text-[#ead397]">
            ${eventsOptions}
          </select>
        </div>

        <div>
          <label class="block text-xs uppercase text-[#c5a059] font-bold mb-1">Modalidad de Pase / Tarifa Oficial *</label>
          <select id="crud-tipo-entrada" class="w-full px-3 py-2 rounded-xl bg-[#0a050c] border border-[#c5a059]/30 text-xs text-[#ead397] font-medium">
          </select>
        </div>

        <input type="hidden" id="crud-tipo-pago" value="total_100" />
        <input type="hidden" id="crud-categoria" value="pago" />

        <div id="wrapper-monto">
          <label class="block text-xs uppercase text-[#c5a059] font-bold mb-1">Monto Cobrado (COP)</label>
          <input type="number" id="crud-monto" value="100000" class="w-full px-3 py-2 rounded-xl bg-[#0a050c] border border-[#c5a059]/30 text-xs text-[#ead397] font-mono" />
        </div>

        <div id="wrapper-metodo">
          <label class="block text-xs uppercase text-[#c5a059] font-bold mb-1">Método de Pago</label>
          <select id="crud-metodo" class="w-full px-3 py-2 rounded-xl bg-[#0a050c] border border-[#c5a059]/30 text-xs text-[#ead397]">
            <option value="efectivo_sitio">💵 Efectivo en Sitio</option>
            <option value="bre_b">⚡ Bre-B (Transferencia Directa)</option>
            <option value="transferencia">🏦 Transferencia Bancolombia / Nequi</option>
            <option value="pasarela_digital">💳 Pasarela Digital</option>
          </select>
        </div>

        <div>
          <label class="block text-xs uppercase text-[#c5a059] font-bold mb-1">Estado</label>
          <select id="crud-estado" class="w-full px-3 py-2 rounded-xl bg-[#0a050c] border border-[#c5a059]/30 text-xs text-[#ead397]">
            <option value="confirmado">Confirmado (Aprobado)</option>
            <option value="asistido">Asistido (Ingresó)</option>
            <option value="pendiente">Pendiente</option>
          </select>
        </div>
      `;

      const eventoSelect = document.getElementById("crud-evento") as HTMLSelectElement;
      const tipoEntradaSelect = document.getElementById("crud-tipo-entrada") as HTMLSelectElement;
      const montoInput = document.getElementById("crud-monto") as HTMLInputElement;
      const metodoSelect = document.getElementById("crud-metodo") as HTMLSelectElement;

      // Real-time search filter for users dropdown
      if (!optionalLeadId) {
        const userSearch = document.getElementById("crud-user-search-filter") as HTMLInputElement;
        const leadSelect = document.getElementById("crud-lead-id") as HTMLSelectElement;
        userSearch?.addEventListener("input", () => {
          const q = userSearch.value.trim().toLowerCase();
          const filtered = (cachedMetrics?.leads || []).filter((l: any) =>
            (l.alias_nombre || "").toLowerCase().includes(q) ||
            (l.whatsapp || "").toLowerCase().includes(q) ||
            (l.email || "").toLowerCase().includes(q) ||
            (l.affiliate_alias || "").toLowerCase().includes(q)
          );
          leadSelect.innerHTML = '<option value="">-- Seleccionar Usuario Obligatorio --</option>' + filtered.map((l: any) => `
            <option value="${l.id}">${l.alias_nombre || 'Invitado'} (${l.whatsapp || l.email || 'Sin contacto'})${l.affiliate_alias ? ' • Embajador: @' + l.affiliate_alias : ''}</option>
          `).join("");
          updatePricingState();
        });

        leadSelect?.addEventListener("change", () => {
          updatePricingState();
        });
      }

      function updatePricingState() {
        const targetLead = getSelectedTargetLead();
        const currentEventKey = eventoSelect?.value || "luna_llena";
        const options = getDynamicTicketOptions(targetLead, currentEventKey);

        if (tipoEntradaSelect) {
          const prevVal = tipoEntradaSelect.value;
          tipoEntradaSelect.innerHTML = options.map((opt: any) => `
            <option value="${opt.id}" ${opt.id === prevVal ? 'selected' : ''}>${opt.label}</option>
          `).join("");
        }

        const selectedOpt = options.find((o: any) => o.id === tipoEntradaSelect?.value) || options[0];
        const catInput = document.getElementById("crud-categoria") as HTMLInputElement;
        const tipoPagoInput = document.getElementById("crud-tipo-pago") as HTMLInputElement;

        if (catInput) catInput.value = selectedOpt.categoria;
        if (tipoPagoInput) tipoPagoInput.value = selectedOpt.tipoPago;

        if (selectedOpt.price === 0) {
          if (montoInput) {
            montoInput.value = "0";
            montoInput.disabled = true;
          }
          if (metodoSelect) {
            metodoSelect.innerHTML = '<option value="cortesia_manual">🎁 Cortesía de Honor ($0 COP)</option>';
          }
        } else {
          if (montoInput) {
            montoInput.disabled = false;
            montoInput.value = selectedOpt.price.toString();
          }
          if (metodoSelect) {
            metodoSelect.innerHTML = `
              <option value="efectivo_sitio">💵 Efectivo en Sitio</option>
              <option value="bre_b">⚡ Bre-B (Transferencia Directa)</option>
              <option value="transferencia">🏦 Transferencia Bancolombia / Nequi</option>
              <option value="pasarela_digital">💳 Pasarela Digital</option>
            `;
          }
        }
      }

      eventoSelect?.addEventListener("change", () => {
        updatePricingState();
      });

      tipoEntradaSelect?.addEventListener("change", updatePricingState);

      // Initial populate
      updatePricingState();
    } else {
      currentCrudEntity = "lead";
      modalCrudTitle.textContent = "Nuevo Lead Manual";
      crudFieldsContainer.innerHTML = `
        <div>
          <label class="block text-xs uppercase text-[#c5a059] font-bold mb-1">Alias / Nombre *</label>
          <input type="text" id="crud-alias-nombre" required placeholder="Nombre o alias" class="w-full px-3 py-2 rounded-xl bg-[#0a050c] border border-[#c5a059]/30 text-xs text-[#ead397]" />
        </div>
        <div>
          <label class="block text-xs uppercase text-[#c5a059] font-bold mb-1">WhatsApp</label>
          <input type="tel" id="crud-wa" placeholder="310 000 0000" class="w-full px-3 py-2 rounded-xl bg-[#0a050c] border border-[#c5a059]/30 text-xs text-[#ead397]" />
        </div>
        <div>
          <label class="block text-xs uppercase text-[#c5a059] font-bold mb-1">Email</label>
          <input type="email" id="crud-email" placeholder="correo@ejemplo.com" class="w-full px-3 py-2 rounded-xl bg-[#0a050c] border border-[#c5a059]/30 text-xs text-[#ead397]" />
        </div>
        <div>
          <label class="block text-xs uppercase text-[#c5a059] font-bold mb-1">Modalidad / Rol</label>
          <select id="crud-rol" class="w-full px-3 py-2 rounded-xl bg-[#0a050c] border border-[#c5a059]/30 text-xs text-[#ead397]">
            <option value="pareja">👫 Pareja</option>
            <option value="mujer_sola">🦄 Mujer Sola (Unicornio)</option>
            <option value="hombre_solo">🙋‍♂️ Hombre Solo (Single)</option>
            <option value="otro">Otro</option>
          </select>
        </div>
        <div>
          <label class="block text-xs uppercase text-[#c5a059] font-bold mb-1">Origen</label>
          <select id="crud-origen" class="w-full px-3 py-2 rounded-xl bg-[#0a050c] border border-[#c5a059]/30 text-xs text-[#ead397]">
            <option value="web">El Placer DC (Web)</option>
            <option value="the_corset">The Corset Society (VIP)</option>
            <option value="aliado_centro_cultural">Aliados / Centro Cultural</option>
            <option value="admin_manual">Creado Manualmente</option>
          </select>
        </div>
      `;
    }
  }

  formCrudCreate?.addEventListener("submit", async (e) => {
    e.preventDefault();
    let payloadData: any = {};

    if (currentCrudEntity === "affiliate") {
      const aliasInput = document.getElementById("crud-alias") as HTMLInputElement;
      const nombreInput = document.getElementById("crud-nombre") as HTMLInputElement;
      const waInput = document.getElementById("crud-wa") as HTMLInputElement;
      payloadData = { alias: aliasInput.value, nombre: nombreInput.value, whatsapp: waInput.value };
    } else if (currentCrudEntity === "ticket") {
      const evInput = document.getElementById("crud-evento") as HTMLSelectElement;
      const tipoInput = document.getElementById("crud-tipo-entrada") as HTMLSelectElement;
      const tipoPagoInput = document.getElementById("crud-tipo-pago") as HTMLInputElement | null;
      const categoriaInput = document.getElementById("crud-categoria") as HTMLInputElement | null;
      const montoInput = document.getElementById("crud-monto") as HTMLInputElement;
      const metodoInput = document.getElementById("crud-metodo") as HTMLSelectElement;
      const estadoInput = document.getElementById("crud-estado") as HTMLSelectElement;
      const leadIdInput = document.getElementById("crud-lead-id") as HTMLSelectElement | null;
      payloadData = {
        evento: evInput.value,
        tipo_entrada: tipoInput.value,
        tipo_pago: tipoPagoInput?.value || "total_100",
        categoria: categoriaInput?.value || "pago",
        monto_pagado: montoInput.value,
        metodo_pago: metodoInput.value,
        estado: estadoInput.value,
        lead_id: leadIdInput?.value || null,
      };
    } else {
      const aliasInput = document.getElementById("crud-alias-nombre") as HTMLInputElement;
      const waInput = document.getElementById("crud-wa") as HTMLInputElement;
      const emailInput = document.getElementById("crud-email") as HTMLInputElement;
      const rolInput = document.getElementById("crud-rol") as HTMLSelectElement;
      const origenInput = document.getElementById("crud-origen") as HTMLSelectElement;
      payloadData = { 
        alias_nombre: aliasInput.value, 
        whatsapp: waInput.value, 
        email: emailInput.value, 
        rol: rolInput.value,
        origen: origenInput.value,
        corset_vip: origenInput.value === "the_corset"
      };
    }

    try {
      const res = await fetch("/api/admin/records", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ entity: currentCrudEntity, data: payloadData }),
      });
      const data = await res.json();
      if (data.success) {
        if (crudCreateStatus) {
          crudCreateStatus.className = "p-3 rounded-lg text-xs bg-[#2e7d32]/25 text-[#81c784] block";
          crudCreateStatus.textContent = "✓ Registro creado exitosamente";
        }
        setTimeout(() => {
          modalCrudCreate?.classList.add("hidden");
          loadMetrics();
        }, 800);
      } else {
        if (crudCreateStatus) {
          crudCreateStatus.className = "p-3 rounded-lg text-xs bg-[#b71c1c]/25 text-[#ef5350] block";
          crudCreateStatus.textContent = data.error || "Error al crear registro";
        }
      }
    } catch (e: any) {
      if (crudCreateStatus) {
        crudCreateStatus.className = "p-3 rounded-lg text-xs bg-[#b71c1c]/25 text-[#ef5350] block";
        crudCreateStatus.textContent = "Error de conexión al crear";
      }
    }
  });

  // 8. ESCÁNER QR DE CÁMARA AUTOMÁTICO
  tabCameraScan?.addEventListener("click", () => {
    tabCameraScan.className = "px-3 py-1.5 rounded-lg text-xs font-semibold bg-[#c5a059] text-[#0e0410] transition-all";
    tabManualScan!.className = "px-3 py-1.5 rounded-lg text-xs font-medium text-[#f7f4ee]/70 hover:text-white transition-all";
    panelCameraScanner?.classList.remove("hidden");
    panelManualScanner?.classList.add("hidden");
    startCamera();
  });

  tabManualScan?.addEventListener("click", () => {
    tabManualScan.className = "px-3 py-1.5 rounded-lg text-xs font-semibold bg-[#c5a059] text-[#0e0410] transition-all";
    tabCameraScan!.className = "px-3 py-1.5 rounded-lg text-xs font-medium text-[#f7f4ee]/70 hover:text-white transition-all";
    panelCameraScanner?.classList.add("hidden");
    panelManualScanner?.classList.remove("hidden");
    stopCamera();
  });

  btnStartCamera?.addEventListener("click", startCamera);

  async function startCamera() {
    try {
      if (videoStream) {
        stopCamera();
      }

      cameraLoadingOverlay?.classList.remove("hidden");
      const stream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: "environment", width: { ideal: 1280 }, height: { ideal: 720 } },
      });

      videoStream = stream;
      if (qrVideoStream) {
        qrVideoStream.srcObject = stream;
        qrVideoStream.setAttribute("playsinline", "true");
        await qrVideoStream.play();
        cameraLoadingOverlay?.classList.add("hidden");
        qrScanActive = true;
        scanLoop();
      }
    } catch (err: any) {
      console.warn("Camera access denied or failed:", err);
      if (cameraLoadingOverlay) {
        cameraLoadingOverlay.innerHTML = `
          <span class="text-2xl text-[#ef5350]">⚠️</span>
          <p class="text-xs text-[#ef5350]">No se pudo acceder a la cámara (${err.name || "Permiso denegado"}).</p>
          <button type="button" id="btn-retry-camera" class="px-3 py-1.5 rounded-lg bg-[#c5a059] text-[#0a050c] text-xs font-bold">Reintentar</button>
        `;
        document.getElementById("btn-retry-camera")?.addEventListener("click", startCamera);
      }
    }
  }

  function stopCamera() {
    qrScanActive = false;
    if (videoStream) {
      videoStream.getTracks().forEach((t) => t.stop());
      videoStream = null;
    }
  }

  // Scan detection loop with native BarcodeDetector API
  async function scanLoop() {
    if (!qrScanActive || !qrVideoStream) return;

    if (!scanCooldown && qrVideoStream.readyState === qrVideoStream.HAVE_ENOUGH_DATA) {
      if ("BarcodeDetector" in window) {
        try {
          const barcodeDetector = new (window as any).BarcodeDetector({ formats: ["qr_code"] });
          const barcodes = await barcodeDetector.detect(qrVideoStream);
          if (barcodes.length > 0 && barcodes[0].rawValue) {
            handleDetectedCode(barcodes[0].rawValue);
          }
        } catch (e) {
          // ignore detection frame error
        }
      }
    }

    if (qrScanActive) {
      requestAnimationFrame(scanLoop);
    }
  }

  async function handleDetectedCode(raw: string) {
    if (scanCooldown) return;
    scanCooldown = true;

    // Haptic feedback if supported
    if ("vibrate" in navigator) {
      navigator.vibrate([100, 50, 100]);
    }

    await validateCheckin(raw);
  }

  // 9. CHECK-IN DISPATCHER WITH DISMISSIBLE MODAL POPUP
  async function validateCheckin(rawCode: string) {
    if (!modalQrResult) return;

    try {
      const res = await fetch("/api/admin/checkin", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ ticket_hash: rawCode }),
      });
      const data = await res.json();

      if (data.success) {
        if (data.already_checked_in) {
          if (qrModalIcon) qrModalIcon.textContent = "⚠️";
          if (qrModalTitle) qrModalTitle.textContent = "Entrada Previamente Utilizada";
          if (qrModalSubtitle) qrModalSubtitle.textContent = "Este pase ya fue validado en el ingreso anteriormente.";
          if (qrModalBody) {
            qrModalBody.innerHTML = `
              <div class="space-y-1.5 font-sans">
                <div><span class="text-[#c5a059] font-bold">Titular:</span> ${data.ticket.titular}</div>
                <div><span class="text-[#c5a059] font-bold">WhatsApp:</span> ${data.ticket.whatsapp || "No registrado"}</div>
                <div><span class="text-[#c5a059] font-bold">Evento:</span> ${data.ticket.evento}</div>
                <div><span class="text-[#c5a059] font-bold">Pase:</span> ${data.ticket.tipo_entrada} (${data.ticket.tipo_pago})</div>
                <div class="text-[10px] text-[#ffb74d] font-mono break-all pt-1">Hash: ${data.ticket.ticket_hash || rawCode}</div>
              </div>
            `;
          }
        } else {
          if (qrModalIcon) qrModalIcon.textContent = "✨";
          if (qrModalTitle) qrModalTitle.textContent = "¡Acceso Concedido!";
          if (qrModalSubtitle) qrModalSubtitle.textContent = "Entrada válida y registrada para el evento.";
          if (qrModalBody) {
            qrModalBody.innerHTML = `
              <div class="space-y-1.5 font-sans">
                <div><span class="text-[#81c784] font-bold">Titular:</span> ${data.ticket.titular}</div>
                <div><span class="text-[#81c784] font-bold">WhatsApp:</span> ${data.ticket.whatsapp || "No registrado"}</div>
                <div><span class="text-[#81c784] font-bold">Evento:</span> ${data.ticket.evento}</div>
                <div><span class="text-[#81c784] font-bold">Pase:</span> ${data.ticket.tipo_entrada} (${data.ticket.tipo_pago})</div>
                <div class="text-[10px] text-[#81c784] font-mono break-all pt-1">Hash: ${data.ticket.ticket_hash || rawCode}</div>
              </div>
            `;
          }
          loadMetrics();
        }
      } else {
        if (qrModalIcon) qrModalIcon.textContent = "❌";
        if (qrModalTitle) qrModalTitle.textContent = "Entrada Inválida";
        if (qrModalSubtitle) qrModalSubtitle.textContent = "Código no encontrado o revocado.";
        if (qrModalBody) {
          qrModalBody.innerHTML = `
            <div class="text-[#ef5350]">
              <p>${data.error || "El código escaneado no coincide con ningún pase registrado en la base de datos."}</p>
              <p class="font-mono text-[10px] text-[#f7f4ee]/50 mt-1 break-all">${rawCode}</p>
            </div>
          `;
        }
      }

      modalQrResult.classList.remove("hidden");
    } catch (e: any) {
      if (qrModalIcon) qrModalIcon.textContent = "❌";
      if (qrModalTitle) qrModalTitle.textContent = "Error de Conexión";
      if (qrModalSubtitle) qrModalSubtitle.textContent = "No se pudo contactar el servidor de validación.";
      if (qrModalBody) qrModalBody.textContent = "Revisa tu conexión a internet e intenta nuevamente.";
      modalQrResult.classList.remove("hidden");
    }
  }

  // Dismiss QR Modal
  btnCloseQrModal?.addEventListener("click", () => {
    modalQrResult?.classList.add("hidden");
    scanCooldown = false;
  });

  // Manual Check-in Form Handler
  checkinForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const raw = inputTicketHash.value.trim();
    if (!raw) return;
    btnCheckinSubmit.disabled = true;
    btnCheckinSubmit.textContent = "Validando...";
    await validateCheckin(raw);
    inputTicketHash.value = "";
    btnCheckinSubmit.disabled = false;
    btnCheckinSubmit.textContent = "Validar Asistencia";
  });

  btnRefresh?.addEventListener("click", loadMetrics);

  // Initialize only if authenticated dashboard is active
  if (btnLogout) {
    loadMetrics();

    // Actualización periódica en caliente (cada 30s si la pestaña está visible)
    setInterval(() => {
      if (document.visibilityState === "visible") {
        loadMetrics();
      }
    }, 30000);

    // If mobile or permission ready, start camera on load
    if (tabCameraScan && window.innerWidth < 768) {
      startCamera();
    }
  }
</script>
