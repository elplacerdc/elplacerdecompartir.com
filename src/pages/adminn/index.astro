  function openDrawer(type: "leads" | "affiliates" | "tickets" | "pending_cash" | "checkins" | "aliados" | "vip") {
    activeDrawerType = type;
    drawerContainer?.classList.remove("hidden");
    renderDrawer(type);
  }

  function closeDrawer() {
    activeDrawerType = null;
    drawerContainer?.classList.add("hidden");
  }

  drawerBackdrop?.addEventListener("click", closeDrawer);
  drawerClose?.addEventListener("click", closeDrawer);

  cardLeads?.addEventListener("click", () => openDrawer("leads"));
  cardAffiliates?.addEventListener("click", () => openDrawer("aliados"));
  cardTickets?.addEventListener("click", () => openDrawer("vip"));
  cardPendingCash?.addEventListener("click", () => openDrawer("tickets"));
  cardCheckins?.addEventListener("click", () => {
    modalFinancial?.classList.remove("hidden");
    renderFinancialModal();
