            <div><strong>Email:</strong> ${lead.email || "—"}</div>
            <div><strong>Modalidad:</strong> ${lead.rol ? lead.rol.replace('_', ' ') : "general"} • <strong>Ciudad:</strong> ${lead.ciudad || "Bogotá"}</div>
            <div><strong>Origen:</strong> ${lead.origen || "web"} • <strong>Registrado:</strong> ${lead.created_at ? new Date(lead.created_at).toLocaleString("es-CO", { timeZone: "America/Bogota" }) + " (Bogotá)" : "—"}</div>
