            </button>
            <button type="button" class="btn-ticket-tab flex-1 py-1.5 px-3 rounded-lg font-semibold transition-all ${ticketsCategoryFilter === 'gratuitos' ? 'bg-[#c5a059] text-[#0a050c] font-bold shadow-sm' : 'text-[#ead397] hover:bg-[#c5a059]/20'}" data-tab="gratuitos">
