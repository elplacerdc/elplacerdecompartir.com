---
// src/pages/admin/index.astro - Dashboard de Administración y Control General Single-Page Luxury
import Layout from "../../layouts/Layout.astro";
import { verifyAdminSessionToken } from "../../services/adminAuth";

const token = Astro.cookies.get("admin_token")?.value;
const isAuthenticated = verifyAdminSessionToken(token);
---

<Layout title="Panel de Administración — El Placer de Compartir" isCorset={false} noindex={true}>
  <main class="min-h-screen bg-[#140816] text-[#f7f4ee] py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto space-y-8">

      {!isAuthenticated ? (
        <!-- Luxury Password Gate Modal/Card -->
        <div class="min-h-[70vh] flex items-center justify-center">
          <div class="w-full max-w-md p-8 sm:p-10 rounded-3xl bg-gradient-to-b from-[#250e29] to-[#1c081e] border border-[#c5a059]/40 shadow-[0_12px_45px_rgba(0,0,0,0.6)] text-center space-y-6">
            <div class="w-16 h-16 mx-auto rounded-full bg-[#c5a059]/15 border border-[#c5a059]/40 flex items-center justify-center text-2xl shadow-[0_0_20px_rgba(197,160,89,0.3)]">
              🔒
            </div>

            <div>
              <span class="text-[10px] uppercase tracking-[0.25em] text-[#ead397] font-semibold block mb-1">
                Acceso Restringido • Dirección
              </span>
              <h1 class="text-2xl font-serif font-bold text-[#f7f4ee]">
                Panel de Administración
              </h1>
              <p class="text-xs text-[#f7f4ee]/70 mt-2">
                Ingresa la contraseña de seguridad para gestionar métricas, validar accesos QR y administrar la comunidad.
              </p>
            </div>

            <form id="login-form" class="space-y-4 text-left">
              <div>
                <label for="admin-password-input" class="block text-xs font-semibold uppercase tracking-wider text-[#c5a059] mb-1.5">
                  Contraseña Maestra
                </label>
                <input 
                  type="password" 
                  id="admin-password-input" 
                  required
                  placeholder="••••••••••••" 
                  class="w-full px-4 py-3 rounded-xl bg-[#0a050c] border border-[#c5a059]/40 text-[#ead397] text-sm focus:outline-none focus:border-[#c5a059] focus:ring-1 focus:ring-[#c5a059]"
                  autofocus
                />
              </div>

              <div id="login-error" class="hidden p-3 rounded-lg bg-[#b71c1c]/25 border border-[#ef5350]/50 text-xs text-[#ef5350] text-center"></div>

              <button 
                type="submit" 
                id="btn-login-submit"
                class="w-full py-3.5 rounded-xl bg-gradient-to-r from-[#c5a059] to-[#ead397] text-[#0a050c] font-serif font-bold uppercase text-xs tracking-wider hover:brightness-110 shadow-lg transition-all"
              >
                Acceder al Panel
              </button>
            </form>

            <p class="text-[11px] text-[#f7f4ee]/40">
              El acceso no autorizado está estrictamente monitoreado y registrado.
            </p>
          </div>
        </div>
      ) : (
        <!-- Dashboard Single-Page Luxury Activo -->
        <div class="space-y-8">
          
          <!-- Header Bar -->
          <div class="flex flex-col md:flex-row items-start md:items-center justify-between border-b border-[#c5a059]/25 pb-6 gap-4">
            <div>
              <div class="flex items-center gap-2 mb-1.5">
                <span class="py-1 px-3 rounded-full bg-[#c5a059]/15 border border-[#c5a059]/30 text-[#ead397] text-[10px] uppercase tracking-[0.2em] font-semibold">
                  Dirección & Control General
                </span>
                <span class="text-xs text-[#81c784] font-medium flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-[#81c784] animate-pulse"></span> Sesión Activa
                </span>
              </div>
              <h1 class="text-2xl sm:text-3xl font-serif font-bold text-[#ead397]">
                Dashboard de Administración
              </h1>
              <p class="text-xs text-[#f7f4ee]/70 mt-1">
                Haz clic en cualquier tarjeta o fila para abrir el panel de gestión interactivo sin recargar la página.
              </p>
            </div>

            <div class="flex flex-wrap items-center gap-2.5">
              <button 
                id="btn-create-ticket-top" 
                class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-gradient-to-r from-[#c5a059] to-[#ead397] text-[#0a050c] hover:brightness-110 transition-all flex items-center gap-1.5 shadow-md"
                title="Generar entrada o cortesía 100%"
              >
                <span>🎟️</span> + Crear Pase / Cortesía 100%
              </button>
              <button 
                id="btn-change-password-modal" 
                class="px-3.5 py-2 rounded-xl text-xs font-medium bg-[#250e29] border border-[#c5a059]/40 text-[#ead397] hover:bg-[#c5a059]/20 transition-all flex items-center gap-1.5"
                title="Cambiar contraseña de acceso"
              >
                <span>🔑</span> Cambiar Clave
              </button>
              <button 
                id="btn-refresh" 
                class="px-3.5 py-2 rounded-xl text-xs font-medium bg-[#250e29] border border-[#c5a059]/40 text-[#ead397] hover:bg-[#c5a059]/20 transition-all flex items-center gap-1.5"
                title="Actualizar datos en tiempo real"
              >
                <span>↻</span> Actualizar
              </button>
              <button 
                id="btn-logout" 
                class="px-3.5 py-2 rounded-xl text-xs font-medium bg-[#3a111b] border border-[#ef5350]/40 text-[#ef5350] hover:bg-[#ef5350]/20 transition-all"
                title="Cerrar sesión segura"
              >
                Cerrar Sesión
              </button>
            </div>
          </div>

          <!-- KPI Metrics Grid (100% Clickeables e interactivas) -->
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs uppercase tracking-widest text-[#c5a059] font-bold">Métricas Globales (Toca una tarjeta para ver detalle y gestionar)</span>
              <span class="text-[11px] text-[#f7f4ee]/50 italic">Single-Page Interactivo</span>
            </div>

            <div class="grid grid-cols-2 lg:grid-cols-6 gap-3 sm:gap-4">
              
              <!-- KPI 1: Comunidad Registrada -->
              <div 
                id="card-kpi-leads" 
                class="p-4 sm:p-5 rounded-2xl bg-gradient-to-b from-[#260e2a] to-[#1c081e] border border-[#c5a059]/30 hover:border-[#c5a059] cursor-pointer hover:scale-[1.02] transition-all text-center group shadow-md"
              >
                <span class="text-[11px] uppercase tracking-wider text-[#f7f4ee]/70 block mb-1">Comunidad Registrada</span>
                <span id="kpi-leads" class="text-2xl sm:text-3xl font-serif font-bold text-[#ead397] group-hover:text-white transition-colors">...</span>
                <span class="text-[10px] text-[#c5a059] block mt-1 underline">Directorio unificado →</span>
              </div>

              <!-- KPI 2: Solicitudes de Aliados -->
              <div 
                id="card-kpi-affiliates" 
                class="p-4 sm:p-5 rounded-2xl bg-gradient-to-b from-[#260e2a] to-[#1c081e] border border-[#c5a059]/30 hover:border-[#c5a059] cursor-pointer hover:scale-[1.02] transition-all text-center group shadow-md"
              >
                <span class="text-[11px] uppercase tracking-wider text-[#f7f4ee]/70 block mb-1">Solicitudes Aliados</span>
                <span id="kpi-affiliates" class="text-2xl sm:text-3xl font-serif font-bold text-[#c5a059] group-hover:text-white transition-colors">...</span>
                <span class="text-[10px] text-[#c5a059] block mt-1 underline">Centro cultural →</span>
              </div>

              <!-- KPI 3: Credenciales VIP Activas -->
              <div 
                id="card-kpi-tickets" 
                class="p-4 sm:p-5 rounded-2xl bg-gradient-to-b from-[#260e2a] to-[#1c081e] border border-[#c5a059]/30 hover:border-[#c5a059] cursor-pointer hover:scale-[1.02] transition-all text-center group shadow-md"
              >
                <span class="text-[11px] uppercase tracking-wider text-[#f7f4ee]/70 block mb-1">Credenciales VIP</span>
                <span id="kpi-tickets" class="text-2xl sm:text-3xl font-serif font-bold text-[#e57373] group-hover:text-white transition-colors">...</span>
                <span class="text-[10px] text-[#c5a059] block mt-1 underline">Corset Society →</span>
              </div>

              <!-- KPI 4: Pases Emitidos -->
              <div 
                id="card-kpi-pending-cash" 
                class="p-4 sm:p-5 rounded-2xl bg-gradient-to-b from-[#2b1021] to-[#1c081e] border border-[#ffb74d]/40 hover:border-[#ffb74d] cursor-pointer hover:scale-[1.02] transition-all text-center group shadow-md"
              >
                <span class="text-[11px] uppercase tracking-wider text-[#ffb74d] block mb-1">Pases Emitidos</span>
                <span id="kpi-pending-cash" class="text-2xl sm:text-3xl font-serif font-bold text-[#ffb74d] group-hover:text-white transition-colors">...</span>
                <span class="text-[10px] text-[#ffb74d] block mt-1 underline">Ver todos los pases →</span>
              </div>

              <!-- KPI 5: Ingreso Neto Pasarelas -->
              <div 
                id="card-kpi-checkins" 
                class="p-4 sm:p-5 rounded-2xl bg-gradient-to-b from-[#260e2a] to-[#1c081e] border border-[#c5a059]/30 hover:border-[#c5a059] cursor-pointer hover:scale-[1.02] transition-all text-center group shadow-md"
              >
                <span class="text-[11px] uppercase tracking-wider text-[#81c784] block mb-1">Ingreso Neto Pasarelas</span>
                <span id="kpi-checkins" class="text-lg sm:text-xl font-serif font-bold text-[#81c784] group-hover:text-white transition-colors">...</span>
                <span class="text-[10px] text-[#81c784] block mt-1 underline">Menos comisiones →</span>
              </div>

              <!-- KPI 6: Margen Neto Real -->
              <div 
                id="card-kpi-revenue" 
                class="p-4 sm:p-5 rounded-2xl bg-gradient-to-b from-[#260e2a] to-[#1c081e] border border-[#c5a059]/30 hover:border-[#c5a059] cursor-pointer hover:scale-[1.02] transition-all text-center group shadow-md"
              >
                <span class="text-[11px] uppercase tracking-wider text-[#ead397] block mb-1">Margen Neto Real</span>
                <span id="kpi-revenue" class="text-lg sm:text-xl font-serif font-bold text-[#ead397] group-hover:text-white transition-colors">...</span>
                <span class="text-[10px] text-[#c5a059] block mt-1 underline">Ver balance y gastos →</span>
              </div>

            </div>
          </div>

          <!-- Escáner QR de Cámara Automático & Control de Acceso -->
          <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-[#280f2d] via-[#1e0a22] to-[#250d28] border border-[#c5a059]/40 shadow-2xl space-y-6">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-b border-[#c5a059]/20 pb-4">
              <div>
                <span class="text-xs uppercase tracking-widest text-[#c5a059] font-bold block mb-1">Control de Acceso Físico en Puerta</span>
                <h2 class="text-xl sm:text-2xl font-serif font-bold text-[#ead397]">Validador de Asistencia y Escáner QR</h2>
              </div>

              <!-- Tabs de Modo de Escaneo -->
              <div class="flex items-center gap-2 bg-[#0e0410] p-1.5 rounded-xl border border-[#c5a059]/30">
                <button 
                  type="button" 
                  id="tab-camera-scan" 
                  class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-[#c5a059] text-[#0e0410] transition-all"
                >
                  📷 Escáner Cámara Celular
                </button>
                <button 
                  type="button" 
                  id="tab-manual-scan" 
                  class="px-3 py-1.5 rounded-lg text-xs font-medium text-[#f7f4ee]/70 hover:text-white transition-all"
                >
                  ⌨️ Manual por Código
                </button>
              </div>
            </div>

            <!-- Panel 1: Escáner con Cámara Automático (Móvil / Web) -->
            <div id="panel-camera-scanner" class="space-y-4">
              <div class="max-w-md mx-auto relative rounded-2xl overflow-hidden border-2 border-[#c5a059]/60 shadow-[0_0_25px_rgba(197,160,89,0.25)] bg-[#0a040b]">
                <video id="qr-video-stream" class="w-full h-72 sm:h-80 object-cover" autoplay playsinline muted></video>
                
                <!-- Retícula de escaneo visual -->
                <div class="absolute inset-0 pointer-events-none flex items-center justify-center">
                  <div class="w-56 h-56 border-2 border-[#c5a059] rounded-2xl relative shadow-[0_0_20px_rgba(197,160,89,0.4)] animate-pulse">
                    <span class="absolute top-2 left-2 w-4 h-4 border-t-2 border-l-2 border-[#ead397]"></span>
                    <span class="absolute top-2 right-2 w-4 h-4 border-t-2 border-r-2 border-[#ead397]"></span>
                    <span class="absolute bottom-2 left-2 w-4 h-4 border-b-2 border-l-2 border-[#ead397]"></span>
                    <span class="absolute bottom-2 right-2 w-4 h-4 border-b-2 border-r-2 border-[#ead397]"></span>
                  </div>
                </div>

                <div id="camera-loading-overlay" class="absolute inset-0 bg-[#0a040b] flex flex-col items-center justify-center p-4 text-center space-y-3">
                  <span class="text-3xl">📷</span>
                  <p class="text-xs text-[#ead397]">Iniciando cámara del dispositivo...</p>
                  <button 
                    type="button" 
                    id="btn-start-camera" 
                    class="px-4 py-2 rounded-xl bg-[#c5a059] text-[#0a040b] text-xs font-bold uppercase tracking-wider"
                  >
                    Activar Cámara
                  </button>
                </div>
              </div>

              <p class="text-center text-xs text-[#f7f4ee]/70">
                Apunta la cámara al código QR de la credencial. Se valida <strong class="text-[#ead397]">automáticamente</strong> y se abre en ventana emergente sin copiar ni pegar.
              </p>
            </div>

            <!-- Panel 2: Ingreso Manual -->
            <div id="panel-manual-scanner" class="hidden">
              <form id="checkin-form" class="flex flex-col sm:flex-row gap-3">
                <input 
                  type="text" 
                  id="input-ticket-hash" 
                  placeholder="Pega o escribe el Ticket Hash o código QR (ej: ELPLACERDC-EVENT-c188...)" 
                  class="flex-1 px-4 py-3 rounded-xl bg-[#0a050c] border border-[#c5a059]/40 text-[#ead397] font-mono text-sm placeholder-[#f7f4ee]/30 focus:outline-none focus:border-[#c5a059]"
                />
                <button 
                  type="submit" 
                  id="btn-checkin-submit" 
                  class="px-6 py-3 rounded-xl bg-gradient-to-r from-[#c5a059] to-[#ead397] text-[#0a050c] font-serif font-bold uppercase text-xs tracking-wider hover:brightness-110 shadow-md transition-all whitespace-nowrap"
                >
                  Validar Asistencia
                </button>
              </form>
            </div>

            <!-- Inline feedback fallback -->
            <div id="checkin-result" class="hidden p-4 rounded-2xl text-sm transition-all duration-300"></div>
          </div>

          <!-- Filtro por Etiquetas / Segmentos (Reubicado antes del Directorio) -->
          <div class="flex flex-wrap items-center gap-2 p-3 rounded-2xl bg-[#1c081e] border border-[#c5a059]/25 shadow-sm text-xs">
            <span class="text-[11px] uppercase tracking-wider text-[#c5a059] font-bold mr-1">Filtrar Vistas:</span>
            <button 
              type="button" 
              class="tag-filter-btn px-3 py-1.5 rounded-full border border-[#c5a059] bg-[#c5a059] text-[#0a050c] font-bold transition-all shadow-sm"
              data-tag="todos"
            >
              Todos
            </button>
            <button 
              type="button" 
              class="tag-filter-btn px-3 py-1.5 rounded-full border border-[#c5a059]/40 bg-[#250e29] text-[#ead397] hover:bg-[#c5a059]/20 transition-all font-semibold"
              data-tag="elplacerdc"
            >
              🍷 El Placer DC
            </button>
            <button 
              type="button" 
              class="tag-filter-btn px-3 py-1.5 rounded-full border border-[#c5a059]/40 bg-[#250e29] text-[#ead397] hover:bg-[#c5a059]/20 transition-all font-semibold"
              data-tag="corset"
            >
              🔒 The Corset Society
            </button>
            <button 
              type="button" 
              class="tag-filter-btn px-3 py-1.5 rounded-full border border-[#c5a059]/40 bg-[#250e29] text-[#ead397] hover:bg-[#c5a059]/20 transition-all font-semibold"
              data-tag="aliados"
            >
              🤝 Aliados & Centro Cultural
            </button>
          </div>

          <!-- Directorio Unificado de Usuarios & Embajadores (Lógica Indivisible Registro = Lead = Embajador) -->
          <div class="p-6 rounded-3xl bg-[#1c081e] border border-[#c5a059]/30 space-y-4 shadow-xl">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-[#c5a059]/20 pb-3 gap-3">
              <div>
                <h3 class="text-lg font-serif font-bold text-[#ead397]">Directorio Unificado de Usuarios & Embajadores</h3>
                <span class="text-xs text-[#f7f4ee]/60">Registro = Lead = Embajador • Clic en una fila para ver ficha completa y gestión</span>
              </div>
              <div class="flex items-center gap-2">
                <button 
                  id="btn-add-unified-user" 
                  class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-[#c5a059]/20 text-[#ead397] border border-[#c5a059]/40 hover:bg-[#c5a059]/30 transition-all flex items-center gap-1.5"
                >
                  <span>👤</span> + Nuevo Usuario / Lead
                </button>
              </div>
            </div>

            <div class="overflow-x-auto max-h-[520px]">
              <table class="w-full text-left text-xs">
                <thead class="sticky top-0 bg-[#1c081e] border-b border-[#c5a059]/20 text-[#f7f4ee]/60 uppercase tracking-wider font-semibold">
                  <tr>
                    <th class="py-2.5 px-3">Usuario / Nombre</th>
                    <th class="py-2.5 px-3">Contacto</th>
                    <th class="py-2.5 px-3">Código Embajador</th>
                    <th class="py-2.5 px-3">Modalidad / Origen</th>
                    <th class="py-2.5 px-2 text-center">Clics</th>
                    <th class="py-2.5 px-2 text-center">Referidos</th>
                    <th class="py-2.5 px-2 text-center">Ventas</th>
                    <th class="py-2.5 px-2 text-center">VIP</th>
                    <th class="py-2.5 px-3 text-right">Acciones</th>
                  </tr>
                </thead>
                <tbody id="unified-table-body" class="divide-y divide-[#c5a059]/10 text-[#f7f4ee]/90">
                  <tr><td colspan="9" class="py-6 text-center text-[#f7f4ee]/40">Cargando directorio unificado...</td></tr>
                </tbody>
              </table>
            </div>
          </div>

        </div>
      )}

    </div>
  </main>

  <!-- MODAL / DRAWER INTERACTIVO (SINGLE-PAGE) PARA DETALLE Y GESTIÓN CRUD -->
  <div id="drawer-container" class="hidden fixed inset-0 z-50 overflow-hidden">
    <!-- Backdrop oscuro con blur -->
    <div id="drawer-backdrop" class="absolute inset-0 bg-black/80 backdrop-blur-sm transition-opacity"></div>

    <div class="fixed inset-y-0 right-0 max-w-full flex w-full sm:max-w-3xl">
      <div class="w-full bg-[#1c081e] border-l border-[#c5a059]/40 shadow-2xl flex flex-col">
        
        <!-- Drawer Header -->
        <div class="p-4 sm:p-6 border-b border-[#c5a059]/25 flex items-center justify-between bg-[#250e29]">
          <div>
            <span id="drawer-badge" class="text-[10px] uppercase tracking-widest text-[#c5a059] font-bold block mb-1">Gestión Interactiva</span>
            <h2 id="drawer-title" class="text-xl font-serif font-bold text-[#ead397]">Detalle de Registros</h2>
          </div>
          <button 
            id="drawer-close" 
            class="p-2 rounded-xl text-[#f7f4ee]/70 hover:text-white hover:bg-white/10 transition-colors text-lg"
          >
            ✕
          </button>
        </div>

        <!-- Drawer Search / Action Bar -->
        <div class="p-3 sm:p-4 border-b border-[#c5a059]/15 flex items-center justify-between gap-3 bg-[#140816]">
          <input 
            type="text" 
            id="drawer-search" 
            placeholder="Buscar por nombre, teléfono, hash..." 
            class="flex-1 px-3.5 py-2 rounded-xl bg-[#0a050c] border border-[#c5a059]/30 text-xs text-[#ead397] placeholder-[#f7f4ee]/40 focus:outline-none focus:border-[#c5a059]"
          />
          <button 
            id="drawer-btn-add-new" 
            class="px-4 py-2 rounded-xl bg-[#c5a059] text-[#0a050c] text-xs font-bold uppercase tracking-wider hover:brightness-110 whitespace-nowrap shadow-sm"
          >
            + Añadir
          </button>
        </div>

        <!-- Drawer Content Area (Scrollable Table & Form) -->
        <div id="drawer-content" class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-4">
          <!-- Dynamically populated -->
        </div>

      </div>
    </div>
  </div>

  <!-- MODAL: RESULTADO DE ESCÁNER QR EN POPUP DISMISSIBLE -->
  <div id="modal-qr-result" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md">
    <div class="w-full max-w-md p-6 sm:p-8 rounded-3xl bg-[#250e29] border-2 border-[#c5a059] shadow-2xl space-y-5 text-center">
      <div id="qr-modal-icon" class="text-5xl">✨</div>
      <div>
        <h3 id="qr-modal-title" class="text-2xl font-serif font-bold text-[#ead397]">Acceso Concedido</h3>
        <p id="qr-modal-subtitle" class="text-xs text-[#f7f4ee]/70 mt-1">Verificación biométrica y de credencial en puerta</p>
      </div>
      
      <div id="qr-modal-body" class="p-4 rounded-2xl bg-[#0a050c] border border-[#c5a059]/30 text-xs text-left space-y-2 text-[#f7f4ee]">
        <!-- Dynamic attendee details -->
      </div>

      <button 
        type="button" 
        id="btn-close-qr-modal" 
        class="w-full py-3.5 rounded-xl bg-gradient-to-r from-[#c5a059] to-[#ead397] text-[#0a050c] font-serif font-bold uppercase text-xs tracking-wider hover:brightness-110 shadow-lg"
      >
        Cerrar / Continuar Escaneando
      </button>
    </div>
  </div>

  <!-- MODAL: DESGLOSE FINANCIERO Y RECAUDACIÓN (COP) -->
  <div id="modal-financial" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md">
    <div class="w-full max-w-lg p-6 sm:p-8 rounded-3xl bg-[#250e29] border border-[#c5a059]/40 shadow-2xl space-y-5 text-left max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-[#c5a059]/20 pb-3">
        <div>
          <span class="text-[10px] uppercase tracking-widest text-[#c5a059] font-bold block mb-1">Tesorería & Facturación</span>
          <h3 class="text-xl font-serif font-bold text-[#ead397]">Desglose de Recaudación (COP)</h3>
        </div>
        <button id="modal-financial-close" class="text-sm text-[#f7f4ee]/70 hover:text-white p-2">✕</button>
      </div>
      <div id="financial-modal-content" class="space-y-4 text-xs">
        <!-- Populated by JS -->
      </div>
    </div>
  </div>

  <!-- MODAL: CAMBIAR CONTRASEÑA ADMIN -->
  <div id="modal-password" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm">
    <div class="w-full max-w-md p-6 rounded-3xl bg-[#250e29] border border-[#c5a059]/40 shadow-2xl space-y-5">
      <div class="flex items-center justify-between border-b border-[#c5a059]/20 pb-3">
        <h3 class="text-lg font-serif font-bold text-[#ead397]">Cambiar Contraseña Maestra</h3>
        <button id="modal-password-close" class="text-sm text-[#f7f4ee]/70 hover:text-white">✕</button>
      </div>

      <form id="form-change-password" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-[#c5a059] uppercase tracking-wider mb-1">Contraseña Actual</label>
          <input type="password" id="input-cur-pwd" required class="w-full px-4 py-2.5 rounded-xl bg-[#0a050c] border border-[#c5a059]/30 text-sm text-[#ead397] focus:outline-none focus:border-[#c5a059]" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-[#c5a059] uppercase tracking-wider mb-1">Nueva Contraseña (mínimo 6 caracteres)</label>
          <input type="password" id="input-new-pwd" minlength="6" required class="w-full px-4 py-2.5 rounded-xl bg-[#0a050c] border border-[#c5a059]/30 text-sm text-[#ead397] focus:outline-none focus:border-[#c5a059]" />
        </div>
        <div id="change-pwd-status" class="hidden p-3 rounded-lg text-xs"></div>
        <button type="submit" class="w-full py-3 rounded-xl bg-gradient-to-r from-[#c5a059] to-[#ead397] text-[#0a050c] font-bold text-xs uppercase tracking-wider hover:brightness-110">
          Guardar Nueva Contraseña
        </button>
      </form>
    </div>
  </div>

  <!-- MODAL: CREACIÓN MANUAL GENÉRICA / 100% DESCUENTO -->
  <div id="modal-crud-create" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm">
    <div class="w-full max-w-lg p-6 sm:p-8 rounded-3xl bg-[#250e29] border border-[#c5a059]/40 shadow-2xl space-y-5 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-[#c5a059]/20 pb-3">
        <h3 id="modal-crud-title" class="text-lg font-serif font-bold text-[#ead397]">Añadir Nuevo Registro</h3>
        <button id="modal-crud-close" class="text-sm text-[#f7f4ee]/70 hover:text-white">✕</button>
      </div>
      <form id="form-crud-create" class="space-y-4">
        <div id="crud-fields-container" class="space-y-3">
          <!-- Populated by JS -->
        </div>
        <div id="crud-create-status" class="hidden p-3 rounded-lg text-xs"></div>
        <button type="submit" class="w-full py-3 rounded-xl bg-gradient-to-r from-[#c5a059] to-[#ead397] text-[#0a050c] font-bold text-xs uppercase tracking-wider hover:brightness-110 shadow-md">
          Guardar Registro
        </button>
      </form>
    </div>
  </div>

</Layout>

<script>
  // State Store
  let cachedMetrics: any = null;
  let activeDrawerType: "leads" | "affiliates" | "tickets" | "pending_cash" | "checkins" | null = null;
  let activeTagFilter = "todos";
  let videoStream: MediaStream | null = null;
  let qrScanActive = false;
  let scanCooldown = false;

  // DOM Elements
  const loginForm = document.getElementById("login-form") as HTMLFormElement;
  const adminPasswordInput = document.getElementById("admin-password-input") as HTMLInputElement;
  const loginError = document.getElementById("login-error");
  const btnLogout = document.getElementById("btn-logout");
  const btnRefresh = document.getElementById("btn-refresh");
  const btnCreateTicketTop = document.getElementById("btn-create-ticket-top");

  // KPIs
  const kpiLeads = document.getElementById("kpi-leads");
  const kpiAffiliates = document.getElementById("kpi-affiliates");
  const kpiTickets = document.getElementById("kpi-tickets");
  const kpiPendingCash = document.getElementById("kpi-pending-cash");
  const kpiCheckins = document.getElementById("kpi-checkins");
  const kpiRevenue = document.getElementById("kpi-revenue");

  // KPI Cards (Clickable)
  const cardLeads = document.getElementById("card-kpi-leads");
  const cardAffiliates = document.getElementById("card-kpi-affiliates");
  const cardTickets = document.getElementById("card-kpi-tickets");
  const cardPendingCash = document.getElementById("card-kpi-pending-cash");
  const cardCheckins = document.getElementById("card-kpi-checkins");
  const cardRevenue = document.getElementById("card-kpi-revenue");

  // Scanner Elements
  const tabCameraScan = document.getElementById("tab-camera-scan");
  const tabManualScan = document.getElementById("tab-manual-scan");
  const panelCameraScanner = document.getElementById("panel-camera-scanner");
  const panelManualScanner = document.getElementById("panel-manual-scanner");
  const qrVideoStream = document.getElementById("qr-video-stream") as HTMLVideoElement;
  const cameraLoadingOverlay = document.getElementById("camera-loading-overlay");
  const btnStartCamera = document.getElementById("btn-start-camera");
  const checkinForm = document.getElementById("checkin-form") as HTMLFormElement;
  const inputTicketHash = document.getElementById("input-ticket-hash") as HTMLInputElement;
  const btnCheckinSubmit = document.getElementById("btn-checkin-submit") as HTMLButtonElement;
  const checkinResult = document.getElementById("checkin-result");

  // QR Modal Popup
  const modalQrResult = document.getElementById("modal-qr-result");
  const qrModalIcon = document.getElementById("qr-modal-icon");
  const qrModalTitle = document.getElementById("qr-modal-title");
  const qrModalSubtitle = document.getElementById("qr-modal-subtitle");
  const qrModalBody = document.getElementById("qr-modal-body");
  const btnCloseQrModal = document.getElementById("btn-close-qr-modal");

  // Financial Modal
  const modalFinancial = document.getElementById("modal-financial");
  const modalFinancialClose = document.getElementById("modal-financial-close");
  const financialModalContent = document.getElementById("financial-modal-content");

  // Drawer Elements
  const drawerContainer = document.getElementById("drawer-container");
  const drawerBackdrop = document.getElementById("drawer-backdrop");
  const drawerClose = document.getElementById("drawer-close");
  const drawerTitle = document.getElementById("drawer-title");
  const drawerBadge = document.getElementById("drawer-badge");
  const drawerSearch = document.getElementById("drawer-search") as HTMLInputElement;
  const drawerBtnAddNew = document.getElementById("drawer-btn-add-new");
  const drawerContent = document.getElementById("drawer-content");

  // Password Modal
  const btnChangePasswordModal = document.getElementById("btn-change-password-modal");
  const modalPassword = document.getElementById("modal-password");
  const modalPasswordClose = document.getElementById("modal-password-close");
  const formChangePassword = document.getElementById("form-change-password") as HTMLFormElement;
  const inputCurPwd = document.getElementById("input-cur-pwd") as HTMLInputElement;
  const inputNewPwd = document.getElementById("input-new-pwd") as HTMLInputElement;
  const changePwdStatus = document.getElementById("change-pwd-status");

  // CRUD Modal
  const modalCrudCreate = document.getElementById("modal-crud-create");
  const modalCrudClose = document.getElementById("modal-crud-close");
  const modalCrudTitle = document.getElementById("modal-crud-title");
  const formCrudCreate = document.getElementById("form-crud-create") as HTMLFormElement;
  const crudFieldsContainer = document.getElementById("crud-fields-container");
  const crudCreateStatus = document.getElementById("crud-create-status");
  const btnAddAffiliateModal = document.getElementById("btn-add-affiliate-modal");
  const btnAddLeadModal = document.getElementById("btn-add-lead-modal");

  // Tables
  const unifiedTableBody = document.getElementById("unified-table-body");
  const btnAddUnifiedUser = document.getElementById("btn-add-unified-user");

  // Tag filter buttons
  document.querySelectorAll(".tag-filter-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".tag-filter-btn").forEach((b) => {
        b.className = "tag-filter-btn px-3 py-1.5 rounded-full border border-[#c5a059]/40 bg-[#250e29] text-[#ead397] hover:bg-[#c5a059]/20 transition-all font-semibold";
      });
      btn.className = "tag-filter-btn px-3 py-1.5 rounded-full border border-[#c5a059] bg-[#c5a059] text-[#0a050c] font-bold transition-all shadow-sm";
      activeTagFilter = btn.getAttribute("data-tag") || "todos";
      
      if (cachedMetrics) {
        renderUnifiedTable(filterByTag(cachedMetrics.leads));
        if (activeDrawerType) renderDrawer(activeDrawerType);
      }
    });
  });

  function filterByTag(items: any[]) {
    if (!items) return [];
    if (activeTagFilter === "todos") return items;
    if (activeTagFilter === "elplacerdc") {
      return items.filter((item) => {
        const org = (item.origen || "").toLowerCase();
        const tags = Array.isArray(item.metadata?.tags) ? item.metadata.tags : [];
        const channels = Array.isArray(item.metadata?.registered_channels) ? item.metadata.registered_channels : [];
        return org.includes("elplacerdc") || org.includes("comunidad") || org === "web" || org === "web_comunidad" ||
               tags.includes("elplacerdc") || channels.includes("elplacerdc") ||
               (!item.corset_vip && !org.includes("corset") && !org.includes("alianza"));
      });
    }
    if (activeTagFilter === "corset") {
      return items.filter((item) => {
        const org = (item.origen || "").toLowerCase();
        const tags = Array.isArray(item.metadata?.tags) ? item.metadata.tags : [];
        const channels = Array.isArray(item.metadata?.registered_channels) ? item.metadata.registered_channels : [];
        return item.corset_vip === true || org.includes("corset") || tags.includes("corset") || tags.includes("corset_vip") || channels.includes("corset");
      });
    }
    if (activeTagFilter === "aliados") {
      return items.filter((item) => {
        const org = (item.origen || "").toLowerCase();
        const tags = Array.isArray(item.metadata?.tags) ? item.metadata.tags : [];
        const channels = Array.isArray(item.metadata?.registered_channels) ? item.metadata.registered_channels : [];
        return org.includes("alianza") || org.includes("aliado") || org.includes("centro_cultural") || org.includes("impacto") ||
               tags.includes("alianza") || tags.includes("centro_cultural") || channels.includes("centro_cultural");
      });
    }
    return items;
  }

  // 1. LOGIN HANDLER
  loginForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const pwd = adminPasswordInput.value.trim();
    if (!pwd) return;

    try {
      const res = await fetch("/api/admin/auth/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ password: pwd }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        if (loginError) {
          loginError.textContent = data.error || "Contraseña incorrecta";
          loginError.classList.remove("hidden");
        }
      }
    } catch (e: any) {
      if (loginError) {
        loginError.textContent = "Error al conectar con el servidor";
        loginError.classList.remove("hidden");
      }
    }
  });

  // 2. LOGOUT HANDLER
  btnLogout?.addEventListener("click", async () => {
    await fetch("/api/admin/auth/logout", { method: "POST" });
    window.location.reload();
  });

  // 3. LOAD METRICS IN-PLACE
  async function loadMetrics() {
    try {
      const res = await fetch("/api/admin/metrics");
      if (res.status === 401) {
        if (btnLogout) {
          window.location.reload();
        }
        return;
      }
      const data = await res.json();
      if (!data.success) return;

      cachedMetrics = data;

      if (kpiLeads) kpiLeads.textContent = (data.counts.totalLeads ?? 0).toString();
      if (kpiAffiliates) kpiAffiliates.textContent = (data.counts.totalAliados ?? 0).toString();
      if (kpiTickets) kpiTickets.textContent = (data.counts.totalVip ?? 0).toString();
      if (kpiPendingCash) kpiPendingCash.textContent = (data.counts.totalTickets ?? 0).toString();
      if (kpiCheckins) kpiCheckins.textContent = `$${Number(data.counts.netRevenue ?? 0).toLocaleString("es-CO")}`;
      if (kpiRevenue) kpiRevenue.textContent = `$${Number(data.counts.netMargin ?? 0).toLocaleString("es-CO")}`;

      renderUnifiedTable(filterByTag(data.leads));

      // If drawer is open, re-render it
      if (activeDrawerType) {
        renderDrawer(activeDrawerType);
      }
    } catch (e) {
      console.error("[Admin Metrics Err]:", e);
    }
  }

  // 4. RENDER DIRECTORTIO UNIFICADO (Registro = Lead = Embajador)
  function renderUnifiedTable(leads: any[]) {
    if (!unifiedTableBody) return;
    if (!leads || leads.length === 0) {
      unifiedTableBody.innerHTML = '<tr><td colspan="9" class="py-6 text-center text-[#f7f4ee]/40">No hay registros con este filtro.</td></tr>';
      return;
    }

    unifiedTableBody.innerHTML = leads.map((l) => {
      const isVip = l.corset_vip === true || l.is_possible_vip === true;
      const affAlias = l.affiliate_alias ? `@${l.affiliate_alias}` : '—';
      const clicks = l.affiliate_clicks || 0;
      const refCount = l.affiliate_leads_count || 0;
      const salesCount = l.affiliate_sales_count || 0;
      const roleDisplay = l.rol ? l.rol.replace('_', ' ') : 'general';

      return `
        <tr class="hover:bg-[#250e29]/70 cursor-pointer transition-colors group" data-lead-id="${l.id}">
          <td class="py-3 px-3 font-medium text-[#f7f4ee]">
            <div class="font-serif font-bold text-sm text-[#ead397] group-hover:text-white transition-colors">${l.alias_nombre || "Invitado"}</div>
            <div class="text-[10px] text-[#f7f4ee]/40 font-mono">ID: ${l.id.substring(0, 8)}...</div>
          </td>
          <td class="py-3 px-3 font-mono text-[11px]">
            <div class="text-[#f7f4ee]/90">${l.whatsapp || "—"}</div>
            <div class="text-[#f7f4ee]/50 text-[10px] truncate max-w-[150px]">${l.email || "—"}</div>
          </td>
          <td class="py-3 px-3 font-mono text-[11px] text-[#ead397] font-semibold">
            ${affAlias}
          </td>
          <td class="py-3 px-3 text-[11px]">
            <span class="capitalize text-[#f7f4ee]/80">${roleDisplay}</span>
            <span class="block text-[10px] text-[#c5a059]/70">${l.origen || "web"}</span>
          </td>
          <td class="py-3 px-2 text-center font-mono text-xs">${clicks}</td>
          <td class="py-3 px-2 text-center font-mono text-xs text-[#ead397] font-semibold">${refCount}</td>
          <td class="py-3 px-2 text-center font-mono text-xs text-[#81c784] font-bold">${salesCount}</td>
          <td class="py-3 px-2 text-center">
            ${isVip ? '<span class="px-2 py-0.5 rounded-full bg-[#c5a059]/20 text-[#ead397] text-[10px] font-bold border border-[#c5a059]/40"><span class="sm:hidden text-xs">👑</span><span class="hidden sm:inline">👑 VIP</span></span>' : '<span class="text-[#f7f4ee]/30">—</span>'}
          </td>
          <td class="py-3 px-3 text-right">
            <div class="flex items-center justify-end gap-1.5">
              <button 
                type="button" 
                class="btn-row-add-ticket px-2.5 py-1 rounded-lg bg-[#c5a059]/20 text-[#ead397] hover:bg-[#c5a059]/30 border border-[#c5a059]/40 text-[10px] font-semibold whitespace-nowrap"
                data-lead-id="${l.id}"
                data-lead-name="${l.alias_nombre || ''}"
                title="Crear Pase o Cortesía asignado a este usuario"
              >
                + Pase
              </button>
              <button 
                type="button" 
                class="btn-delete-record px-2.5 py-1 rounded-lg bg-[#3a111b] text-[#ef5350] hover:bg-[#ef5350]/20 border border-[#ef5350]/30 text-[10px] font-semibold whitespace-nowrap"
                data-entity="user"
                data-id="${l.id}"
                data-name="${l.alias_nombre || 'este usuario'}"
                title="Eliminar usuario y su embajador de forma indivisible"
              >
                🗑️ Borrar
              </button>
            </div>
          </td>
        </tr>
      `;
    }).join("");
  }

  function renderLeadsTable(leads: any[]) {
    if (!leadsTableBody) return;
    if (leads.length === 0) {
      leadsTableBody.innerHTML = `<tr><td colspan="5" class="py-4 text-center text-[#f7f4ee]/40">No hay leads registrados con este filtro.</td></tr>`;
      return;
    }

    leadsTableBody.innerHTML = leads.slice(0, 10).map((l) => {
      const isVip = l.is_possible_vip || l.corset_vip;
      return `
        <tr class="hover:bg-[#250e29]/60 cursor-pointer transition-colors" data-lead-id="${l.id}">
          <td class="py-2.5 px-2 font-medium text-[#f7f4ee]">${l.alias_nombre || "Invitado"}</td>
          <td class="py-2.5 px-2 text-[11px] capitalize text-[#ead397]">${l.rol ? l.rol.replace('_', ' ') : "general"}</td>
          <td class="py-2.5 px-2 text-[10px] text-[#f7f4ee]/70">${l.origen || "web"}</td>
          <td class="py-2.5 px-2 text-center">
            ${isVip ? '<span class="px-2 py-0.5 rounded-full bg-[#c5a059]/20 text-[#ead397] text-[10px] font-bold border border-[#c5a059]/40">👑 VIP</span>' : '—'}
          </td>
          <td class="py-2.5 px-2 text-right">
            <button type="button" class="btn-delete-record text-[11px] text-[#ef5350] hover:underline" data-entity="lead" data-id="${l.id}">Eliminar</button>
          </td>
        </tr>
      `;
    }).join("");

    bindDeleteButtons();
  }

  
  function openDrawerWithLead(leadId: string) {
    if (!cachedMetrics?.leads) return;
    const lead = cachedMetrics.leads.find((l: any) => l.id === leadId);
    if (!lead) return;

    activeDrawerType = "leads";
    drawerContainer?.classList.remove("hidden");
    if (drawerBadge) drawerBadge.textContent = "Ficha de Usuario";
    if (drawerTitle) drawerTitle.textContent = lead.alias_nombre || "Invitado";

    const isVip = lead.corset_vip === true || lead.is_possible_vip === true;

    drawerContent.innerHTML = `
      <div class="space-y-4">
        <div class="p-5 rounded-2xl bg-[#250e29] border border-[#c5a059]/40 space-y-3">
          <div class="flex items-center justify-between">
            <h4 class="text-base font-serif font-bold text-[#ead397]">${lead.alias_nombre || "Invitado"}</h4>
            ${isVip ? '<span class="px-2 py-0.5 rounded-full bg-[#c5a059]/20 text-[#ead397] text-xs font-bold border border-[#c5a059]/40">👑 VIP</span>' : ''}
          </div>
          <div class="text-xs text-[#f7f4ee]/80 font-mono space-y-1">
            <div><strong>WhatsApp:</strong> ${lead.whatsapp || "—"}</div>
            <div><strong>Email:</strong> ${lead.email || "—"}</div>
            <div><strong>Modalidad:</strong> ${lead.rol ? lead.rol.replace('_', ' ') : "general"} • <strong>Ciudad:</strong> ${lead.ciudad || "Bogotá"}</div>
            <div><strong>Origen:</strong> ${lead.origen || "web"} • <strong>Registrado:</strong> ${new Date(lead.created_at).toLocaleString("es-CO")}</div>
          </div>
        </div>

        <div class="p-5 rounded-2xl bg-[#250e29] border border-[#c5a059]/30 space-y-2">
          <h5 class="text-xs uppercase text-[#c5a059] font-bold">Programa de Embajador</h5>
          <div class="text-xs text-[#f7f4ee]/80 font-mono space-y-1">
            <div><strong>Código:</strong> @${lead.affiliate_alias || "No asignado"}</div>
            <div><strong>Clics en Link:</strong> ${lead.affiliate_clicks || 0}</div>
            <div><strong>Referidos Registrados:</strong> ${lead.affiliate_leads_count || 0}</div>
            <div><strong>Ventas Pagadas Acreditadas:</strong> ${lead.affiliate_sales_count || 0}</div>
            <div><strong>Entradas Gratuitas Ganadas:</strong> ${lead.affiliate_tickets_won || 0}</div>
          </div>
        </div>

        <div class="flex items-center gap-3 pt-2">
          <button type="button" class="btn-drawer-add-ticket flex-1 py-2.5 rounded-xl bg-gradient-to-r from-[#c5a059] to-[#ead397] text-[#0a050c] font-bold text-xs uppercase" data-lead-id="${lead.id}">
            + Asignar Pase o Cortesía
          </button>
          <button type="button" class="btn-delete-record py-2.5 px-4 rounded-xl bg-[#3a111b] text-[#ef5350] border border-[#ef5350]/30 font-semibold text-xs" data-entity="user" data-id="${lead.id}">
            🗑️ Eliminar Usuario
          </button>
        </div>
      </div>
    `;

    drawerContent.querySelector(".btn-drawer-add-ticket")?.addEventListener("click", () => {
      openCrudModal("tickets", lead.id);
    });

    drawerContent.querySelector(".btn-delete-record")?.addEventListener("click", async () => {
      if (!confirm("¿Eliminar este usuario y su embajador en cascada indivisible?")) return;
      await fetch(`/api/admin/records?entity=user&id=${lead.id}`, { method: "DELETE" });
      drawerContainer?.classList.add("hidden");
      loadMetrics();
    });
  }

  // Event delegation on unifiedTableBody for instant reactivity (Optimistic UI)
  unifiedTableBody?.addEventListener("click", async (e) => {
    const target = e.target as HTMLElement;

    // + Pase button
    const addTicketBtn = target.closest(".btn-row-add-ticket") as HTMLElement;
    if (addTicketBtn) {
      e.stopPropagation();
      const leadId = addTicketBtn.getAttribute("data-lead-id");
      if (leadId) openCrudModal("tickets", leadId);
      return;
    }

    // Delete record button
    const deleteBtn = target.closest(".btn-delete-record") as HTMLElement;
    if (deleteBtn) {
      e.stopPropagation();
      const entity = deleteBtn.getAttribute("data-entity") || "user";
      const id = deleteBtn.getAttribute("data-id");
      const name = deleteBtn.getAttribute("data-name") || "este usuario";
      if (!id) return;

      if (!confirm(`¿Estás seguro de eliminar a "${name}" (y su perfil de embajador en cascada indivisible)?`)) return;

      const row = deleteBtn.closest("tr");
      if (row) {
        row.style.opacity = "0.3";
        row.style.pointerEvents = "none";
      }

      try {
        const res = await fetch(`/api/admin/records?entity=${entity}&id=${id}`, { method: "DELETE" });
        const data = await res.json();
        if (data.success) {
          if (row) row.remove();
          if (cachedMetrics?.leads) {
            cachedMetrics.leads = cachedMetrics.leads.filter((l: any) => l.id !== id);
            cachedMetrics.counts.totalLeads = Math.max(0, (cachedMetrics.counts.totalLeads || 1) - 1);
            if (kpiLeads) kpiLeads.textContent = cachedMetrics.counts.totalLeads.toString();
          }
        } else {
          alert(data.error || "No se pudo eliminar el registro");
          if (row) {
            row.style.opacity = "1";
            row.style.pointerEvents = "auto";
          }
        }
      } catch (err: any) {
        alert("Error de conexión al eliminar");
        if (row) {
          row.style.opacity = "1";
          row.style.pointerEvents = "auto";
        }
      }
      return;
    }

    // Row click -> drawer
    const row = target.closest("tr");
    if (row && row.hasAttribute("data-lead-id")) {
      const leadId = row.getAttribute("data-lead-id");
      if (leadId) openDrawerWithLead(leadId);
    }
  });

  function bindDeleteButtons() {
    document.querySelectorAll(".btn-delete-record").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        e.stopPropagation();
        const entity = btn.getAttribute("data-entity");
        const id = btn.getAttribute("data-id");
        const name = btn.getAttribute("data-name") || "este registro";
        if (!confirm(`¿Estás seguro de eliminar a "${name}" de ${entity}?`)) return;

        try {
          const res = await fetch(`/api/admin/records?entity=${entity}&id=${id}`, { method: "DELETE" });
          const data = await res.json();
          if (data.success) {
            loadMetrics();
          } else {
            alert(data.error || "No se pudo eliminar el registro");
          }
        } catch (err: any) {
          alert("Error de conexión al eliminar");
        }
      });
    });
  }

