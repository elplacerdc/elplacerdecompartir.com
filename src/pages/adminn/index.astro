    const isPaidVip = Boolean(lead.is_active_vip || (lead.vip_until && new Date(lead.vip_until) > new Date()));
    const isPossibleVip = Boolean((lead.is_possible_vip || lead.corset_vip) && !isPaidVip);

    drawerContent.innerHTML = `
      <div class="space-y-4">
        <div class="p-5 rounded-2xl bg-[#250e29] border border-[#c5a059]/40 space-y-3">
          <div class="flex items-center justify-between">
