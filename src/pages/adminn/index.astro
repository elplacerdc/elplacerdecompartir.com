  // Event delegation on unifiedTableBody for instant reactivity (Optimistic UI)
  unifiedTableBody?.addEventListener("click", async (e) => {
    const target = e.target as HTMLElement;

    // ✏️ Edit Lead button
    const editLeadBtn = target.closest(".btn-row-edit-lead") as HTMLElement;
    if (editLeadBtn) {
      e.stopPropagation();
      const leadId = editLeadBtn.getAttribute("data-lead-id");
      if (leadId) openEditLeadModal(leadId);
      return;
    }

    // 🎟️ Events History button
    const eventsBtn = target.closest(".btn-row-events") as HTMLElement;
    if (eventsBtn) {
      e.stopPropagation();
      const leadId = eventsBtn.getAttribute("data-lead-id");
      if (leadId) openUserEventsModal(leadId);
      return;
    }

    // + Pase button
    const addTicketBtn = target.closest(".btn-row-add-ticket") as HTMLElement;
    if (addTicketBtn) {
      e.stopPropagation();
      const leadId = addTicketBtn.getAttribute("data-lead-id");
      if (leadId) openCrudModal("tickets", leadId);
      return;
    }

    // Delete record button
    const deleteBtn = target.closest(".btn-delete-record") as HTMLElement;
    if (deleteBtn) {
      e.stopPropagation();
      const entity = deleteBtn.getAttribute("data-entity") || "user";
      const id = deleteBtn.getAttribute("data-id");
      const name = deleteBtn.getAttribute("data-name") || "este usuario";
      if (!id) return;

      if (!confirm(`¿Estás seguro de eliminar a "${name}" (y su perfil de embajador en cascada indivisible)?`)) return;

      const row = deleteBtn.closest("tr");
      if (row) {
        row.style.opacity = "0.3";
        row.style.pointerEvents = "none";
      }

      try {
        const res = await fetch(`/api/admin/records?entity=${entity}&id=${id}`, { method: "DELETE" });
        const data = await res.json();
        if (data.success) {
          if (row) row.remove();
          await loadMetrics();
        } else {
          alert(data.error || "No se pudo eliminar el registro");
          if (row) {
            row.style.opacity = "1";
            row.style.pointerEvents = "auto";
          }
        }
      } catch (err: any) {
        alert("Error de conexión al eliminar");
        if (row) {
          row.style.opacity = "1";
          row.style.pointerEvents = "auto";
        }
      }
      return;
    }

    // Row click -> drawer
    const row = target.closest("tr");
    if (row && row.hasAttribute("data-lead-id")) {
      const leadId = row.getAttribute("data-lead-id");
      if (leadId) openDrawerWithLead(leadId);
    }
  });

  // Modal Edit Lead Elements
  const modalEditLead = document.getElementById("modal-edit-lead");
  const modalEditLeadClose = document.getElementById("modal-edit-lead-close");
  const formEditLead = document.getElementById("form-edit-lead") as HTMLFormElement;
  const editLeadId = document.getElementById("edit-lead-id") as HTMLInputElement;
  const editLeadAlias = document.getElementById("edit-lead-alias") as HTMLInputElement;
  const editLeadWa = document.getElementById("edit-lead-wa") as HTMLInputElement;
  const editLeadEmail = document.getElementById("edit-lead-email") as HTMLInputElement;
  const editLeadRol = document.getElementById("edit-lead-rol") as HTMLSelectElement;
  const editLeadCiudad = document.getElementById("edit-lead-ciudad") as HTMLInputElement;
  const editLeadOrigen = document.getElementById("edit-lead-origen") as HTMLInputElement;
  const editLeadAfiliado = document.getElementById("edit-lead-afiliado") as HTMLInputElement;
  const editLeadIsVip = document.getElementById("edit-lead-is-vip") as HTMLInputElement;
  const editLeadCorsetVip = document.getElementById("edit-lead-corset-vip") as HTMLInputElement;
  const editLeadVipUntil = document.getElementById("edit-lead-vip-until") as HTMLInputElement;
  const editLeadPrimerPago = document.getElementById("edit-lead-primer-pago") as HTMLInputElement;
  const editLeadStatus = document.getElementById("edit-lead-status");

  modalEditLeadClose?.addEventListener("click", () => modalEditLead?.classList.add("hidden"));

  function openEditLeadModal(leadId: string) {
    if (!cachedMetrics?.leads) return;
    const lead = cachedMetrics.leads.find((l: any) => l.id === leadId);
    if (!lead) return;

    if (editLeadId) editLeadId.value = lead.id;
    if (editLeadAlias) editLeadAlias.value = lead.alias_nombre || "";
    if (editLeadWa) editLeadWa.value = lead.whatsapp || "";
    if (editLeadEmail) editLeadEmail.value = lead.email || "";
    if (editLeadRol) editLeadRol.value = lead.rol || "pareja";
    if (editLeadCiudad) editLeadCiudad.value = lead.ciudad || "bogota";
    if (editLeadOrigen) editLeadOrigen.value = lead.origen || "web";
    if (editLeadAfiliado) editLeadAfiliado.value = lead.afiliado_id || "";

    const isVip = Boolean(lead.is_active_vip || (lead.vip_until && new Date(lead.vip_until) > new Date()));
    if (editLeadIsVip) editLeadIsVip.checked = isVip;
    if (editLeadCorsetVip) editLeadCorsetVip.checked = Boolean(lead.corset_vip || lead.is_possible_vip);
    if (editLeadVipUntil) {
      editLeadVipUntil.value = lead.vip_until ? new Date(lead.vip_until).toISOString().split("T")[0] : "";
    }
    if (editLeadPrimerPago) editLeadPrimerPago.checked = Boolean(lead.primer_pago_acreditado);
    if (editLeadStatus) editLeadStatus.classList.add("hidden");

    modalEditLead?.classList.remove("hidden");
  }

  formEditLead?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!editLeadId?.value) return;

    const updates = {
      alias_nombre: editLeadAlias.value.trim(),
      whatsapp: editLeadWa.value.trim() || null,
      email: editLeadEmail.value.trim() || null,
      rol: editLeadRol.value,
      ciudad: editLeadCiudad.value.trim() || null,
      origen: editLeadOrigen.value.trim() || null,
      afiliado_id: editLeadAfiliado.value.trim().toLowerCase() || null,
      corset_vip: editLeadCorsetVip.checked,
      vip_status: editLeadIsVip.checked ? "vip_activo" : (editLeadCorsetVip.checked ? "posible_vip" : "no_vip"),
      vip_until: editLeadVipUntil.value ? new Date(editLeadVipUntil.value).toISOString() : (editLeadIsVip.checked ? new Date(Date.now() + 365*24*3600*1000).toISOString() : null),
      primer_pago_acreditado: editLeadPrimerPago.checked,
    };

    try {
      const res = await fetch("/api/admin/records", {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ entity: "lead", id: editLeadId.value, updates }),
      });
      const data = await res.json();
      if (data.success) {
        if (editLeadStatus) {
          editLeadStatus.className = "p-3 rounded-lg text-xs bg-[#2e7d32]/25 text-[#81c784] block";
          editLeadStatus.textContent = "✓ Perfil actualizado exitosamente";
        }
        setTimeout(() => {
          modalEditLead?.classList.add("hidden");
          loadMetrics();
        }, 800);
      } else {
        if (editLeadStatus) {
          editLeadStatus.className = "p-3 rounded-lg text-xs bg-[#b71c1c]/25 text-[#ef5350] block";
          editLeadStatus.textContent = data.error || "Error al actualizar perfil";
        }
      }
    } catch (err: any) {
      if (editLeadStatus) {
        editLeadStatus.className = "p-3 rounded-lg text-xs bg-[#b71c1c]/25 text-[#ef5350] block";
        editLeadStatus.textContent = "Error de conexión al guardar cambios";
      }
    }
  });

  // Modal User Events Elements
  const modalUserEvents = document.getElementById("modal-user-events");
  const modalUserEventsClose = document.getElementById("modal-user-events-close");
  const modalUserEventsTitle = document.getElementById("modal-user-events-title");
  const modalUserEventsList = document.getElementById("modal-user-events-list");

  modalUserEventsClose?.addEventListener("click", () => modalUserEvents?.classList.add("hidden"));

  function openUserEventsModal(leadId: string) {
    if (!cachedMetrics?.leads) return;
    const lead = cachedMetrics.leads.find((l: any) => l.id === leadId);
    if (!lead) return;

    if (modalUserEventsTitle) {
      modalUserEventsTitle.textContent = `Eventos de ${lead.alias_nombre || "Usuario"}`;
    }

    const events = Array.isArray(lead.events_list) ? lead.events_list : [];
    if (!modalUserEventsList) return;

    if (events.length === 0) {
      modalUserEventsList.innerHTML = `<p class="text-[#f7f4ee]/40 text-center py-6">No registra historial de pases o asistencias aún.</p>`;
    } else {
      modalUserEventsList.innerHTML = events.map((ev: any) => `
        <div class="p-3.5 rounded-2xl bg-[#140816] border border-[#c5a059]/20 flex items-center justify-between gap-3 shadow-sm">
          <div>
            <div class="font-bold text-[#ead397] font-serif text-xs capitalize">${(ev.evento || "Evento").replace(/_/g, " ")}</div>
            <div class="text-[10px] text-[#f7f4ee]/60 font-mono mt-0.5">
              ${ev.tipo_entrada || "General"} • ${ev.created_at ? new Date(ev.created_at).toLocaleDateString("es-CO", { timeZone: "America/Bogota" }) : "—"}
            </div>
            ${ev.monto_pagado ? `<div class="text-[10px] text-[#81c784] font-mono">$${Number(ev.monto_pagado).toLocaleString("es-CO")} COP</div>` : ''}
          </div>
          <span class="px-2.5 py-1 rounded-full text-[10px] font-bold shrink-0 ${
            ev.estado === "asistido"
              ? "bg-[#81c784]/20 text-[#81c784] border border-[#81c784]/40"
              : "bg-[#c5a059]/20 text-[#ead397] border border-[#c5a059]/30"
          }">
            ${ev.estado === "asistido" ? "✓ Asistido" : (ev.estado || "Confirmado")}
          </span>
        </div>
      `).join("");
    }

    modalUserEvents?.classList.remove("hidden");
  }

  function bindDeleteButtons() {
    document.querySelectorAll(".btn-delete-record").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        e.stopPropagation();
        const entity = btn.getAttribute("data-entity") || "registro";
        const id = btn.getAttribute("data-id");
        const name = btn.getAttribute("data-name") || "este registro";
        let confirmMsg = `¿Estás seguro de eliminar a "${name}"?`;
        if (entity === "ticket") {
          confirmMsg = `¿Estás seguro de eliminar el ${name}?`;
        } else if (entity === "lead" || entity === "user" || entity === "affiliate") {
          confirmMsg = `¿Estás seguro de eliminar a "${name}" (y su perfil de embajador en cascada indivisible)?`;
        }
        if (!confirm(confirmMsg)) return;

        try {
          const res = await fetch(`/api/admin/records?entity=${entity}&id=${id}`, { method: "DELETE" });
          const data = await res.json();
          if (data.success) {
            loadMetrics();
          } else {
            alert(data.error || "No se pudo eliminar el registro");
          }
        } catch (err: any) {
          alert("Error de conexión al eliminar");
        }
      });
    });
  }

  // 5. DRAWER SINGLE-PAGE SYSTEM
  function openDrawer(type: "leads" | "affiliates" | "tickets" | "pending_cash" | "checkins" | "aliados" | "vip") {
    activeDrawerType = type;
    drawerContainer?.classList.remove("hidden");
    renderDrawer(type);
  }

  function closeDrawer() {
    activeDrawerType = null;
    drawerContainer?.classList.add("hidden");
  }

  drawerBackdrop?.addEventListener("click", closeDrawer);
  drawerClose?.addEventListener("click", closeDrawer);

  cardLeads?.addEventListener("click", () => openDrawer("leads"));
  cardAffiliates?.addEventListener("click", () => openDrawer("aliados"));
  cardTickets?.addEventListener("click", () => openDrawer("vip"));
  cardPendingCash?.addEventListener("click", () => openDrawer("tickets"));
  cardCheckins?.addEventListener("click", () => {
    modalFinancial?.classList.remove("hidden");
    renderFinancialModal();
  });
  cardRevenue?.addEventListener("click", () => {
    modalFinancial?.classList.remove("hidden");
