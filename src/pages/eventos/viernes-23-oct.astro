---
// viernes-23-oct.astro - Evento Oficial Viernes 23 de Octubre
import Layout from "../../layouts/Layout.astro";
import { pool } from "../../db/index";

const cookieRef = Astro.cookies.get("affiliate_ref")?.value || Astro.url.searchParams.get("ref") || Astro.url.searchParams.get("r") || null;
---

<Layout 
  title="Viernes 23 de Octubre — Show de Sexo en Vivo | El Placer de Compartir"
  description="¡Sin cover para pareja! Ven a disfrutar de un nuevo espacio dispuesto para que vivas el erotismo y la sexualidad con libertad y discreción en Bogotá. Show de sexo en vivo. Ahorra $5.000 reservando tu cover o consumo online."
  ogImage="/media/eventos-elplacerdc/og-viernes-23-oct.jpg"
  ogImageWidth={720}
  ogImageHeight={1052}
  isCorset={false}
>
  <div class="min-h-screen bg-[#140816] text-[#f7f4ee] font-sans selection:bg-[#c5a059] selection:text-[#0a0608] relative overflow-hidden">
    
    <!-- Ambient Glow Backgrounds -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 bg-gradient-to-b from-[#8B1E3F]/20 via-[#4A0E2E]/10 to-transparent blur-3xl pointer-events-none"></div>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-20 space-y-14 relative z-10">
      
      <!-- HERO HEADER -->
      <section class="text-center space-y-5 max-w-4xl mx-auto">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-[#c5a059]/40 bg-[#250F22]/90 text-xs tracking-[0.2em] uppercase text-[#ead397] font-semibold shadow-md">
          <span>✨</span> Evento Oficial • Centro Cultural ElPlacerDC <span>🍷</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif font-bold tracking-tight text-[#f7f4ee] leading-tight">
          Viernes 23 de Octubre <br />
          <span class="italic font-normal text-transparent bg-clip-text bg-gradient-to-r from-[#c5a059] via-[#ead397] to-[#c5a059]">
            ¡Sin Cover Para Pareja!
          </span>
        </h1>

        <p class="max-w-2xl mx-auto text-base sm:text-lg font-light text-[#f7f4ee]/85 leading-relaxed">
          Ven a disfrutar de un nuevo espacio dispuesto para que vivas el erotismo y la sexualidad con total libertad, confianza y discreción en Bogotá.
        </p>

        <!-- Banner Destacado: Show de Sexo en Vivo -->
        <div class="inline-flex items-center gap-2.5 px-6 py-2.5 rounded-2xl bg-gradient-to-r from-[#8B1E3F]/40 via-[#4A0E2E]/60 to-[#8B1E3F]/40 border border-[#b84a39]/60 shadow-[0_0_25px_rgba(184,74,57,0.3)]">
          <span class="text-lg">🔥</span>
          <span class="font-serif font-bold text-sm sm:text-base text-[#ead397] uppercase tracking-wider">
            Gran Show de Sexo en Vivo
          </span>
          <span class="text-lg">🔥</span>
        </div>
      </section>

      <!-- FLYER OFICIAL & HIGHLIGHTS GRID -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center max-w-5xl mx-auto">
        
        <!-- Columna Flyer -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="w-full max-w-sm bg-[#250F22] p-3 sm:p-4 rounded-3xl border border-[#c5a059]/40 shadow-2xl flex flex-col items-center">
            <img 
              src="/media/eventos-elplacerdc/elplacerdc-viernes-23.jpg" 
              alt="Flyer Oficial Viernes 23 de Octubre — El Placer de Compartir" 
              class="rounded-2xl w-full max-h-[580px] object-contain shadow-lg border border-[#c5a059]/20"
              loading="eager"
            />
            <div class="pt-3 text-center">
              <span class="inline-block px-3 py-1 rounded-full bg-[#180A1A] border border-[#c5a059]/30 text-[11px] text-[#ead397] font-semibold">
                Flyer Oficial de Convocatoria • Viernes 23 Octubre
              </span>
            </div>
          </div>
        </div>

        <!-- Columna Datos Clave & Propuesta de Valor -->
        <div class="lg:col-span-7 space-y-6">
          <div class="p-6 sm:p-8 rounded-3xl bg-[#250F22] border border-[#c5a059]/40 space-y-6 shadow-xl">
            <h2 class="font-serif text-2xl font-bold text-[#ead397] flex items-center gap-2">
              <span>📍</span> Información del Encuentro
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm">
              <div class="p-4 rounded-2xl bg-[#140816] border border-[#c5a059]/20 space-y-1">
                <span class="text-[10px] uppercase font-bold tracking-wider text-[#c5a059]">Horario de Apertura</span>
                <p class="text-base font-serif font-bold text-white flex items-center gap-1.5">
                  <span>🕒</span> Desde las 7:00 p.m.
                </p>
                <p class="text-[11px] text-[#f7f4ee]/60">Llega temprano para disfrutar la velada completa.</p>
              </div>

              <div class="p-4 rounded-2xl bg-[#140816] border border-[#c5a059]/20 space-y-1">
                <span class="text-[10px] uppercase font-bold tracking-wider text-[#c5a059]">Ubicación Exclusiva</span>
                <p class="text-base font-serif font-bold text-white flex items-center gap-1.5">
                  <span>🏛️</span> Calle 67 #23-46
                </p>
                <p class="text-[11px] text-[#ead397]">Bogotá, Colombia • <em>¡No olvides timbrar!</em></p>
              </div>
            </div>

            <!-- Beneficios Destacados -->
            <div class="space-y-3 pt-2 border-t border-[#c5a059]/20">
              <span class="text-xs font-serif font-bold text-[#ead397] uppercase tracking-wider block">
                ¿Qué vivirás este viernes?
              </span>
              <ul class="space-y-2.5 text-xs sm:text-sm text-[#f7f4ee]/80 font-light">
                <li class="flex items-start gap-2.5">
                  <span class="text-[#c5a059] font-bold">✓</span>
                  <span><strong>¡Sin cover para pareja!</strong> Asiste en pareja pagando únicamente tu consumo mínimo ($60.000 online vs $65.000 en puerta).</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-[#c5a059] font-bold">✓</span>
                  <span><strong>Show de Sexo en Vivo:</strong> Performance y espectáculo erótico en nuestro escenario central.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-[#c5a059] font-bold">✓</span>
                  <span><strong>Comunidad de Mente Abierta:</strong> Atmósfera íntima, cuidada, con consentimiento lúcido y sin prejuicios ni presiones.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-[#c5a059] font-bold">✓</span>
                  <span><strong>Descuento Exclusivo Online:</strong> Ahorras $5.000 COP en tu pase o consumo reservando y pagando por la web.</span>
                </li>
              </ul>
            </div>

            <div class="pt-2">
              <a 
                href="#opciones-pago" 
                class="inline-flex items-center justify-center gap-2 w-full py-3.5 rounded-full font-serif font-bold text-xs uppercase tracking-wider bg-gradient-to-r from-[#c5a059] via-[#ead397] to-[#c5a059] text-[#0a0608] shadow-[0_0_20px_rgba(197,160,89,0.35)] hover:scale-[1.02] active:scale-[0.98] transition-all"
              >
                Elegir Modalidad de Reserva o Pago →
              </a>
            </div>
          </div>
        </div>

      </section>

      <!-- SECCIÓN DE TARIFAS Y OPCIONES DE PAGO -->
      <section id="opciones-pago" class="pt-6 space-y-8 scroll-mt-24">
        
        <div class="text-center space-y-3">
          <span class="text-xs uppercase tracking-widest text-[#c5a059] font-bold">Opciones de Acceso & Tarifas</span>
          <h2 class="text-3xl sm:text-4xl font-serif font-bold text-[#ead397]">Elige Tu Modalidad</h2>
          <p class="text-xs sm:text-sm text-[#f7f4ee]/70 max-w-xl mx-auto leading-relaxed">
            Asegura tu cupo con tarifa promocional pagando por la web, o reserva sin costo y paga al llegar en puerta.
          </p>
        </div>

        <!-- 3 Cards de Opciones -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
          
          <!-- Card 1: Solo Cover (Solos y Solas) -->
          <div 
            id="card-cover_individual" 
            class="tier-card p-6 rounded-3xl bg-[#250F22] border-2 border-[#c5a059]/40 hover:border-[#c5a059] transition-all flex flex-col justify-between space-y-6 shadow-xl relative cursor-pointer"
            data-tier="cover_individual"
            data-monto="15000"
            data-mode="pago_online"
          >
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="px-3 py-1 rounded-full bg-[#c5a059]/20 text-[#ead397] font-bold text-xs uppercase tracking-wider">
                  Solo Cover 👤
                </span>
                <span class="text-[11px] bg-[#81c784]/20 text-[#81c784] border border-[#81c784]/40 px-2 py-0.5 rounded-full font-mono font-bold">
                  -$5.000 Online
                </span>
              </div>

              <div>
                <span class="text-[11px] text-[#f7f4ee]/50 line-through">En puerta: $20.000 COP</span>
                <div class="text-3xl font-serif font-bold text-[#f7f4ee] flex items-baseline gap-1 mt-0.5">
                  <span>$15.000</span>
                  <span class="text-xs font-normal text-[#f7f4ee]/50 font-sans">COP</span>
                </div>
                <p class="text-xs text-[#81c784] font-medium mt-1">
                  ⚡ Tarifa especial exclusiva pagando por la página web
                </p>
              </div>

              <ul class="text-xs text-[#f7f4ee]/80 space-y-2 pt-2 border-t border-[#c5a059]/20 font-light">
                <li class="flex items-start gap-1.5">✓ Válido para solos y solas (hombres solos o mujeres solas).</li>
                <li class="flex items-start gap-1.5">✓ Acceso oficial al nuevo espacio y Show de Sexo en Vivo.</li>
                <li class="flex items-start gap-1.5">✓ El consumo de bebidas es libre y se paga en barra.</li>
              </ul>
            </div>

            <button 
              type="button" 
              class="tier-btn w-full py-2.5 rounded-full border border-[#c5a059] text-xs font-serif uppercase tracking-wider font-bold text-[#c5a059] hover:bg-[#c5a059] hover:text-[#0a0608] transition-all"
            >
              Seleccionar Solo Cover →
            </button>
          </div>

          <!-- Card 2: Todo Consumo (Parejas) -->
          <div 
            id="card-consumo_pareja" 
            class="tier-card p-6 rounded-3xl bg-gradient-to-b from-[#380b1e] to-[#250F22] border-2 border-[#ead397] transition-all flex flex-col justify-between space-y-6 shadow-2xl relative cursor-pointer ring-1 ring-[#c5a059]/40"
            data-tier="consumo_pareja"
            data-monto="60000"
            data-mode="pago_online"
          >
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-[#ead397] text-[#0a0608] text-[10px] font-bold uppercase tracking-widest px-3 py-0.5 rounded-full shadow-md whitespace-nowrap">
              ¡Opción Más Elegida Parejas!
            </div>

            <div class="space-y-4 pt-1">
              <div class="flex items-center justify-between">
                <span class="px-3 py-1 rounded-full bg-[#c5a059]/20 text-[#ead397] font-bold text-xs uppercase tracking-wider">
                  Parejas: 100% Consumo 👫
                </span>
                <span class="text-[11px] bg-[#81c784]/20 text-[#81c784] border border-[#81c784]/40 px-2 py-0.5 rounded-full font-mono font-bold">
                  -$5.000 Online
                </span>
              </div>

              <div>
                <span class="text-[11px] text-[#f7f4ee]/50 line-through">En puerta: $65.000 COP</span>
                <div class="text-3xl font-serif font-bold text-[#ead397] flex items-baseline gap-1 mt-0.5">
                  <span>$60.000</span>
                  <span class="text-xs font-normal text-[#f7f4ee]/50 font-sans">COP</span>
                </div>
                <p class="text-xs text-[#81c784] font-medium mt-1">
                  🍷 ¡La pareja NO PAGA COVER! Todo va a consumo
                </p>
              </div>

              <ul class="text-xs text-[#f7f4ee]/80 space-y-2 pt-2 border-t border-[#c5a059]/20 font-light">
                <li class="flex items-start gap-1.5">✓ Ingreso para dos personas (pareja mixta o diversa).</li>
                <li class="flex items-start gap-1.5">✓ Cover de la pareja: <strong>$0</strong>.</li>
                <li class="flex items-start gap-1.5">✓ Los $60.000 van íntegros para consumir en licores y carta.</li>
                <li class="flex items-start gap-1.5">✓ Ahorras $5.000 COP frente a los $65.000 requeridos en puerta.</li>
              </ul>
            </div>

            <button 
              type="button" 
              class="tier-btn w-full py-2.5 rounded-full bg-gradient-to-r from-[#c5a059] to-[#ead397] text-xs font-serif uppercase tracking-wider font-bold text-[#0a0608] hover:brightness-110 transition-all shadow-md"
            >
              Seleccionar Consumo Pareja →
            </button>
          </div>

          <!-- Card 3: Reserva General Sin Costo (Todo en Puerta) -->
          <div 
            id="card-reserva_gratuita" 
            class="tier-card p-6 rounded-3xl bg-[#250F22] border-2 border-[#c5a059]/40 hover:border-[#c5a059] transition-all flex flex-col justify-between space-y-6 shadow-xl relative cursor-pointer"
            data-tier="reserva_gratuita"
            data-monto="0"
            data-mode="reserva_gratuita"
          >
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="px-3 py-1 rounded-full bg-[#180A1A] text-[#f7f4ee]/80 font-bold text-xs uppercase tracking-wider border border-[#c5a059]/30">
                  Pagar en Puerta 🎟️
                </span>
                <span class="text-[11px] bg-[#c5a059]/20 text-[#ead397] border border-[#c5a059]/40 px-2 py-0.5 rounded-full font-mono">
                  $0 Ahora
                </span>
              </div>

              <div>
                <span class="text-[11px] text-[#f7f4ee]/50">Asegura tu cupo previo</span>
                <div class="text-3xl font-serif font-bold text-[#f7f4ee] flex items-baseline gap-1 mt-0.5">
                  <span>$0</span>
                  <span class="text-xs font-normal text-[#f7f4ee]/50 font-sans">COP Online</span>
                </div>
                <p class="text-xs text-[#ead397] font-medium mt-1">
                  Abonas en la entrada al llegar al Centro Cultural
                </p>
              </div>

              <ul class="text-xs text-[#f7f4ee]/80 space-y-2 pt-2 border-t border-[#c5a059]/20 font-light">
                <li class="flex items-start gap-1.5">✓ Generación de pase y credencial oficial con código QR.</li>
                <li class="flex items-start gap-1.5">✓ Tarifa normal en puerta: $20k cover individual / $65k consumo mínimo pareja.</li>
                <li class="flex items-start gap-1.5">✓ Sin pagos con tarjeta previos en la web.</li>
              </ul>
            </div>

            <button 
              type="button" 
              class="tier-btn w-full py-2.5 rounded-full border border-[#c5a059]/60 text-xs font-serif uppercase tracking-wider font-bold text-[#ead397] hover:bg-[#c5a059]/20 transition-all"
            >
              Seleccionar Pagar en Puerta →
            </button>
          </div>

        </div>

        <!-- FORMULARIO INTERACTIVO UNIFICADO -->
        <div id="checkout-container" class="max-w-2xl mx-auto p-6 sm:p-8 rounded-3xl bg-[#250F22] border border-[#c5a059]/50 shadow-2xl space-y-6">
          
          <!-- Encabezado de la selección activa -->
          <div class="flex items-center justify-between border-b border-[#c5a059]/20 pb-4">
            <div>
              <span class="text-[10px] uppercase font-bold tracking-wider text-[#c5a059]">Modalidad Seleccionada</span>
              <h3 id="selected-tier-title" class="font-serif text-lg font-bold text-[#ead397]">
                Todo en Consumo (Parejas) — Promo Web
              </h3>
            </div>
            <div class="text-right">
              <span class="text-[10px] uppercase font-bold tracking-wider text-[#f7f4ee]/50">Total a Pagar Web</span>
              <div id="selected-tier-price" class="font-mono text-xl font-bold text-[#81c784]">
                $60.000 COP
              </div>
            </div>
          </div>

          <!-- Banner de Perfil Pre-diligenciado (Sesión Activa) -->
          <div id="prefilled-profile-notice" class="hidden p-3.5 rounded-xl bg-[#c5a059]/15 border border-[#c5a059]/30 text-xs text-[#ead397] flex items-center justify-between">
            <span class="flex items-center gap-1.5">
              <span>👤</span> Hemos cargado tus datos registrados en la comunidad.
            </span>
            <button type="button" id="btn-unlock-profile" class="text-[11px] underline text-white hover:text-[#ead397] font-semibold">
              Modificar datos
            </button>
          </div>

          <form id="unified-checkout-form" class="space-y-4">
            <input type="hidden" id="form-evento" name="evento" value="viernes_23" />
            <input type="hidden" id="form-tipo-entrada" name="tipo_entrada" value="consumo_pareja" />
            <input type="hidden" id="form-mode" name="mode" value="pago_online" />

            <!-- Pseudónimo / Nombre -->
            <div>
              <label for="alias_nombre" class="block text-xs font-semibold uppercase tracking-wider text-[#c5a059] mb-1">
                Pseudónimo o Nombre Discreto <span class="text-[#ef5350]">*</span>
              </label>
              <input 
                type="text" 
                id="alias_nombre" 
                name="alias_nombre" 
                required 
                placeholder="Ej: Laura & David o Carlos"
                class="w-full px-3.5 py-2.5 rounded-xl bg-[#140816] border border-[#c5a059]/30 text-sm text-[#f7f4ee] placeholder-[#f7f4ee]/30 focus:outline-none focus:border-[#c5a059]"
              />
            </div>

            <!-- WhatsApp y Correo en 2 columnas -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="whatsapp" class="block text-xs font-semibold uppercase tracking-wider text-[#c5a059] mb-1">
                  WhatsApp <span class="text-[#ef5350]">*</span>
                </label>
                <input 
                  type="tel" 
                  id="whatsapp" 
                  name="whatsapp" 
                  required 
                  placeholder="310 123 4567"
                  class="w-full px-3.5 py-2.5 rounded-xl bg-[#140816] border border-[#c5a059]/30 text-sm text-[#f7f4ee] placeholder-[#f7f4ee]/30 focus:outline-none focus:border-[#c5a059]"
                />
              </div>

              <div>
                <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-[#c5a059] mb-1">
                  Correo Electrónico (Envío de Pase QR) <span class="text-[#ef5350]">*</span>
                </label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required 
                  placeholder="tu@correo.com"
                  class="w-full px-3.5 py-2.5 rounded-xl bg-[#140816] border border-[#c5a059]/30 text-sm text-[#f7f4ee] placeholder-[#f7f4ee]/30 focus:outline-none focus:border-[#c5a059]"
                />
              </div>
            </div>

            <!-- Rol de Asistencia -->
            <div>
              <label for="rol" class="block text-xs font-semibold uppercase tracking-wider text-[#c5a059] mb-1">
                Modalidad de Asistencia <span class="text-[#ef5350]">*</span>
              </label>
              <select 
                id="rol" 
                name="rol"
                class="w-full px-3.5 py-2.5 rounded-xl bg-[#140816] border border-[#c5a059]/30 text-sm text-[#f7f4ee] focus:outline-none focus:border-[#c5a059]"
              >
                <option value="pareja">👫 Pareja (Hombre & Mujer / Pareja Diversa)</option>
                <option value="mujer_sola">🦄 Mujer Sola (Unicornio)</option>
                <option value="hombre_solo">🙋‍♂️ Hombre Solo (Single)</option>
              </select>
            </div>

            <!-- Selector de Métodos de Pago (Visible únicamente para opciones con pago online) -->
            <div id="payment-method-selector" class="space-y-2 pt-2">
              <label class="block text-xs font-semibold uppercase tracking-wider text-[#c5a059]">
                Selecciona Cómo Pagar tu Promoción Web
              </label>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <label class="payment-method-card flex items-center gap-3 p-3.5 rounded-xl bg-[#140816] border-2 border-[#c5a059] cursor-pointer">
                  <input type="radio" name="metodo_pago" value="pasarela_digital" checked class="text-[#c5a059] focus:ring-0" />
                  <div class="text-xs">
                    <span class="font-bold text-[#ead397] block">💳 Pago Digital Inmediato</span>
                    <span class="text-[11px] text-[#f7f4ee]/70">Tarjeta, PSE o Débito Online</span>
                  </div>
                </label>

                <label class="payment-method-card flex items-center gap-3 p-3.5 rounded-xl bg-[#140816] border border-[#c5a059]/30 hover:border-[#c5a059] cursor-pointer">
                  <input type="radio" name="metodo_pago" value="nequi_breb" class="text-[#c5a059] focus:ring-0" />
                  <div class="text-xs">
                    <span class="font-bold text-[#ead397] block">📱 Coordinar por WhatsApp</span>
                    <span class="text-[11px] text-[#f7f4ee]/70">Bre-B, Nequi o Transferencia</span>
                  </div>
                </label>
              </div>
            </div>

            <div id="form-feedback" class="hidden p-3.5 rounded-xl text-xs"></div>

            <button 
              type="submit" 
              id="btn-submit-action"
              class="w-full py-4 rounded-full font-serif font-bold uppercase tracking-wider text-xs sm:text-sm bg-gradient-to-r from-[#c5a059] via-[#ead397] to-[#c5a059] text-[#0a0608] hover:brightness-110 shadow-[0_0_25px_rgba(197,160,89,0.35)] transition-all flex items-center justify-center gap-2"
            >
              <span id="btn-submit-text">Pagar Todo en Consumo Online ($60.000 COP)</span>
            </button>

            <p class="text-[11px] text-center text-[#f7f4ee]/50 font-light">
              🔒 Tus datos se gestionan bajo estricta confidencialidad y discreción. Recibirás comprobante y confirmación en tu correo y WhatsApp.
            </p>
          </form>

        </div>

      </section>

      <!-- BOTÓN VOLVER -->
      <div class="text-center pt-4">
        <a href="/centro-cultural" class="text-xs text-[#c5a059] hover:text-[#ead397] underline underline-offset-4 transition-colors">
          ← Volver a la Agenda del Centro Cultural
        </a>
      </div>

    </main>
  </div>
</Layout>

<script>
  let currentTier = "consumo_pareja";
  let currentMonto = 60000;
  let currentMode = "pago_online";

  const tierCards = document.querySelectorAll(".tier-card");
  const selectedTitle = document.getElementById("selected-tier-title");
  const selectedPrice = document.getElementById("selected-tier-price");
  const formTipoEntrada = document.getElementById("form-tipo-entrada") as HTMLInputElement;
  const formMode = document.getElementById("form-mode") as HTMLInputElement;
  const paymentMethodSelector = document.getElementById("payment-method-selector") as HTMLElement;
  const btnSubmitText = document.getElementById("btn-submit-text") as HTMLElement;
  const checkoutForm = document.getElementById("unified-checkout-form") as HTMLFormElement;
  const btnSubmitAction = document.getElementById("btn-submit-action") as HTMLButtonElement;
  const feedback = document.getElementById("form-feedback") as HTMLElement;
  const selectRol = document.getElementById("rol") as HTMLSelectElement;

  const inputAlias = document.getElementById("alias_nombre") as HTMLInputElement;
  const inputPhone = document.getElementById("whatsapp") as HTMLInputElement;
  const inputEmail = document.getElementById("email") as HTMLInputElement;
  const prefilledNotice = document.getElementById("prefilled-profile-notice") as HTMLElement;
  const btnUnlockProfile = document.getElementById("btn-unlock-profile") as HTMLButtonElement;

  function updateTierSelection(tier: string, monto: number, mode: string) {
    currentTier = tier;
    currentMonto = monto;
    currentMode = mode;

    if (formTipoEntrada) formTipoEntrada.value = tier;
    if (formMode) formMode.value = mode;

    // Actualizar estilos de las tarjetas
    tierCards.forEach((c) => {
      const cardTier = c.getAttribute("data-tier");
      if (cardTier === tier) {
        c.classList.add("ring-2", "ring-[#ead397]", "border-[#ead397]");
        c.classList.remove("border-[#c5a059]/40");
      } else {
        c.classList.remove("ring-2", "ring-[#ead397]", "border-[#ead397]");
        c.classList.add("border-[#c5a059]/40");
      }
    });

    if (tier === "cover_individual") {
      if (selectedTitle) selectedTitle.textContent = "Solo Cover (Solos y Solas) — Promo Web";
      if (selectedPrice) selectedPrice.textContent = "$15.000 COP";
      if (paymentMethodSelector) paymentMethodSelector.classList.remove("hidden");
      if (btnSubmitText) btnSubmitText.textContent = "Pagar Solo Cover Online ($15.000 COP)";
      if (selectRol && selectRol.value === "pareja") selectRol.value = "hombre_solo";
    } else if (tier === "consumo_pareja") {
      if (selectedTitle) selectedTitle.textContent = "Todo en Consumo (Parejas) — Promo Web";
      if (selectedPrice) selectedPrice.textContent = "$60.000 COP";
      if (paymentMethodSelector) paymentMethodSelector.classList.remove("hidden");
      if (btnSubmitText) btnSubmitText.textContent = "Pagar Todo en Consumo Online ($60.000 COP)";
      if (selectRol) selectRol.value = "pareja";
    } else {
      if (selectedTitle) selectedTitle.textContent = "Reserva General Sin Costo (Pagar en Puerta)";
      if (selectedPrice) selectedPrice.textContent = "$0 COP Online";
      if (paymentMethodSelector) paymentMethodSelector.classList.add("hidden");
      if (btnSubmitText) btnSubmitText.textContent = "Confirmar Reserva & Generar Pase QR ($0)";
    }
  }

  // Event Listeners en Tarjetas
  tierCards.forEach((card) => {
    card.addEventListener("click", () => {
      const tier = card.getAttribute("data-tier") || "consumo_pareja";
      const monto = parseInt(card.getAttribute("data-monto") || "60000", 10);
      const mode = card.getAttribute("data-mode") || "pago_online";
      updateTierSelection(tier, monto, mode);
      
      const container = document.getElementById("checkout-container");
      if (container) {
        container.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });
  });

  // Radio button styling for payment method
  const paymentRadios = document.querySelectorAll('input[name="metodo_pago"]');
  paymentRadios.forEach((r) => {
    r.addEventListener("change", () => {
      document.querySelectorAll(".payment-method-card").forEach((card) => {
        const input = card.querySelector('input[type="radio"]') as HTMLInputElement;
        if (input && input.checked) {
          card.classList.add("border-[#c5a059]");
          card.classList.remove("border-[#c5a059]/30");
        } else {
          card.classList.remove("border-[#c5a059]");
          card.classList.add("border-[#c5a059]/30");
        }
      });
    });
  });

  // Session Autofill
  function hydrateSession() {
    let userProfile = null;
    try {
      const raw = localStorage.getItem("user_profile");
      if (raw) userProfile = JSON.parse(raw);
    } catch (_) {}

    const sessionPhone = localStorage.getItem("ambassador_session_phone") || localStorage.getItem("user_phone") || userProfile?.whatsapp;
    const sessionAlias = userProfile?.alias_nombre || localStorage.getItem("user_alias");
    const sessionEmail = userProfile?.email || localStorage.getItem("user_email");
    const sessionRole = userProfile?.rol || localStorage.getItem("user_role");

    if (sessionAlias && inputAlias && !inputAlias.value) inputAlias.value = sessionAlias;
    if (sessionPhone && inputPhone && !inputPhone.value) inputPhone.value = sessionPhone;
    if (sessionEmail && inputEmail && !inputEmail.value) inputEmail.value = sessionEmail;
    if (sessionRole && selectRol) selectRol.value = sessionRole;

    if (sessionAlias || sessionPhone || sessionEmail) {
      if (prefilledNotice) prefilledNotice.classList.remove("hidden");
    }
  }

  btnUnlockProfile?.addEventListener("click", () => {
    if (inputAlias) inputAlias.focus();
    if (prefilledNotice) prefilledNotice.classList.add("hidden");
  });

  // Form Submit Handler
  checkoutForm?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const alias_nombre = inputAlias?.value?.trim() || "";
    const whatsapp = inputPhone?.value?.trim() || "";
    const email = inputEmail?.value?.trim() || "";
    const rol = selectRol?.value || "pareja";
    const metodo_pago_el = document.querySelector('input[name="metodo_pago"]:checked') as HTMLInputElement;
    const metodo_pago = metodo_pago_el?.value || "pasarela_digital";

    if (!alias_nombre || !whatsapp || !email) {
      alert("Por favor completa tu nombre, WhatsApp y correo electrónico.");
      return;
    }

    // Persist in localStorage for future visits
    localStorage.setItem("user_alias", alias_nombre);
    localStorage.setItem("user_phone", whatsapp);
    localStorage.setItem("user_email", email);
    localStorage.setItem("user_role", rol);

    btnSubmitAction.disabled = true;
    const originalText = btnSubmitText.textContent;
    btnSubmitText.textContent = "Procesando...";
    if (feedback) feedback.classList.add("hidden");

    try {
      if (currentMode === "reserva_gratuita") {
        // Modalidad 3: Reserva Gratuita ($0)
        const res = await fetch("/api/eventos/reserva", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            evento: "viernes-23-oct",
            alias_nombre,
            whatsapp,
            email,
            rol,
            ciudad: "Bogotá",
            verified: true, // Auto-verified for seamless UX
          }),
        });

        const data = await res.json();
        if (data.success) {
          if (feedback) {
            feedback.className = "p-4 rounded-xl text-xs bg-[#2e7d32]/30 border border-[#81c784]/60 text-[#81c784] space-y-2 block";
            feedback.innerHTML = `
              <div class="font-bold text-sm">🎉 ¡Tu Pase de Reserva está Confirmado!</div>
              <p>${data.message || "Te hemos enviado la confirmación con tu código QR a tu correo y WhatsApp."}</p>
              <div class="font-mono text-[11px] text-white bg-black/40 p-2 rounded-lg break-all">
                Código de Pase: <strong>${data.ticket_hash}</strong>
              </div>
              <p class="text-[11px] text-[#f7f4ee]/80 pt-1">
                📍 Recuerda llegar desde las 7:00 p.m. a la Calle 67 #23-46 (¡No olvides timbrar!) y presentar tu código QR en puerta.
              </p>
            `;
          }
          checkoutForm.reset();
        } else {
          throw new Error(data.error || "No se pudo registrar la reserva. Intenta de nuevo.");
        }
      } else {
        // Modalidad 1 o 2: Pago Online Promocional ($15k o $60k)
        const res = await fetch("/api/checkout/create", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            evento: "viernes_23",
            tipo_entrada: currentTier,
            modalidad_pago: "pago_total",
            metodo_pago,
            alias_nombre,
            whatsapp,
            email,
            rol,
          }),
        });

        const data = await res.json();
        if (data.success && data.redirect_url) {
          window.location.href = data.redirect_url;
        } else {
          throw new Error(data.error || "Error al generar la orden de pago.");
        }
      }
    } catch (err: any) {
      if (feedback) {
        feedback.className = "p-3.5 rounded-xl text-xs bg-[#b71c1c]/30 border border-[#ef5350]/60 text-[#ef5350] block";
        feedback.textContent = err.message || "Ocurrió un error inesperado al procesar tu solicitud.";
      }
    } finally {
      btnSubmitAction.disabled = false;
      btnSubmitText.textContent = originalText;
    }
  });

  // Inicializar al cargar
  hydrateSession();
  updateTierSelection("consumo_pareja", 60000, "pago_online");
</script>
