import AmbassadorLink from "../../components/AmbassadorLink.astro";
---
import Layout from "../../layouts/Layout.astro";
import LeadForm from "../../components/LeadForm.astro";
---

<Layout 
  title="Próximos Eventos | El Placer de Compartir"
  description="Conoce los próximos eventos, fiestas y talleres en ElPlacerDC."
>
  <div class="pt-24 pb-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto space-y-16">
    
    <div class="text-center space-y-6">
      <h1 class="font-serif text-4xl sm:text-5xl font-bold tracking-tight text-elplacer-ivory">
        Evento Oficial de ElPlacerDC
      </h1>
      <p class="text-lg text-corset-champagne font-light max-w-2xl mx-auto">
        Una oportunidad única para conocer nuestro nuevo sitio, interactuar con la comunidad y vivir experiencias excepcionales.
      </p>
    </div>

    <!-- Detalle Evento -->
    <div class="bg-elplacer-midnight-plum border border-corset-gold/30 rounded-2xl overflow-hidden shadow-2xl">
      <div class="grid grid-cols-1 md:grid-cols-2">
        <img 
          src="/media/flayer_luna_llena.jpg" 
          alt="Evento Oficial" 
          class="w-full h-full object-cover"
          onerror="this.src='/media/primera_invitacion_centro_cultural.jpg'"
        />
        <div class="p-8 space-y-6 flex flex-col justify-center">
          <span class="inline-block px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest bg-corset-gold/20 text-corset-gold border border-corset-gold/40 w-fit inline-block mb-4">
            Fiesta Oficial
          </span>
          <h2 class="text-3xl font-serif font-bold text-elplacer-ivory">
            Noche de Luna Llena
          </h2>
          <p class="text-elplacer-ivory/80 font-light">
            Déjate envolver por la magia de la luna en nuestro nuevo espacio. Disfruta de un ambiente exclusivo, shows en vivo y networking con otros miembros de la comunidad.
          </p>
          <div class="pt-4 border-t border-corset-gold/20">
            <p class="text-corset-champagne font-bold">Reserva Exclusiva</p>
            <p class="text-xs text-elplacer-ivory/60 mt-2">
              Regístrate a continuación. Al finalizar, recibirás un correo con el código QR de asistencia y un WhatsApp de confirmación de reserva (mencionando tu QR).
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Formulario de Reserva -->
    <div class="pt-8">
      <AmbassadorLink />
      <LeadForm 
        title="Reserva tu Entrada" 
        subtitle="Diligencia tus datos para asegurar tu cupo y generar tu QR de acceso."
      />
    </div>

  </div>
</Layout>
