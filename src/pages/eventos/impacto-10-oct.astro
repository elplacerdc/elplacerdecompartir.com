---
// impacto-10-oct.astro - Evento Aliado: Impacto Producciones
import Layout from "../../layouts/Layout.astro";
---

<Layout 
  title="Evento Aliado: Impacto Producciones — Sábado 10 de Octubre | Centro Cultural"
  description="Impacto Producciones en el Centro Cultural: Sábado 10 de Octubre. Sin cover de 7:00 a 9:30 pm con reserva previa. Fire Show especial, 3 ambientes, habitaciones privadas."
  ogImage="/media/eventos-aliados/sabado-10-octubre_impacto-producciones.jpg"
>
  <div class="pt-24 pb-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto space-y-12">
    
    <div class="text-center space-y-4">
      <span class="inline-block px-5 py-2 rounded-full text-xs font-serif font-bold uppercase tracking-wider bg-[#8E4A8C]/20 text-[#f3e5f5] border border-[#8E4A8C]/40 mb-2 whitespace-nowrap">
        Evento Aliado en nuestra sede
      </span>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold tracking-tight text-[#f7f4ee]">
        Impacto Producciones — Sábado 10
      </h1>
      <p class="text-base sm:text-lg text-[#f7f4ee]/85 font-light max-w-2xl mx-auto leading-relaxed">
        Nuestros aliados de Impacto Producciones se toman la casa. Una noche distinta con música, performances en vivo y atmósfera de alta energía en nuestro escenario central.
      </p>

      <!-- Ficha Técnica del Flyer -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-3xl mx-auto pt-4 text-left">
        <div class="p-3 rounded-xl bg-[#1E0C24] border border-[#8E4A8C]/30 text-xs">
          <span class="text-[#f3e5f5]/60 block text-[10px] uppercase font-bold">Entrada Libre</span>
          <span class="text-[#f3e5f5] font-semibold block mt-0.5">Sin cover 7:00 a 9:30 pm</span>
          <span class="text-[10px] text-[#81c784] block">Con reserva previa</span>
        </div>
        <div class="p-3 rounded-xl bg-[#1E0C24] border border-[#8E4A8C]/30 text-xs">
          <span class="text-[#f3e5f5]/60 block text-[10px] uppercase font-bold">Show Central</span>
          <span class="text-[#f3e5f5] font-semibold block mt-0.5">Fire Show Especial 🔥</span>
          <span class="text-[10px] text-[#f3e5f5]/60 block">En vivo</span>
        </div>
        <div class="p-3 rounded-xl bg-[#1E0C24] border border-[#8E4A8C]/30 text-xs">
          <span class="text-[#f3e5f5]/60 block text-[10px] uppercase font-bold">Instalaciones</span>
          <span class="text-[#f3e5f5] font-semibold block mt-0.5">3 Ambientes</span>
          <span class="text-[10px] text-[#f3e5f5]/60 block">Habitaciones privadas</span>
        </div>
        <div class="p-3 rounded-xl bg-[#1E0C24] border border-[#8E4A8C]/30 text-xs">
          <span class="text-[#f3e5f5]/60 block text-[10px] uppercase font-bold">Ubicación</span>
          <span class="text-[#f3e5f5] font-semibold block mt-0.5">Calle 67 # 23-46 Piso 2</span>
          <span class="text-[10px] text-[#f3e5f5]/60 block">Parqueadero cercano</span>
        </div>
      </div>
    </div>

    <div class="bg-[#1E0C24] rounded-3xl border border-[#8E4A8C]/40 shadow-xl overflow-hidden flex flex-col md:flex-row">
      <div class="md:w-1/2 p-6 flex justify-center items-center bg-black/40">
        <img 
          src="/media/eventos-aliados/sabado-10-octubre_impacto-producciones.jpg" 
          alt="Flyer Impacto Producciones Sábado 10 de Octubre" 
          class="rounded-xl max-h-[580px] object-contain shadow-md border border-[#8E4A8C]/30"
        />
      </div>
      
      <div class="md:w-1/2 p-8 space-y-6 flex flex-col justify-center">
        <div>
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#8E4A8C]/20 border border-[#8E4A8C]/40 text-[11px] text-[#f3e5f5] font-semibold mb-2">
            <span>📍</span> Sede Oficial: Bogotá, Colombia
          </div>
          <h2 class="font-serif text-2xl font-bold text-[#f3e5f5]">Asegura tu Asistencia</h2>
          <p class="text-xs text-[#f7f4ee]/70 mt-1 leading-relaxed font-light">
            El evento se realizará en nuestro Centro Cultural en <strong class="text-[#f3e5f5]">Bogotá</strong>. Es requerido para el ingreso generar tu pase con código QR (válido para ingreso sin cover entre 7:00 y 9:30 PM).
          </p>
        </div>

        <form id="event-reserve-form" class="space-y-4">
          <input type="hidden" name="evento" value="impacto-10-oct" />

          <!-- Paso 1: WhatsApp con Verificación OTP Progresiva -->
          <div id="section-phone-auth">
            <div id="step-phone-input" class="space-y-1.5">
              <label class="block text-xs font-semibold uppercase tracking-wider text-[#f3e5f5]">
                WhatsApp / Teléfono <span class="text-[#ef5350]">*</span>
              </label>
              <div class="flex flex-col sm:flex-row gap-2">
                <input 
                  type="tel" 
                  name="whatsapp" 
                  id="input-whatsapp" 
                  required 
                  placeholder="310 123 4567" 
                  class="flex-1 px-3 py-2.5 rounded-lg bg-[#140816] border border-[#8E4A8C]/30 text-[#f7f4ee] text-xs placeholder-[#f7f4ee]/30 focus:outline-none focus:border-[#8E4A8C]"
                />
                <button 
                  type="button" 
                  id="btn-send-wa-otp" 
                  class="w-full sm:w-auto px-4 py-2.5 text-xs uppercase tracking-wider font-semibold rounded-lg bg-[#8E4A8C] text-white hover:bg-[#a35da1] transition-all whitespace-nowrap shadow-md text-center"
                >
                  Enviar Código
                </button>
              </div>
            </div>

            <!-- Paso OTP (Oculta el teléfono, muestra código y botones Verificar / Atrás apilados) -->
            <div id="step-otp-verify" class="hidden p-4 rounded-xl bg-[#140816] border border-[#8E4A8C]/40 space-y-3">
              <label class="block text-xs font-semibold uppercase tracking-wider text-[#f3e5f5]">
                Código de Verificación WhatsApp <span class="text-[#ef5350]">*</span>
              </label>
              <p class="text-[11px] text-[#f7f4ee]/70">Ingresa el código de 6 dígitos enviado a tu WhatsApp.</p>
              <div class="space-y-2.5">
                <input 
                  type="text" 
                  id="input-wa-otp" 
                  maxlength="6" 
                  placeholder="123456" 
                  class="w-full px-4 py-2.5 text-center font-mono tracking-[0.4em] text-base rounded-lg bg-[#0a0608] border border-[#8E4A8C]/40 text-[#f3e5f5] focus:outline-none focus:border-[#8E4A8C]"
                />
                <div class="flex flex-col gap-2">
                  <button 
                    type="button" 
                    id="btn-verify-wa-otp" 
                    class="w-full py-2.5 text-xs font-bold uppercase rounded-lg bg-[#8E4A8C] text-white hover:bg-[#a35da1] transition-all shadow-md text-center"
                  >
                    Verificar Código
                  </button>
                  <button 
                    type="button" 
                    id="btn-back-wa-otp" 
                    class="w-full py-2 text-xs text-[#f7f4ee]/70 hover:text-white border border-[#8E4A8C]/30 rounded-lg transition-all text-center"
                  >
                    Atrás
                  </button>
                </div>
              </div>
              <span id="wa-otp-status" class="text-xs text-[#ef5350] block min-h-[14px]"></span>
            </div>

            <div id="wa-verified-badge" class="hidden p-2.5 rounded-lg bg-[#140816] border border-[#81c784]/40 flex items-center justify-between text-xs text-[#81c784] font-medium mt-1">
              <span>✓ WhatsApp verificado: <strong id="wa-display-phone" class="font-mono text-white"></strong></span>
              <button type="button" id="btn-change-wa" class="text-[10px] text-[#f3e5f5] underline hover:text-[#8E4A8C]">Cambiar</button>
            </div>
          </div>

          <!-- Campos Desplegables tras Verificar WhatsApp -->
          <div id="remaining-fields" class="hidden space-y-4 pt-1">
            <div id="lead-status-box" class="p-3 rounded-xl bg-[#8E4A8C]/20 border border-[#8E4A8C]/30 space-y-2">
              <p id="lead-status-msg" class="text-xs text-[#f3e5f5]"></p>
              <button 
                type="button" 
                id="btn-enable-edit-profile" 
                class="hidden text-[11px] text-[#f3e5f5] underline hover:text-white font-medium block"
              >
                ✏️ Modificar mis datos registrados
              </button>
            </div>

            <!-- Pseudónimo -->
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-[#f3e5f5] mb-1">
                Pseudónimo o Nombre <span class="text-[#ef5350]">*</span>
              </label>
              <input 
                type="text" 
                name="alias_nombre" 
                id="input-alias" 
                required 
                placeholder="Tu alias o nombre discreto" 
                class="w-full px-3 py-2.5 rounded-lg bg-[#140816] border border-[#8E4A8C]/30 text-[#f7f4ee] text-xs placeholder-[#f7f4ee]/30 focus:outline-none focus:border-[#8E4A8C]"
              />
            </div>

            <!-- Correo Electrónico (para QR requerido) -->
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-[#f3e5f5] mb-1">
                Correo Electrónico (Para envío del QR requerido) <span class="text-[#ef5350]">*</span>
              </label>
              <input 
                type="email" 
                name="email" 
                id="input-email" 
                required 
                placeholder="tu@correo.com" 
                class="w-full px-3 py-2.5 rounded-lg bg-[#140816] border border-[#8E4A8C]/30 text-[#f7f4ee] text-xs placeholder-[#f7f4ee]/30 focus:outline-none focus:border-[#8E4A8C]"
              />
            </div>

            <!-- Rol / Modalidad -->
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-[#f3e5f5] mb-1">
                Modalidad de Asistencia <span class="text-[#ef5350]">*</span>
              </label>
              <select 
                name="rol" 
                id="select-rol"
                class="w-full px-3 py-2.5 rounded-lg bg-[#140816] border border-[#8E4A8C]/30 text-[#f7f4ee] text-xs focus:outline-none focus:border-[#8E4A8C]"
              >
                <option value="pareja">👫 Pareja</option>
                <option value="mujer_sola">🦄 Mujer Sola (Unicornio)</option>
                <option value="hombre_solo">🙋‍♂️ Hombre Solo (Single)</option>
              </select>
            </div>

            <div id="reserve-feedback" class="hidden text-xs p-3 rounded-lg"></div>

            <button 
              type="submit" 
              id="btn-submit-reserve" 
              class="w-full py-3.5 rounded-full font-serif font-bold uppercase tracking-wider text-xs bg-gradient-to-r from-[#7A3579] via-[#8E4A8C] to-[#7A3579] text-white hover:brightness-110 shadow-md transition-all"
            >
              Confirmar Asistencia & Generar Pase QR
            </button>
          </div>
        </form>

        <div class="text-center sm:text-left pt-2">
          <a href="/centro-cultural" class="text-xs text-[#e1bee7] hover:text-white transition-colors underline underline-offset-2">← Volver a Centro Cultural</a>
        </div>
      </div>
    </div>

  </div>
</Layout>

<script>
  const form = document.getElementById("event-reserve-form") as HTMLFormElement;
  const inputWhatsapp = document.getElementById("input-whatsapp") as HTMLInputElement;
  const btnSendWaOtp = document.getElementById("btn-send-wa-otp") as HTMLButtonElement;
  const stepPhoneInput = document.getElementById("step-phone-input") as HTMLElement;
  const stepOtpVerify = document.getElementById("step-otp-verify") as HTMLElement;
  const inputWaOtp = document.getElementById("input-wa-otp") as HTMLInputElement;
  const btnVerifyWaOtp = document.getElementById("btn-verify-wa-otp") as HTMLButtonElement;
  const btnBackWaOtp = document.getElementById("btn-back-wa-otp") as HTMLButtonElement;
  const btnChangeWa = document.getElementById("btn-change-wa") as HTMLButtonElement;
  const waOtpStatus = document.getElementById("wa-otp-status") as HTMLElement;
  const waVerifiedBadge = document.getElementById("wa-verified-badge") as HTMLElement;
  const waDisplayPhone = document.getElementById("wa-display-phone") as HTMLElement;

  const remainingFields = document.getElementById("remaining-fields") as HTMLElement;
  const leadStatusMsg = document.getElementById("lead-status-msg") as HTMLElement;
  const inputAlias = document.getElementById("input-alias") as HTMLInputElement;
  const inputEmail = document.getElementById("input-email") as HTMLInputElement;
  const selectRol = document.getElementById("select-rol") as HTMLSelectElement;

  const feedback = document.getElementById("reserve-feedback") as HTMLElement;
  const submitBtn = document.getElementById("btn-submit-reserve") as HTMLButtonElement;

  let waVerified = false;

  btnSendWaOtp?.addEventListener("click", async () => {
    const whatsapp = inputWhatsapp.value.trim();
    if (!whatsapp) {
      alert("Por favor ingresa tu número de WhatsApp");
      inputWhatsapp.focus();
      return;
    }

    btnSendWaOtp.disabled = true;
    btnSendWaOtp.textContent = "Enviando...";

    try {
      const res = await fetch("/api/otp/send", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ destination: whatsapp, channel: "whatsapp" }),
      });
      const data = await res.json();

      if (data.success) {
        stepPhoneInput.classList.add("hidden");
        stepOtpVerify.classList.remove("hidden");
        inputWaOtp.value = "";
        inputWaOtp.focus();
        if (waOtpStatus) waOtpStatus.textContent = "";
      } else {
        alert(data.error || "No se pudo enviar el código");
      }
    } catch (e: any) {
      alert("Error al conectar para enviar código");
    } finally {
      btnSendWaOtp.disabled = false;
      btnSendWaOtp.textContent = "Enviar Código";
    }
  });

  btnBackWaOtp?.addEventListener("click", () => {
    stepOtpVerify.classList.add("hidden");
    stepPhoneInput.classList.remove("hidden");
    inputWhatsapp.focus();
  });

  btnChangeWa?.addEventListener("click", () => {
    waVerified = false;
    waVerifiedBadge.classList.add("hidden");
    remainingFields.classList.add("hidden");
    stepOtpVerify.classList.add("hidden");
    stepPhoneInput.classList.remove("hidden");
    inputWhatsapp.readOnly = false;
    inputWhatsapp.focus();
  });

  btnVerifyWaOtp?.addEventListener("click", async () => {
    const whatsapp = inputWhatsapp.value.trim();
    const code = inputWaOtp.value.trim();

    if (!code || code.length < 4) {
      if (waOtpStatus) waOtpStatus.textContent = "Ingresa el código de 6 dígitos";
      return;
    }

    btnVerifyWaOtp.disabled = true;
    btnVerifyWaOtp.textContent = "...";

    try {
      const res = await fetch("/api/otp/verify", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ destination: whatsapp, code, channel: "whatsapp" }),
      });
      const data = await res.json();

      if (data.success) {
        waVerified = true;
        stepOtpVerify.classList.add("hidden");
        if (waDisplayPhone) waDisplayPhone.textContent = whatsapp;
        waVerifiedBadge.classList.remove("hidden");
        inputWhatsapp.readOnly = true;

        // Comprobar si ya existe en la comunidad (WhatsApp-first)
        try {
          const checkRes = await fetch("/api/leads/check", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ whatsapp }),
          });
          const checkData = await checkRes.json();

          if (checkData.exists && checkData.lead) {
            const lead = checkData.lead;
            if (inputAlias) {
              inputAlias.value = lead.alias_nombre || "";
              inputAlias.readOnly = true;
            }
            if (inputEmail) {
              inputEmail.value = lead.email || "";
              inputEmail.readOnly = true;
            }
            if (selectRol) {
              selectRol.value = lead.rol || "pareja";
              selectRol.disabled = true;
            }

            if (leadStatusMsg) {
              leadStatusMsg.innerHTML = `✓ <strong>Hola ${lead.alias_nombre || 'Miembro'}</strong>, reconocemos tu perfil registrado. Tus datos están protegidos contra sobreescritura accidental.`;
            }
            const btnEditProfile = document.getElementById("btn-enable-edit-profile");
            if (btnEditProfile) {
              btnEditProfile.classList.remove("hidden");
              btnEditProfile.onclick = () => {
                if (inputAlias) inputAlias.readOnly = false;
                if (inputEmail) inputEmail.readOnly = false;
                if (selectRol) selectRol.disabled = false;
                btnEditProfile.classList.add("hidden");
                leadStatusMsg.innerHTML = `✏️ <strong>Edición habilitada</strong>: puedes modificar tus datos.`;
              };
            }
            if (submitBtn) submitBtn.textContent = "Confirmar Asistencia & Generar Pase QR";
          } else {
            if (inputAlias) inputAlias.readOnly = false;
            if (inputEmail) inputEmail.readOnly = false;
            if (selectRol) selectRol.disabled = false;
            const btnEditProfile = document.getElementById("btn-enable-edit-profile");
            if (btnEditProfile) btnEditProfile.classList.add("hidden");
            if (leadStatusMsg) {
              leadStatusMsg.innerHTML = `✨ <strong>Número verificado</strong>. Completa tus datos para radicar tu registro en la comunidad y generar tu pase QR sin cover.`;
            }
            if (submitBtn) submitBtn.textContent = "Completar Registro & Generar Pase QR";
          }
        } catch (checkErr) {
          console.warn("[Check Lead Err]:", checkErr);
        }

        remainingFields.classList.remove("hidden");
        inputAlias.focus();
      } else {
        if (waOtpStatus) waOtpStatus.textContent = "Código inválido o expirado";
      }
    } catch (e: any) {
      if (waOtpStatus) waOtpStatus.textContent = "Error al verificar código";
    } finally {
      btnVerifyWaOtp.disabled = false;
      btnVerifyWaOtp.textContent = "Verificar Código";
    }
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (!waVerified) {
      feedback.className = "text-xs p-3 rounded-lg bg-[#b84a39]/20 border border-[#b84a39]/40 text-[#ef5350]";
      feedback.textContent = "⚠️ Por favor verifica tu WhatsApp antes de confirmar la reserva.";
      feedback.classList.remove("hidden");
      inputWhatsapp.focus();
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = "Generando Pase...";

    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());
    if (selectRol && !payload.rol) {
      payload.rol = selectRol.value;
    }

    try {
      const res = await fetch("/api/eventos/reserva", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          ...payload,
          verified: true,
        }),
      });
      const data = await res.json();

      if (data.success) {
        // Guardar sesión de embajador automáticamente
        const submittedPhone = inputWhatsapp.value.trim();
        if (submittedPhone) {
          localStorage.setItem("ambassador_session_phone", submittedPhone);
        }

        feedback.className = "text-xs p-4 rounded-xl bg-[#2e7d32]/20 border border-[#4caf50]/40 text-[#81c784] space-y-2";
        feedback.innerHTML = `
          <div class="font-bold text-sm text-[#81c784]">✨ ¡Pase Confirmado Exitosamente!</div>
          <p>Tu Pase ID oficial es <strong class="font-mono text-white select-all">${data.ticket_hash}</strong>.</p>
          <p class="text-[11px] text-[#f7f4ee]/80">Es <strong>requerido para el ingreso</strong> presentar tu código QR en tu pantalla al llegar a la recepción (sin cover de 7:00 a 9:30 PM). Lo hemos enviado a tu correo.</p>
          <div class="pt-2">
            <a href="/dashboard" class="inline-block px-3 py-1.5 rounded bg-[#8E4A8C] text-white font-bold uppercase tracking-wider text-[11px]">
              Ir a mi Panel de Embajador →
            </a>
          </div>
        `;
        feedback.classList.remove("hidden");
        form.reset();
      } else {
        throw new Error(data.error || "No se pudo completar la reserva");
      }
    } catch (err: any) {
      feedback.className = "text-xs p-3 rounded-lg bg-[#b71c1c]/20 border border-[#b71c1c]/40 text-[#ef5350]";
      feedback.textContent = err.message || "Error al conectar.";
      feedback.classList.remove("hidden");
      submitBtn.disabled = false;
      submitBtn.textContent = "Confirmar Asistencia & Generar Pase QR";
    }
  });
</script>
