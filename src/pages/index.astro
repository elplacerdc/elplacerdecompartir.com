---
// index.astro - Landing Principal: El Placer de Compartir
import Layout from "../layouts/Layout.astro";
import LeadForm from "../components/LeadForm.astro";
---

<Layout title="El Placer de Compartir | Libertad, Erotismo Consciente y Comunidad">
  <!-- Hero Section: Lindo, Cálido y Sensorial (Inspirado en el medallón icon-512 y el salón del Flyer) -->
  <section class="relative min-h-[90vh] flex items-center justify-center pt-20 pb-16 px-4 sm:px-6 lg:px-8 overflow-hidden bg-gradient-to-b from-[#180A1A] via-[#240D20] to-[#1C0A1B]">
    <!-- Delicadas texturas y halos ámbar cálidos y terciopelo vino -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[#591F26]/30 via-[#240D20]/50 to-transparent pointer-events-none -z-10"></div>
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[700px] h-[700px] bg-[#C5A059]/10 rounded-full blur-[140px] pointer-events-none -z-10"></div>

    <div class="max-w-5xl mx-auto text-center space-y-8 relative z-10">
      <!-- Medallón Oficial & Eyebrow -->
      <div class="inline-flex items-center gap-2.5 px-5 py-2 rounded-full bg-[#2A0F24] border border-[#C5A059]/40 shadow-[0_4px_25px_rgba(89,31,38,0.2)] text-xs font-serif font-bold uppercase tracking-[0.2em] text-[#EAD397]">
        <span class="w-2 h-2 rounded-full bg-[#C5A059]"></span>
        <span>Espacio de Erotismo Consciente & Comunidad</span>
      </div>

      <!-- Main Title: Tipografía Clásica Esculpida del Logotipo -->
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#F7F4EE] leading-[1.15] break-words">
        El arte de compartir <br />
        <span class="italic font-normal text-transparent bg-clip-text bg-gradient-to-r from-[#EAD397] via-[#C5A059] to-[#F7D6CB]">
          el placer sin juicio ni ataduras
        </span>
      </h1>

      <!-- Subtitle -->
      <p class="max-w-2xl mx-auto text-base sm:text-lg text-[#F7F4EE]/85 font-light leading-relaxed">
        Pioneros en Colombia en explorar la libertad relacional, el consentimiento lúcido y el erotismo libre de presiones. Un espacio seguro, confidencial y humano.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
        <a 
          href="#registro" 
          class="px-8 py-4 rounded-full font-serif font-bold uppercase tracking-wider text-sm bg-gradient-to-r from-[#721C24] via-[#8E2835] to-[#721C24] text-[#F7F4EE] hover:brightness-110 shadow-[0_6px_25px_rgba(114,28,36,0.35)] border border-[#C5A059]/50 transition-all"
        >
          Unirme a la Comunidad
        </a>
        <a 
          href="/centro-cultural" 
          class="px-8 py-4 rounded-full font-serif font-semibold uppercase tracking-wider text-sm border border-[#C5A059]/40 bg-[#2A0F24]/80 text-[#EAD397] hover:bg-[#2A0F24] shadow-sm transition-all flex items-center gap-2"
        >
          <span>Conocer el Centro Cultural</span>
          <span class="text-xs">🏛️</span>
        </a>
      </div>

      <!-- Official Social Badges -->
      <div class="pt-8 flex flex-wrap items-center justify-center gap-6 text-xs text-[#F7F4EE]/70 border-t border-[#C5A059]/20">
        <span class="text-[#EAD397] font-serif uppercase tracking-wider font-semibold">Canales Verificados:</span>
        <a href="https://x.com/ElPlacerDC" target="_blank" rel="noopener noreferrer" class="hover:text-[#EAD397] transition-colors font-medium">X: @ElPlacerDC</a>
        <span>•</span>
        <a href="https://x.com/SegiSw" target="_blank" rel="noopener noreferrer" class="hover:text-[#EAD397] transition-colors font-medium">Dirección: @SegiSw</a>
        <span>•</span>
        <a href="https://www.tiktok.com/@elplacerdc" target="_blank" rel="noopener noreferrer" class="hover:text-[#EAD397] transition-colors font-medium">TikTok: @elplacerdc</a>
        <span>•</span>
        <a href="https://wa.me/573194194785" target="_blank" rel="noopener noreferrer" class="text-[#4CAF50] hover:text-[#81C784] transition-colors font-semibold">WhatsApp: +57 319 419 4785</a>
      </div>
    </div>
  </section>

  <!-- Anuncio Estelar: Centro Cultural & The Corset Society -->
  <section class="py-24 bg-gradient-to-b from-[#1C0A1B] via-[#240D20] to-[#180A1A] border-y border-[#C5A059]/25 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Columna Izquierda: Centro Cultural Lindo y Cálido -->
      <div class="space-y-6">
        <span class="px-3.5 py-1.5 rounded-full text-[11px] font-serif font-bold uppercase tracking-widest bg-[#591F26]/30 text-[#EAD397] border border-[#C5A059]/40">
          Apertura Exclusiva • Bogotá
        </span>
        <h2 class="font-serif text-3xl sm:text-5xl font-bold tracking-tight text-[#F7F4EE]">
          Nuevo Centro Cultural <br />
          <span class="text-[#EAD397] italic">El Placer de Compartir</span>
        </h2>
        <p class="text-base text-[#F7F4EE]/85 font-light leading-relaxed">
          Un espacio físico multidisciplinario concebido para la expansión sensorial, talleres de parejas, BDSM ético, nudismo consciente, masajes tántricos y citas a ciegas basadas en compatibilidad real.
        </p>
        <div class="p-5 rounded-2xl bg-[#2A0F24] border border-[#C5A059]/35 shadow-[0_4px_25px_rgba(89,31,38,0.25)] space-y-2">
          <p class="text-xs uppercase tracking-wider text-[#EAD397] font-serif font-bold">✨ Filosofía Innegociable</p>
          <p class="text-xs text-[#F7F4EE]/80 leading-relaxed">
            Cero personal contratado ni modelos pagadas. Toda mujer asiste por decisión, curiosidad y disfrute propio. La reciprocidad es innegociable.
          </p>
        </div>
        <div class="pt-2">
          <a href="/centro-cultural" class="inline-flex items-center gap-2 text-sm font-serif font-bold text-[#EAD397] hover:text-[#C5A059] transition-colors group">
            <span>Explorar sedes, talleres y programa de aliados</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>
      </div>

      <!-- Columna Derecha: The Corset Society Círculo Privado (Gala Noir con Logo Transparente sin recuadro) -->
      <div class="relative p-6 sm:p-8 rounded-2xl bg-[#050505] border border-[#C5A059]/50 shadow-[0_12px_45px_rgba(0,0,0,0.5)] space-y-6 text-[#F7F4EE]">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <img 
              src="/media/logo_corsetsociety_transparent.png" 
              alt="Logo The Corset Society" 
              class="h-12 w-auto object-contain drop-shadow-[0_0_12px_rgba(197,160,89,0.35)]" 
            />
            <div class="flex flex-col">
              <span class="text-xs uppercase tracking-widest text-[#EAD397] font-serif font-bold">The Corset Society</span>
              <span class="text-[10px] uppercase tracking-wider text-[#C5A059]/70 font-sans">Línea Luxury & Ticket Alto</span>
            </div>
          </div>
          <span class="px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-[#C5A059]/20 text-[#EAD397] border border-[#C5A059]/40">Círculo Privado</span>
        </div>

        <!-- Flyer Oficial Luna Llena Preview -->
        <div class="rounded-xl overflow-hidden border border-[#C5A059]/30 shadow-md">
          <img 
            src="/media/corset-society/flyer_halloween_clean.jpg" 
            alt="Flyer Oficial Luna Llena Halloween" 
            class="w-full h-44 object-cover object-top hover:scale-105 transition-transform duration-500" 
          />
        </div>

        <p class="text-xs sm:text-sm text-[#F7F4EE]/75 leading-relaxed font-light">
          Gala Noir, antifaces y misterio en las noches de luna llena. Veladas de ticket alto y aforo estrictamente limitado con protocolo y dirección de honor, donde el acceso se concede y jamás se anuncia.
        </p>
        <div class="pt-4 border-t border-[#C5A059]/20 flex flex-wrap items-center justify-between gap-3">
          <a href="/the-corset-society" class="px-5 py-2.5 rounded-full text-xs font-serif font-bold uppercase tracking-wider bg-[#C5A059] text-[#050505] hover:bg-[#EAD397] transition-colors">
            Acceso Ceremonial
          </a>
          <a href="/the-corset-society/luna-llena" class="text-xs text-[#EAD397] hover:underline font-serif">
            Próximo Evento: Luna Llena →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Manifiesto Comunitario: Diagramación Editorial Asimétrica (Anti-Vibe-Coding / Taste-Skill) -->
  <section id="manifiesto" class="py-24 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto space-y-16">
    <div class="text-center space-y-4">
      <span class="text-xs uppercase tracking-[0.25em] text-[#EAD397] font-serif font-bold">Nuestros Principios</span>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[#F7F4EE]">
        El Manifiesto de la Libertad Consciente
      </h2>
      <div class="w-16 h-0.5 bg-[#C5A059] mx-auto mt-2"></div>
    </div>

    <!-- Composición Editorial Asimétrica -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      <!-- Columna Principal Editorial (5 columnas) -->
      <div class="lg:col-span-5 p-8 rounded-3xl bg-[#2A0F24] border border-[#C5A059]/35 shadow-[0_8px_30px_rgba(89,31,38,0.25)] flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-[#721C24] text-[#F7F4EE] flex items-center justify-center font-serif text-lg font-bold shadow-md border border-[#C5A059]/40">
            I
          </div>
          <h3 class="font-serif text-2xl font-bold text-[#F7F4EE]">Consentimiento Continuo</h3>
          <p class="text-sm text-[#F7F4EE]/80 leading-relaxed font-light">
            Un "sí" puede convertirse en un "no" en cualquier instante y es innegociable. La lucidez, la presencia y el respeto irrestricto son condiciones indispensables de cada encuentro.
          </p>
        </div>
        <div class="p-4 rounded-xl bg-[#1E0A1A] border-l-2 border-[#C5A059]">
          <p class="text-xs font-serif italic text-[#EAD397]">
            "Solo un 'SÍ' explícito y entusiasta es un sí. El 'no' nunca requiere justificación."
          </p>
        </div>
      </div>

      <!-- Columna Secundaria Staggered (7 columnas) -->
      <div class="lg:col-span-7 flex flex-col justify-between space-y-8">
        <!-- Panel 2: Sensualidad Libre de Presiones -->
        <div class="p-8 rounded-3xl bg-[#2A0F24] border border-[#C5A059]/35 shadow-[0_8px_30px_rgba(89,31,38,0.25)] space-y-3">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-[#B84A39]/25 text-[#EAD397] flex items-center justify-center font-serif font-bold text-base border border-[#C5A059]/30">
              II
            </div>
            <h3 class="font-serif text-xl font-bold text-[#F7F4EE]">Sensualidad Libre de Presiones</h3>
          </div>
          <p class="text-sm text-[#F7F4EE]/80 leading-relaxed font-light">
            El placer trasciende lo genital. Miradas, complicidad, baile, masajes, aromas y atmósfera constituyen la verdadera esencia erótica. No venimos a cumplir expectativas ajenas ni guiones predecibles.
          </p>
        </div>

        <!-- Panel 3: Sigilo & Privacidad Absoluta -->
        <div class="p-8 rounded-3xl bg-[#2A0F24] border border-[#C5A059]/35 shadow-[0_8px_30px_rgba(89,31,38,0.25)] space-y-3">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-[#682D7E]/25 text-[#EAD397] flex items-center justify-center font-serif font-bold text-base border border-[#C5A059]/30">
              III
            </div>
            <h3 class="font-serif text-xl font-bold text-[#F7F4EE]">Sigilo, Confianza y Privacidad</h3>
          </div>
          <p class="text-sm text-[#F7F4EE]/80 leading-relaxed font-light">
            Cero cámaras no consentidas. Lo vivido dentro de nuestras puertas pertenece exclusivamente a la intimidad de quienes lo compartieron. La discreción es nuestro pacto de honor.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Registration Form -->
  <section id="registro" class="py-20 px-4 sm:px-6 lg:px-8 max-w-xl mx-auto">
    <LeadForm 
      title="Entrada a la Comunidad" 
      subtitle="Ingresa tu WhatsApp o correo para recibir convocatorias privadas, talleres y novedades de la comunidad."
    />
  </section>
</Layout>
