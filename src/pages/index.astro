---
// index.astro - Landing Principal: El Placer de Compartir
import Layout from "../layouts/Layout.astro";
import LeadForm from "../components/LeadForm.astro";
import AmbassadorSection from "../components/AmbassadorSection.astro";
---

<Layout title="El Placer de Compartir | Libertad, Erotismo Consciente y Comunidad">
  <!-- Hero Section: Lindo, Cálido y Sensorial -->
  <section class="relative min-h-[90vh] flex items-center justify-center pt-20 pb-16 px-4 sm:px-6 lg:px-8 overflow-hidden bg-transparent">
    <!-- Background Image from Media -->
    <div class="absolute inset-0 pointer-events-none -z-20">
      <img src="/media/Gemini_Generated_Image_2.jpg" alt="Centro Cultural" class="w-full h-full object-cover opacity-20" />
    </div>
    <!-- Delicadas texturas y halos ámbar cálidos y terciopelo vino -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#200D28]/95 via-[#2C1237]/90 to-[#200D28] pointer-events-none -z-10"></div>
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[700px] h-[700px] bg-[#C5A059]/10 rounded-full blur-[140px] pointer-events-none -z-10"></div>

    <div class="max-w-5xl mx-auto text-center space-y-8 relative z-10">
      <!-- Medallón Oficial & Eyebrow con separación limpia del título -->
      <div class="inline-flex items-center gap-2.5 px-5 py-2 rounded-full bg-[#2A0F24] border border-[#C5A059]/40 shadow-[0_4px_25px_rgba(89,31,38,0.2)] text-xs font-serif font-bold uppercase tracking-[0.2em] text-[#EAD397] mb-3">
        <span class="w-2 h-2 rounded-full bg-[#C5A059]"></span>
        <span>Espacio de Erotismo Consciente & Comunidad</span>
      </div>

      <!-- Main Title: Tipografía Clásica Esculpida del Logotipo -->
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#F7F4EE] leading-[1.15] break-words">
        El arte de compartir <br />
        <span class="italic font-normal text-transparent bg-clip-text bg-gradient-to-r from-[#EAD397] via-[#C5A059] to-[#F7D6CB]">
          el placer sin juicio ni ataduras
        </span>
      </h1>

      <!-- Subtitle -->
      <p class="max-w-2xl mx-auto text-base sm:text-lg text-[#F7F4EE]/85 font-light leading-relaxed">
        Pioneros en Colombia en explorar la libertad relacional, el consentimiento lúcido y el erotismo libre de presiones. Un espacio seguro, confidencial y humano.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
        <a 
          href="#registro" 
          class="px-8 py-4 rounded-full font-serif font-bold uppercase tracking-wider text-sm bg-gradient-to-r from-[#721C24] via-[#8E2835] to-[#721C24] text-[#F7F4EE] hover:brightness-110 shadow-[0_6px_25px_rgba(114,28,36,0.35)] border border-[#C5A059]/50 transition-all"
        >
          Unirme a la Comunidad
        </a>
        <a 
          href="/centro-cultural" 
          class="px-8 py-4 rounded-full font-serif font-semibold uppercase tracking-wider text-sm border border-[#C5A059]/40 bg-[#2A0F24]/80 text-[#EAD397] hover:bg-[#2A0F24] shadow-sm transition-all flex items-center gap-2"
        >
          <span>Conocer el Centro Cultural</span>
          <span class="text-xs">🏛️</span>
        </a>
      </div>

      <!-- Official Social Badges -->
      <div class="pt-8 flex flex-wrap items-center justify-center gap-6 text-xs text-[#F7F4EE]/70 border-t border-[#C5A059]/20">
        <span class="text-[#EAD397] font-serif uppercase tracking-wider font-semibold">Canales Verificados:</span>
        <a href="https://x.com/ElPlacerDC" target="_blank" rel="noopener noreferrer" class="hover:text-[#EAD397] transition-colors font-medium">X: @ElPlacerDC</a>
        <span>•</span>
        <a href="https://x.com/SegiSw" target="_blank" rel="noopener noreferrer" class="hover:text-[#EAD397] transition-colors font-medium">Dirección: @SegiSw</a>
        <span>•</span>
        <a href="https://www.tiktok.com/@elplacerdc" target="_blank" rel="noopener noreferrer" class="hover:text-[#EAD397] transition-colors font-medium">TikTok: @elplacerdc</a>
        <span>•</span>
        <a href="https://wa.me/573194194785?text=te%20escribo%20desde%20la%20p%C3%A1gina%20web%20de%20ElPlacerDC,%20deseo%20m%C3%A1s%20informaci%C3%B3n,%20me%20gu%C3%ADas%3F%20%E2%9C%A8" target="_blank" rel="noopener noreferrer" class="text-[#4CAF50] hover:text-[#81C784] transition-colors font-semibold">WhatsApp: +57 319 419 4785</a>
      </div>
    </div>
  </section>

  <!-- Sección 2: Apertura Exclusiva Centro Cultural Bogotá con Mini-Galería -->
  <section class="py-20 bg-gradient-to-b from-[#200D28] via-[#2A1132] to-[#200D28] border-y border-[#C5A059]/25 relative">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <span class="inline-block px-3.5 py-1.5 rounded-full text-[11px] font-serif font-bold uppercase tracking-widest bg-[#591F26]/30 text-[#EAD397] border border-[#C5A059]/40 mb-1">
          Apertura Exclusiva • Bogotá
        </span>
        <h2 class="font-serif text-3xl sm:text-5xl font-bold tracking-tight text-[#F7F4EE]">
          Nuevo Centro Cultural <br />
          <span class="text-[#EAD397] italic">El Placer de Compartir</span>
        </h2>
        <p class="text-base text-[#F7F4EE]/85 font-light leading-relaxed">
          Un espacio físico multidisciplinario concebido para la expansión sensorial, talleres de parejas, BDSM ético, nudismo consciente, masajes tántricos y citas a ciegas basadas en compatibilidad real.
        </p>

        <!-- Filosofía de la Dirección (@SegiSw) -->
        <div class="p-5 rounded-2xl bg-[#2A0F24] border border-[#C5A059]/35 shadow-[0_4px_25px_rgba(89,31,38,0.25)] text-left space-y-2 mt-4">
          <p class="text-xs uppercase tracking-wider text-[#EAD397] font-serif font-bold">✨ Filosofía de la Dirección (@SegiSw)</p>
          <p class="text-xs text-[#F7F4EE]/80 leading-relaxed">
            En nuestro centro cultural no existen 'ganchos' ni damas de compañía, ni personal comercial contratado (excepto por los shows). Cada mujer que asiste lo hace por su propia voluntad, curiosidad y disfrute pleno. La elegancia reside en la reciprocidad absoluta.
          </p>
        </div>
      </div>

      <!-- Mini-Galería de 4 Fotos (Lobby, Salón, Habitación, Licorera) -->
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <span class="text-xs font-serif uppercase tracking-wider text-[#EAD397] font-bold">Instalaciones Reales:</span>
          <a href="/galeria-centro-cultural" class="text-xs text-[#C5A059] hover:text-[#EAD397] transition-colors underline font-medium">
            Ver galería completa con videos →
          </a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <a href="/galeria-centro-cultural" class="group rounded-2xl overflow-hidden bg-[#140816] border border-[#C5A059]/30 shadow-md block relative">
            <div class="aspect-[4/3] overflow-hidden">
              <img 
                src="/media/centro-cultural/fotos/lobby-1.jpg" 
                alt="Lobby Principal" 
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              />
            </div>
            <div class="p-2.5 bg-[#180A1A] border-t border-[#C5A059]/20 text-center">
              <p class="text-xs font-serif font-semibold text-[#F7F4EE]">Lobby Central</p>
            </div>
          </a>

          <a href="/galeria-centro-cultural" class="group rounded-2xl overflow-hidden bg-[#140816] border border-[#C5A059]/30 shadow-md block relative">
            <div class="aspect-[4/3] overflow-hidden">
              <img 
                src="/media/centro-cultural/fotos/salon-rogo-1.jpg" 
                alt="Salón Rojo" 
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              />
            </div>
            <div class="p-2.5 bg-[#180A1A] border-t border-[#C5A059]/20 text-center">
              <p class="text-xs font-serif font-semibold text-[#F7F4EE]">Salón de Talleres</p>
            </div>
          </a>

          <a href="/galeria-centro-cultural" class="group rounded-2xl overflow-hidden bg-[#140816] border border-[#C5A059]/30 shadow-md block relative">
            <div class="aspect-[4/3] overflow-hidden">
              <img 
                src="/media/centro-cultural/fotos/hab-1-a.jpg" 
                alt="Suite Sensorial" 
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              />
            </div>
            <div class="p-2.5 bg-[#180A1A] border-t border-[#C5A059]/20 text-center">
              <p class="text-xs font-serif font-semibold text-[#F7F4EE]">Suite Íntima</p>
            </div>
          </a>

          <a href="/galeria-centro-cultural" class="group rounded-2xl overflow-hidden bg-[#140816] border border-[#C5A059]/30 shadow-md block relative">
            <div class="aspect-[4/3] overflow-hidden">
              <img 
                src="/media/centro-cultural/fotos/licorera-1.jpg" 
                alt="Barra y Licorera" 
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              />
            </div>
            <div class="p-2.5 bg-[#180A1A] border-t border-[#C5A059]/20 text-center">
              <p class="text-xs font-serif font-semibold text-[#F7F4EE]">Zona Licorera</p>
            </div>
          </a>
        </div>

        <div class="text-center pt-2">
          <a href="/centro-cultural" class="inline-flex items-center gap-2 text-sm font-serif font-bold text-[#EAD397] hover:text-[#C5A059] transition-colors group">
            <span>Explora eventos, talleres y programa de aliados del Centro Cultural</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Manifiesto Comunitario -->
  <section id="manifiesto" class="pt-20 pb-12 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto space-y-12">
    <div class="text-center space-y-4">
      <span class="inline-block px-4 py-1.5 rounded-full text-xs font-serif font-bold uppercase tracking-[0.25em] bg-[#591F26]/30 text-[#EAD397] border border-[#C5A059]/40 mb-2">
        Nuestros Principios
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[#F7F4EE]">
        El Manifiesto de la Libertad Consciente
      </h2>
      <div class="w-16 h-0.5 bg-[#C5A059] mx-auto mt-2"></div>
    </div>

    <!-- Composición Editorial Asimétrica -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      <!-- Columna Principal Editorial (5 columnas) -->
      <div class="lg:col-span-5 p-8 rounded-3xl bg-[#2A0F24] border border-[#C5A059]/35 shadow-[0_8px_30px_rgba(89,31,38,0.25)] flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-[#721C24] text-[#F7F4EE] flex items-center justify-center font-serif text-lg font-bold shadow-md border border-[#C5A059]/40">
            I
          </div>
          <h3 class="font-serif text-2xl font-bold text-[#F7F4EE]">Consentimiento Continuo</h3>
          <p class="text-sm text-[#F7F4EE]/80 leading-relaxed font-light">
            Un "sí" puede convertirse en un "no" en cualquier instante y es innegociable. La lucidez, la presencia y el respeto irrestricto son condiciones indispensables de cada encuentro.
          </p>
        </div>
        <div class="p-4 rounded-xl bg-[#1E0A1A] border-l-2 border-[#C5A059]">
          <p class="text-xs font-serif italic text-[#EAD397]">
            "Solo un 'SÍ' explícito y entusiasta es un sí. El 'no' nunca requiere justificación."
          </p>
        </div>
      </div>

      <!-- Columna Secundaria Staggered (7 columnas) -->
      <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
        <!-- Panel 2: Sensualidad Libre de Presiones -->
        <div class="p-8 rounded-3xl bg-[#2A0F24] border border-[#C5A059]/35 shadow-[0_8px_30px_rgba(89,31,38,0.25)] space-y-3">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-[#B84A39]/25 text-[#EAD397] flex items-center justify-center font-serif font-bold text-base border border-[#C5A059]/30">
              II
            </div>
            <h3 class="font-serif text-xl font-bold text-[#F7F4EE]">Sensualidad Libre de Presiones</h3>
          </div>
          <p class="text-sm text-[#F7F4EE]/80 leading-relaxed font-light">
            El placer trasciende lo genital. Miradas, complicidad, baile, masajes, aromas y atmósfera constituyen la verdadera esencia erótica. No venimos a cumplir expectativas ajenas ni guiones predecibles.
          </p>
        </div>

        <!-- Panel 3: Sigilo & Privacidad Absoluta -->
        <div class="p-8 rounded-3xl bg-[#2A0F24] border border-[#C5A059]/35 shadow-[0_8px_30px_rgba(89,31,38,0.25)] space-y-3">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-[#682D7E]/25 text-[#EAD397] flex items-center justify-center font-serif font-bold text-base border border-[#C5A059]/30">
              III
            </div>
            <h3 class="font-serif text-xl font-bold text-[#F7F4EE]">Sigilo, Confianza y Privacidad</h3>
          </div>
          <p class="text-sm text-[#F7F4EE]/80 leading-relaxed font-light">
            Cero cámaras no consentidas. Lo vivido dentro de nuestras puertas pertenece exclusivamente a la intimidad de quienes lo compartieron. La discreción es nuestro pacto de honor.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- The Corset Society: Círculo Privado (Sección Intercambiada tras Nuestros Principios) -->
  <section class="py-20 bg-gradient-to-b from-[#200D28] via-[#2A1132] to-[#200D28] border-t border-[#C5A059]/25 relative">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative p-8 sm:p-12 rounded-3xl bg-gradient-to-br from-[#260E2A] via-[#2D1233] to-[#200D28] border border-[#C5A059]/50 shadow-[0_12px_45px_rgba(32,13,40,0.6)] grid grid-cols-1 lg:grid-cols-2 gap-10 items-center text-[#F7F4EE]">
        <div class="space-y-6">
          <div class="flex items-center gap-3">
            <img 
              src="/media/logo_corsetsociety_transparent.png" 
              alt="Logo The Corset Society" 
              class="h-14 w-auto object-contain drop-shadow-[0_0_15px_rgba(197,160,89,0.35)]" 
            />
            <div class="flex flex-col">
              <span class="text-xs uppercase tracking-widest text-[#EAD397] font-serif font-bold">The Corset Society</span>
              <span class="text-[10px] uppercase tracking-wider text-[#C5A059]/70 font-sans">La Línea de Alta Exclusividad de ElPlacerDC</span>
            </div>
          </div>

          <h3 class="font-serif text-3xl sm:text-4xl font-bold text-[#F7F4EE]">
            Círculo Privado de Gala Noir & Antifaces
          </h3>

          <p class="text-sm text-[#F7F4EE]/80 leading-relaxed font-light">
            Gala Noir, antifaces y misterio en las noches de luna llena. Veladas de ticket alto y aforo estrictamente limitado, donde el acceso se concede y jamás se anuncia. Una experiencia sensorial reservada y protegida.
          </p>

          <div class="pt-2 flex flex-wrap items-center gap-4">
            <a 
              href="/the-corset-society" 
              class="px-8 py-3.5 rounded-full text-xs font-serif font-bold uppercase tracking-wider bg-gradient-to-r from-[#C5A059] to-[#EAD397] text-[#050505] hover:brightness-110 shadow-[0_0_20px_rgba(197,160,89,0.35)] transition-all"
            >
              Solicitar Admisión VIP
            </a>
            <a 
              href="/the-corset-society/luna-llena" 
              class="text-xs text-[#EAD397] hover:underline font-serif font-semibold"
            >
              Próximo Evento: Luna Llena →
            </a>
          </div>
        </div>

        <!-- Image Preview: Flyer Membresía Clean con Nuevo Logo The Corset Society -->
        <a href="/the-corset-society" class="block rounded-2xl overflow-hidden border border-[#C5A059]/40 shadow-xl group">
          <img 
            src="/media/corset-society/flyer_membresia_clean.jpg" 
            alt="The Corset Society Membresía VIP" 
            loading="lazy"
            class="w-full h-80 object-cover object-top group-hover:scale-105 transition-transform duration-700" 
          />
        </a>
      </div>
    </div>
  </section>

  <!-- Ambassador Section -->
  <AmbassadorSection />

  <!-- Interactive Registration Form con espaciado optimizado -->
  <section id="registro" class="pt-6 pb-20 px-4 sm:px-6 lg:px-8 max-w-xl mx-auto">
    <LeadForm 
      title="Entrada a la Comunidad" 
      subtitle="Ingresa tu WhatsApp o correo para recibir convocatorias privadas, talleres y eventos de la comunidad."
    />
  </section>
</Layout>
