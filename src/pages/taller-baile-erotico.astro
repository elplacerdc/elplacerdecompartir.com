---
// taller-baile-erotico.astro - Evento Oficial ElPlacerDC / Centro Cultural
import Layout from "../layouts/Layout.astro";
import { pool } from "../db/index";

const cookieRef = Astro.cookies.get("affiliate_ref")?.value || Astro.url.searchParams.get("ref") || Astro.url.searchParams.get("r") || null;

let isVipRefSsr = false;
if (cookieRef) {
  const cleanRef = cookieRef.trim().toLowerCase();
  if (cleanRef === "segisw") {
    isVipRefSsr = true;
  } else {
    try {
      const { rows } = await pool.query(
        `SELECT l.vip_until, l.metadata 
         FROM afiliados a 
         LEFT JOIN leads l ON (LOWER(l.email) = LOWER(a.email) OR l.whatsapp = a.whatsapp OR LOWER(l.alias_nombre) = LOWER(a.alias))
         WHERE LOWER(a.alias) = LOWER($1)
         LIMIT 1`,
        [cleanRef]
      );
      if (rows.length > 0) {
        const row = rows[0];
        const hasVipUntil = row.vip_until && new Date(row.vip_until) > new Date();
        const hasVipTag = Array.isArray(row.metadata?.tags) && (row.metadata.tags.includes("vip_activo") || row.metadata.tags.includes("corset_vip"));
        if (hasVipUntil || hasVipTag) {
          isVipRefSsr = true;
        }
      }
    } catch (_) {}
  }
}

const discPercentSsr = isVipRefSsr ? 0.20 : (cookieRef ? 0.10 : 0);
const discLabelSsr = isVipRefSsr ? "-20%" : "-10%";

// Precios base: Solo Taller $40k (pago completo), Taller + Velada $120k (reserva 50% = $60k)
const baseSoloSsr = 40000;
const baseVeladaSsr = 120000;
const baseSeparaVeladaSsr = 60000;

const precioSoloTallerSsr = Math.round(baseSoloSsr * (1 - discPercentSsr));
const precioVeladaSsr = Math.round(baseVeladaSsr * (1 - discPercentSsr));
const separaVeladaSsr = Math.round(baseSeparaVeladaSsr * (1 - discPercentSsr));
---

