            </h3>
            <p class="text-xs text-[#f7f4ee]/70 mt-1">
              Genera tu credencial oficial con código QR y coordina tu pago seguro.
            </p>
          </div>

          <!-- Aviso de Datos Vinculados a Cuenta Oficial + Botón Editar Perfil -->
          <div id="prefilled-profile-notice" class="hidden p-3.5 rounded-xl bg-[#140816] border border-[#c5a059]/40 text-xs font-sans text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-2 shadow-sm">
            <div class="flex items-center gap-2">
              <span class="text-base">🔒</span>
              <div>
                <span class="text-[#ead397] font-semibold block text-[11px]">Datos vinculados a tu cuenta oficial</span>
                <span class="text-[#f7f4ee]/70 text-[10px]">Para modificar tu nombre, correo o modalidad:</span>
              </div>
            </div>
            <a 
              href="/dashboard#section-profile-settings" 
              class="px-3.5 py-1.5 rounded-full border border-[#c5a059]/50 text-[#ead397] hover:bg-[#c5a059]/20 text-[11px] font-bold uppercase tracking-wider transition-all whitespace-nowrap shrink-0 inline-flex items-center gap-1"
            >
              <span>⚙️</span> Editar mi Perfil →
            </a>
          </div>

          <form id="checkoutForm" class="space-y-5">
            <input type="hidden" id="selectedTierInput" name="tipo_entrada" value="taller_velada" />

            <!-- Selector de Modalidad (Pago Total vs Separación) -->
            <div class="space-y-2">
              <label class="block text-xs font-semibold uppercase tracking-wider text-[#c5a059]">
                Modalidad de Pago:
              </label>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                <label id="opt-pago-total" class="flex items-center gap-2.5 p-3 rounded-xl bg-[#180A1A] border border-[#c5a059]/40 cursor-pointer hover:border-[#c5a059]">
                  <input type="radio" name="modalidad" value="pago_total" checked onchange="updateSummary()" class="accent-[#c5a059]" />
                  <div>
                    <span class="font-bold text-[#f7f4ee] block">Pago Total (100%)</span>
                    <span class="text-[11px] text-[#ead397]" id="summary-total-label">Garantiza tu cupo de inmediato</span>
                  </div>
                </label>

                <label id="opt-reserva-50" class="flex items-center gap-2.5 p-3 rounded-xl bg-[#180A1A] border border-[#c5a059]/40 cursor-pointer hover:border-[#c5a059]">
                  <input type="radio" name="modalidad" value="reserva_50" onchange="updateSummary()" class="accent-[#c5a059]" />
                  <div>
                    <span class="font-bold text-[#f7f4ee] block">Separar Cupo (50%)</span>
                    <span class="text-[11px] text-[#81c784]" id="summary-separa-label">Saldo restante en puerta</span>
                  </div>
                </label>
              </div>
            </div>

            <!-- Campos de Contacto -->
            <div class="space-y-4">
              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-[#c5a059] mb-1">
                  Nombre o Alias de Asistencia <span class="text-[#b84a39]">*</span>
                </label>
                <input 
                  type="text" 
                  id="alias_nombre" 
                  name="alias_nombre" 
                  required 
                  placeholder="Ej: Andrés / Pareja Sw / Laura"
                  class="w-full px-3.5 py-2.5 rounded-xl bg-[#180A1A] border border-[#c5a059]/40 text-xs text-[#f7f4ee] focus:outline-none focus:border-[#c5a059]"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-semibold uppercase tracking-wider text-[#c5a059] mb-1">
                    WhatsApp (con indicativo) <span class="text-[#b84a39]">*</span>
                  </label>
                  <input 
                    type="tel" 
                    id="whatsapp" 
                    name="whatsapp" 
                    required 
                    placeholder="Ej: +57 310 123 4567"
                    class="w-full px-3.5 py-2.5 rounded-xl bg-[#180A1A] border border-[#c5a059]/40 text-xs text-[#f7f4ee] focus:outline-none focus:border-[#c5a059]"
                  />
                </div>

                <div>
                  <label class="block text-xs font-semibold uppercase tracking-wider text-[#c5a059] mb-1">
                    Correo Electrónico <span class="text-[#b84a39]">*</span>
                  </label>
                  <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    required 
                    placeholder="Para recibir tu credencial con QR"
                    class="w-full px-3.5 py-2.5 rounded-xl bg-[#180A1A] border border-[#c5a059]/40 text-xs text-[#f7f4ee] focus:outline-none focus:border-[#c5a059]"
                  />
                </div>
              </div>
            </div>

            <!-- Resumen de Liquidación -->
            <div class="p-4 rounded-2xl bg-[#180A1A] border border-[#c5a059]/30 space-y-2 text-xs">
              <div class="flex justify-between items-center text-[#f7f4ee]/70">
                <span>Pase Seleccionado:</span>
                <strong id="summary-tier-name" class="text-[#ead397]">Taller + Velada VIP</strong>
              </div>
              <div class="flex justify-between items-center text-[#f7f4ee]/70">
                <span>Modalidad:</span>
                <strong id="summary-mod-name" class="text-[#f7f4ee]">Pago Total (100%)</strong>
              </div>
              <div class="flex justify-between items-center pt-2 border-t border-[#c5a059]/20 text-sm">
                <span class="font-bold text-[#ead397]">Monto a Pagar Hoy:</span>
                <span id="summary-monto-hoy" class="font-bold text-lg text-[#81c784]">$120.000 COP</span>
              </div>
              <div id="summary-saldo-puerta-row" class="hidden flex justify-between items-center text-[11px] text-[#f7f4ee]/60">
                <span>Saldo pendiente al ingresar:</span>
                <span id="summary-saldo-puerta" class="font-semibold text-[#ead397]">$60.000 COP</span>
              </div>
            </div>

            <!-- Botones de Acción de Pago -->
            <div class="pt-2 space-y-3">
              <button 
                type="button" 
                onclick="submitCheckout('pasarela_digital')"
                id="btnDigitalPay"
                class="w-full py-3.5 rounded-full bg-gradient-to-r from-[#c5a059] via-[#ead397] to-[#c5a059] text-[#0a0608] font-serif font-bold text-xs uppercase tracking-wider hover:brightness-110 shadow-[0_0_20px_rgba(197,160,89,0.3)] transition-all cursor-pointer"
              >
                Pagar en Línea Seguro (PSE / Tarjeta) →
              </button>

              <button 
                type="button" 
                onclick="submitCheckout('whatsapp_manual')"
                id="btnManualPay"
                class="w-full py-3 rounded-full border border-[#c5a059]/50 text-xs font-serif uppercase tracking-wider text-[#ead397] hover:bg-[#c5a059]/15 transition-all text-center block cursor-pointer"
              >
                Coordinar Pago Manual por WhatsApp (Bre-B / Nequi / Bancolombia)
              </button>
            </div>

            <p id="checkoutMsg" class="text-center text-xs text-[#ead397] min-h-[1.5rem]"></p>
          </form>

          <div class="text-[11px] text-center text-[#f7f4ee]/50 space-y-1 pt-3 border-t border-[#c5a059]/20">
            <p>🛡️ Reserva formal respaldada por la comunidad El Placer de Compartir.</p>
            <p>Atención directa por WhatsApp: <strong>+57 319 419 4785</strong> • Calle 67 # 23-46 Piso 2, Bogotá</p>
          </div>
        </div>

      </section>

    </main>

  </div>

  <script is:inline>
    var activeRef = null;
    var discPercent = 0;
    var isVipRef = false;

    // 0. Precios base oficiales actualizados: $40.000 y $120.000
    var PRICING = {
      taller_solo: {
        total: 40000,
        reserva_50: null,
        name: "Solo Taller (Individual o Pareja)"
      },
      taller_velada: {
        total: 120000,
        reserva_50: 60000,
        name: "Taller + Velada VIP Centro Cultural"
      }
    };

    var selectedTier = "taller_velada";

    // 1. Mostrar banner de beneficio de embajador / VIP
    function showAffiliateBanner(title, alias, pct) {
      var banner = document.getElementById("affiliateBanner");
      if (banner) banner.classList.remove("hidden");
      
      var bannerTitle = document.getElementById("affiliateBannerTitle");
      if (bannerTitle) bannerTitle.textContent = title;

      var affText = document.getElementById("affiliateAliasText");
      if (affText) affText.textContent = alias;

      var discText = document.getElementById("affiliateDiscText");
      if (discText) discText.textContent = pct;
    }

    function applyDiscountToCards() {
      if (discPercent <= 0) return;

      var pSolo = Math.round(PRICING.taller_solo.total * (1 - discPercent));
      var pVelada = Math.round(PRICING.taller_velada.total * (1 - discPercent));
      var sVelada = Math.round(PRICING.taller_velada.reserva_50 * (1 - discPercent));

      var dispSolo = document.getElementById("price-display-solo");
      if (dispSolo) {
        dispSolo.innerHTML = '<span class="line-through text-[#f7f4ee]/40 text-xl mr-2 font-normal font-sans">$40.000</span><span class="text-[#81c784]">$' + pSolo.toLocaleString('es-CO') + '</span><span class="text-xs font-normal text-[#f7f4ee]/50 ml-1 font-sans">COP</span>';
      }
      var badgeSolo = document.getElementById("badge-disc-solo");
      if (badgeSolo) {
        badgeSolo.textContent = discPercent === 0.20 ? "-20%" : "-10%";
        badgeSolo.classList.remove("hidden");
      }

      var dispVelada = document.getElementById("price-display-velada");
      if (dispVelada) {
        dispVelada.innerHTML = '<span class="line-through text-[#f7f4ee]/40 text-xl mr-2 font-normal font-sans">$120.000</span><span class="text-[#81c784]">$' + pVelada.toLocaleString('es-CO') + '</span><span class="text-xs font-normal text-[#f7f4ee]/50 ml-1 font-sans">COP</span>';
      }
      var separaVelada = document.getElementById("separa-display-velada");
      if (separaVelada) {
        separaVelada.innerHTML = 'O separa con la mitad: <strong class="text-[#81c784]">$' + sVelada.toLocaleString('es-CO') + ' COP</strong> <span class="line-through text-[#f7f4ee]/40 text-[10px]">($60.000)</span>';
      }
      var badgeVelada = document.getElementById("badge-disc-velada");
      if (badgeVelada) {
        badgeVelada.textContent = discPercent === 0.20 ? "-20%" : "-10%";
        badgeVelada.classList.remove("hidden");
      }
    }

    // 2. Selección de Pase con Desplazamiento Suave al Formulario de Pago
    function selectTierAndScroll(tierKey) {
      selectTier(tierKey);
      var checkoutEl = document.getElementById("checkout");
      if (checkoutEl) {
        checkoutEl.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }

    function selectTier(tierKey) {
      selectedTier = tierKey;
      var tierInput = document.getElementById("selectedTierInput");
      if (tierInput) tierInput.value = tierKey;

      var cardSolo = document.getElementById("card-taller_solo");
      var cardVelada = document.getElementById("card-taller_velada");
      var optReserva = document.getElementById("opt-reserva-50");

      if (tierKey === "taller_solo") {
        if (cardSolo) {
          cardSolo.classList.add("border-[#c5a059]", "shadow-[0_0_25px_rgba(197,160,89,0.3)]");
          cardSolo.classList.remove("border-[#c5a059]/40");
        }
        if (cardVelada) {
          cardVelada.classList.remove("border-[#c5a059]", "shadow-[0_0_30px_rgba(197,160,89,0.2)]");
          cardVelada.classList.add("border-[#c5a059]/40");
        }
        if (optReserva) optReserva.classList.add("hidden");
        var radioTotal = document.querySelector('input[name="modalidad"][value="pago_total"]');
        if (radioTotal) radioTotal.checked = true;
      } else {
        if (cardVelada) {
          cardVelada.classList.add("border-[#c5a059]", "shadow-[0_0_30px_rgba(197,160,89,0.2)]");
          cardVelada.classList.remove("border-[#c5a059]/40");
        }
        if (cardSolo) {
          cardSolo.classList.remove("border-[#c5a059]", "shadow-[0_0_25px_rgba(197,160,89,0.3)]");
          cardSolo.classList.add("border-[#c5a059]/40");
        }
        if (optReserva) optReserva.classList.remove("hidden");
      }

      updateSummary();
    }

    function updateSummary() {
      var tierInfo = PRICING[selectedTier];
      var modRadio = document.querySelector('input[name="modalidad"]:checked');
      var modalidad = modRadio ? modRadio.value : "pago_total";

      var totalReal = Math.round(tierInfo.total * (1 - discPercent));
      var reservaReal = tierInfo.reserva_50 ? Math.round(tierInfo.reserva_50 * (1 - discPercent)) : null;

      var sumTierName = document.getElementById("summary-tier-name");
      var sumModName = document.getElementById("summary-mod-name");
      var sumMontoHoy = document.getElementById("summary-monto-hoy");
      var saldoRow = document.getElementById("summary-saldo-puerta-row");
      var saldoPuerta = document.getElementById("summary-saldo-puerta");

      if (sumTierName) sumTierName.textContent = tierInfo.name;

      if (modalidad === "reserva_50" && reservaReal) {
        if (sumModName) sumModName.textContent = "Separación de Cupo (50%)";
        if (sumMontoHoy) sumMontoHoy.textContent = "$" + reservaReal.toLocaleString('es-CO') + " COP";
        if (saldoRow) saldoRow.classList.remove("hidden");
        if (saldoPuerta) saldoPuerta.textContent = "$" + (totalReal - reservaReal).toLocaleString('es-CO') + " COP";
      } else {
        if (sumModName) sumModName.textContent = "Pago Total (100%)";
        if (sumMontoHoy) sumMontoHoy.textContent = "$" + totalReal.toLocaleString('es-CO') + " COP";
        if (saldoRow) saldoRow.classList.add("hidden");
      }
    }

    // 3. Resolución Dinámica de VIP y Descuentos
    async function resolveDiscountsAndVip() {
      try {
        var urlParams = new URLSearchParams(window.location.search);
        var qRef = urlParams.get("ref") || urlParams.get("r");

        var storedRef = qRef ? qRef.trim().toLowerCase() : localStorage.getItem("affiliate_ref");
        if (!storedRef) {
          var match = document.cookie.match(/(?:^|;\s*)affiliate_ref=([^;]+)/);
          if (match) storedRef = decodeURIComponent(match[1]).trim().toLowerCase();
        }
        if (storedRef) {
          activeRef = storedRef.trim().toLowerCase();
          localStorage.setItem("affiliate_ref", activeRef);
          document.cookie = 'affiliate_ref=' + encodeURIComponent(activeRef) + '; path=/; max-age=2592000; SameSite=Lax';
        }

        // Revisar si el usuario en sesión activa es VIP activo
        var isUserVip = false;
        var sessionPhone = localStorage.getItem("ambassador_session_phone") || localStorage.getItem("user_phone");
        var userProfile = null;
        try {
          var raw = localStorage.getItem("user_profile");
          if (raw) userProfile = JSON.parse(raw);
        } catch (_) {}
        var sessionEmail = userProfile?.email || localStorage.getItem("user_email");
        var sessionAlias = userProfile?.alias_nombre || localStorage.getItem("user_alias");
        var sessionIdent = sessionPhone || sessionEmail || sessionAlias;

        if (sessionIdent) {
          try {
            var statsRes = await fetch("/api/affiliates/stats?identifier=" + encodeURIComponent(sessionIdent));
            var statsData = await statsRes.json();
            if (statsData?.stats?.vipStatus === "vip_activo") {
              isUserVip = true;
            }
          } catch (_) {}
        }

        if (!isUserVip) {
          var cachedVip = localStorage.getItem("user_vip_status") || localStorage.getItem("vip_status");
          if (cachedVip === "vip_activo") isUserVip = true;
        }

        if (isUserVip) {
          discPercent = 0.20;
          isVipRef = true;
          showAffiliateBanner("Has sido invitado por un Embajador VIP", "VIP Activo", "-20%");
          applyDiscountToCards();
          updateSummary();
          return;
        }

        // Si no es VIP propio, verificar si el embajador referente es VIP
        if (activeRef) {
          var isAmbassadorVip = (activeRef === "segisw");
          try {
            var checkRes = await fetch("/api/affiliates/stats?identifier=" + encodeURIComponent(activeRef));
            var checkData = await checkRes.json();
            if (checkData?.stats?.vipStatus === "vip_activo") {
              isAmbassadorVip = true;
            }
          } catch (_) {}

          discPercent = isAmbassadorVip ? 0.20 : 0.10;
          isVipRef = isAmbassadorVip;
          var title = isAmbassadorVip ? "Has sido invitado por un Embajador VIP" : "Has sido invitado por un Embajador";
          showAffiliateBanner(title, activeRef, isAmbassadorVip ? "-20%" : "-10%");
          applyDiscountToCards();
          updateSummary();
        }
      } catch (_) {}
    }

    // 4. Carga Automática Inmutable de Usuario Activo y Enlace a Editar Perfil
    async function hydrateSessionFormFields() {
      var userProfile = null;
      try {
        var raw = localStorage.getItem("user_profile");
        if (raw) userProfile = JSON.parse(raw);
      } catch (_) {}

      var sessionPhone = localStorage.getItem("ambassador_session_phone") || localStorage.getItem("user_phone") || userProfile?.whatsapp;
      var aliasVal = userProfile?.alias_nombre || localStorage.getItem("user_alias");
      var emailVal = userProfile?.email || localStorage.getItem("user_email");
      var phoneVal = sessionPhone;

      var inputAlias = document.getElementById("alias_nombre");
      var inputPhone = document.getElementById("whatsapp");
      var inputEmail = document.getElementById("email");
      var noticeBanner = document.getElementById("prefilled-profile-notice");

      function lockReadOnly(el) {
        if (!el || !el.value) return;
        el.readOnly = true;
        el.classList.add("opacity-80", "cursor-not-allowed", "bg-[#0a050c]");
        el.title = "Dato vinculado a tu cuenta oficial. Para modificarlo haz clic en 'Editar mi Perfil'.";
      }

      if (inputAlias && aliasVal) {
        inputAlias.value = aliasVal;
        lockReadOnly(inputAlias);
      }
      if (inputPhone && phoneVal) {
        inputPhone.value = phoneVal;
        lockReadOnly(inputPhone);
      }
      if (inputEmail && emailVal) {
        inputEmail.value = emailVal;
        lockReadOnly(inputEmail);
      }

      if (aliasVal || phoneVal || emailVal) {
        if (noticeBanner) noticeBanner.classList.remove("hidden");
      }

      if ((!aliasVal || !emailVal) && sessionPhone) {
        try {
          var res = await fetch("/api/leads/check", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ whatsapp: sessionPhone }),
          });
          var data = await res.json();
          if (data.exists && data.lead) {
            var lead = data.lead;
            if (lead.alias_nombre) {
              aliasVal = lead.alias_nombre;
              localStorage.setItem("user_alias", lead.alias_nombre);
              if (inputAlias) {
                inputAlias.value = lead.alias_nombre;
                lockReadOnly(inputAlias);
              }
            }
            if (lead.email) {
              emailVal = lead.email;
              localStorage.setItem("user_email", lead.email);
              if (inputEmail) {
                inputEmail.value = lead.email;
                lockReadOnly(inputEmail);
              }
            }
            if (lead.whatsapp) {
              phoneVal = lead.whatsapp;
              localStorage.setItem("user_phone", lead.whatsapp);
              if (inputPhone) {
                inputPhone.value = lead.whatsapp;
                lockReadOnly(inputPhone);
              }
            }
            localStorage.setItem("user_profile", JSON.stringify({
              alias: lead.affiliate_code || aliasVal,
              alias_nombre: aliasVal,
              whatsapp: phoneVal,
              email: emailVal || "",
              rol: lead.rol || "pareja",
              ciudad: lead.ciudad || "Bogotá",
              referredBy: lead.referred_by || null,
            }));
            if (noticeBanner) noticeBanner.classList.remove("hidden");
          }
        } catch (_) {}
      }
    }

    // Exponer funciones globales para onclick en HTML
    window.selectTierAndScroll = selectTierAndScroll;
    window.selectTier = selectTier;
    window.updateSummary = updateSummary;
    window.submitCheckout = submitCheckout;

    document.getElementById("card-taller_solo")?.addEventListener("click", function() { selectTierAndScroll("taller_solo"); });
    document.getElementById("card-taller_velada")?.addEventListener("click", function() { selectTierAndScroll("taller_velada"); });

    async function submitCheckout(metodo) {
      var msg = document.getElementById("checkoutMsg");
      var alias = document.getElementById("alias_nombre")?.value?.trim();
      var whatsapp = document.getElementById("whatsapp")?.value?.trim();
      var email = document.getElementById("email")?.value?.trim();
      var modRadio = document.querySelector('input[name="modalidad"]:checked');
      var modalidad = modRadio ? modRadio.value : "pago_total";

      if (!alias || !whatsapp || !email) {
        if (msg) msg.textContent = "⚠️ Por favor completa tu nombre, WhatsApp y correo electrónico.";
        return;
      }

      var btnDigital = document.getElementById("btnDigitalPay");
      var btnManual = document.getElementById("btnManualPay");
      if (btnDigital) btnDigital.disabled = true;
      if (btnManual) btnManual.disabled = true;

      if (msg) msg.textContent = "⏳ Conectando con la pasarela segura...";

      try {
        var res = await fetch("/api/checkout/create", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            evento: "taller_baile_erotico",
            tipo_entrada: selectedTier,
            modalidad_pago: modalidad,
            metodo_pago: metodo,
            alias_nombre: alias,
            whatsapp: whatsapp,
            email: email,
            ref: activeRef
          })
        });

        var data = await res.json();
        if (data.success && data.redirect_url) {
          if (msg) msg.textContent = "✓ Redireccionando a la pasarela segura...";
          window.location.href = data.redirect_url;
        } else if (data.error) {
          if (msg) msg.textContent = "❌ " + data.error;
          if (btnDigital) btnDigital.disabled = false;
          if (btnManual) btnManual.disabled = false;
        } else {
          if (msg) msg.textContent = "⚠️ Ocurrió un error al generar la orden.";
          if (btnDigital) btnDigital.disabled = false;
          if (btnManual) btnManual.disabled = false;
        }
      } catch (err) {
        if (msg) msg.textContent = "❌ Error de conexión al procesar el pago.";
        if (btnDigital) btnDigital.disabled = false;
        if (btnManual) btnManual.disabled = false;
      }
    }

    // Inicializar resumen e hidratar campos al cargar
    updateSummary();
    hydrateSessionFormFields();
    resolveDiscountsAndVip();
  </script>
</Layout>
