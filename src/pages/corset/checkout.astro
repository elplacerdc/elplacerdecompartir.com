---
// src/pages/corset/checkout.astro - Landing Individual de Checkout Membresía VIP ($199.000 COP)
import Layout from "../../layouts/Layout.astro";
import VipCheckout from "../../components/VipCheckout.astro";
import CorsetHeader from "../../components/CorsetHeader.astro";
---

<Layout 
  title="Activación de Credencial VIP Anual — The Corset Society"
  description="Finaliza la activación de tu membresía anual VIP a The Corset Society ($199.000 COP). Acceso preferencial, invitaciones exclusivas y beneficios de honor."
  isCorset={true}
>
  <div class="min-h-screen bg-[#050505] text-[#f7f4ee] font-serif selection:bg-[#c5a059] selection:text-[#050505] relative overflow-hidden">
    
    <!-- Header Minimalista Noir -->
    <CorsetHeader current="checkout" />

    <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 text-center space-y-12 relative z-10">
      
      <!-- Headline -->
      <div class="space-y-4">
        <div class="inline-block px-4 py-1.5 rounded-full border border-[#c5a059]/40 bg-[#4a0e17]/25 text-[11px] tracking-[0.25em] uppercase text-[#ead397]">
          Paso Final de Admisión VIP
        </div>

        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-[#f7f4ee] leading-[1.15]">
          Activación de Credencial VIP <br />
          <span class="italic font-normal text-transparent bg-clip-text bg-gradient-to-r from-[#c5a059] via-[#ead397] to-[#8a6d3b]">
            The Corset Society
          </span>
        </h1>

        <p class="max-w-2xl mx-auto text-sm sm:text-base font-sans font-light text-[#f7f4ee]/85 leading-relaxed">
          Tu postulación ha sido recibida con éxito. Para activar formalmente tu membresía anual y recibir tu código de acceso prioritario a todas las veladas, completa el pago oficial a continuación.
        </p>
      </div>

      <!-- Artefacto Visual Credencial VIP Oficial (Clickeable ancla al pago) -->
      <a href="#vip-checkout-box" class="block max-w-md mx-auto my-8 relative group cursor-pointer transition-transform duration-300 hover:scale-[1.01]">
        <div class="absolute -inset-1.5 bg-gradient-to-r from-[#c5a059]/40 via-[#ead397]/60 to-[#c5a059]/40 rounded-3xl blur-lg opacity-75 group-hover:opacity-100 transition duration-1000 group-hover:duration-200 animate-pulse"></div>
        <div class="relative rounded-2xl overflow-hidden shadow-[0_0_50px_rgba(197,160,89,0.35)] border border-[#c5a059]/40 bg-[#0d0408]">
          <img 
            src="/media/corset-society/credencial-vip-checkout.jpg" 
            alt="Membresía Oficial The Corset Society — Credencial VIP" 
            class="w-full h-auto object-contain transition-transform duration-700 ease-out group-hover:scale-[1.02]"
            loading="eager"
          />
          <div class="py-3.5 px-4 bg-[#140816]/95 border-t border-[#c5a059]/30 flex items-center justify-between text-left gap-2">
            <div>
              <p class="text-[11px] font-sans text-[#f7f4ee]/90 leading-tight">
                esta credencial puede ser tuya, emisión directa y vinculada a tu perfil tras el pago
              </p>
            </div>
            <span class="inline-flex items-center gap-1 text-[11px] uppercase tracking-wider text-[#c5a059] font-bold border border-[#c5a059]/50 px-3 py-1.5 rounded-full bg-[#c5a059]/20 shrink-0 group-hover:bg-[#c5a059] group-hover:text-[#050505] transition-all">
              activar 💎
            </span>
          </div>
        </div>
      </a>

      <!-- Checkout Container -->
      <div id="vip-checkout-box" class="max-w-xl mx-auto scroll-mt-24">
        <VipCheckout />
      </div>

      <!-- Beneficios Destacados -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-left pt-6 border-t border-[#c5a059]/20">
        <div class="p-5 rounded-2xl bg-[#140816] border border-[#c5a059]/30 space-y-2">
          <span class="text-xl">🗝️</span>
          <h2 class="font-serif text-base font-bold text-[#ead397]">Acceso Preferencial</h2>
          <p class="text-xs font-sans text-[#f7f4ee]/70 leading-relaxed font-light">
            Convocatorias secretas con antelación prioritaria de 24 horas y cupos garantizados.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-[#140816] border border-[#c5a059]/30 space-y-2">
          <span class="text-xl">💎</span>
          <h2 class="font-serif text-base font-bold text-[#ead397]">Tarifas de Honor</h2>
          <p class="text-xs font-sans text-[#f7f4ee]/70 leading-relaxed font-light">
            Descuentos permanentes durante todo un año en entradas de gala y encuentros privados.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-[#140816] border border-[#c5a059]/30 space-y-2">
          <span class="text-xl">🎭</span>
          <h2 class="font-serif text-base font-bold text-[#ead397]">Fantasías a Medida</h2>
          <p class="text-xs font-sans text-[#f7f4ee]/70 leading-relaxed font-light">
            Canal directo y confidencial con la dirección para realización de veladas personalizadas.
          </p>
        </div>
      </div>

      <!-- Footer Asistencia -->
      <div class="text-[11px] font-sans text-[#f7f4ee]/50 space-y-1 pt-6">
        <p>¿Prefieres coordinar tu activación por transferencia bancaria directa (Bancolombia / Nequi / Bre-B)?</p>
        <p>Escríbenos directamente a la línea oficial: <a href="https://wa.me/573194194785" target="_blank" rel="noopener noreferrer" class="text-[#4caf50] underline font-semibold">+57 319 419 4785</a></p>
      </div>

    </main>
  </div>
</Layout>
