---
// Layout.astro - El Placer de Compartir & The Corset Society
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  isCorset?: boolean;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  canonicalUrl?: string;
  noindex?: boolean;
  hideFooter?: boolean;
  hideHeader?: boolean;
}

const {
  title,
  isCorset = false,
  ogImage = isCorset ? "/assets_corsetsociety/og-default.jpg" : "/assets_elplacerdc/og-default.jpg",
  ogImageWidth = 1200,
  ogImageHeight = 630,
  canonicalUrl = Astro.url.href,
  noindex = false,
  hideFooter = false,
  hideHeader = false,
} = Astro.props;

const defaultDescription = isCorset
  ? "The Corset Society • Espacio exclusivo de alta elegancia, estética noir, experiencias inmersivas y libertad sexual consciente en Bogotá. Convocatorias y eventos selectos."
  : "Comunidad pionera en Colombia para adultos de mente abierta y sexualidad responsable. Centro cultural organizador de talleres, encuentros y eventos para toda la comunidad de libertad sexual sin tabús ni prejuicios en Bogotá.";

const description = Astro.props.description || defaultDescription;

const siteUrl = "https://elplacerdecompartir.com";
const resolvedOgImage = ogImage.startsWith("http")
  ? ogImage
  : `${siteUrl}${ogImage.startsWith("/") ? "" : "/"}${ogImage}`;

const faviconFolder = isCorset ? "/assets_corsetsociety" : "/assets_elplacerdc";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && (
      <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
      <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    )}

    <!-- Favicon Suite -->
    <link rel="icon" type="image/x-icon" href={`${faviconFolder}/favicon.ico`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${faviconFolder}/favicon-16x16.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${faviconFolder}/favicon-32x32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${faviconFolder}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${faviconFolder}/site.webmanifest`} />

    <!-- OpenGraph / WhatsApp (<300KB budget) -->
    <meta property="og:site_name" content={isCorset ? "The Corset Society" : "El Placer de Compartir"} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:secure_url" content={resolvedOgImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={isCorset ? "@corsetsociety" : "@ElPlacerDC"} />
    <meta name="twitter:creator" content="@SegiSw" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- SEO-AEO-GEO Directives -->
    <meta name="geo.region" content="CO-DC" />
    <meta name="geo.placename" content="Bogotá, Colombia" />
    <meta name="geo.position" content="4.60971;-74.08175" />
    <meta name="ICBM" content="4.60971, -74.08175" />
    <meta name="rating" content="mature" />

    <!-- Google Fonts Optimized (Cinzel Display, Inter Body, Plus Jakarta Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@400;600&display=swap"
      rel="stylesheet"
    />

    <!-- Schema.org RDF @graph -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://elplacerdecompartir.com/#organization",
          "name": "El Placer de Compartir",
          "url": "https://elplacerdecompartir.com",
          "logo": "https://elplacerdecompartir.com/media/logo_elplacerdc_x.jpg",
          "sameAs": [
            "https://x.com/ElPlacerDC",
            "https://x.com/corsetsociety",
            "https://x.com/SegiSw",
            "https://www.tiktok.com/@elplacerdc"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "+57-319-419-4785",
            "contactType": "reservations",
            "areaServed": "CO"
          }
        },
        {
          "@type": "WebSite",
          "@id": "https://elplacerdecompartir.com/#website",
          "url": "https://elplacerdecompartir.com",
          "name": "El Placer de Compartir",
          "publisher": { "@id": "https://elplacerdecompartir.com/#organization" }
        }
      ]
    })} />
  </head>
  <body class:list={[isCorset ? "bg-[#050505]" : "bg-[#180A1A]", "text-[#f7f4ee] selection:bg-[#c5a059] selection:text-[#050505] min-h-[100dvh] w-full overflow-x-hidden antialiased"]}>
    {!isCorset && !hideHeader && <Header />}
    <slot />
    {!isCorset && !hideFooter && <Footer />}
    <script is:inline>
      try {
        const params = new URLSearchParams(window.location.search);
        const ref = params.get('ref') || params.get('r');
        let cleanRef = ref ? ref.trim().toLowerCase() : null;

        // Prevención dinámica de auto-referido y referidor sellado
        let myAlias = (localStorage.getItem('user_alias') || '').trim().toLowerCase();
        let myReferredBy = (localStorage.getItem('user_referred_by') || '').trim().toLowerCase();
        try {
          const profileRaw = localStorage.getItem('user_profile');
          if (profileRaw) {
            const parsed = JSON.parse(profileRaw);
            if (parsed.alias) myAlias = parsed.alias.trim().toLowerCase();
            if (parsed.referredBy) myReferredBy = parsed.referredBy.trim().toLowerCase();
          }
        } catch (e) {}

        if (cleanRef && myAlias && cleanRef === myAlias) {
          cleanRef = myReferredBy || 'segisw';
        }

        if (!cleanRef) {
          const match = document.cookie.match(/(?:^|;\s*)affiliate_ref=([^;]+)/);
          if (match) cleanRef = decodeURIComponent(match[1]).trim().toLowerCase();
        }
        if (!cleanRef) {
          cleanRef = localStorage.getItem('affiliate_ref');
        }
        // Fallback orgánico al Embajador Padre si entra directo a la web
        if (!cleanRef && myReferredBy) {
          cleanRef = myReferredBy;
        }

        if (cleanRef && myAlias && cleanRef === myAlias) {
          cleanRef = myReferredBy || 'segisw';
        }

        if (cleanRef) {
          localStorage.setItem('affiliate_ref', cleanRef);
          document.cookie = 'affiliate_ref=' + encodeURIComponent(cleanRef) + '; path=/; max-age=2592000; SameSite=Lax';
        }
      } catch (e) {}
    </script>
  </body>
</html>
