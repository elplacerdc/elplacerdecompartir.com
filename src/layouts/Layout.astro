---
// Layout.astro - El Placer de Compartir & The Corset Society
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  isCorset?: boolean;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title,
  description = "Comunidad pionera en Colombia de libertad, consentimiento consciente y erotismo libre de presiones. Nuevo Centro Cultural en Bogotá y The Corset Society.",
  isCorset = false,
  ogImage = isCorset ? "/assets_corsetsociety/og-default.jpg" : "/assets_elplacerdc/og-default.jpg",
  canonicalUrl = Astro.url.href,
} = Astro.props;

const siteUrl = "https://elplacerdecompartir.com";
const resolvedOgImage = ogImage.startsWith("http")
  ? ogImage
  : `${siteUrl}${ogImage.startsWith("/") ? "" : "/"}${ogImage}`;

const faviconFolder = isCorset ? "/assets_corsetsociety" : "/assets_elplacerdc";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon Suite -->
    <link rel="icon" type="image/x-icon" href={`${faviconFolder}/favicon.ico`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${faviconFolder}/favicon-16x16.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${faviconFolder}/favicon-32x32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${faviconFolder}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${faviconFolder}/site.webmanifest`} />

    <!-- OpenGraph / WhatsApp (<300KB budget) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:secure_url" content={resolvedOgImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={isCorset ? "@corsetsociety" : "@ElPlacerDC"} />
    <meta name="twitter:creator" content="@SegiSw" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Google Fonts: Cinzel, Cormorant Garamond, Syne, Inter, Plus Jakarta Sans, Montserrat, Pinyon Script -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@400;500;600;700&family=Pinyon+Script&family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Syne:wght@500;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Schema.org RDF @graph -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://elplacerdecompartir.com/#organization",
          "name": "El Placer de Compartir",
          "url": "https://elplacerdecompartir.com",
          "logo": "https://elplacerdecompartir.com/media/logo_elplacerdc_x.jpg",
          "sameAs": [
            "https://x.com/ElPlacerDC",
            "https://x.com/corsetsociety",
            "https://x.com/SegiSw",
            "https://www.tiktok.com/@elplacerdc"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "+57-319-419-4785",
            "contactType": "reservations",
            "areaServed": "CO"
          }
        },
        {
          "@type": "WebSite",
          "@id": "https://elplacerdecompartir.com/#website",
          "url": "https://elplacerdecompartir.com",
          "name": "El Placer de Compartir",
          "publisher": { "@id": "https://elplacerdecompartir.com/#organization" }
        }
      ]
    })} />
  </head>
  <body class="bg-[#050505] text-[#f7f4ee] selection:bg-[#c5a059] selection:text-[#050505] min-h-[100dvh] w-full overflow-x-hidden antialiased">
    {!isCorset && <Header />}
    <slot />
    {!isCorset && <Footer />}
  </body>
</html>
